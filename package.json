{
  "name": "sotf-mods-v2",
  "version": "0.0.0",
  "private": true,
  "description": "SOTF Mods v2: the home of Sons of the Forest modding (sotf-mods.com).",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "build": "turbo run build",
    "verify": "node tooling/scripts/verify.ts",
    "ci:local": "bash tooling/scripts/ci-local.sh",
    "check:forbidden": "node tooling/scripts/check-forbidden.ts",
    "check:ownership": "node tooling/scripts/check-ownership.ts",
    "i18n:check": "node tooling/scripts/delegate.ts i18n:check",
    "i18n:pseudo": "node tooling/scripts/delegate.ts i18n:pseudo",
    "gen": "node tooling/scripts/gen.ts",
    "gen:ownership": "node tooling/scripts/gen-ownership.ts",
    "dev": "turbo run dev",
    "infra:up": "node tooling/scripts/infra.ts up",
    "infra:down": "node tooling/scripts/infra.ts down",
    "infra:reset": "node tooling/scripts/infra.ts reset",
    "infra:status": "node tooling/scripts/infra.ts status",
    "db:migrate": "node tooling/scripts/delegate.ts db:migrate",
    "db:guard": "node tooling/scripts/delegate.ts db:guard",
    "db:baseline": "node tooling/scripts/delegate.ts db:baseline",
    "db:seed:dev": "node tooling/scripts/delegate.ts db:seed:dev",
    "db:reset:dev": "node tooling/scripts/delegate.ts db:reset:dev",
    "db:backfill": "node tooling/scripts/delegate.ts db:backfill",
    "db:invariants": "node tooling/scripts/delegate.ts db:invariants",
    "db:verify-snapshot": "node tooling/scripts/delegate.ts db:verify-snapshot",
    "db:revert-fix": "node tooling/scripts/delegate.ts db:revert-fix",
    "admin:grant": "node tooling/scripts/delegate.ts admin:grant",
    "e2e": "node tooling/scripts/delegate.ts e2e",
    "contract:legacy": "node tooling/scripts/delegate.ts contract:legacy",
    "lhci": "node tooling/scripts/delegate.ts lhci",
    "load": "node tooling/scripts/delegate.ts load"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
