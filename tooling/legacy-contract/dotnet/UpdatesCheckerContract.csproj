<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UpdatesChecker contract checker (PLAN §5.5, WP-24). Deserialises legacy `GET /api/mods`
    bodies with the typed DTO extracted from the UpdatesChecker DLL (research/01 §1.2) and
    Newtonsoft.Json, exactly as the in-game mod does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UpdatesCheckerContract</AssemblyName>
    <RootNamespace>SotfMods.LegacyContract</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
