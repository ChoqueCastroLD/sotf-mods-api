# sotf-v2-web · Coolify → Environment Variables → Developer view (PLAN §11.4).
# Production values; the lines marked «staging:» show what changes in the staging environment.
# Replace every <…>. Never commit real values.
NODE_ENV=production
TZ=UTC
LOG_LEVEL=info
# staging: SITE_ENV=staging (noindex + banner) · preflight (next.sotf-mods.com): SITE_ENV=preflight
SITE_ENV=production
# staging: https://beta.sotf-mods.com · preflight: https://next.sotf-mods.com
PUBLIC_SITE_URL=https://sotf-mods.com
PORT=4321
HOST=0.0.0.0
# 75 % of the 384 MB memory limit.
NODE_OPTIONS=--max-old-space-size=288
# Internal URL of the API app: http://<container name (uuid) of sotf-v2-api>:3001
INTERNAL_API_URL=http://<sotf-v2-api uuid>:3001
# Same value in web, api and worker of this environment (openssl rand -base64 48).
INTERNAL_SECRET=<secret: 48 random bytes, base64>
R2_PUBLIC_BASE_URL=https://r2.sotf-mods.com
# Public AdSense publisher id. staging: leave empty (no ads outside production).
PUBLIC_ADSENSE_CLIENT=ca-pub-2799839819522052
# AdSense ad unit ids (numeric) per placement; empty = that slot is not rendered.
PUBLIC_ADSENSE_SLOT_HOME=
PUBLIC_ADSENSE_SLOT_FEED=
PUBLIC_ADSENSE_SLOT_MOD_SIDEBAR=
# Commit being served: Coolify injects SOURCE_COMMIT (built-in); RELEASE_SHA overrides it when set.
# RELEASE_SHA=
# CSP delivery: empty = per SITE_ENV (staging report-only). After a week without unexplained
# reports on staging (API logs «csp violation»), set CSP_MODE=enforce there (PLAN §9.1).
CSP_MODE=
# Cloudflare Turnstile site key (public). staging: 1x00000000000000000000AA (always passes)
PUBLIC_TURNSTILE_SITE_KEY=<turnstile site key>
# IndexNow key: the web serves /<key>.txt (same value as the worker). staging: leave empty.
INDEXNOW_KEY=<indexnow key>
# Optional error reporting (never on public pages; PLAN §10.3).
SENTRY_DSN=
PUBLIC_SENTRY_DSN_CONSOLE=
