# sotf-v2-api · Coolify → Environment Variables → Developer view (PLAN §11.4).
# Production values; the lines marked «staging:» show what changes in the staging environment.
# Replace every <…>. Never commit real values.
SOTF_ROLE=api
NODE_ENV=production
TZ=UTC
LOG_LEVEL=info
# staging: SITE_ENV=staging · preflight: SITE_ENV=preflight
SITE_ENV=production
# staging: https://beta.sotf-mods.com · preflight: https://next.sotf-mods.com
PUBLIC_SITE_URL=https://sotf-mods.com
PORT=3001
HOST=0.0.0.0
# 75 % of the 512 MB memory limit.
NODE_OPTIONS=--max-old-space-size=384
# Same value in web, api and worker of this environment.
INTERNAL_SECRET=<secret: 48 random bytes, base64>
# HMAC of sessions, ipHash and chatHash. Same value in api and worker. Rotating it logs everyone out.
APP_SECRET=<secret: 48 random bytes, base64>
# Application role created by ops/sql/roles.sql (DML only). Internal host of sotf-mods-db: ukg0ks4.
# staging: postgres://sotf_v2_app:<password>@<sotf-v2-staging-db internal host>:5432/sotf_staging
DATABASE_URL=postgres://sotf_v2_app:<password>@ukg0ks4:5432/sotf_mods
DB_POOL_MAX=10
# true until the cutover step D3 (the legacy apps keep writing); PLAN §2.9, §5.5.
LEGACY_COEXIST=true
LEGACY_SNAKE_ALIASES=false
# R2 (S3 API; the endpoint is derived from the account id). Token scoped to sotf-mods,
# sotf-mods-private and sotf-mods-staging (PLAN §11.6).
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret access key>
# staging: R2_BUCKET=sotf-mods-staging (legacy objects are still read from r2.sotf-mods.com)
R2_BUCKET=sotf-mods
# staging: sotf-mods-staging as well
R2_PRIVATE_BUCKET=sotf-mods-private
R2_PUBLIC_BASE_URL=https://r2.sotf-mods.com
# staging: 1x0000000000000000000000000000000AA (Cloudflare's always-pass test secret)
TURNSTILE_SECRET_KEY=<turnstile secret key>
# KelvinSeek. staging: leave OPENAI_API_KEY empty or set a small budget.
OPENAI_API_KEY=<openai api key>
KELVINSEEK_MODEL=gpt-4o-mini
KELVINSEEK_DAILY_BUDGET_USD=3
# Scout (Cmd+K mod finder): uses OPENAI_API_KEY; hidden when the key is missing or the cap is spent.
SCOUT_MODEL=gpt-4o-mini
SCOUT_DAILY_BUDGET_USD=2
SCOUT_ENABLED=true
ARGON2_CONCURRENCY=2
# Sunset date (ISO, e.g. 2027-09-30) announced by the legacy /api/* routes. Empty = T0 + 12 months.
LEGACY_SUNSET_AT=
# Extra origins allowed for cookie-authenticated writes besides PUBLIC_SITE_URL (comma-separated).
# Only during the preflight/cutover overlap, e.g. https://next.sotf-mods.com
CSRF_TRUSTED_ORIGINS=
SENTRY_DSN=
