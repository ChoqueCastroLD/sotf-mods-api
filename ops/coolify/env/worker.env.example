# sotf-v2-worker · Coolify → Environment Variables → Developer view (PLAN §11.4).
# Production values; the lines marked «staging:» show what changes in the staging environment.
# Replace every <…>. Never commit real values.
SOTF_ROLE=worker
NODE_ENV=production
TZ=UTC
LOG_LEVEL=info
# staging: SITE_ENV=staging · preflight: SITE_ENV=preflight
SITE_ENV=production
# staging: https://beta.sotf-mods.com
PUBLIC_SITE_URL=https://sotf-mods.com
# Health server (GET /healthz, /readyz) for Coolify's health check.
PORT=3002
HOST=0.0.0.0
# 75 % of the 768 MB memory limit (sharp and satori run here).
NODE_OPTIONS=--max-old-space-size=576
WORKER_CONCURRENCY=2
# Operational alerts to the admins: check interval in seconds, 0 = off.
# Same values as the api of this environment.
INTERNAL_SECRET=<secret: same as the api>
APP_SECRET=<secret: same as the api>
# staging: the staging database (see api.env.example)
DATABASE_URL=postgres://sotf_v2_app:<password>@ukg0ks4:5432/sotf_mods
DB_POOL_MAX=5
# true until the cutover step D3, then false (starts legacy.counters and B18).
LEGACY_COEXIST=true
LEGACY_SNAKE_ALIASES=false
# Web container for the origin cache invalidation: http://<container name (uuid) of sotf-v2-web>:4321
WEB_INTERNAL_URL=http://<sotf-v2-web uuid>:4321
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret access key>
# staging: sotf-mods-staging
R2_BUCKET=sotf-mods
# staging: sotf-mods-staging
R2_PRIVATE_BUCKET=sotf-mods-private
R2_PUBLIC_BASE_URL=https://r2.sotf-mods.com
# Email. staging: EMAIL_TRANSPORT=allowlist + EMAIL_ALLOWLIST=<your address(es), comma-separated>
EMAIL_TRANSPORT=resend
EMAIL_FROM=SOTF Mods <noreply@sotf-mods.com>
EMAIL_ALLOWLIST=
RESEND_API_KEY=<resend api key>
# Cloudflare cache purge: token with only "Zone → Cache Purge" on sotf-mods.com (PLAN §11.5).
# staging: the same zone (beta.sotf-mods.com is in it) or leave both empty (edge TTL fallback).
CF_ZONE_ID=<zone id of sotf-mods.com>
CF_API_TOKEN=<cache purge token>
# staging: leave empty (no IndexNow pings from staging).
INDEXNOW_KEY=<indexnow key>
VIRUSTOTAL_API_KEY=<virustotal api key (optional)>
# One-off recategorisation suggestions only.
OPENAI_API_KEY=<openai api key (optional)>
KELVINSEEK_MODEL=gpt-4o-mini
SENTRY_DSN=
