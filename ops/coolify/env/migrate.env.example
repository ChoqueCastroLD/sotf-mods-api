# sotf-v2-migrate · Coolify → Environment Variables → Developer view (PLAN §11.3, §11.4).
# Runs `node dist/migrate.js up` on every deployment, then answers GET /healthz on PORT.
# Replace every <…>. Never commit real values.
SOTF_ROLE=migrate-task
NODE_ENV=production
TZ=UTC
LOG_LEVEL=info
PORT=3003
HOST=0.0.0.0
# OWNER credentials of the database (the current credential of sotf-mods-db in Coolify): the
# migrations are DDL. Only this app and sotf-v2-tools have them.
# staging: postgres://sotf_staging:<password>@<sotf-v2-staging-db internal host>:5432/sotf_staging
MIGRATIONS_DATABASE_URL=postgres://<owner user>:<owner password>@ukg0ks4:5432/sotf_mods
