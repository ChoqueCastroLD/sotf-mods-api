# sotf-v2-tools · Coolify → Environment Variables → Developer view. Start it only to run an
# operator CLI in its terminal, then stop it (ops/runbooks/deploy/05-migrations-and-backfills.md).
# Replace every <…>. Never commit real values.
SOTF_ROLE=idle
NODE_ENV=production
TZ=UTC
# Owner credentials (backfills write legacy columns under audit; PLAN §6.9, §14.5).
MIGRATIONS_DATABASE_URL=postgres://<owner user>:<owner password>@ukg0ks4:5432/sotf_mods
# R2 passes (B17, manifest fixes): the same scoped token as the api. Dry run unless --apply.
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<r2 access key id>
R2_SECRET_ACCESS_KEY=<r2 secret access key>
R2_BUCKET=sotf-mods
R2_PRIVATE_BUCKET=sotf-mods-private
R2_PUBLIC_BASE_URL=https://r2.sotf-mods.com
# Optional: LLM suggestions of r2:suggest-categories.
OPENAI_API_KEY=
