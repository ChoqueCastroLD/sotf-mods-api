+// Markdown is user content: its HTML must be sanitized before any innerHTML.
+const MARKDOWN_PURIFY_CONFIG = {
+    USE_PROFILES: { html: true },
+    FORBID_TAGS: ['style', 'form', 'input', 'button', 'textarea', 'select', 'option'],
+    FORBID_ATTR: ['style'],
+};
+
+function escapeHTML(text) {
+    return String(text ?? '')
+        .replaceAll('&', '&amp;')
+        .replaceAll('<', '&lt;')
+        .replaceAll('>', '&gt;')
+        .replaceAll('"', '&quot;')
+        .replaceAll("'", '&#39;');
+}
+
+function sanitizeMarkdownHTML(html, source) {
+    if (window.DOMPurify && typeof window.DOMPurify.sanitize === 'function') {
+        return window.DOMPurify.sanitize(html, MARKDOWN_PURIFY_CONFIG);
+    }
+    // Fail closed: without DOMPurify the markdown is shown as plain text.
+    return escapeHTML(source).replaceAll('\n', '<br>');
+}
+window.sanitizeMarkdownHTML = sanitizeMarkdownHTML;
