diff --git a/src/static/scripts/comments.js b/src/static/scripts/comments.js
new file mode 100644
index 0000000..59656db
--- /dev/null
+++ b/src/static/scripts/comments.js
@@ -0,0 +1,135 @@
+// Comment rendering with DOM nodes only: user content (message, names, URLs)
+// is always assigned through textContent or validated attributes, never HTML.
+
+const MENTION_PATTERN = /@(\w+)/g;
+
+function el(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+/** Only absolute http(s) or same-origin relative URLs are rendered. */
+export function safeUrl(value) {
+  if (typeof value !== "string" || value.trim() === "") return null;
+  try {
+    const url = new URL(value, window.location.origin);
+    return url.protocol === "https:" || url.protocol === "http:" ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Appends `message` to `parent`: line breaks become <br>, @mentions are highlighted. */
+export function appendMessage(parent, message) {
+  const lines = String(message ?? "").split("\n");
+  lines.forEach((line, index) => {
+    if (index > 0) parent.appendChild(document.createElement("br"));
+    let last = 0;
+    for (const match of line.matchAll(MENTION_PATTERN)) {
+      if (match.index > last) parent.appendChild(document.createTextNode(line.slice(last, match.index)));
+      const mention = el("span", "", match[0]);
+      mention.style.fontWeight = "bold";
+      mention.style.color = "oklch(var(--a))";
+      parent.appendChild(mention);
+      last = match.index + match[0].length;
+    }
+    if (last < line.length) parent.appendChild(document.createTextNode(line.slice(last)));
+  });
+}
+
+function avatar(user, size) {
+  const imageUrl = safeUrl(user?.imageUrl);
+  if (imageUrl) {
+    const img = el("img", `w-${size} rounded-full`);
+    img.src = imageUrl;
+    img.alt = `${user?.name ?? ""}'s avatar`;
+    return img;
+  }
+  const svgNs = "http://www.w3.org/2000/svg";
+  const svg = document.createElementNS(svgNs, "svg");
+  svg.setAttribute("class", `w-${size} h-${size} text-[#02cdb3]`);
+  svg.setAttribute("fill", "currentColor");
+  svg.setAttribute("viewBox", "0 0 24 24");
+  const path = document.createElementNS(svgNs, "path");
+  path.setAttribute("fill-rule", "evenodd");
+  path.setAttribute("clip-rule", "evenodd");
+  path.setAttribute(
+    "d",
+    "M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4h-4Z",
+  );
+  svg.appendChild(path);
+  return svg;
+}
+
+function commentImage(imageUrl, onOpenImage) {
+  const url = safeUrl(imageUrl);
+  if (!url) return null;
+  const wrapper = el("div", "mt-2");
+  const img = el("img", "rounded-lg cursor-pointer object-contain");
+  img.src = url;
+  img.alt = "Comment image";
+  img.style.maxHeight = "100px";
+  img.style.maxWidth = "200px";
+  img.addEventListener("click", () => onOpenImage?.(url));
+  wrapper.appendChild(img);
+  return wrapper;
+}
+
+function chat(comment, { isReply, canReply, onReply, onOpenImage }) {
+  const { id, message, imageUrl, createdAt, user } = comment;
+  const size = isReply ? 8 : 10;
+  const root = el("div", isReply ? "chat chat-start ml-12" : "chat chat-start");
+
+  const avatarWrapper = el("div", "chat-image avatar");
+  const avatarFrame = el("div", `w-${size} rounded-full`);
+  avatarFrame.appendChild(avatar(user, size));
+  avatarWrapper.appendChild(avatarFrame);
+  root.appendChild(avatarWrapper);
+
+  const header = el("div", "chat-header");
+  const profile = el("a", `${isReply ? "text-xs" : "text-sm"} font-bold hover:underline`, user?.name ?? "");
+  profile.href = `/profile/${encodeURIComponent(user?.slug ?? "")}`;
+  header.appendChild(profile);
+  if (user?.isTrusted) {
+    header.appendChild(document.createTextNode(" "));
+    header.appendChild(el("span", `badge badge-primary ${isReply ? "badge-xs" : "badge-sm"} ml-1`, "Trusted"));
+  }
+  header.appendChild(document.createTextNode(" "));
+  header.appendChild(el("time", "text-xs opacity-50", ` • ${new Date(createdAt).toLocaleString()}`));
+  root.appendChild(header);
+
+  const bubble = el("div", isReply ? "chat-bubble chat-bubble-secondary text-sm" : "chat-bubble");
+  appendMessage(bubble, message);
+  const image = commentImage(imageUrl, onOpenImage);
+  if (image) bubble.appendChild(image);
+  root.appendChild(bubble);
+
+  if (!isReply) {
+    const footer = el("div", "chat-footer");
+    if (canReply) {
+      const button = el("button", "btn btn-ghost btn-xs mt-1", "Reply");
+      button.type = "button";
+      button.addEventListener("click", () => onReply?.(id, user?.name ?? ""));
+      footer.appendChild(button);
+    }
+    root.appendChild(footer);
+  }
+  return root;
+}
+
+/**
+ * Replaces the content of `container` with the given comments (top-level
+ * comments with their `replies`).
+ */
+export function renderComments(container, comments, options = {}) {
+  const fragment = document.createDocumentFragment();
+  for (const comment of comments ?? []) {
+    fragment.appendChild(chat(comment, { ...options, isReply: false }));
+    for (const reply of comment.replies ?? []) {
+      fragment.appendChild(chat(reply, { ...options, isReply: true }));
+    }
+  }
+  container.replaceChildren(fragment);
+}
