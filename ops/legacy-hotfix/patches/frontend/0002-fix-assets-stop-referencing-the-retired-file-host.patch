From a954810336987322ac73c0b70ed4f98bf15bfb05 Mon Sep 17 00:00:00 2001
From: Luis Choque <luis.choque.castro@outlook.com>
Date: Tue, 29 Sep 2026 14:07:44 +0200
Subject: [PATCH 2/3] fix(assets): stop referencing the retired file host

- Default og:image and twitter:image point to
  https://sotf-mods.com/static/images/hd_thumbnail.png (2560x1440,
  served by this app) instead of an object on the dead file server.
- The build upload preview uses /static/images/thumbnail.png as its
  placeholder.
- lazyLoadImages no longer requests "<url>/preview" (a route of the old
  file server that 404s on R2) nor re-downloads every image as a blob:
  it assigns the R2 URL with loading="lazy".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/static/scripts/shared.js       | 25 +++++++------------------
 src/static/scripts/upload-build.js |  2 +-
 src/templates/build.njk            |  2 +-
 src/templates/layout.njk           |  4 ++--
 src/templates/mod.njk              |  2 +-
 5 files changed, 12 insertions(+), 23 deletions(-)

diff --git a/src/static/scripts/shared.js b/src/static/scripts/shared.js
index 2609086..90ab16e 100644
--- a/src/static/scripts/shared.js
+++ b/src/static/scripts/shared.js
@@ -174,26 +174,15 @@ if (window.showdown) {
     }
 }
 
-const blobCache = {};
-async function lazyLoadImages(elements) {
+// Images are served directly by R2; the browser loads and caches them.
+function lazyLoadImages(elements) {
     for (const img of elements) {
         const imageUrl = img.dataset.lazySrc;
-        if(blobCache[imageUrl]) {
-            img.src = blobCache[imageUrl];
-            continue;
-        }
-        try {
-            img.removeAttribute('data-lazy-src');
-            img.src = imageUrl + '/preview';
-            const f = await fetch(imageUrl);
-            const blob = await f.blob();
-            const image = URL.createObjectURL(blob);
-            blobCache[imageUrl] = image;
-            img.src = image;
-        } catch (error) {
-            // we just ignore the error and let the browser handle it
-            img.src = imageUrl;
-        }
+        img.removeAttribute('data-lazy-src');
+        if (!imageUrl) continue;
+        img.loading = 'lazy';
+        img.decoding = 'async';
+        img.src = imageUrl;
     }
 }
 
diff --git a/src/static/scripts/upload-build.js b/src/static/scripts/upload-build.js
index 74e9046..e6f340f 100644
--- a/src/static/scripts/upload-build.js
+++ b/src/static/scripts/upload-build.js
@@ -21,7 +21,7 @@ function getModTemplate(mod) {
   if (!mod.shortDescription)
     mod.shortDescription = _("This is a description of the mod.");
   return `<figure class="skeleton w-100 h-[216px]"><img data-lazy-src="${
-    mod.imageUrl || "https://files.sotf-mods.com/download/thumbnail.png"
+    mod.imageUrl || "/static/images/thumbnail.png"
   }" class="${mod.isNSFW && !user ? "blur-md hover:blur-none" : ""}" alt="${
     mod.name || _("Mod Name")
   }"/></figure>
