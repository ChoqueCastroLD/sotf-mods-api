{
  "name": "@sotf/core",
  "version": "0.0.0",
  "private": true,
  "description": "Domain services shared by the API and the worker (the only home of business logic).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../packages/config/vitest/unit.ts",
    "test:int": "vitest run --config ../../packages/config/vitest/int.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fontsource/big-shoulders": "catalog:",
    "@fontsource/martian-mono": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@node-rs/bcrypt": "catalog:",
    "@sotf/brand": "workspace:*",
    "@sotf/contracts": "workspace:*",
    "@sotf/db": "workspace:*",
    "@sotf/i18n": "workspace:*",
    "@sotf/markdown": "workspace:*",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "file-type": "catalog:",
    "isbot": "catalog:",
    "lru-cache": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "satori": "catalog:",
    "sharp": "catalog:",
    "thumbhash": "catalog:",
    "uuidv7": "catalog:",
    "yauzl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sotf/config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/yauzl": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
