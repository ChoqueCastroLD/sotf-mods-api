exports[`domain components render on the server > ReviewCard · deleted author, hidden 1`] = `"<article data-review-id="78" data-status="hidden" class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4 md:p-5"><p class="flex items-center gap-1.5 rounded-sm bg-warning-soft px-2 py-1 text-xs text-warning"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off shrink-0" focusable="false" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg>Hidden by a ranger. Only you and the rangers can see it.</p><header class="flex items-start gap-3"><svg viewBox="0 0 64 64" width="40" height="40" class="inline-block aspect-square shrink-0 rounded-full bg-raised object-cover object-center" aria-hidden="true"><circle cx="32" cy="32" r="32" fill="var(--color-raised)"></circle><circle cx="32" cy="32" r="27.5" fill="none" stroke="var(--color-chart-8)" stroke-width="3"></circle><path d="M32 1.5v7M32 55.5v7M1.5 32h7M55.5 32h7" stroke="var(--color-chart-8)" stroke-width="3" stroke-linecap="round"></path><text x="32" y="33" text-anchor="middle" dominant-baseline="central" fill="var(--color-fg)" font-family="var(--font-display)" font-weight="800" font-size="24" class="uppercase">DS</text></svg><div class="flex min-w-0 flex-1 flex-col gap-0.5"><p class="flex min-w-0 flex-wrap items-center gap-x-1.5 gap-y-1 text-sm"><span class="font-semibold text-fg-muted">Deleted survivor</span></p><p class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-fg-muted"><time dateTime="2026-09-27T20:00:00.000Z" title="Sep 27, 2026, 8:00 PM">Sep 27, 2026</time><spa