{
  "name": "@sotf/brand",
  "version": "0.0.0",
  "private": true,
  "description": "SOTF Mods «Locator» brand: isotype, lockups, favicons, OG image, topography texture, Field kit icons and deterministic generative artwork.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.ts",
    "check:assets": "node scripts/build-assets.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource/big-shoulders": "catalog:",
    "@fontsource/big-shoulders-stencil": "catalog:",
    "@fontsource/martian-mono": "catalog:",
    "@sotf/config": "workspace:*",
    "@types/node": "catalog:",
    "opentype.js": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
