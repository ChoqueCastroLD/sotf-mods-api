{
  "name": "@sotf/brand",
  "version": "0.0.0",
  "private": true,
  "description": "SOTF Mods «Locator» brand: isotype, lockups, favicons, OG image, topography texture, Field kit icons and deterministic generative artwork.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.ts",
    "check:assets": "node scripts/build-assets.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource/big-shoulders": "5.3.0",
    "@fontsource/big-shoulders-stencil": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@types/node": "24.19.0",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
