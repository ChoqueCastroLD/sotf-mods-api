{
  "name": "@sotf/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod 4 contracts shared by API, worker and web: DTOs, endpoint contracts, error codes, typed client, legacy DTOs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:int": "vitest run --config ../../packages/config/vitest/int.ts",
    "gen": "node scripts/gen-legacy.ts && node scripts/gen-routes.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@sotf/config": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "8.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
