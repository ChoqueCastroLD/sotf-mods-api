{
  "name": "@sotf/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling presets: tsconfig variants, Biome rules and Vitest projects (PLAN §2.4, §2.6).",
  "type": "module",
  "exports": {
    "./biome.json": "./biome.json",
    "./tsconfig/*": "./tsconfig/*",
    "./vitest": "./vitest/index.ts",
    "./vitest/unit": "./vitest/unit.ts",
    "./vitest/int": "./vitest/int.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "*"
  }
}
