{
  "name": "@sotf/markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Sanitised unified/remark/rehype Markdown pipeline shared by the server and the editor preview.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:int": "vitest run --config ../../packages/config/vitest/int.ts",
    "fixtures:legacy": "node test/fixtures/extract-legacy-html.ts"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "@types/markdown-it": "14.2.0",
    "markdown-it": "14.3.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@sotf/config": "workspace:*",
    "@types/jsdom": "28.0.3",
    "@types/node": "catalog:",
    "@types/showdown": "2.0.6",
    "jsdom": "catalog:",
    "rehype-stringify": "catalog:",
    "showdown": "2.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
