{
  "name": "@sotf/markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Safe Markdown pipeline (markdown-it → hast → rehype-raw/rehype-sanitize → enhancers → verifyTree → closed-set serialiser) shared by the server and the editor preview.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:int": "vitest run --config ../../packages/config/vitest/int.ts",
    "fixtures:legacy": "node test/fixtures/extract-legacy-html.ts"
  },
  "dependencies": {
    "@types/hast": "catalog:",
    "@types/markdown-it": "catalog:",
    "markdown-it": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-sanitize": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@sotf/config": "workspace:*",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@types/showdown": "catalog:",
    "jsdom": "catalog:",
    "rehype-stringify": "catalog:",
    "showdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
