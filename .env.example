# SOTF Mods v2: environment variables (PLAN §11.4). Copy to `.env` for local development:
#   cp .env.example .env
# Each app validates its own subset with Zod at start-up (src/env.ts) and exits with a clear
# message if something is missing. Values below point at the local infra (`pnpm infra:up`,
# ops/compose/dev.yml). Local-infra credentials are throwaway values, not secrets.
# NEVER commit real secrets: production/staging values live only in Coolify (PLAN §9.4).
# Removed legacy variables are not listed on purpose (PLAN §2.8; enforced by `pnpm check:forbidden`).

# ── Common (web, api, worker) ──────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=UTC
LOG_LEVEL=info
# production | staging | preflight | development (anything but production => noindex + banner)
SITE_ENV=development
PUBLIC_SITE_URL=http://127.0.0.1:47321
# PORT/HOST are set per app: dev scripts use web 47321, api 47301, worker health 47302;
# Coolify uses web 4321, api 3001, worker 3002 (PLAN §11.2, §11.3).
# PORT=
# HOST=0.0.0.0

# Shared secret for internal calls (header X-Internal-Auth). Generate: openssl rand -base64 48
INTERNAL_SECRET=

# ── web ────────────────────────────────────────────────────────────────────────────────────
INTERNAL_API_URL=http://127.0.0.1:47301
# Google AdSense publisher id (public). Leave empty locally to keep ads off.
PUBLIC_ADSENSE_CLIENT=
# Cloudflare Turnstile: official "always passes" test keys for development.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── api + worker ───────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sotf:sotf@127.0.0.1:47432/sotf
# api: 10, worker: 5
DB_POOL_MAX=10
# Owner credentials, only for the one-off migrate task.
MIGRATIONS_DATABASE_URL=postgres://sotf:sotf@127.0.0.1:47432/sotf
# HMAC key for sessions, ipHash (+ derived daily salt) and chatHash. Generate: openssl rand -base64 48
APP_SECRET=
LEGACY_COEXIST=true
LEGACY_SNAKE_ALIASES=false

# R2 (S3 API). Locally SeaweedFS emulates it; R2_ENDPOINT is only set for local/test emulators,
# in production the endpoint is derived from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ENDPOINT=http://127.0.0.1:47333
R2_ACCESS_KEY_ID=sotf-dev-access-key
R2_SECRET_ACCESS_KEY=sotf-dev-secret-key
R2_BUCKET=sotf-mods
R2_PRIVATE_BUCKET=sotf-mods-private
R2_PUBLIC_BASE_URL=http://127.0.0.1:47333/sotf-mods

# check-forbidden-allow: secret-assignment Cloudflare's documented public always-pass test secret
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

OPENAI_API_KEY=
KELVINSEEK_MODEL=gpt-4o-mini
KELVINSEEK_DAILY_BUDGET_USD=3

# Optional error reporting (all apps; never on public pages, PLAN §10.3).
SENTRY_DSN=
PUBLIC_SENTRY_DSN_CONSOLE=

# ── api only ───────────────────────────────────────────────────────────────────────────────
ARGON2_CONCURRENCY=2

# ── worker only ────────────────────────────────────────────────────────────────────────────
WEB_INTERNAL_URL=http://127.0.0.1:47321
# resend | mailpit | allowlist
EMAIL_TRANSPORT=mailpit
EMAIL_FROM="SOTF Mods <no-reply@sotf-mods.com>"
EMAIL_ALLOWLIST=
# Local Mailpit SMTP endpoint used by EMAIL_TRANSPORT=mailpit (UI: http://127.0.0.1:47080).
SMTP_URL=smtp://127.0.0.1:47025
RESEND_API_KEY=
# Cloudflare cache purge (token scoped to "Zone → Cache Purge"). Empty => no purge (TTL fallback).
CF_ZONE_ID=
CF_API_TOKEN=
VIRUSTOTAL_API_KEY=

# ── web + worker ───────────────────────────────────────────────────────────────────────────
# IndexNow key: served by the web as /<key>.txt and used by the worker to ping.
INDEXNOW_KEY=
