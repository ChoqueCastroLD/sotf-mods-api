---
/**
 * «More» (desktop and tablet): a native `popover` menu under the top bar holding what does not
 * fit the bar: Help (install guide, Share logs, Patch Radar, Developers) and the community
 * destinations the bar had to drop at this width. No framework and no JavaScript needed (the
 * popover opens from `popovertarget`; it light-dismisses and closes on Escape by itself).
 * The phone version of the same menu is `MoreSheet.astro`.
 *
 * The «Install app» row stays hidden until `lib/client/install.ts` learns the browser can
 * install the PWA.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { ChevronDown, Ellipsis, Share, Smartphone } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import { HIDE_FROM, isCurrentPath, moreGroups } from './nav-items.ts';

const locale = Astro.locals.locale;
const current = Astro.locals.pagePath.split('?', 1)[0] ?? '/';
const groups = moreGroups();
const label = m.shell_more_label();
---

<div class="relative hidden md:block">
  <button
    type="button"
    popovertarget="more-menu"
    aria-label={label}
    data-more-trigger
    class="more-anchor press loc-host flex h-10 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-fg-muted hover:text-fg lg:px-3"
  >
    <Icon icon={Ellipsis} size={20} className="lg:hidden" />
    <span class="hidden lg:inline">{label}</span>
    <Icon icon={ChevronDown} size={16} className="hidden lg:block" />
  </button>

  <div id="more-menu" popover="auto" data-more-menu class="more-menu m-0 w-72 rounded-xl border border-border bg-overlay p-1.5 text-fg shadow-lg">
    <nav aria-label={label}>
      {
        groups.map((group, index) => (
          <section class={index > 0 ? 'mt-1 border-t border-border pt-1.5' : undefined}>
            <h2 class="readout px-3 pt-1.5 pb-1">{group.title}</h2>
            <ul class="grid">
              {group.items.map((item) => (
                <li class={item.inBarFrom ? HIDE_FROM[item.inBarFrom] : undefined}>
                  <a
                    href={href(item.path, locale)}
                    aria-current={isCurrentPath(current, item.path) ? 'page' : undefined}
                    class="press flex min-h-11 items-center gap-3 rounded-md px-3 text-sm text-fg hover:bg-fg/8 focus-visible:bg-fg/8 aria-[current=page]:bg-primary-soft aria-[current=page]:font-semibold"
                  >
                    <Icon icon={item.icon} size={18} className="text-fg-muted" />
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <p data-install-ios-hint hidden class="mx-1 mt-1 flex items-start gap-2.5 border-t border-border px-2 pt-3 pb-2 text-sm text-fg-muted">
        <Icon icon={Share} size={18} className="mt-0.5 text-primary" />
        <span>{m.shell_install_ios_hint()}</span>
      </p>
      <section class="mt-1 border-t border-border pt-1.5" data-install-app-row hidden>
        <button
          type="button"
          data-install-app
          class="press flex min-h-11 w-full items-center gap-3 rounded-md px-3 text-start text-sm font-semibold text-fg hover:bg-fg/8"
        >
          <Icon icon={Smartphone} size={18} className="text-primary" />
          {m.shell_install_app()}
        </button>
      </section>
    </nav>
  </div>
</div>

<style>
  .more-anchor {
    anchor-name: --more-anchor;
  }
  div:has(> .more-menu:popover-open) > .more-anchor {
    color: var(--color-fg);
  }
  .more-menu {
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      overlay var(--dur-fast) allow-discrete,
      display var(--dur-fast) allow-discrete;
  }
  .more-menu:popover-open {
    opacity: 1;
    transform: none;
    position: fixed;
    inset: auto;
    inset-block-start: calc(var(--safe-top) + var(--topbar-h) + 0.25rem);
    inset-inline-end: max(1rem, calc((100vw - var(--container-wide)) / 2 + 1.5rem));
  }
  @supports (position-anchor: --more-anchor) {
    .more-menu:popover-open {
      position-anchor: --more-anchor;
      inset-block-start: calc(anchor(bottom) + 0.5rem);
      inset-inline-end: anchor(right);
      inset-inline-start: auto;
      position-try-fallbacks: flip-inline;
    }
  }
  @starting-style {
    .more-menu:popover-open {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
</style>
