---
/**
 * Global banners under the header (PLAN §6.10, §11.4):
 * - environment notice when `SITE_ENV` is not production (staging, preflight, development);
 * - «sign in again» after the legacy-token cleanup (hidden until the inline script sets
 *   `html[data-relogin]`);
 * - the language suggestion, a floating notice filled by `scripts/lang-suggest.ts` in the
 *   *suggested* locale (never a redirect, PLAN §4.1; out of the flow, so no layout shift).
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { FlaskConical, KeyRound, Languages, X } from 'lucide-react';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';

const env = loadEnv();
const locale = Astro.locals.locale;
const envNotice =
  env.siteEnv === 'staging'
    ? m.common_env_staging()
    : env.siteEnv === 'preflight'
      ? m.common_env_preflight()
      : env.siteEnv === 'development'
        ? m.common_env_development()
        : null;
const loginHref = href('/login', locale);
---

{
  envNotice && (
    <div class="border-b border-warning/40 bg-warning-soft text-fg" role="note">
      <p class="mx-auto flex max-w-(--container-wide) items-center gap-2 px-4 py-1.5 text-xs md:px-6">
        <Icon icon={FlaskConical} size={16} className="text-warning" />
        {envNotice}
      </p>
    </div>
  )
}

<div data-relogin-banner class="border-b border-border bg-raised text-fg" role="status">
  <div class="mx-auto flex max-w-(--container-wide) items-center gap-3 px-4 py-2 text-sm md:px-6">
    <Icon icon={KeyRound} size={18} className="text-fg-muted" />
    <p class="flex-1">
      <a href={loginHref} class="font-semibold underline underline-offset-4">{m.shell_relogin_banner()}</a>
    </p>
    <button
      type="button"
      data-relogin-dismiss
      class="flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-fg/8 hover:text-fg"
      aria-label={m.common_action_dismiss()}
    >
      <Icon icon={X} size={18} />
    </button>
  </div>
</div>

<!--
  Language prompt (scripts/locale-prompt.ts): visitor landed on a URL of another language than the
  saved one. Non-modal, floating like the suggestion below (CLS 0); filled in the preferred language.
-->
<!-- biome-ignore lint/a11y/useSemanticElements: a status banner, not a <fieldset>/<section> landmark -->
<div
  data-locale-prompt
  hidden
  role="region"
  aria-labelledby="locale-prompt-title"
  class="lang-sheet fixed inset-x-3 bottom-20 z-(--z-toast) mx-auto max-w-2xl overflow-hidden rounded-lg border border-border-strong bg-raised text-fg shadow-lg max-md:inset-x-0 max-md:bottom-0 max-md:mx-0 max-md:max-w-none max-md:rounded-b-none max-md:rounded-t-2xl max-md:border-x-0 max-md:border-b-0 md:bottom-4"
>
  <span aria-hidden="true" class="mx-auto mt-2 block h-1 w-10 rounded-full bg-border-strong md:hidden"></span>
  <div class="flex items-start gap-3 px-4 pt-3 pb-4 max-md:px-5 max-md:pt-4 max-md:pb-[calc(1.25rem+env(safe-area-inset-bottom))]">
    <Icon icon={Languages} size={20} className="mt-0.5 shrink-0 text-fg-muted" />
    <div class="min-w-0 flex-1">
      <p id="locale-prompt-title" role="status" class="font-semibold" data-locale-prompt-title></p>
      <p class="mt-0.5 text-sm text-fg-muted" data-locale-prompt-hint></p>
      <div class="mt-3 flex flex-wrap items-center gap-2 max-md:mt-4 max-md:grid max-md:grid-cols-2 max-md:[&>*]:min-h-12 max-md:[&>*]:justify-center max-md:[&>*]:text-center">
        <button
          type="button"
          data-locale-prompt-stay
          class="inline-flex min-h-10 items-center rounded-md border border-border-strong px-3 text-sm font-medium hover:bg-fg/8"
        ></button>
        <!-- biome-ignore lint/a11y/useAnchorContent: text is filled in by the locale-pref script -->
        <a
          data-locale-prompt-switch
          href="/"
          class="inline-flex min-h-10 items-center rounded-md bg-primary px-3 text-sm font-semibold text-primary-fg"
        ></a>
        <!-- biome-ignore lint/a11y/useAnchorContent: text is filled in by the locale-pref script -->
        <a
          data-locale-prompt-original
          href="/"
          hidden
          class="inline-flex min-h-10 items-center rounded-md border border-border-strong px-3 text-sm font-medium hover:bg-fg/8"
        ></a>
      </div>
      <!-- biome-ignore lint/a11y/noLabelWithoutControl: the input is nested in the label -->
      <label class="mt-3 flex cursor-pointer items-start gap-2.5 text-sm">
        <input type="checkbox" data-locale-prompt-remember class="mt-0.5 size-5 shrink-0 accent-primary" />
        <span>
          <span class="font-medium" data-locale-prompt-remember-label></span>
          <span class="block text-xs text-fg-muted" data-locale-prompt-remember-hint></span>
        </span>
      </label>
    </div>
    <button
      type="button"
      data-locale-prompt-close
      class="flex size-11 shrink-0 items-center justify-center rounded-md text-fg-muted hover:bg-fg/8 hover:text-fg"
      aria-label={m.common_action_dismiss()}
    >
      <Icon icon={X} size={18} />
    </button>
  </div>
</div>

<!-- Floating (not in the flow): appearing after load must never shift the page (CLS 0). On phones it is a bottom sheet (grabber, swipe down = «No, thanks»). -->
<div
  data-lang-suggest
  hidden
  class="lang-sheet fixed inset-x-3 bottom-20 z-(--z-toast) mx-auto max-w-xl rounded-lg border border-border-strong bg-raised text-fg shadow-lg max-md:inset-x-0 max-md:bottom-0 max-md:mx-0 max-md:max-w-none max-md:rounded-b-none max-md:rounded-t-2xl max-md:border-x-0 max-md:border-b-0 md:bottom-4"
  aria-live="polite"
>
  <span aria-hidden="true" class="mx-auto mt-2 block h-1 w-10 rounded-full bg-border-strong md:hidden"></span>
  <div class="flex flex-wrap items-center gap-3 px-4 py-2 text-sm max-md:grid max-md:gap-4 max-md:px-5 max-md:pt-4 max-md:pb-[calc(1.25rem+env(safe-area-inset-bottom))] max-md:text-base">
    <div class="flex min-w-0 flex-1 items-center gap-3">
      <Icon icon={Languages} size={20} className="shrink-0 text-fg-muted" />
      <p class="flex-1 text-balance max-md:font-semibold" data-lang-suggest-text></p>
    </div>
    <div class="flex items-center gap-2 max-md:grid max-md:grid-cols-2 max-md:[&>*]:h-12 max-md:[&>*]:justify-center">
      <a
        data-lang-suggest-accept
        href="/"
        class="inline-flex h-10 items-center rounded-md bg-primary px-3 font-semibold text-primary-fg"
        >{m.common_language_suggest_accept()}</a
      >
      <button
        type="button"
        data-lang-suggest-decline
        class="inline-flex h-10 items-center rounded-md px-3 text-fg-muted hover:bg-fg/8 hover:text-fg max-md:border max-md:border-border-strong"
        >{m.common_language_suggest_decline()}</button
      >
    </div>
  </div>
</div>

<style is:global>
  @keyframes lang-sheet-in {
    from {
      transform: translateY(100%);
    }
    to {
      transform: none;
    }
  }
  @media (max-width: 47.99rem) {
    .lang-sheet:not([hidden]) {
      animation: lang-sheet-in 0.32s var(--ease-out, ease-out) both;
      box-shadow: 0 -16px 48px rgb(0 0 0 / 0.5);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-sheet:not([hidden]) {
      animation: none;
    }
  }
</style>
