---
/**
 * ArtPicture: the painted «Locator» scenes of `public/art/<name>-<width>.{avif,webp}` (generated
 * once from the concept art with sharp: AVIF q52 + WebP q74, ≤ 50 KB each). Explicit `width` and
 * `height` reserve the box (no CLS); `priority` makes it the LCP image (eager, high priority),
 * otherwise it is lazy-loaded. Decorative by default (`alt=""`).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height' | 'alt' | 'sizes'> {
  /** File stem under `/art/`. */
  name: 'auth-side' | 'not-found' | 'empty-state' | 'cabin-waypoint';
  /** Widths that exist on disk, ascending. */
  widths: readonly number[];
  /** Intrinsic size of the widest file (the aspect ratio of the box). */
  width: number;
  height: number;
  sizes: string;
  alt?: string;
  priority?: boolean;
}

const { name, widths, width, height, sizes, alt = '', priority = false, class: className, ...rest } = Astro.props;
const srcset = (ext: 'avif' | 'webp') => widths.map((w) => `/art/${name}-${w}.${ext} ${w}w`).join(', ');
const widest = widths[widths.length - 1] ?? width;
---

<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={`/art/${name}-${widest}.webp`}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class={className}
    {...rest}
  />
</picture>
