---
/**
 * Site header (research/03 §5.4): logo · destinations that fit (`nav-items.ts`) · «More» · search
 * (field ≥ lg, icon at md, the centre tab below md) · account slot. Sticky; on phones it is a
 * compact 56 px bar that slides away while scrolling down and returns on the first upward flick
 * (`data-scroll-dir`, transform only); from md it compacts instead (CSS scroll timeline). Notch
 * and landscape insets are honoured. Works without JavaScript: the search is a real GET form to
 * `/search`, the account slot starts with «Sign in» and is upgraded by `account-hint.ts`.
 *
 * «More» (Help: install guide, Share logs, Patch Radar, Developers, plus the destinations the bar
 * had to drop) is a popover from md (`MoreMenu.astro`) and a bottom sheet on phones
 * (`MoreSheet.astro`, opened by the «⋯» button here).
 */
import { lockupSvg } from '@sotf/brand/logo';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Kbd } from '@sotf/ui/kbd';
import { Ellipsis, Search } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import HeaderAccount from '../account/HeaderAccount.astro';
import MoreMenu from './MoreMenu.astro';
import { barItems, isCurrentPath, SHOW_FROM } from './nav-items.ts';

const locale = Astro.locals.locale;
const current = Astro.locals.pagePath.split('?', 1)[0] ?? '/';

const NAV = barItems();
const isCurrent = (path: string) => isCurrentPath(current, path);
const logo = lockupSvg({ layout: 'horizontal', theme: 'adaptive', height: 24, title: '' });
const searchHref = href('/search', locale);
---

<header
  data-site-header
  class="sticky top-0 z-(--z-sticky) border-b border-border bg-bg/95 pt-safe supports-[backdrop-filter]:bg-bg/85 supports-[backdrop-filter]:backdrop-blur-md"
>
  <div
    data-header-bar
    class="mx-auto flex h-14 w-full max-w-(--container-wide) items-center gap-2 ps-[max(1rem,var(--safe-left))] pe-[max(0.75rem,var(--safe-right))] md:h-16 md:gap-3 md:px-6 lg:gap-6"
  >
    <a
      href={href('/', locale)}
      class="press touch-target flex min-h-11 shrink-0 items-center rounded-md text-fg"
      aria-label={`${m.common_site_name()} · ${m.common_nav_home()}`}
    >
      <Fragment set:html={logo} />
    </a>

    <nav aria-label={m.common_nav_label()} class="hidden md:block">
      <ul class="flex items-center gap-0.5 lg:gap-1">
        {
          NAV.map((item) => (
            <li class={SHOW_FROM[item.from]}>
              <a
                href={href(item.path, locale)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
                data-loc-pip
                class="loc-host loc-frame flex h-10 items-center rounded-md px-3 text-sm font-medium text-fg-muted transition-colors duration-(--dur-fast) hover:text-fg aria-[current=page]:text-fg lg:px-3.5"
              >
                {item.label}
                {isCurrent(item.path) && <span class="loc-pip" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <search class="ms-auto hidden w-full max-w-sm min-w-0 lg:block">
      <form method="get" action={searchHref} class="flex items-center" data-header-search>
        <label for="site-search" class="sr-only">{m.common_search_label()}</label>
        <div class="relative w-full">
          <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-fg-subtle">
            <Icon icon={Search} size={18} />
          </span>
          <input
            id="site-search"
            name="q"
            type="search"
            enterkeyhint="search"
            autocomplete="off"
            maxlength="100"
            placeholder={m.common_search_placeholder()}
            data-cmdk-input
            class="h-10 w-full rounded-md border border-border-strong bg-sunken ps-10 pe-12 text-sm text-fg placeholder:text-fg-subtle focus-visible:outline-2 focus-visible:outline-focus"
          />
          <span class="pointer-events-none absolute inset-y-0 end-2 flex items-center" aria-hidden="true">
            <Kbd>/</Kbd>
          </span>
        </div>
      </form>
    </search>

    <div class="ms-auto flex items-center gap-1 lg:ms-0" data-topbar-actions>
      <a
        href={searchHref}
        class="press hidden size-11 items-center justify-center rounded-full text-fg-muted hover:text-fg md:flex lg:hidden"
        aria-label={m.common_search_label()}
      >
        <Icon icon={Search} size={20} />
      </a>
      <MoreMenu />
      <button
        type="button"
        data-sheet-open="more-sheet"
        data-haptic
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label={m.shell_more_label()}
        class="press flex size-10 items-center justify-center rounded-full border border-border-strong text-fg hover:bg-fg/8 md:hidden"
      >
        <Icon icon={Ellipsis} size={20} />
      </button>
    </div>

    <HeaderAccount />
  </div>
</header>
