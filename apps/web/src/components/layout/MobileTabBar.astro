---
/**
 * Bottom tab bar of phones (< md): Mods, Builds, Search, Notifications (Log in for guests) and
 * Account (Register for guests). Plain: five equal tabs, icon and label, the current one in the
 * accent colour. Real links (works without JavaScript); the Account tab opens the account menu
 * (`HeaderAccount.astro`, drawn as a bottom sheet on phones) and the Search tab opens the Ctrl+K
 * palette full screen (`islands/cmdk/Trigger.ts`).
 *
 * The page HTML is the same for everyone, so both the guest and the signed-in tabs are rendered:
 * `html[data-signed-in]` (set by `scripts/account-hint.ts`) decides which pair shows. The bar slides
 * away while scrolling down (`html[data-scroll-dir]`, `lib/client/chrome.ts`) and returns on the
 * first upward flick. Safe-area aware, 44 px+ targets.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Bell, CircleUser, Hammer, LogIn, Package, Search, UserPlus } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import { isCurrentPath, PATHS } from './nav-items.ts';

const locale = Astro.locals.locale;
const current = Astro.locals.pagePath.split('?', 1)[0] ?? '/';
const on = (...paths: string[]) => paths.some((path) => isCurrentPath(current, path));
const loginHref = `${href(PATHS.login, locale)}?next=${encodeURIComponent(Astro.locals.pagePath)}`;
const accountPaths = [PATHS.dashboard, '/settings', '/me', PATHS.moderation, PATHS.profile];
---

<nav data-tab-bar aria-label={m.common_nav_label()} class="tabbar md:hidden">
  <ul class="tabbar-list">
    <li>
      <a
        href={href(PATHS.mods, locale)}
        class="tab"
        aria-current={on(PATHS.mods, '/') && !on(PATHS.search) ? 'page' : undefined}
      >
        <Icon icon={Package} size={22} />
        <span class="tab-label">{m.common_term_mods()}</span>
      </a>
    </li>
    <li>
      <a href={href(PATHS.builds, locale)} class="tab" aria-current={on(PATHS.builds) ? 'page' : undefined}>
        <Icon icon={Hammer} size={22} />
        <span class="tab-label">{m.common_term_builds()}</span>
      </a>
    </li>
    <li>
      <a href={href(PATHS.search, locale)} class="tab" aria-current={on(PATHS.search) ? 'page' : undefined}>
        <Icon icon={Search} size={22} />
        <span class="tab-label">{m.shell_nav_search()}</span>
      </a>
    </li>
    <li data-tab-guest>
      <a href={loginHref} class="tab" aria-current={on(PATHS.login) ? 'page' : undefined}>
        <Icon icon={LogIn} size={22} />
        <span class="tab-label">{m.shell_nav_login()}</span>
      </a>
    </li>
    <li data-tab-guest>
      <a href={href(PATHS.register, locale)} class="tab" aria-current={on(PATHS.register) ? 'page' : undefined}>
        <Icon icon={UserPlus} size={22} />
        <span class="tab-label">{m.shell_nav_register()}</span>
      </a>
    </li>
    <li data-tab-user>
      <a href={PATHS.notifications} class="tab" aria-current={on(PATHS.notifications) ? 'page' : undefined}>
        <span class="relative flex">
          <Icon icon={Bell} size={22} />
          <span
            data-tab-unread
            hidden
            class="absolute -top-1 -end-2 min-w-4 rounded-full bg-primary px-1 text-center text-2xs leading-4 font-semibold text-primary-fg tabular-nums"
          ></span>
        </span>
        <span class="tab-label">{m.shell_nav_notifications()}</span>
      </a>
    </li>
    <li data-tab-user>
      <button
        type="button"
        popovertarget="account-menu"
        class="tab"
        aria-haspopup="menu"
        aria-current={on(...accountPaths) ? 'page' : undefined}
      >
        <Icon icon={CircleUser} size={22} />
        <span class="tab-label">{m.shell_nav_account()}</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  .tabbar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-sticky);
    padding-inline: max(var(--safe-left), var(--safe-right));
    padding-block-end: var(--safe-bottom);
    border-block-start: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: transform var(--dur-slow) var(--ease-out);
    view-transition-name: tab-bar;
  }
  .tabbar-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    block-size: var(--tabbar-h);
    margin-inline: auto;
    max-inline-size: 32rem;
  }
  .tabbar-list > li {
    display: flex;
  }
  /* Guest or signed in: the account hint script sets `html[data-signed-in]`. */
  .tabbar-list > [data-tab-user] {
    display: none;
  }
  :global(html[data-signed-in]) .tabbar-list > [data-tab-user] {
    display: flex;
  }
  :global(html[data-signed-in]) .tabbar-list > [data-tab-guest] {
    display: none;
  }

  .tab {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-block-size: 2.75rem;
    color: var(--color-fg-muted);
    font-size: var(--text-2xs);
    font-weight: 500;
    outline-offset: -4px;
    -webkit-user-select: none;
    user-select: none;
  }
  .tab:active {
    background: color-mix(in oklab, var(--color-fg) 8%, transparent);
  }
  .tab[aria-current='page'] {
    color: var(--color-link);
  }
  .tab-label {
    line-height: 1rem;
  }

  /* Hide while scrolling down (set by the chrome script); focus inside keeps it visible. */
  :global(html[data-scroll-dir='down']) .tabbar:not(:focus-within) {
    transform: translateY(calc(100% + var(--safe-bottom)));
  }
  @media (prefers-reduced-motion: reduce) {
    .tabbar {
      transition: none;
    }
  }
</style>
