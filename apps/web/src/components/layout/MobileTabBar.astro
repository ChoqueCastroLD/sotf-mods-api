---
/**
 * MobileTabBar (research/03 §5.4, < md): Explore · Builds · **Search** (centre) · Kits · You.
 * Real links (works without JavaScript); hidden while scrolling down (`lib/client/chrome.ts`
 * sets `data-scroll-dir` on `<html>`, CSS translates the bar). 44 px targets, safe-area aware.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Backpack, Compass, DraftingCompass, Package, Search } from 'lucide-react';
import { href } from '../../lib/i18n.ts';

const locale = Astro.locals.locale;
const current = Astro.locals.pagePath.split('?', 1)[0] ?? '/';
const isCurrent = (path: string) => current === path || current.startsWith(`${path}/`);

const TABS = [
  { path: '/mods', label: m.common_nav_explore(), icon: Compass },
  { path: '/builds', label: m.common_term_builds(), icon: DraftingCompass },
  { path: '/search', label: m.common_search_label(), icon: Search, primary: true },
  { path: '/kits', label: m.common_term_kits(), icon: Package },
  { path: '/me/backpack', label: m.common_nav_you(), icon: Backpack },
] as const;
---

<nav
  data-tab-bar
  aria-label={m.common_nav_label()}
  class="fixed inset-x-0 bottom-0 z-(--z-sticky) border-t border-border bg-bg/95 pb-[env(safe-area-inset-bottom)] supports-[backdrop-filter]:bg-bg/80 supports-[backdrop-filter]:backdrop-blur-md md:hidden"
>
  <ul class="mx-auto grid h-16 max-w-lg grid-cols-5">
    {
      TABS.map((tab) => (
        <li class="flex">
          <a
            href={href(tab.path, locale)}
            aria-current={isCurrent(tab.path) ? 'page' : undefined}
            class:list={[
              'flex min-h-11 flex-1 flex-col items-center justify-center gap-0.5 text-2xs font-medium text-fg-muted aria-[current=page]:text-primary',
              'primary' in tab && tab.primary ? 'text-fg' : null,
            ]}
          >
            <span
              class:list={[
                'flex items-center justify-center',
                'primary' in tab && tab.primary ? 'size-10 rounded-full bg-primary text-primary-fg' : 'size-6',
              ]}
            >
              <Icon icon={tab.icon} size={'primary' in tab && tab.primary ? 20 : 22} />
            </span>
            <span class:list={['primary' in tab && tab.primary ? 'sr-only' : null]}>{tab.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
