---
/**
 * MobileTabBar (research/03 §5.4, < md): Explore · Builds · **Search** (centre) · Kits · You.
 * Real links (works without JavaScript). Phone: an edge-to-edge bar with the search action lifted
 * out of it like a GPS ping button; from `sm` up (large phones in landscape, small tablets) the
 * same bar floats as a centred dock instead of stretching. Safe-area aware (home indicator,
 * landscape notch), 44 px+ targets, slides away while scrolling down (`html[data-scroll-dir]`,
 * `lib/client/chrome.ts`) and returns on the first upward flick.
 *
 * The current destination is marked by the «Locator» waypoint: an orange diamond on the bar's top
 * edge (a real element, so it glides between tabs across pages through a view transition) and a
 * soft glow behind the icon. Pressing a tab sinks the icon and tints a disc behind it;
 * `lib/client/chrome.ts` adds a short vibration where the platform has one.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Backpack, Compass, DraftingCompass, Package, Search } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import { isCurrentPath } from './nav-items.ts';

const locale = Astro.locals.locale;
const current = Astro.locals.pagePath.split('?', 1)[0] ?? '/';
const isCurrent = (path: string, extra: readonly string[] = []) =>
  isCurrentPath(current, path) || extra.some((alias) => isCurrentPath(current, alias));

const TABS = [
  { path: '/mods', label: m.common_nav_explore(), icon: Compass },
  { path: '/builds', label: m.common_term_builds(), icon: DraftingCompass },
  { path: '/search', label: m.common_search_label(), icon: Search, primary: true },
  { path: '/kits', label: m.common_term_kits(), icon: Package },
  { path: '/me/backpack', label: m.common_nav_you(), icon: Backpack, alias: ['/me', '/basecamp', '/settings', '/signals'] },
] as const;
---

<nav data-tab-bar aria-label={m.common_nav_label()} class="tabbar md:hidden">
  <ul class="tabbar-list">
    {
      TABS.map((tab) => {
        const primary = 'primary' in tab && tab.primary;
        const active = isCurrent(tab.path, 'alias' in tab ? tab.alias : []);
        return (
          <li class="flex">
            <a
              href={href(tab.path, locale)}
              aria-current={active ? 'page' : undefined}
              data-tab={primary ? 'primary' : 'item'}
              class="tab"
            >
              <span class="tab-icon">
                <Icon icon={tab.icon} size={primary ? 24 : 22} />
              </span>
              <span class:list={['tab-label', primary && 'sr-only']}>{tab.label}</span>
              {active && !primary && <span class="loc-pip tab-pip" aria-hidden="true" />}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .tabbar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-sticky);
    padding-inline: max(var(--safe-left), var(--safe-right));
    padding-block-end: var(--safe-bottom);
    border-block-start: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface) 97%, transparent);
    box-shadow: 0 -12px 28px -18px var(--elev-color);
    transition: transform var(--dur-slow) var(--ease-out);
    view-transition-name: tab-bar;
  }
  @supports (backdrop-filter: blur(1px)) {
    .tabbar {
      background: color-mix(in oklab, var(--color-surface) 90%, transparent);
      backdrop-filter: blur(18px) saturate(1.3);
    }
  }
  .tabbar-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    block-size: var(--tabbar-h);
    margin-inline: auto;
    max-inline-size: 32rem;
  }
  /* Larger phones in landscape and small tablets: a centred floating dock, not a stretched bar. */
  @media (min-width: 40rem) {
    .tabbar {
      inset-inline: 0;
      inset-block-end: max(0.75rem, var(--safe-bottom));
      margin-inline: auto;
      inline-size: min(28rem, calc(100% - 2rem));
      padding-inline: 0.25rem;
      padding-block-end: 0;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-2xl);
      box-shadow: var(--shadow-lg);
    }
    .tabbar-list {
      block-size: 3.75rem;
    }
  }

  .tab {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    min-block-size: 2.75rem;
    color: var(--color-fg-muted);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.01em;
    outline-offset: -4px;
    border-radius: var(--radius-lg);
    -webkit-user-select: none;
    user-select: none;
  }
  .tab-label {
    line-height: 1rem;
  }
  .tab-icon {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 1.875rem;
    border-radius: 999px;
    transition:
      transform 90ms var(--ease-out),
      background-color 140ms var(--ease-out),
      color 140ms var(--ease-out);
  }
  /* Pressed: the icon sinks and a disc tints behind it (a hardware-key feel). */
  .tab:active .tab-icon {
    background-color: color-mix(in oklab, var(--color-fg) 14%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tab:active .tab-icon {
      transform: scale(0.88);
    }
  }
  /* Current destination: signal orange, soft glow behind the icon, label at full strength. */
  .tab[aria-current='page'] {
    color: var(--color-fg);
  }
  .tab[aria-current='page'] .tab-icon {
    color: var(--color-primary);
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--color-primary) 26%, transparent),
      transparent
    );
  }
  .tab-pip {
    --loc-vt: tab-pip;
    inset-block-end: auto;
    inset-block-start: -4px;
  }

  /* The centre action: lifted out of the bar, ringed by the bar colour so it reads as cut in. */
  .tab[data-tab='primary'] {
    min-block-size: 3rem;
    overflow: visible;
  }
  .tab[data-tab='primary'] .tab-icon {
    inline-size: 3.5rem;
    block-size: 3.5rem;
    margin-block-start: -1.5rem;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border: 4px solid var(--color-bg);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--color-primary) 55%, transparent),
      0 10px 22px -8px var(--glow-color);
  }
  .tab[data-tab='primary']:active .tab-icon {
    background: var(--color-primary-hover);
  }
  .tab[data-tab='primary'][aria-current='page'] .tab-icon {
    color: var(--color-primary-fg);
    background: var(--color-primary);
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  /* Hide while scrolling down (set by the chrome script); focus inside keeps it visible. */
  :global(html[data-scroll-dir='down']) .tabbar:not(:focus-within) {
    transform: translateY(calc(100% + 1.5rem + var(--safe-bottom)));
  }
  @media (prefers-reduced-motion: reduce) {
    .tabbar {
      transition: none;
    }
  }
</style>
