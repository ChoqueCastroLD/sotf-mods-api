---
/**
 * Site footer, like the old one: three link columns (SOTF-MODS, Partners, Related sites), a row with
 * the site pages (About, install guide, logs, developers, legal) and the language switcher, and the
 * grayscale logo with «Providing quality mods since March 2023» and the fan-community disclaimer.
 */
import { m } from '@sotf/i18n/messages';
import { LanguageSwitcher } from '@sotf/ui/language-switcher';
import { href, languageLinks } from '../../lib/i18n.ts';
import { PATHS } from './nav-items.ts';
import SiteLogo from './SiteLogo.astro';

const locale = Astro.locals.locale;
const languages = languageLinks(Astro.locals.pagePath);

interface FooterLink {
  label: string;
  url: string;
  description?: string;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: 'SOTF-MODS',
    links: [
      { label: 'YouTube Shoko', url: 'https://www.youtube.com/@ShokoCC' },
      {
        label: 'GitHub Backend',
        url: 'https://github.com/ChoqueCastroLD/sotf-mods-api',
        description: m.shell_footer_github_backend(),
      },
      {
        label: 'GitHub Frontend',
        url: 'https://github.com/ChoqueCastroLD/sotf-mods-frontend',
        description: m.shell_footer_github_frontend(),
      },
    ],
  },
  {
    title: m.shell_footer_partners(),
    links: [
      { label: 'Discord Sons of | The forest', url: 'https://discord.gg/sotf' },
      { label: 'YouTube Toni Macaroni', url: 'https://www.youtube.com/@tonimacaroni8746' },
    ],
  },
  {
    title: m.shell_footer_related(),
    links: [
      { label: 'Tonihub', url: 'https://tonihub.com/', description: m.shell_footer_tonihub() },
      {
        label: 'RedLoader Wiki',
        url: 'https://tonimacaroni.github.io/RedLoader/',
        description: m.shell_footer_redloader(),
      },
      {
        label: 'SOTF Mods Tutorials',
        url: 'https://imaxel0.github.io/sotf-mods-tutorials/',
        description: m.shell_footer_tutorials(),
      },
    ],
  },
];

const pages = [
  { path: PATHS.about, label: m.common_footer_about() },
  { path: PATHS.install, label: m.shell_more_install_guide() },
  { path: PATHS.logs, label: m.logs_nav_link() },
  { path: PATHS.developers, label: m.shell_footer_developers() },
  { path: PATHS.terms, label: m.common_footer_terms() },
  { path: PATHS.privacy, label: m.common_footer_privacy() },
  { path: PATHS.cookies, label: m.common_footer_cookies() },
  { path: PATHS.contentPolicy, label: m.common_footer_content_policy() },
  { path: PATHS.dmca, label: m.common_footer_dmca() },
];
---

<footer class="mt-auto border-t border-border bg-surface pb-[calc(var(--bottom-chrome)+1.5rem)] md:pb-0">
  <div
    class="mx-auto grid w-full max-w-(--container-wide) gap-10 py-10 ps-[max(1rem,var(--safe-left))] pe-[max(1rem,var(--safe-right))] md:px-6"
  >
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="mb-3 text-sm font-semibold text-fg">{column.title}</h2>
            <ul class="grid gap-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener"
                    class="group grid gap-0.5 text-sm text-fg-muted hover:text-fg"
                  >
                    <span class="text-fg underline-offset-4 group-hover:underline">{link.label}</span>
                    {link.description && <span>{link.description}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-1 border-t border-border pt-5">
      <nav aria-label={m.common_footer_resources()} class="w-full min-w-0 md:w-auto md:flex-1">
        <ul class="flex flex-wrap gap-x-5">
          {
            pages.map((page) => (
              <li>
                <a
                  href={href(page.path, locale)}
                  class="inline-flex min-h-11 items-center text-sm text-fg-muted underline-offset-4 hover:text-fg hover:underline md:min-h-9"
                >
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <LanguageSwitcher languages={languages} current={locale} placement="top" />
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-border pt-6 text-sm text-fg-muted">
      <div class="flex items-center gap-4">
        <SiteLogo variant="footer" height={64} />
        <p>
          Sons of the Forest Mods<br />{m.shell_footer_since()}
        </p>
      </div>
      <p class="max-w-(--container-prose) text-xs text-fg-subtle md:ms-auto">{m.common_disclaimer()}</p>
    </div>
  </div>
</footer>
