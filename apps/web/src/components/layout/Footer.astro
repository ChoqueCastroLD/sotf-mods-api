---
/**
 * Site footer. The content of the old one (SOTF-MODS, Partners and Related sites links, site pages,
 * legal links, language, «Providing quality mods since March 2023», the fan-community disclaimer)
 * in a clear structure: a brand block (logo, one line, Discord), four link columns, and a bottom bar
 * (copyright, legal links, language) with the disclaimer under it.
 *
 * Phones: the columns are accordions (`<details>`, all open without JavaScript; the script below
 * folds them on small screens and keeps them open from `md`). The footer sits on the surface tone
 * so it reads as the base of the page.
 */
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { LanguageSwitcher } from '@sotf/ui/language-switcher';
import { ChevronDown } from 'lucide-react';
import { href, languageLinks } from '../../lib/i18n.ts';
import { FOOTER_ACCORDION_SCRIPT } from '../../scripts/footer-accordion.ts';
import { DISCORD_ICON_PATH, DISCORD_URL, PATHS } from './nav-items.ts';
import SiteLogo from './SiteLogo.astro';

const locale = Astro.locals.locale;
const languages = languageLinks(Astro.locals.pagePath);

interface FooterLink {
  label: string;
  url: string;
  description?: string;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: 'SOTF-MODS',
    links: [
      { label: 'YouTube Shoko', url: 'https://www.youtube.com/@ShokoCC' },
      {
        label: 'GitHub Backend',
        url: 'https://github.com/ChoqueCastroLD/sotf-mods-api',
        description: m.shell_footer_github_backend(),
      },
      {
        label: 'GitHub Frontend',
        url: 'https://github.com/ChoqueCastroLD/sotf-mods-frontend',
        description: m.shell_footer_github_frontend(),
      },
    ],
  },
  {
    title: m.shell_footer_partners(),
    links: [
      { label: 'Discord Sons of | The forest', url: 'https://discord.gg/sotf' },
      { label: 'YouTube Toni Macaroni', url: 'https://www.youtube.com/@tonimacaroni8746' },
    ],
  },
  {
    title: m.shell_footer_related(),
    links: [
      { label: 'Tonihub', url: 'https://tonihub.com/', description: m.shell_footer_tonihub() },
      {
        label: 'RedLoader Wiki',
        url: 'https://tonimacaroni.github.io/RedLoader/',
        description: m.shell_footer_redloader(),
      },
      {
        label: 'SOTF Mods Tutorials',
        url: 'https://imaxel0.github.io/sotf-mods-tutorials/',
        description: m.shell_footer_tutorials(),
      },
    ],
  },
];

const resources: FooterLink[] = [
  { label: m.common_footer_about(), url: href(PATHS.about, locale) },
  { label: m.shell_more_install_guide(), url: href(PATHS.install, locale) },
  { label: m.logs_nav_link(), url: href(PATHS.logs, locale) },
  { label: m.shell_footer_developers(), url: href(PATHS.developers, locale) },
];
// The site pages are internal links (same tab); the community links open in a new tab.
const internal = new Set(resources.map((link) => link.url));
columns.unshift({ title: m.common_footer_resources(), links: resources });

const legal = [
  { path: PATHS.terms, label: m.common_footer_terms() },
  { path: PATHS.privacy, label: m.common_footer_privacy() },
  { path: PATHS.cookies, label: m.common_footer_cookies() },
  { path: PATHS.contentPolicy, label: m.common_footer_content_policy() },
  { path: PATHS.dmca, label: m.common_footer_dmca() },
];
const year = new Date().getUTCFullYear();
---

<footer
  data-site-footer
  class="mt-auto border-t border-border bg-surface pb-[calc(var(--bottom-chrome)+1rem)] md:pb-0"
>
  <div
    class="mx-auto w-full max-w-(--container-wide) ps-[max(1rem,var(--safe-left))] pe-[max(1rem,var(--safe-right))] md:px-6"
  >
    <div data-defer-footer class="grid gap-6 py-8 md:gap-8 md:py-12 lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] lg:gap-16">
      <div class="grid content-start justify-items-start gap-4">
        <a
          href={href(PATHS.home, locale)}
          aria-label="SOTF Mods"
          class="-m-1 block rounded-sm p-1 transition-opacity hover:opacity-85"
        >
          <SiteLogo variant="header" height={34} />
        </a>
        <p class="max-w-xs text-sm text-fg-muted">{m.shell_footer_tagline()}</p>
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener"
          class={buttonClasses({ variant: 'secondary', size: 'md', className: 'max-md:h-11' })}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d={DISCORD_ICON_PATH}></path>
          </svg>
          {m.shell_footer_discord()}
        </a>
        <p class="text-xs text-fg-subtle">{m.shell_footer_since()}</p>
      </div>

      <div
        class="grid border-t border-border md:grid-cols-2 md:gap-x-10 md:gap-y-8 md:border-t-0 xl:grid-cols-4"
        data-footer-columns
      >
        {
          columns.map((column) => (
            <details
              open
              class="group border-b border-border md:border-b-0"
              data-footer-column
            >
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-fg select-none md:pointer-events-none md:min-h-0 md:cursor-default md:pb-3 [&::-webkit-details-marker]:hidden">
                <h2 class="contents">{column.title}</h2>
                <span class="flex text-fg-subtle transition-transform duration-(--dur-fast) group-open:rotate-180 md:hidden">
                  <Icon icon={ChevronDown} size={18} />
                </span>
              </summary>
              <ul class="grid gap-1 pb-4 md:gap-2 md:pb-0">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target={internal.has(link.url) ? undefined : '_blank'}
                      rel={internal.has(link.url) ? undefined : 'noopener'}
                      class="group/link grid gap-0.5 rounded-xs py-1 text-sm"
                    >
                      <span class="w-fit text-fg-muted underline-offset-4 transition-colors duration-(--dur-fast) group-hover/link:text-fg group-hover/link:underline">
                        {link.label}
                      </span>
                      {link.description && <span class="text-xs text-fg-subtle">{link.description}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
    </div>

    <div class="grid gap-5 py-6 md:border-t md:border-border">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-8">
        <p class="text-sm text-fg-muted md:shrink-0">{m.shell_footer_copyright({ year })}</p>
        <nav aria-label={m.shell_footer_legal()} class="min-w-0 md:flex-1">
          <ul class="flex flex-wrap gap-x-5 gap-y-0.5">
            {
              legal.map((page) => (
                <li>
                  <a
                    href={href(page.path, locale)}
                    class="inline-flex min-h-9 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-(--dur-fast) hover:text-fg hover:underline md:min-h-8"
                  >
                    {page.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <LanguageSwitcher languages={languages} current={locale} placement="top" className="max-md:-ms-2.5" />
      </div>
      <p class="max-w-3xl text-xs text-fg-subtle">{m.common_disclaimer()}</p>
    </div>
  </div>
</footer>

<script is:inline set:html={FOOTER_ACCORDION_SCRIPT} />
