---
/**
 * Art: a responsive `<picture>` for the generated concept art in `public/art/`
 * (`<name>-<width>.avif` and `.webp`, built by `apps/web/scripts/build-pwa-art.mjs`). Explicit
 * `width`/`height` (no layout shift), lazy and async by default; pass `priority` for the LCP image.
 * Decorative by default (`alt=""`).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height' | 'alt'> {
  /** File stem under `/art/`, e.g. `offline`. */
  name: string;
  /** Widths that exist on disk, ascending; the largest is the fallback `src`. */
  widths: readonly number[];
  /** Intrinsic size of the largest file (sets the aspect ratio). */
  width: number;
  height: number;
  /** `sizes` attribute; default full width. */
  sizes?: string;
  alt?: string;
  /** LCP image: eager, high priority. */
  priority?: boolean;
}

const { name, widths, width, height, sizes = '100vw', alt = '', priority = false, class: className, ...rest } = Astro.props;
const largest = widths[widths.length - 1] ?? width;
const srcset = (ext: 'avif' | 'webp') => widths.map((w) => `/art/${name}-${w}.${ext} ${w}w`).join(', ');
---

<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={`/art/${name}-${largest}.webp`}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class={className}
    {...rest}
  />
</picture>
