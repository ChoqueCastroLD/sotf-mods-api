---
/**
 * «Download all» (PLAN §7.8): a sheet with the kit's files as a sequential checklist. Every link is
 * the normal download route (so each one counts and gets the same 302 to R2); the page script
 * ticks an item when its link is used, remembers the ticks for this kit revision in
 * `sessionStorage`, shows the progress and offers «Download next». Bundles/RedManager install are
 * T1. Without JavaScript the opener jumps to the item list, which has the same links.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { ArrowDownToLine, BookOpen } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import ModDialog from '../mod/ModDialog.astro';
import type { KitDTO } from './data.ts';
import { downloadableItems, itemDownloadPath, itemVersion, totalSizeLabel } from './format.ts';

interface Props {
  kit: KitDTO;
}

const { kit } = Astro.props;
const locale = Astro.locals.locale;
const items = downloadableItems(kit);
const size = totalSizeLabel(kit, locale);
---

<ModDialog
  id="kit-download-dialog"
  title={m.kits_download_all_title()}
  description={size
    ? m.kits_download_all_description_size({ count: items.length, size })
    : m.kits_download_all_description({ count: items.length })}
>
  <p class="text-sm text-fg-muted">{m.kits_download_all_hint()}</p>
  <div class="grid gap-2">
    <div class="flex items-center justify-between gap-3 text-sm">
      <p class="font-medium text-fg" data-kit-progress-text aria-live="polite">
        {m.kits_download_progress({ done: 0, total: items.length })}
      </p>
      <button
        type="button"
        data-kit-download-next
        class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover disabled:opacity-55"
      >
        <Icon icon={ArrowDownToLine} size={16} />
        {m.kits_download_next()}
      </button>
    </div>
    <progress
      class="h-2 w-full overflow-hidden rounded-full [&::-moz-progress-bar]:bg-primary [&::-webkit-progress-bar]:bg-raised [&::-webkit-progress-value]:bg-primary"
      max={items.length}
      value="0"
      data-kit-progress
      aria-label={m.kits_download_progress_label()}></progress>
  </div>
  <ol class="grid gap-2" data-kit-checklist>
    {
      items.map((item, index) => (
        <li class="flex items-center gap-3 rounded-md border border-border px-3 py-2" data-kit-check={item.mod.id}>
          <input
            type="checkbox"
            id={`kit-check-${item.mod.id}`}
            class="size-5 shrink-0 accent-(--color-primary)"
            data-kit-check-box
          />
          <label for={`kit-check-${item.mod.id}`} class="min-w-0 flex-1">
            <span class="font-mono text-xs text-fg-subtle tabular-nums">{index + 1}. </span>
            <span class="font-medium text-fg">{item.mod.name}</span>
            <span class="font-mono text-xs text-fg-muted"> v{itemVersion(item)}</span>
            {item.isAutoDependency && <span class="text-xs text-fg-muted"> · {m.kits_item_auto_dependency()}</span>}
          </label>
          <a
            href={itemDownloadPath(item)}
            rel="nofollow"
            data-no-prerender
            data-kit-download={item.mod.id}
            class="inline-flex h-11 shrink-0 items-center gap-1.5 rounded-md border border-border-strong px-3 text-sm font-semibold hover:bg-fg/6"
          >
            <Icon icon={ArrowDownToLine} size={16} />
            <span class="sr-only">{m.kits_item_download_sr({ name: item.mod.name, version: itemVersion(item) ?? '' })}</span>
            <span aria-hidden="true">{m.common_action_download()}</span>
          </a>
        </li>
      ))
    }
  </ol>
  <a href={href('/install', locale)} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-link">
    <Icon icon={BookOpen} size={16} />
    {m.kits_download_install_guide()}
  </a>
</ModDialog>
