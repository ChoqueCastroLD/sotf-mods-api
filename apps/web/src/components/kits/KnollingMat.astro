---
/**
 * «Knolling» header of a kit (research/03 §6.5): the mod icons laid out square on a cutting mat,
 * each slot slightly rotated (deterministic, so the cached HTML never changes between renders),
 * with the kit's own cover instead when it has one. Decorative: the list below carries the
 * information. Rotations are dropped under `prefers-reduced-motion` (no hover wobble either).
 */
import Picture from '../layout/Picture.astro';
import type { KitDTO } from './data.ts';

interface Props {
  kit: KitDTO;
}

const { kit } = Astro.props;
const ROTATIONS = [-2.5, 1.5, -1, 2, -1.5, 1, 2.5, -2, 1, -1.5, 2, -1] as const;
const slots = kit.items
  .filter((item) => item.mod.thumbnail !== null)
  .slice(0, 12)
  .map((item) => item.mod.thumbnail);
const emptySlots = Math.max(0, (slots.length <= 6 ? 6 : 12) - slots.length);
// Phones: two full rows of four at most, and no placeholders (they read as «missing pictures»).
const PHONE_SLOTS = 8;
---

{
  kit.cover ? (
    <div class="aspect-[3/1] overflow-hidden rounded-xl border border-border bg-raised max-sm:-mx-4 max-sm:aspect-[2/1] max-sm:rounded-none max-sm:border-x-0">
      <Picture
        image={kit.cover}
        sizes="(min-width: 80rem) 1216px, 100vw"
        alt=""
        priority
        hero
        class="size-full object-cover"
      />
    </div>
  ) : (
    <div
      aria-hidden="true"
      data-surface="blueprint"
      class="texture-blueprint relative overflow-hidden rounded-xl border border-dashed border-blueprint/50 bg-sunken p-4 max-sm:-mx-4 max-sm:rounded-none max-sm:border-x-0 max-sm:border-solid max-sm:px-5 sm:p-6"
    >
      <ul class="grid grid-cols-4 place-items-center gap-3 sm:grid-cols-6 sm:gap-5">
        {slots.map((image, index) => (
          <li
            class:list={[
              'kit-knoll block aspect-square w-full max-w-24 overflow-hidden rounded-md bg-raised shadow-md',
              index >= PHONE_SLOTS && 'max-sm:hidden',
            ]}
            style={`--knoll-rotate:${ROTATIONS[index % ROTATIONS.length]}deg`}
          >
            {image && (
              <Picture
                image={image}
                sizes="96px"
                alt=""
                fallbackWidth={96}
                fallbackHeight={96}
                class="size-full object-cover"
              />
            )}
          </li>
        ))}
        {Array.from({ length: emptySlots }, (_, index) => (
          <li
            class="kit-knoll block aspect-square w-full max-w-24 rounded-md border border-dashed border-blueprint/40 max-sm:hidden"
            style={`--knoll-rotate:${ROTATIONS[(slots.length + index) % ROTATIONS.length]}deg`}
          />
        ))}
      </ul>
    </div>
  )
}

<style>
  .kit-knoll {
    rotate: var(--knoll-rotate, 0deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .kit-knoll {
      rotate: 0deg;
    }
  }
</style>
