---
/**
 * Share a kit (PLAN §7.8): the share code `KIT-XXXX-XX` (type it on `/kits` or in RedManager
 * later), the short URL `/k/XXXXXX`, the full link, a Markdown line for Discord, X/Reddit, the
 * system share sheet where available and a QR code of the short URL (drawn on demand by the mod
 * page's QR encoder, loaded only when the disclosure opens).
 */
import { kitShortPath } from '@sotf/contracts/kits';
import { absoluteUrl } from '@sotf/contracts/seo';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Copy, QrCode, Share2 } from 'lucide-react';
import ModDialog from '../mod/ModDialog.astro';
import type { KitDTO } from './data.ts';

interface Props {
  kit: KitDTO;
  /** Absolute canonical URL of the kit (localised). */
  url: string;
  siteUrl: string;
}

const { kit, url, siteUrl } = Astro.props;
const shortUrl = absoluteUrl(kitShortPath(kit.code), siteUrl);
const markdown = `**[${kit.name.replace(/[[\]]/g, '')}](${shortUrl})** — ${m.kits_share_markdown_suffix({ count: kit.items.length, code: kit.code })}`;
const shareText = m.kits_share_text({ name: kit.name });
const xHref = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shortUrl)}`;
const redditHref = `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(kit.name)}`;
const fieldClasses =
  'min-w-0 flex-1 rounded-md border border-border-strong bg-raised px-3 py-2 font-mono text-xs text-fg';
const copyClasses =
  'inline-flex h-11 shrink-0 items-center gap-2 rounded-md border border-border-strong px-3 text-sm font-semibold hover:bg-fg/6';
const externalClasses =
  'inline-flex h-11 items-center justify-center gap-2 rounded-md border border-border-strong px-3 text-sm font-semibold hover:bg-fg/6';
const fields = [
  { id: 'kit-share-code', label: m.kits_share_code_label(), value: kit.code },
  { id: 'kit-share-short', label: m.kits_share_short_label(), value: shortUrl },
  { id: 'kit-share-link', label: m.kits_share_link_label(), value: url },
];
---

<ModDialog id="kit-share-dialog" title={m.kits_share_title()} description={m.kits_share_description()}>
  {
    fields.map((field) => (
      <div class="grid gap-1.5">
        <label for={field.id} class="text-sm font-semibold">
          {field.label}
        </label>
        <div class="flex gap-2">
          <input id={field.id} type="text" readonly value={field.value} class={fieldClasses} data-share-select />
          <button type="button" class={copyClasses} data-copy-from={field.id}>
            <Icon icon={Copy} size={16} />
            {m.common_action_copy()}
          </button>
        </div>
      </div>
    ))
  }

  <div class="grid gap-1.5">
    <label for="kit-share-markdown" class="text-sm font-semibold">{m.kits_share_markdown_label()}</label>
    <div class="flex gap-2">
      <textarea id="kit-share-markdown" readonly rows="2" class:list={[fieldClasses, 'resize-none']} data-share-select
        >{markdown}</textarea
      >
      <button type="button" class={copyClasses} data-copy-from="kit-share-markdown">
        <Icon icon={Copy} size={16} />
        {m.common_action_copy()}
      </button>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
    <a href={xHref} target="_blank" rel="noopener noreferrer" class={externalClasses}>
      {m.kits_share_on({ network: 'X' })}
      <span class="sr-only">{m.common_new_tab()}</span>
    </a>
    <a href={redditHref} target="_blank" rel="noopener noreferrer" class={externalClasses}>
      {m.kits_share_on({ network: 'Reddit' })}
      <span class="sr-only">{m.common_new_tab()}</span>
    </a>
    <button type="button" hidden data-native-share class={externalClasses}>
      <Icon icon={Share2} size={16} />
      {m.kits_share_more()}
    </button>
  </div>

  <details class="group rounded-md border border-border" data-share-qr-details>
    <summary class="flex min-h-11 cursor-pointer items-center gap-2 px-3 font-semibold">
      <Icon icon={QrCode} size={18} />
      {m.kits_share_qr()}
    </summary>
    <div class="grid justify-items-center gap-2 p-4">
      <div
        data-share-qr
        data-qr-value={shortUrl}
        role="img"
        aria-label={m.kits_share_qr_alt({ name: kit.name })}
        class="size-56 rounded-md bg-white p-3"
      >
      </div>
      <p class="font-mono text-sm text-fg">{kit.code}</p>
      <p class="text-xs text-fg-muted">{m.kits_share_qr_hint()}</p>
    </div>
  </details>
  <p class="sr-only" role="status" aria-live="polite" data-share-status></p>
</ModDialog>
