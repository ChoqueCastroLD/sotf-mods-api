---
/**
 * «More actions» bottom sheet of the kit page on phones (opened from the sticky bar): copy the kit
 * code, share (the system share sheet when there is one, else the share dialog), fork and, for the
 * curator, edit. The follow button lives in the bar itself. Handled by `scripts/index.ts`.
 */
import { kitShortPath } from '@sotf/contracts/kits';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Copy, GitFork, Pencil, Share2 } from 'lucide-react';
import ModDialog from '../mod/ModDialog.astro';
import type { KitDTO } from './data.ts';

interface Props {
  kit: KitDTO;
  login: string;
}

const { kit, login } = Astro.props;
const ROW =
  'flex min-h-14 w-full items-center gap-3 rounded-lg px-2 py-2 text-start text-base font-medium text-fg active:bg-fg/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus';
const TILE = 'flex size-10 shrink-0 items-center justify-center rounded-lg bg-raised text-signal';
---

<ModDialog id="kit-more-sheet" title={m.mod_action_more()} bodyClass="!gap-0 !px-3 !py-2">
  <ul class="grid">
    <li>
      <button type="button" hidden data-js-only data-copy-text={kit.code} class={ROW}>
        <span class={TILE}><Icon icon={Copy} size={20} /></span>
        <span class="min-w-0 flex-1">{m.kits_copy_code()}</span>
        <span class="font-mono text-sm text-fg-muted">{kit.code}</span>
      </button>
    </li>
    <li>
      <a href={kitShortPath(kit.code)} data-share-action data-dialog-open="kit-share-dialog" class={ROW}>
        <span class={TILE}><Icon icon={Share2} size={20} /></span>
        <span class="min-w-0 flex-1">{m.common_action_share()}</span>
      </a>
    </li>
    <li>
      <a href={login} data-kit-fork rel="nofollow" class={ROW}>
        <span class={TILE}><Icon icon={GitFork} size={20} /></span>
        <span class="min-w-0 flex-1">{m.kits_fork()}</span>
      </a>
    </li>
    <li>
      <a href={`/me/kits/${kit.id}`} hidden data-kit-owner-only rel="nofollow" class={ROW}>
        <span class={TILE}><Icon icon={Pencil} size={20} /></span>
        <span class="min-w-0 flex-1">{m.kits_edit()}</span>
      </a>
    </li>
  </ul>
</ModDialog>
