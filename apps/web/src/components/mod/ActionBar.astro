---
/**
 * Actions of the mod header: the Download button (latest version and size, the other versions in
 * its menu), «Install with RedManager» (opens the install steps), and a small group with Follow,
 * Share and Report. On phones `MobileDownloadBar` is the download CTA and `MoreSheet` holds the rest.
 *
 * Without JavaScript the download links work (302 to R2), Install opens `/install` and Follow
 * leads to sign-in; Share and Report (dialogs) stay hidden until the page script enables them.
 * Follow is upgraded to a toggle for signed-in visitors (`scripts/mod/follow.ts`).
 */
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { DownloadSplitButton, downloadOptionOf } from '@sotf/ui/domain';
import { Icon } from '@sotf/ui/icons';
import { BookOpen, Flag, Heart, Share2 } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { ModDetailDTO, VersionDTO } from './data.ts';
import { otherVersions, versionsPagePath } from './format.ts';
import { FOCUS_RING } from './styles.ts';

interface Props {
  mod: ModDetailDTO;
  versions: VersionDTO[] | null;
  loginHref: string;
}

const { mod, versions, loginHref } = Astro.props;
const locale = Astro.locals.locale;
const latest = mod.latestVersion;
const downloadable = latest !== null && latest.status === 'active';
const others = otherVersions(versions, latest?.id ?? null).map(downloadOptionOf);
const versionsHref = href(versionsPagePath(mod), locale);
const LINK =
  'inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-fg-muted ' +
  'hover:bg-fg/6 hover:text-fg aria-pressed:text-primary aria-busy:cursor-progress ' +
  FOCUS_RING;
---

<div class="grid gap-3 max-md:hidden" data-mod-actions>
  <div class="flex flex-wrap items-start gap-3">
    {
      downloadable && latest ? (
        <div data-download-area class="min-w-0">
          <DownloadSplitButton
            primary={downloadOptionOf(latest)}
            others={others}
            allVersionsHref={versionsHref}
            size="md"
          />
        </div>
      ) : (
        <p class="text-sm text-fg-muted">
          {m.mod_download_unavailable()}{' '}
          <a href={versionsHref} class="font-semibold text-link underline underline-offset-3">{m.mod_tab_versions()}</a>
        </p>
      )
    }
    <a
      href={href('/install', locale)}
      data-dialog-open="install-dialog"
      data-track="install_modal_open"
      class={buttonClasses({ variant: 'secondary', size: 'md' })}
    >
      <Icon icon={BookOpen} size={16} />
      <span>{m.mod_action_install_manager()}</span>
    </a>
  </div>

  <div class="-ms-2.5 flex flex-wrap items-center gap-1">
    <a href={loginHref} data-follow data-mod-id={mod.id} data-followers={mod.followers} class={LINK}>
      <Icon icon={Heart} size={16} className="[[aria-pressed=true]_&]:fill-current" />
      <span data-follow-label>{m.common_action_follow()}</span>
      <span class="sr-only" data-follow-name>{mod.name}</span>
    </a>
    <button type="button" hidden data-dialog-open="share-dialog" data-js-only class={LINK}>
      <Icon icon={Share2} size={16} />
      <span>{m.common_action_share()}</span>
    </button>
    <button type="button" hidden data-dialog-open="report-dialog" data-js-only class={LINK}>
      <Icon icon={Flag} size={16} />
      <span>{m.mod_action_report()}</span>
    </button>
  </div>
</div>
