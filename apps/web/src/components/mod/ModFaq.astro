---
/**
 * Questions and answers the author wrote for this mod (plain list, all visible, the same text the
 * `FAQPage` JSON-LD carries). Nothing is generated: without author entries the section is absent.
 */
import { m } from '@sotf/i18n/messages';
import type { FaqEntry } from '../../lib/seo/faq.ts';
import { SECTION_TITLE_CLASSES } from './styles.ts';

interface Props {
  items: readonly FaqEntry[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section id="faq" aria-labelledby="faq-title" class="grid scroll-mt-24 gap-4">
      <h2 id="faq-title" class={SECTION_TITLE_CLASSES}>
        {m.mod_faq_title()}
      </h2>
      <dl class="grid divide-y divide-border">
        {items.map((item) => (
          <div id={item.id} class="scroll-mt-24 py-4 first:pt-0 last:pb-0">
            <dt class="font-semibold text-balance text-fg">{item.question}</dt>
            <dd class="mt-1.5 text-pretty text-fg-muted">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
