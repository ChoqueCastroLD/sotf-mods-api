---
/**
 * «Required by (N)»: published mods that declare this one as a required dependency. The list
 * comes from `GET /mods/:id/dependents` (optional call).
 */
import { m } from '@sotf/i18n/messages';
import type { ModCardDTO, ModDetailDTO } from './data.ts';
import ModList from './ModList.astro';
import { SIDE_BLOCK_CLASSES, SIDE_TITLE_CLASSES } from './styles.ts';

interface Props {
  mod: ModDetailDTO;
  dependents: ModCardDTO[];
}

const { mod, dependents } = Astro.props;
const shown = dependents.slice(0, 6);
---

{
  mod.dependentsCount > 0 && (
    <section data-fold="closed" aria-labelledby="required-by-title" class={SIDE_BLOCK_CLASSES}>
      <h2 id="required-by-title" class={SIDE_TITLE_CLASSES}>
        {m.mod_required_by_title({ count: mod.dependentsCount })}
      </h2>
      {shown.length > 0 && <ModList mods={shown} />}
      {mod.dependentsCount > shown.length && (
        <p class="text-sm text-fg-muted">{m.mod_required_by_more({ count: mod.dependentsCount - shown.length })}</p>
      )}
    </section>
  )
}
