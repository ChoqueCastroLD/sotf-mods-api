---
/**
 * Sticky tab strip that jumps between the sections of a long page on phones (builds): plain
 * underlined links under the site header, the current section marked while scrolling
 * (`scripts/mod/section-nav.ts`, scroll-spy) and centred in the strip. Plain anchors, so it works
 * without JavaScript (only the highlight needs it). Hidden from `md` up.
 */
interface Props {
  label: string;
  items: ReadonlyArray<{ id: string; label: string; count?: string | null }>;
}

const { label, items } = Astro.props;
---

<nav
  aria-label={label}
  data-section-nav
  class="sticky top-[4.0625rem] z-(--z-raised) -mx-4 border-b border-border bg-bg/95 px-1 supports-[backdrop-filter]:bg-bg/85 supports-[backdrop-filter]:backdrop-blur-md md:hidden"
>
  <ul class="flex snap-x snap-proximity overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {
      items.map((item) => (
        <li class="flex shrink-0 snap-center">
          <a
            href={`#${item.id}`}
            data-section-link={item.id}
            class="relative inline-flex h-11 items-center gap-1.5 whitespace-nowrap px-3 text-[0.9375rem] font-medium text-fg-muted select-none after:absolute after:inset-x-3 after:-bottom-px after:h-0.5 after:rounded-full after:bg-primary after:opacity-0 aria-[current=true]:text-fg aria-[current=true]:after:opacity-100 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus"
          >
            {item.label}
            {item.count && <span class="text-xs tabular-nums text-fg-subtle">{item.count}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
