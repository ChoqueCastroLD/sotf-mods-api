---
/**
 * Tab bar of the mod pages: Description · Versions (n) · Comments (n) · Reviews (n). Plain links
 * (real pages and anchors of the overview), `aria-current="page"` on the active page, a hairline
 * under the row with the current tab underlined in red; horizontal scroll on phones.
 */
import { formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { href } from '../../lib/i18n.ts';
import type { ModDetailDTO } from './data.ts';
import { reviewsPagePath, versionsPagePath } from './format.ts';

export type ModTab = 'overview' | 'versions' | 'reviews';

interface Props {
  mod: ModDetailDTO;
  active: ModTab;
  versionsCount: number | null;
}

const { mod, active, versionsCount } = Astro.props;
const locale = Astro.locals.locale;
const overview = href(mod.canonicalPath, locale);
const tabs: Array<{ key: string; label: string; count?: number | null; href: string; current: boolean }> = [
  { key: 'overview', label: m.mod_tab_description(), href: overview, current: active === 'overview' },
  {
    key: 'versions',
    label: m.mod_tab_versions(),
    count: versionsCount,
    href: href(versionsPagePath(mod), locale),
    current: active === 'versions',
  },
  { key: 'comments', label: m.mod_tab_comments(), count: mod.commentsCount, href: `${overview}#comments`, current: false },
  {
    key: 'reviews',
    label: m.mod_tab_reviews(),
    count: mod.reviewsSummary.count,
    href: href(reviewsPagePath(mod), locale),
    current: active === 'reviews',
  },
];
const TAB =
  'relative inline-flex h-11 items-center gap-1.5 whitespace-nowrap px-3 text-[0.9375rem] font-medium text-fg-muted max-md:px-2.5 max-md:text-sm ' +
  'hover:text-fg aria-[current=page]:text-fg ' +
  'after:absolute after:inset-x-3 max-md:after:inset-x-2.5 after:-bottom-px after:h-0.5 after:rounded-full after:bg-primary after:opacity-0 aria-[current=page]:after:opacity-100 ' +
  'focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus';
---

<nav
  aria-label={m.mod_tabs_label()}
  data-mod-tabs
  class="mt-6 border-b border-border max-md:sticky max-md:top-[4.0625rem] max-md:z-(--z-raised) max-md:-mx-4 max-md:bg-bg/95 max-md:px-1 max-md:supports-[backdrop-filter]:bg-bg/85 max-md:supports-[backdrop-filter]:backdrop-blur-md md:mt-8"
>
  <ul class="-mx-3 flex overflow-x-auto overscroll-x-contain [scrollbar-width:none] max-md:mx-0 max-md:snap-x max-md:snap-proximity [&::-webkit-scrollbar]:hidden">
    {
      tabs.map((tab) => (
        <li class="flex shrink-0 max-md:snap-center">
          <a
            href={tab.href}
            data-tab-key={tab.key}
            data-tab-page={tab.key === 'overview' || tab.key === 'versions' || tab.key === 'reviews' ? '' : undefined}
            aria-current={tab.current ? 'page' : undefined}
            class={TAB}
          >
            {tab.label}
            {typeof tab.count === 'number' && tab.count > 0 && (
              <span class="text-xs tabular-nums text-fg-subtle">{formatNumber(locale, tab.count)}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
