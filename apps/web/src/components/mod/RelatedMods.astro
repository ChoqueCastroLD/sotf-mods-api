---
/**
 * One simple list of related mods (same category or tags + text similarity) in the sidebar.
 */
import { m } from '@sotf/i18n/messages';
import type { ModCardDTO } from './data.ts';
import ModList from './ModList.astro';
import { SIDE_BLOCK_CLASSES, SIDE_TITLE_CLASSES } from './styles.ts';

interface Props {
  related: ModCardDTO[];
}

const { related } = Astro.props;
---

{
  related.length > 0 && (
    <section data-fold="closed" aria-labelledby="related-title" class={SIDE_BLOCK_CLASSES}>
      <h2 id="related-title" class={SIDE_TITLE_CLASSES}>{m.mod_related_title()}</h2>
      <ModList mods={related} />
    </section>
  )
}
