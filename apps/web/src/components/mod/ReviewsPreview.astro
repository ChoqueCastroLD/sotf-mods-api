---
/**
 * Reviews on the overview (T0-08, §7.7): histogram + the three most helpful reviews (SSR), a link
 * to the reviews page and the mount point of the reviews island (WP-70: write, vote, reply).
 * Stars are only public with ≥ 3 visible reviews (`RatingHistogram` follows `showStars`).
 */
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { RatingHistogram, ReviewCard } from '@sotf/ui/domain';
import { Icon } from '@sotf/ui/icons';
import { ArrowRight, ChevronRight, Star } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { ModDetailDTO, ReviewPage } from './data.ts';
import EmptyArt from './EmptyArt.astro';
import { pluralTemplates, reviewsPagePath } from './format.ts';
import { markdownLabels } from './i18n.ts';
import { SECTION_TITLE_CLASSES } from './styles.ts';

interface Props {
  mod: ModDetailDTO;
  reviews: ReviewPage | null;
  loginHref: string;
}

const { mod, reviews, loginHref } = Astro.props;
const locale = Astro.locals.locale;
const summary = mod.reviewsSummary;
const labels = markdownLabels();
const items = (reviews?.items ?? []).slice(0, 3).map((review) => ({
  ...review,
  bodyHtml: review.bodyHtml ? localizeHtml(review.bodyHtml, labels) : null,
}));
const reviewsHref = href(reviewsPagePath(mod), locale);
const creatorName = mod.author.displayName || mod.author.handle;
---

<section id="reviews" data-sheet-section="reviews-sheet" aria-labelledby="reviews-title" class="grid scroll-mt-32 gap-4 md:scroll-mt-24">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2
      id="reviews-title"
      class={SECTION_TITLE_CLASSES}
      data-live-count="reviews"
      data-count={summary.count}
      data-count-templates={JSON.stringify(pluralTemplates(locale, (count) => m.mod_reviews_title({ count })))}
      data-count-zero={m.mod_reviews_title({ count: 0 })}
    >{m.mod_reviews_title({ count: summary.count })}</h2>
    {
      summary.count > 0 && (
        <a href={reviewsHref} class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-link">
          {m.mod_reviews_all({ count: summary.count })}
          <Icon icon={ArrowRight} size={16} className="rtl:rotate-180" />
        </a>
      )
    }
  </div>
  <div data-sheet-preview hidden class="grid gap-3">
    <ul data-sheet-preview-list class="grid gap-3 [&_.prose-sm]:line-clamp-3"></ul>
    <button
      type="button"
      data-dialog-open="reviews-sheet"
      class="flex min-h-12 w-full items-center gap-3 rounded-md border border-border px-3 text-start font-medium text-fg active:bg-fg/8"
    >
      <Icon icon={Star} size={18} className="text-fg-muted" />
      <span class="min-w-0 flex-1">{m.entity_reviews_see_all({ count: summary.count })}</span>
      <Icon icon={ChevronRight} size={18} className="text-fg-subtle rtl:rotate-180" />
    </button>
  </div>
  <div data-sheet-body class="grid min-w-0 gap-4">
  {
    summary.count > 0 ? (
      <>
        <RatingHistogram summary={summary} />
        {items.length > 0 && (
          <ul class="grid gap-3" data-review-list>
            {items.map((review) => (
              <li>
                <ReviewCard review={review} creatorName={creatorName} headingLevel={3} />
              </li>
            ))}
          </ul>
        )}
      </>
    ) : (
      <EmptyArt>{m.mod_reviews_empty()}</EmptyArt>
    )
  }
  <div data-island="reviews" data-mod-id={mod.id} data-mod-author-id={mod.userId} data-mod-author-name={creatorName} class="grid gap-2">
    <a href={`${reviewsHref}#write-review`} data-review-write class="inline-flex min-h-11 items-center self-start font-semibold text-link underline underline-offset-3">
      {m.mod_reviews_write()}
    </a>
    <p class="text-xs text-fg-muted" data-review-guest-hint>
      <a href={loginHref} class="underline underline-offset-3">{m.common_account_sign_in()}</a>
      {' · '}{m.mod_reviews_rules()}
    </p>
  </div>
  </div>
</section>
