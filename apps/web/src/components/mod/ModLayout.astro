---
/**
 * Shell of every mod page (overview, versions, one version, reviews; WP-62):
 *
 * - `BaseLayout` with the page SEO + JSON-LD (+ `BreadcrumbList` built from the visible trail),
 *   the `.md` and per-mod RSS alternates (PLAN §4.2, §8.7),
 *   `entity` for analytics and the LCP preload;
 * - breadcrumbs, status banners, the adult-content gate (content hidden behind it), header, tabs;
 * - main column + optional sidebar (`slot="sidebar"`, a plain list of blocks separated by
 *   hairlines): phones → header, tabs, main, sidebar; desktops → main on the left, sidebar on the
 *   right;
 * - dialogs (install, dependencies, share, report, lightbox), the mobile download bar, the JSON
 *   island and the page script (`scripts/mod/index.ts`, vanilla, lazy parts on demand).
 */
import { categoryPath } from '@sotf/contracts/seo';
import { m } from '@sotf/i18n/messages';
import { Breadcrumbs } from '@sotf/ui/breadcrumbs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import { breadcrumbJsonLd, type JsonLd } from '../../lib/seo/jsonld.ts';
import AdUnit from '../ads/AdUnit.astro';
import type { SeoProps } from '../layout/SeoHead.astro';
import DependencySheet from './DependencySheet.astro';
import type { ModDetailDTO, VersionDTO } from './data.ts';
import { loginHrefFor } from './format.ts';
import InstallDialog from './InstallDialog.astro';
import { configureModDomainI18n, taxonomyName } from './i18n.ts';
import Lightbox from './Lightbox.astro';
import MobileDownloadBar from './MobileDownloadBar.astro';
import ModHeader from './ModHeader.astro';
import ModScripts from './ModScripts.astro';
import ModTabs, { type ModTab } from './ModTabs.astro';
import MoreSheet from './MoreSheet.astro';
import NsfwGate from './NsfwGate.astro';
import PageData from './PageData.astro';
import ReportDialog from './ReportDialog.astro';
import ShareDialog from './ShareDialog.astro';
import SocialSheets from './SocialSheets.astro';
import StatusBanners from './StatusBanners.astro';
import VersionSheet from './VersionSheet.astro';

export interface ModCrumb {
  label: string;
  /** Locale-less path; omit on the current page. */
  path?: string;
}

interface Props {
  mod: ModDetailDTO;
  tab: ModTab;
  seo: SeoProps;
  jsonLd?: readonly JsonLd[];
  versions: VersionDTO[] | null;
  /** Crumbs after the mod (sub-pages). */
  crumbs?: readonly ModCrumb[];
  preloadImage?: { href: string; srcset?: string; sizes?: string; type?: string };
}

configureModDomainI18n();

const { mod, tab, seo, jsonLd = [], versions, crumbs = [], preloadImage } = Astro.props;
const locale = Astro.locals.locale;
const env = loadEnv();
const overviewHref = href(mod.canonicalPath, locale);
const currentPath = href(Astro.locals.pagePath, locale);
const loginHref = loginHrefFor(href('/login', locale), currentPath);
const adultAccepted = Astro.url.searchParams.get('adult') === '1';
const gated = mod.nsfw && !adultAccepted;
const revealUrl = new URL(Astro.url.href);
revealUrl.searchParams.set('adult', '1');
const revealHref = `${href(Astro.url.pathname, locale)}${revealUrl.search}`;

const trail: ModCrumb[] = [
  { label: m.common_nav_explore(), path: '/mods' },
  ...(mod.category ? [{ label: taxonomyName(mod.category), path: categoryPath(mod.category.slug) }] : []),
  crumbs.length > 0 ? { label: mod.name, path: mod.canonicalPath } : { label: mod.name },
  ...crumbs,
];
const visibleCrumbs = trail.map((crumb) => ({
  label: crumb.label,
  href: crumb.path === undefined ? undefined : href(crumb.path, locale),
}));
const graph: JsonLd[] = [
  ...jsonLd,
  breadcrumbJsonLd(
    trail.map((crumb) => ({
      name: crumb.label,
      url: crumb.path === undefined ? undefined : `${env.siteUrl}${href(crumb.path, locale)}`,
    })),
  ),
];
const hasSidebar = Astro.slots.has('sidebar');
---

<BaseLayout
  template="mod"
  seo={{ ...seo, adult: mod.nsfw || seo.adult === true }}
  jsonLd={graph}
  entity={{ type: 'mod', id: mod.id }}
  preloadImage={gated ? undefined : preloadImage}
>
  <Fragment slot="head">
    <meta name="sotf:content-lang" content={mod.contentLang ?? 'en'} />
    <link rel="alternate" type="text/markdown" href={`${mod.canonicalPath}.md`} title={mod.name} />
    <link
      rel="alternate"
      type="application/rss+xml"
      href={`${mod.canonicalPath}/feed.xml`}
      title={m.mod_feed_title({ name: mod.name })}
    />
    <link
      rel="alternate"
      type="application/json+oembed"
      href={`/oembed?url=${encodeURIComponent(`${env.siteUrl}${overviewHref}`)}&format=json`}
      title={mod.name}
    />
  </Fragment>
  <div
    data-mod-page
    data-mod-id={mod.id}
    data-nsfw={mod.nsfw ? '' : undefined}
  >
    <div class="mx-auto grid w-full max-w-(--container-content) grid-cols-1 gap-4 px-4 py-4 md:gap-5 md:px-6 md:py-8">
      <Breadcrumbs items={visibleCrumbs} />
      <StatusBanners mod={mod} />
      {gated && <NsfwGate revealHref={revealHref} />}
      <div class="min-w-0" data-nsfw-content hidden={gated ? true : undefined}>
        <ModHeader
          mod={mod}
          versions={versions}
          compact={tab !== 'overview'}
          overviewHref={overviewHref}
          loginHref={loginHref}
        />
        <ModTabs mod={mod} active={tab} versionsCount={versions?.length ?? null} />
        <div class:list={['mt-8 grid gap-10', hasSidebar && 'lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-12']}>
          <div class="grid min-w-0 content-start gap-12">
            <slot />
          </div>
          {
            hasSidebar && (
              <aside aria-label={m.mod_sidebar_label()} class="grid min-w-0 content-start gap-6 max-lg:border-t max-lg:border-border max-lg:pt-8">
                <slot name="sidebar" />
                {!mod.nsfw && <AdUnit placement="modSidebar" format="sidebar" />}
              </aside>
            )
          }
        </div>
        <MobileDownloadBar mod={mod} loginHref={loginHref} />
      </div>
    </div>

    <InstallDialog mod={mod} />
    <DependencySheet mod={mod} />
    <MoreSheet mod={mod} url={`${env.siteUrl}${overviewHref}`} />
    <ShareDialog mod={mod} url={`${env.siteUrl}${overviewHref}`} />
    <ReportDialog mod={mod} loginHref={loginHref} />
    {tab === 'overview' && <Lightbox mod={mod} />}
    {(tab === 'overview' || tab === 'versions') && <VersionSheet />}
    {tab === 'overview' && <SocialSheets mod={mod} loginHref={loginHref} />}
    <div
      data-mod-toast
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed inset-x-0 bottom-[calc(9rem+env(safe-area-inset-bottom))] z-(--z-toast) flex justify-center px-4 md:bottom-6"
    ></div>
    <PageData mod={mod} siteUrl={env.siteUrl} loginHref={loginHref} />
    <ModScripts />
  </div>
</BaseLayout>
