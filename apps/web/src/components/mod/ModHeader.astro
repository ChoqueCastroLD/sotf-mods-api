---
/**
 * Mod header, modelled on the old mod page: gallery on the left; on the right the title with the
 * version, the short description, the author (avatar, name, Trusted tag), a plain stats row
 * (downloads, followers, rating, updated) and the actions (`ActionBar`).
 *
 * `compact` (sub-pages): no gallery or description, smaller title; the actions stay.
 */
import { categoryPath, profilePath } from '@sotf/contracts/seo';
import { formatCompactNumber, formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Avatar } from '@sotf/ui/avatar';
import { displayName, GalleryStrip, StarRating, TrustedMark } from '@sotf/ui/domain';
import { href } from '../../lib/i18n.ts';
import { loadModTranslation } from '../../lib/mod-translation.ts';
import ActionBar from './ActionBar.astro';
import type { ModDetailDTO, VersionDTO } from './data.ts';
import { isShortVersion, reviewsPagePath } from './format.ts';
import GalleryCarousel from './GalleryCarousel.astro';
import { taxonomyName } from './i18n.ts';
import TranslatedText from './TranslatedText.astro';

interface Props {
  mod: ModDetailDTO;
  versions: VersionDTO[] | null;
  compact?: boolean;
  /** Localised overview path. */
  overviewHref: string;
  loginHref: string;
}

const { mod, versions, compact = false, overviewHref, loginHref } = Astro.props;
const locale = Astro.locals.locale;
const summary = mod.reviewsSummary;
const author = mod.author;
const authorName = author.displayName || author.handle;
// The visitor's language version of the title and short description (the original stays one
// click away). `resolveModPage` already fetched it (memoized per mod).
const translation = !compact && locale !== 'en' && mod.shortDescription ? await loadModTranslation(mod, locale) : null;
const shownName = displayName(mod);
const translatedName = shownName !== mod.name;
const galleryLabel = m.mod_gallery_label({ name: mod.name });
const stat = 'inline-flex items-center gap-1.5 tabular-nums';
---

<header class:list={['grid grid-cols-1 gap-6', compact ? '' : 'md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:items-start md:gap-8']}>
  {
    !compact && (
      <div class="grid min-w-0 gap-3">
        <GalleryCarousel
          mod={mod}
          sizes="(min-width: 80rem) 700px, (min-width: 48rem) 55vw, 100vw"
          label={galleryLabel}
        />
        {(mod.gallery.length > 1 || mod.video) && (
          <div data-gallery-strip class="max-md:hidden">
            <GalleryStrip
              images={mod.gallery}
              video={mod.video ? { id: mod.video.id, url: mod.video.url } : null}
              label={galleryLabel}
            />
          </div>
        )}
      </div>
    )
  }

  <div class="grid min-w-0 grid-cols-1 content-start gap-4">
    <div class="grid grid-cols-1 gap-2">
      {mod.kind === 'library' && <p class="text-sm font-medium text-fg-muted">{m.mod_kind_library()}</p>}
      <h1
        class:list={[
          'text-balance break-words font-bold text-fg [hyphens:auto]',
          compact ? 'text-2xl' : 'text-3xl leading-tight md:text-4xl',
        ]}
        lang={translatedName ? locale : (mod.contentLang ?? undefined)}
      >
        {compact ? <a href={overviewHref} class="hover:underline underline-offset-4">{shownName}</a> : shownName}
        {mod.latestVersion && isShortVersion(mod.latestVersion.version) && (
          <span class="ms-2 whitespace-nowrap align-baseline font-mono text-base font-normal text-fg-muted">v{mod.latestVersion.version}</span>
        )}
      </h1>
      {
        translatedName && (
          <p class="flex items-baseline gap-2 text-sm text-fg-subtle" data-original-name>
            <span class="shrink-0">{m.entity_original_label()}</span>
            <span class="min-w-0 break-words text-base text-fg-muted" lang={mod.contentLang ?? 'en'} translate="no">{mod.name}</span>
          </p>
        )
      }
      {
        !compact && mod.shortDescription && !translation?.shortDescription && (
          <p class="text-base text-fg-muted md:text-lg" lang={mod.contentLang ?? undefined}>
            {mod.shortDescription}
          </p>
        )
      }
      {
        !compact && mod.shortDescription && translation?.shortDescription && (
          <TranslatedText
            translated={translation.shortDescription}
            original={mod.shortDescription}
            locale={locale}
            sourceLang={mod.contentLang}
            source={translation.sources?.shortDescription ?? 'machine'}
            class="text-base text-fg-muted md:text-lg"
          />
        )
      }
    </div>

    <p class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-border pt-4 text-sm text-fg-muted">
      <a
        href={href(profilePath(author.handle), locale)}
        class="inline-flex min-h-6 items-center gap-2 font-semibold text-fg hover:underline underline-offset-3"
      >
        <Avatar name={authorName} id={author.id} src={author.avatarUrl} size={24} />
        <span>{authorName}</span>
      </a>
      {author.verifiedCreator && <TrustedMark />}
      {
        mod.category && (
          <a href={href(categoryPath(mod.category.slug), locale)} class="text-fg-muted underline-offset-3 hover:text-fg hover:underline">
            {taxonomyName(mod.category)}
          </a>
        )
      }
    </p>

    {
      !compact && mod.originalAuthor && (
        <p class="text-sm text-fg-muted">
          {mod.originalAuthor.url ? (
            <a href={mod.originalAuthor.url} rel="ugc nofollow noopener" class="text-link underline underline-offset-3">
              {m.mod_original_author({ name: mod.originalAuthor.name })}
            </a>
          ) : (
            m.mod_original_author({ name: mod.originalAuthor.name })
          )}
        </p>
      )
    }

    <ul class:list={['flex flex-wrap gap-x-5 gap-y-2 text-sm text-fg-muted', compact && 'max-md:hidden']}>
      <li class={stat} title={formatNumber(locale, mod.downloads)}>
        <span class="text-fg" data-live="downloads-compact">{formatCompactNumber(locale, mod.downloads)}</span>
        <span class="sr-only" data-live="downloads-full">{formatNumber(locale, mod.downloads)}</span>
        <span>{m.mod_stat_downloads()}</span>
      </li>
      <li class={stat}>
        <span class="text-fg" data-follow-count-text>{m.common_followers_count({ count: mod.followers })}</span>
      </li>
      {
        summary.showStars && summary.average !== null && (
          <li class={stat}>
            <a href={href(reviewsPagePath(mod), locale)} class="inline-flex items-center gap-1.5 hover:text-fg hover:underline underline-offset-3">
              <StarRating value={summary.average} size={14} />
              {m.mod_stat_rating_value({ rating: formatNumber(locale, summary.average, { maximumFractionDigits: 1, minimumFractionDigits: 1 }), count: summary.count })}
            </a>
          </li>
        )
      }
      <li class={stat}>
        <time datetime={mod.lastReleasedAt}>{m.mod_fact_updated({ date: formatDate(locale, mod.lastReleasedAt) })}</time>
      </li>
    </ul>

    <ActionBar mod={mod} versions={versions} loginHref={loginHref} />
  </div>
</header>
