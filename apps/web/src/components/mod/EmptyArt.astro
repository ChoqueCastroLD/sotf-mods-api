---
/**
 * Empty state of the comment and review sheets: the backpack and the GPS in the fog (concept art,
 * `public/art/entity/empty-*`, built by `tooling/scripts/art-entity.ts`) above a short line. The
 * art is decorative, lazy and only shown on phones (the sheets), where the dialog is closed until
 * the visitor opens it, so it costs nothing until then.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['grid justify-items-center gap-3 text-center', className]}>
  <picture class="max-md:block md:hidden">
    <source type="image/avif" srcset="/art/entity/empty-320.avif 320w, /art/entity/empty-640.avif 640w" sizes="160px" />
    <source type="image/webp" srcset="/art/entity/empty-320.webp 320w, /art/entity/empty-640.webp 640w" sizes="160px" />
    <img
      src="/art/entity/empty-320.webp"
      alt=""
      width="160"
      height="160"
      loading="lazy"
      decoding="async"
      class="size-40 rounded-2xl border border-border object-cover"
    />
  </picture>
  <p class="max-w-prose text-fg-muted"><slot /></p>
</div>
