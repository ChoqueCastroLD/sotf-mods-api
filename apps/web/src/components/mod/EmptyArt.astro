---
/**
 * Empty state of the comment and review sections: one plain muted line, no artwork.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {}
const { class: className, ...attrs } = Astro.props;
---

<p class:list={['max-w-prose text-fg-muted', className]} {...attrs}><slot /></p>
