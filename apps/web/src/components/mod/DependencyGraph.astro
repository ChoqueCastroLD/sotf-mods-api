---
/**
 * «Dependency graph» (PLAN §7.13 T1-05): a server-rendered SVG with the mod in the middle, what it
 * needs on the left (line style by kind: solid = required, dashed = optional, dotted red =
 * conflict) and the mods that require it on the right. Every node that exists on the site is a
 * link; nodes that do not are labelled «Not on SOTF Mods». The textual `DependencyList` stays the
 * accessible source of truth. No JavaScript.
 */
import { m } from '@sotf/i18n/messages';
import { href } from '../../lib/i18n.ts';
import type { ModCardDTO, ModDetailDTO } from './data.ts';
import { PANEL_CLASSES, SECTION_TITLE_CLASSES } from './styles.ts';

interface Props {
  mod: ModDetailDTO;
  dependents: ModCardDTO[];
}

const { mod, dependents } = Astro.props;
const locale = Astro.locals.locale;
const MAX = 8;
const left = mod.dependencies.slice(0, MAX);
const right = dependents.slice(0, MAX);
const rows = Math.max(left.length, right.length, 1);
const ROW = 34;
const W = 720;
const H = rows * ROW + 16;
const NODE_W = 200;
const CX = W / 2;
const cy = H / 2;
const yOf = (index: number, count: number) => H / 2 + (index - (count - 1) / 2) * ROW;
const clip = (text: string) => (text.length > 26 ? `${text.slice(0, 25)}…` : text);
const kindLabel = (kind: string) =>
  kind === 'required'
    ? m.ui_domain_dependency_kind_required()
    : kind === 'optional'
      ? m.ui_domain_dependency_kind_optional()
      : m.ui_domain_dependency_kind_conflicts();
const dash = (kind: string) => (kind === 'required' ? undefined : kind === 'optional' ? '6 4' : '2 4');
const stroke = (kind: string) => (kind === 'conflicts' ? 'var(--color-danger, #e5484d)' : 'var(--color-border-strong)');
---

{
  (left.length > 0 || right.length > 0) && (
    <section id="dependency-graph" data-fold="closed" aria-labelledby="dependency-graph-title" class="grid gap-3">
      <h2 id="dependency-graph-title" class={SECTION_TITLE_CLASSES}>{m.mod_graph_title()}</h2>
      <figure class:list={[PANEL_CLASSES, 'overflow-x-auto']}>
        <!-- biome-ignore lint/a11y/useSemanticElements: an SVG drawing labelled as a group has no semantic HTML element -->
        <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={m.mod_graph_label({ name: mod.name })} class="mx-auto h-auto w-full min-w-[34rem] max-w-3xl text-fg" font-family="var(--font-sans)">
          {left.map((dependency, index) => {
            const y = yOf(index, left.length);
            return <path d={`M ${NODE_W} ${y} C ${NODE_W + 80} ${y}, ${CX - 180} ${cy}, ${CX - 80} ${cy}`} fill="none" stroke={stroke(dependency.kind)} stroke-width="1.5" stroke-dasharray={dash(dependency.kind)} />;
          })}
          {right.map((card, index) => {
            const y = yOf(index, right.length);
            return <path d={`M ${CX + 80} ${cy} C ${CX + 180} ${cy}, ${W - NODE_W - 80} ${y}, ${W - NODE_W} ${y}`} fill="none" stroke="var(--color-border-strong)" stroke-width="1.5" />;
          })}
          <rect x={CX - 80} y={cy - 15} width="160" height="30" rx="6" fill="var(--color-primary)" />
          <text x={CX} y={cy + 4} text-anchor="middle" font-size="12" font-weight="600" fill="var(--color-primary-fg)">{clip(mod.name)}</text>
          {left.map((dependency, index) => {
            const y = yOf(index, left.length);
            const label = `${clip(dependency.mod?.name ?? dependency.manifestId)}`;
            const title = `${kindLabel(dependency.kind)}: ${dependency.mod?.name ?? dependency.manifestId}${dependency.mod ? '' : ` (${m.ui_domain_dependency_state_missing()})`}`;
            const node = (
              <>
                <title>{title}</title>
                <rect x="0" y={y - 13} width={NODE_W} height="26" rx="6" fill="var(--color-raised)" stroke={stroke(dependency.kind)} stroke-dasharray={dependency.mod ? undefined : '3 3'} />
                <text x="10" y={y + 4} font-size="12" fill="currentColor">{label}</text>
              </>
            );
            return dependency.mod ? <a href={href(dependency.mod.canonicalPath, locale)} aria-label={title}>{node}</a> : <g>{node}</g>;
          })}
          {right.map((card, index) => {
            const y = yOf(index, right.length);
            const title = `${m.mod_graph_required_by()}: ${card.name}`;
            return (
              <a href={href(card.canonicalPath, locale)} aria-label={title}>
                <title>{title}</title>
                <rect x={W - NODE_W} y={y - 13} width={NODE_W} height="26" rx="6" fill="var(--color-raised)" stroke="var(--color-border-strong)" />
                <text x={W - NODE_W + 10} y={y + 4} font-size="12" fill="currentColor">{clip(card.name)}</text>
              </a>
            );
          })}
        </svg>
        <figcaption class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-fg-muted">
          <span>{m.ui_domain_dependency_kind_required()} ─</span>
          <span>{m.ui_domain_dependency_kind_optional()} ╌</span>
          <span>{m.ui_domain_dependency_kind_conflicts()} ┈</span>
          <span>{m.mod_graph_required_by()} →</span>
        </figcaption>
      </figure>
    </section>
  )
}
