---
/**
 * One live pin of the hero: a Signal dot with the locator ping (paused off-screen and under
 * reduced motion), the item name and «label · time». The same markup is emitted once empty inside
 * a `<template>` so the landing script can rebuild the pulse pins without shipping markup in JS.
 */
import { formatDateTime, type Locale } from '@sotf/i18n';
import type { PinKind } from './pins.ts';

interface Props {
  locale: Locale;
  kind: PinKind | '';
  href: string;
  name: string;
  label: string;
  /** ISO instant; empty in the template. */
  at: string;
  /** Slot index (desktop position on the map). */
  position: number;
}

const { locale, kind, href, name, label, at, position } = Astro.props;
const fallbackTime = at ? formatDateTime(locale, at, 'medium', 'short') : '';
---

<li data-pin={kind} data-slot={position} class="landing-pin shrink-0 snap-start">
  <a
    href={href}
    data-pin-link
    class="group flex min-h-11 max-w-72 items-center gap-3 rounded-full border border-border-strong bg-surface/90 py-1.5 ps-3 pe-4 text-start shadow-sm backdrop-blur-sm transition-colors duration-(--dur-fast) hover:border-primary hover:bg-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
  >
    <span data-live-dot class="relative inline-flex size-2.5 shrink-0 data-offscreen:ping-paused" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-signal opacity-60 motion-safe:animate-ping-locator"></span>
      <span class="relative size-2.5 rounded-full bg-signal"></span>
    </span>
    <span class="grid min-w-0">
      <span data-pin-name class="truncate text-sm font-semibold text-fg group-hover:text-primary">{name}</span>
      <span class="readout truncate">
        <span data-pin-label>{label}</span>
        <span aria-hidden="true"> · </span>
        <time data-relative datetime={at}>{fallbackTime}</time>
      </span>
    </span>
  </a>
</li>
