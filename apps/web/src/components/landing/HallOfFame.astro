---
/**
 * «Legends of the island» (hall of fame): the ~24 most downloaded mods of all time as a dense,
 * wrapping cloud of title pills (rank + name + compact downloads; the top of the ranking is set
 * a little larger). Each pill is a plain link; a details card (cover, author, blurb, downloads,
 * version, category) opens on `:hover` / `:focus-within` with CSS only, placed by
 * `islands/landing/hall.ts` (flips towards the free side). Touch devices (`hover: none`) never
 * show the card: a tap goes straight to the mod. The card is `display: none` when closed, so
 * its lazy cover is fetched on first use and nothing shifts; it floats over the page.
 */
import { formatCompactNumber, formatNumber, type Locale } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { categoryAccent, generativeCoverUri } from '@sotf/ui/domain';
import { href } from '../../lib/i18n.ts';
import { type Category, categoryNames, type ModCardDTO } from './data.ts';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
  mods: readonly ModCardDTO[] | null;
  categories: readonly Category[] | null;
}

const { locale, mods, categories } = Astro.props;
const MOBILE_VISIBLE = 8;
const names = categoryNames(categories, locale);
const tier = (rank: number): string =>
  rank <= 3 ? 'text-base md:text-xl' : rank <= 10 ? 'text-base md:text-lg' : 'text-sm md:text-base';
---

{
  mods && mods.length > 0 && (
    <section class="border-y border-border bg-sunken/50" aria-labelledby="hall-title" data-hall>
      <div class="mx-auto w-full max-w-(--container-wide) px-4 py-8 md:px-6 md:py-14">
        <SectionHeader
          id="hall-title"
          title={m.landing_hall_title()}
          hint={m.landing_hall_hint()}
          link={{ href: `${href('/mods', locale)}?sort=downloads`, label: m.landing_trending_all() }}
        />
        <ol class="hall-list grid grid-cols-1 gap-2 md:flex md:flex-wrap md:items-center md:gap-2.5" data-hall-list>
          {mods.map((mod, index) => {
            const rank = index + 1;
            const accent = categoryAccent(mod.category?.slug);
            const cardId = `hall-card-${mod.id}`;
            const category = mod.category ? (names.get(mod.category.nameKey) ?? mod.category.name) : null;
            return (
              <li class="hall-item relative" data-hall-item>
                <a
                  href={href(mod.canonicalPath, locale)}
                  aria-describedby={cardId}
                  class:list={[
                    'flex min-h-12 w-full items-center gap-2 rounded-xl border border-border-strong bg-surface py-1 ps-3 pe-3 active:bg-raised md:inline-flex md:w-auto md:rounded-full md:min-h-11 md:gap-2 md:ps-3 md:pe-4 font-semibold text-fg transition-colors duration-(--dur-fast) hover:border-primary hover:bg-raised hover:text-primary focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus',
                    tier(rank),
                  ]}
                >
                  <span class="readout w-5 shrink-0 tabular-nums text-fg-subtle md:w-auto" aria-hidden="true">
                    {rank}
                  </span>
                  <span class="size-2 shrink-0 rounded-full" style={{ backgroundColor: accent }} aria-hidden="true" />
                  <span class="min-w-0 truncate md:overflow-visible">{mod.name}</span>
                  <span class="readout ms-auto font-normal tabular-nums text-fg-subtle md:ms-0" aria-hidden="true">
                    {formatCompactNumber(locale, mod.downloads)}
                  </span>
                </a>
                <div id={cardId} role="tooltip" class="hall-card">
                  <div class="aspect-video w-full overflow-hidden rounded-t-lg bg-sunken">
                    <img
                      alt=""
                      loading="lazy"
                      decoding="async"
                      src={mod.thumbnail?.url ?? generativeCoverUri(mod.slug, mod.name, accent)}
                      srcset={mod.thumbnail?.srcset ?? undefined}
                      sizes={mod.thumbnail?.srcset ? '320px' : undefined}
                      width={mod.thumbnail?.width ?? 480}
                      height={mod.thumbnail?.height ?? 270}
                      style={{ backgroundColor: mod.thumbnail?.dominantColor ?? undefined }}
                      class="block size-full object-cover"
                    />
                  </div>
                  <div class="grid gap-1.5 p-3 text-start">
                    <p class="flex flex-wrap items-baseline gap-x-2">
                      <span class="font-semibold text-fg">{mod.name}</span>
                      <span class="readout">@{mod.userHandle}</span>
                    </p>
                    <p class="line-clamp-3 text-sm text-fg-muted">{mod.shortDescription}</p>
                    <p class="readout flex flex-wrap gap-x-2 gap-y-0.5">
                      <span>
                        <span class="tabular-nums text-fg">{formatNumber(locale, mod.downloads)}</span>{' '}
                        {m.landing_stat_downloads()}
                      </span>
                      {mod.latestVersion && <span>{m.landing_notes_version({ version: mod.latestVersion })}</span>}
                      {category && <span>{category}</span>}
                    </p>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
        {
          mods.length > MOBILE_VISIBLE && (
            <p class="mt-4 md:hidden">
              <a
                href={`${href('/mods', locale)}?sort=downloads`}
                data-hall-more
                class="inline-flex h-12 w-full items-center justify-center rounded-xl border border-border-strong bg-surface text-sm font-semibold text-fg active:bg-raised"
              >
                {m.landing_hall_show_all({ count: mods.length })}
              </a>
            </p>
          )
        }
      </div>
    </section>
  )
}

<style>
  @media (width < 48rem) {
    .hall-list:not([data-expanded]) > .hall-item:nth-child(n + 9) {
      display: none;
    }
  }
  .hall-card {
    display: none;
    position: absolute;
    z-index: 30;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-start: 0;
    inline-size: min(20rem, calc(100vw - 2rem));
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg, 0.5rem);
    background: var(--color-raised, var(--color-surface));
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.55);
    pointer-events: none;
  }
  .hall-item[data-x="end"] > .hall-card {
    inset-inline-start: auto;
    inset-inline-end: 0;
  }
  .hall-item[data-y="up"] > .hall-card {
    inset-block-start: auto;
    inset-block-end: calc(100% + 0.5rem);
  }
  .hall-item:focus-within > .hall-card {
    display: block;
  }
  /* Hover opens the card only on devices that hover; touch taps navigate directly. */
  @media (hover: hover) {
    .hall-item:hover > .hall-card {
      display: block;
    }
  }
  @media (hover: none) {
    .hall-item:focus-within > .hall-card {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hall-card {
      transition:
        opacity 140ms ease-out,
        display 140ms allow-discrete;
      opacity: 1;
      @starting-style {
        opacity: 0;
      }
    }
  }
</style>
