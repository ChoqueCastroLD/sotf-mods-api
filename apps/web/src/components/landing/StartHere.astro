---
/**
 * «Start here — 3 steps» (research/03 §6.1): install RedLoader → pick mods or a Kit → launch.
 * An ordered list joined by a dashed trail on desktop; every step links to where it happens.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { ArrowRight, Download, Gamepad2, Package } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import SectionHeader from './SectionHeader.astro';

const locale = Astro.locals.locale;
const steps = [
  {
    icon: Download,
    title: m.landing_start_install_title(),
    text: m.landing_start_install_text(),
    path: '/install',
  },
  { icon: Package, title: m.landing_start_pick_title(), text: m.landing_start_pick_text(), path: '/kits' },
  { icon: Gamepad2, title: m.landing_start_play_title(), text: m.landing_start_play_text(), path: '/patch-radar' },
];
---

<section class="mx-auto w-full max-w-(--container-wide) px-4 py-8 md:px-6 md:py-14" aria-labelledby="start-title">
  <SectionHeader
    id="start-title"
    title={m.landing_start_title()}
    hint={m.landing_start_hint()}
    link={{ href: href('/install', locale), label: m.landing_start_cta() }}
  />
  <ol
    class="relative grid divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface md:grid-cols-3 md:gap-6 md:divide-y-0 md:overflow-visible md:rounded-none md:border-0 md:bg-transparent"
  >
    <li
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-[16%] top-8 hidden border-t-2 border-dashed border-border-strong md:block"
    >
    </li>
    {
      steps.map((step, index) => (
        <li class="relative">
          <a
            href={href(step.path, locale)}
            class="group flex items-center gap-4 p-4 transition-colors duration-(--dur-fast) active:bg-raised focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-focus md:h-full md:flex-col md:items-stretch md:gap-3 md:rounded-lg md:border md:border-border md:bg-surface md:p-5 md:hover:border-border-strong md:hover:bg-raised md:focus-visible:outline-offset-2"
          >
            <span class="flex shrink-0 items-center gap-3 md:w-full">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-primary bg-bg font-display-caps text-xl text-primary md:size-12">
                {index + 1}
              </span>
              <span class="readout hidden md:inline">{m.landing_start_step({ step: index + 1 })}</span>
              <Icon icon={step.icon} size={20} className="ms-auto hidden text-fg-subtle group-hover:text-primary md:block" />
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5 md:flex-none md:gap-3">
              <span class="text-base font-semibold text-fg md:text-lg">{step.title}</span>
              <span class="line-clamp-2 text-sm text-fg-muted md:line-clamp-none">{step.text}</span>
            </span>
            <Icon
              icon={ArrowRight}
              size={18}
              className="shrink-0 text-fg-subtle transition-transform duration-(--dur-fast) group-hover:text-primary md:mt-auto motion-safe:group-hover:translate-x-1 rtl:rotate-180"
            />
          </a>
        </li>
      ))
    }
  </ol>
</section>
