---
/**
 * Creator spotlight: two labelled groups of three creators, «Legends» (most downloads of all
 * time) and «Rising» (new and fast-growing). Square avatars (the generated waypoint avatar
 * when there is no photo), mods / downloads / followers and the top mod. Three columns from
 * `md`; on phones each group is a horizontal scroll-snap strip.
 */
import { profilePath } from '@sotf/contracts/seo';
import { formatCompactNumber, formatNumber, formatRelativeTime, type Locale } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Avatar } from '@sotf/ui/avatar';
import { TrustedMark } from '@sotf/ui/domain';
import { href } from '../../lib/i18n.ts';
import type { Creator } from './data.ts';

interface Props {
  locale: Locale;
  legends: readonly Creator[];
  rising: readonly Creator[];
}

const { locale, legends, rising } = Astro.props;
const groups = [
  { id: 'legends', tone: 'featured', title: m.landing_creators_legends(), hint: m.landing_creators_legends_hint(), items: legends },
  { id: 'rising', tone: 'signal', title: m.landing_creators_rising(), hint: m.landing_creators_rising_hint(), items: rising },
].filter((group) => group.items.length > 0);
---

<div class="grid gap-8">
  {
    groups.map((group) => (
      <section aria-labelledby={`creators-${group.id}`} data-tone={group.tone} class="spot-group">
        <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 id={`creators-${group.id}`} class="readout flex items-center gap-2 text-fg">
            <span class="spot-diamond" aria-hidden="true" />
            {group.title}
          </h3>
          <p class="text-sm text-fg-muted">{group.hint}</p>
        </div>
        <ul class="-mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain px-4 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:px-0 md:pb-0">
          {group.items.map((creator) => {
            const { user } = creator;
            const name = user.displayName || user.handle;
            const released = creator.lastReleasedAt;
            return (
              <li class="w-[78%] shrink-0 snap-start sm:w-[45%] md:w-auto">
                <article class="spot-card relative grid h-full gap-4 rounded-lg border border-border bg-surface p-4 transition-colors duration-(--dur-fast) hover:border-border-strong hover:bg-raised">
                  <span class="spot-brackets" aria-hidden="true" />
                  <div class="flex min-w-0 items-center gap-3">
                    <Avatar name={name} id={user.id} src={user.avatarUrl} size={64} className="size-16 rounded-md" />
                    <div class="grid min-w-0 gap-0.5">
                      <h4 class="flex min-w-0 items-center gap-1.5 text-base font-semibold text-fg">
                        <a
                          href={href(profilePath(user.handle), locale)}
                          class="truncate rounded-xs after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-focus"
                        >
                          {name}
                        </a>
                        {user.verifiedCreator && <TrustedMark size={16} />}
                      </h4>
                      <p class="truncate font-mono text-2xs text-fg-subtle">@{user.handle}</p>
                    </div>
                  </div>
                  <dl class="grid grid-cols-3 gap-2 border-t border-border pt-3">
                    <div class="grid min-w-0">
                      <dt class="readout truncate">{m.landing_stat_mods()}</dt>
                      <dd class="font-display-caps text-xl leading-tight tabular-nums text-fg">
                        {formatNumber(locale, creator.modsCount + creator.buildsCount)}
                      </dd>
                    </div>
                    <div class="grid min-w-0">
                      <dt class="readout truncate">{m.landing_stat_downloads()}</dt>
                      <dd class="font-display-caps text-xl leading-tight tabular-nums text-fg" title={formatNumber(locale, creator.downloadsTotal)}>
                        {formatCompactNumber(locale, creator.downloadsTotal)}
                      </dd>
                    </div>
                    <div class="grid min-w-0">
                      <dt class="readout truncate">{m.profile_stat_followers_label()}</dt>
                      <dd class="font-display-caps text-xl leading-tight tabular-nums text-fg">
                        {formatCompactNumber(locale, creator.followersCount)}
                      </dd>
                    </div>
                  </dl>
                  <div class="grid gap-1 text-sm">
                    {creator.topMod && (
                      <p class="truncate text-fg-muted">
                        <span class="readout me-1.5">{m.landing_creators_top()}</span>
                        <a
                          href={href(creator.topMod.canonicalPath, locale)}
                          class="relative z-10 rounded-xs font-semibold text-fg hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-focus"
                        >
                          {creator.topMod.name}
                        </a>
                      </p>
                    )}
                    {released && (
                      <p class="readout truncate">
                        {m.landing_creators_last_release({ when: formatRelativeTime(locale, released) })}
                      </p>
                    )}
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .spot-group {
    --tone: var(--color-featured);
  }
  .spot-group[data-tone="signal"] {
    --tone: var(--color-signal);
  }
  .spot-diamond {
    inline-size: 9px;
    block-size: 9px;
    rotate: 45deg;
    background: var(--tone);
    box-shadow: 0 0 10px color-mix(in oklab, var(--tone) 60%, transparent);
  }
  /* Crosshair corner brackets that light up on hover / focus (same language as the nav). */
  .spot-brackets {
    position: absolute;
    inset: 5px;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    --b: var(--tone);
    background:
      linear-gradient(var(--b), var(--b)) top left / 10px 1.5px no-repeat,
      linear-gradient(var(--b), var(--b)) top left / 1.5px 10px no-repeat,
      linear-gradient(var(--b), var(--b)) top right / 10px 1.5px no-repeat,
      linear-gradient(var(--b), var(--b)) top right / 1.5px 10px no-repeat,
      linear-gradient(var(--b), var(--b)) bottom left / 10px 1.5px no-repeat,
      linear-gradient(var(--b), var(--b)) bottom left / 1.5px 10px no-repeat,
      linear-gradient(var(--b), var(--b)) bottom right / 10px 1.5px no-repeat,
      linear-gradient(var(--b), var(--b)) bottom right / 1.5px 10px no-repeat;
  }
  .spot-card:hover > .spot-brackets,
  .spot-card:focus-within > .spot-brackets {
    opacity: 1;
  }
</style>
