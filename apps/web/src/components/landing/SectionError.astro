---
/**
 * Error state of a landing block whose API call failed (PLAN §1.2 «qué pasó, qué hacer»): the
 * page itself stays up and is cached briefly (`degraded`), so a reload a minute later heals it.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { RotateCw, SignalZero } from 'lucide-react';
import { href } from '../../lib/i18n.ts';

const locale = Astro.locals.locale;
---

<div class="flex flex-wrap items-center gap-3 rounded-lg border border-dashed border-border-strong bg-surface p-4 text-sm text-fg-muted">
  <Icon icon={SignalZero} size={18} className="shrink-0 text-warning" />
  <p class="flex-1">{m.landing_section_error()}</p>
  <a
    href={href('/', locale)}
    class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-3 font-semibold text-fg hover:bg-fg/8"
  >
    <Icon icon={RotateCw} size={16} />
    {m.common_action_retry()}
  </a>
</div>
