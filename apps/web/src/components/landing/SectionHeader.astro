---
/**
 * Header of a landing section: display-caps `h2` (the section's accessible name), an optional
 * readout hint and an optional «view all» link aligned to the end.
 */
import { Icon } from '@sotf/ui/icons';
import { ArrowRight } from 'lucide-react';

interface Props {
  id: string;
  title: string;
  hint?: string | undefined;
  link?: { href: string; label: string } | undefined;
  /** Blueprint band: ink colours instead of the default foreground. */
  tone?: 'default' | 'blueprint';
}

const { id, title, hint, link, tone = 'default' } = Astro.props;
---

<div
  class="mb-4 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-4 gap-y-1 [grid-template-areas:'title_link'_'hint_hint'] md:mb-5 md:[grid-template-areas:'title_link'_'hint_link']"
>
  <h2
    id={id}
    class:list={['min-w-0 font-display-caps text-display-xs [grid-area:title]', tone === 'blueprint' ? 'text-blueprint' : 'text-fg']}
  >
    {title}
  </h2>
  {hint && <p class="text-sm text-fg-muted [grid-area:hint]">{hint}</p>}
  {
    link && (
      <a
        href={link.href}
        class:list={[
          'inline-flex min-h-11 items-center gap-1.5 self-center rounded-md ps-2 text-sm font-semibold whitespace-nowrap [grid-area:link] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus md:self-end',
          tone === 'blueprint' ? 'text-blueprint' : 'text-link',
        ]}
      >
        {link.label}
        <Icon icon={ArrowRight} size={16} className="rtl:rotate-180" />
      </a>
    )
  }
</div>
