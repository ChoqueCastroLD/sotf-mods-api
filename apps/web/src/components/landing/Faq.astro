---
/**
 * Citable FAQ (research/03 §6.1, PLAN §4.5): answer-first paragraphs, rendered open in the HTML
 * so readers and answer engines get the same text as the `FAQPage` JSON-LD. On phones the
 * landing script folds the items into an accordion (`islands/landing/faq.ts`); they stay in the
 * DOM either way.
 */
import type { Locale } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { ArrowRight, ChevronDown } from 'lucide-react';
import type { FaqItem } from '../../content/faq/index.ts';
import { href } from '../../lib/i18n.ts';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
  items: readonly FaqItem[];
  /** Formatted date of the figures («as of»), when the catalogue answer is present. */
  figuresDate: string | null;
}

const { locale, items, figuresDate } = Astro.props;
---

<section class="mx-auto w-full max-w-(--container-wide) px-4 py-8 md:px-6 md:py-14" aria-labelledby="faq-title">
  <SectionHeader id="faq-title" title={m.landing_faq_title()} hint={m.landing_faq_hint()} />
  <div class="grid items-start gap-3 md:grid-cols-2 md:gap-4" data-faq>
    {
      items.map((item) => (
        <details
          id={`faq-${item.id}`}
          open
          class="faq-item group rounded-xl border border-border bg-surface open:bg-surface"
        >
          <summary class="flex min-h-14 cursor-pointer list-none items-center gap-3 rounded-xl p-4 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-focus md:px-5 [&::-webkit-details-marker]:hidden">
            <h3 class="flex-1 text-base font-semibold text-balance text-fg md:text-lg">{item.question}</h3>
            <Icon icon={ChevronDown} size={20} className="shrink-0 text-fg-subtle transition-transform duration-(--dur-fast) group-open:rotate-180" />
          </summary>
          <div class="flex flex-col gap-2 px-4 pb-4 md:px-5 md:pb-5">
            <p class="text-pretty text-fg-muted">{item.answer}</p>
            <a
              href={href(item.path, locale)}
              class="inline-flex min-h-11 items-center gap-1.5 self-start rounded-md text-sm font-semibold text-link hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            >
              {m.landing_faq_more()}
              <span class="sr-only">: {item.question}</span>
              <Icon icon={ArrowRight} size={16} className="rtl:rotate-180" />
            </a>
          </div>
        </details>
      ))
    }
  </div>
  {figuresDate && <p class="readout mt-4">{m.landing_faq_figures({ date: figuresDate })}</p>}
</section>
