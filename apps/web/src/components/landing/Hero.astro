---
/**
 * Hero «The living island» (research/03 §5.10, §6.1; T0-05).
 *
 * - Full-bleed `texture-topo`; no image, so the LCP is the `h1` (text, preloaded display font).
 * - Mono readout: downloads today / last hour (from `live/pulse`, refreshed every
 *   60 s by `islands/landing/pulse.ts`) · current game build · RedLoader.
 * - Headline (second sentence in Flare), lead with dated catalogue figures, primary and secondary
 *   CTAs, the search field (a real GET form; with JS it opens Cmd+K) and four stat tiles with a
 *   count-up (skipped under reduced motion).
 * - Right side: the island map (`IslandMap.astro`), waypoints for ~26 mods over brand contours;
 *   a compact map below `lg`.
 */
import { formatCompactNumber, formatNumber, type Locale } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Kbd } from '@sotf/ui/kbd';
import { ArrowRight, BookOpen, Search } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { Category, Ecosystem, LivePulse, ModCardDTO, SiteStats } from './data.ts';
import IslandMap from './IslandMap.astro';

interface Props {
  locale: Locale;
  stats: SiteStats | null;
  pulse: LivePulse | null;
  currentBuild: string | null;
  loader: Ecosystem['entries'][number] | null;
  mapSources: {
    trending: readonly ModCardDTO[] | null;
    updated: readonly ModCardDTO[] | null;
    legends: readonly ModCardDTO[] | null;
  };
  categories: readonly Category[] | null;
}

const { locale, stats, pulse, currentBuild, loader, mapSources, categories } = Astro.props;

const lead = stats
  ? m.landing_hero_lead({ modCount: stats.mods, buildCount: stats.builds })
  : m.landing_hero_lead_fallback();

const tiles = stats
  ? [
      { key: 'downloads', label: m.landing_stat_downloads(), value: stats.downloads },
      { key: 'mods', label: m.landing_stat_mods(), value: stats.mods },
      { key: 'creators', label: m.landing_stat_creators(), value: stats.creators },
      { key: 'survivors', label: m.landing_stat_survivors(), value: stats.users },
    ]
  : [];

const primaryCta =
  'inline-flex h-12 w-full items-center justify-center gap-2 rounded-md bg-primary px-5 font-semibold text-primary-fg shadow-glow transition-colors duration-(--dur-fast) hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus sm:w-auto';
const secondaryCta =
  'inline-flex h-12 w-full items-center justify-center gap-2 rounded-md border border-border-strong bg-surface/80 px-5 font-semibold text-fg transition-colors duration-(--dur-fast) hover:bg-fg/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus sm:w-auto';
---

<section class="landing-hero texture-topo relative overflow-hidden border-b border-border" aria-labelledby="home-title">
  <div
    class="relative mx-auto grid w-full max-w-(--container-wide) gap-x-10 gap-y-6 px-4 pt-8 pb-10 md:px-6 md:pt-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:pt-16 lg:pb-16"
  >
    <div class="grid content-start gap-5 lg:col-start-1 lg:row-start-1">
      <p class="readout flex flex-wrap items-center gap-x-2 gap-y-1 text-signal" data-pulse-readout>
        <span data-pulse-group hidden={pulse === null} class="contents">
          <span>
            {m.landing_readout_today()}{' '}
            <span data-pulse-field="downloadsToday" class="tabular-nums text-fg">
              {pulse ? formatNumber(locale, pulse.downloadsToday) : ''}
            </span>
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {m.landing_readout_hour()}{' '}
            <span data-pulse-field="downloadsLastHour" class="tabular-nums text-fg">
              {pulse ? formatNumber(locale, pulse.downloadsLastHour) : ''}
            </span>
          </span>
          {(currentBuild || loader) && <span aria-hidden="true">·</span>}
        </span>
        {currentBuild && <span>{m.landing_readout_game({ build: currentBuild })}</span>}
        {
          loader && (
            <>
              {currentBuild && <span aria-hidden="true">·</span>}
              <span>
                {loader.loader.name} {loader.loader.version}
              </span>
            </>
          )
        }
        <span data-pulse-offline data-text={m.landing_readout_offline()} role="status" class="text-warning"></span>
      </p>

      <h1 id="home-title" class="font-display-caps text-display-lg text-balance text-fg">
        <span class="block">{m.landing_hero_title_lead()}</span>
        <span class="block text-primary">{m.landing_hero_title_accent()}</span>
      </h1>
      <p class="max-w-(--container-prose) text-lg text-pretty text-fg-muted">{lead}</p>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={href('/mods', locale)} class={primaryCta}>
          {m.landing_hero_cta_explore()}
          <Icon icon={ArrowRight} size={18} />
        </a>
        <a href={href('/install', locale)} class={secondaryCta}>
          <Icon icon={BookOpen} size={18} />
          {m.landing_hero_cta_install()}
        </a>
      </div>
    </div>

    <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
      <IslandMap
        locale={locale}
        trending={mapSources.trending}
        updated={mapSources.updated}
        legends={mapSources.legends}
        categories={categories}
      />
    </div>

    <div class="grid content-start gap-6 lg:col-start-1 lg:row-start-2">
      <search class="max-w-xl">
        <form method="get" action={href('/search', locale)} data-landing-search class="flex gap-2">
          <label for="landing-search" class="sr-only">{m.landing_hero_search_label()}</label>
          <div class="relative flex-1">
            <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-fg-subtle">
              <Icon icon={Search} size={18} />
            </span>
            <input
              id="landing-search"
              name="q"
              type="search"
              maxlength="100"
              enterkeyhint="search"
              autocomplete="off"
              placeholder={m.common_search_placeholder()}
              aria-describedby="landing-search-hint"
              data-landing-search-input
              class="h-12 w-full rounded-md border border-border-strong bg-sunken ps-10 pe-16 text-base text-fg placeholder:text-fg-subtle focus-visible:outline-2 focus-visible:outline-focus"
            />
            <span
              id="landing-search-hint"
              class="pointer-events-none absolute inset-y-0 end-3 hidden items-center gap-1 md:flex"
            >
              <span class="sr-only">{m.common_search_shortcut({ shortcut: 'Ctrl+K' })}</span>
              <span aria-hidden="true" class="flex gap-1"><Kbd>Ctrl</Kbd><Kbd>K</Kbd></span>
            </span>
          </div>
          <button
            type="submit"
            class="inline-flex h-12 shrink-0 items-center justify-center rounded-md border border-border-strong px-4 font-semibold text-fg hover:bg-fg/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            {m.common_search_label()}
          </button>
        </form>
      </search>

      {
        tiles.length > 0 && (
          <dl class="grid grid-cols-2 gap-3 md:grid-cols-4" aria-label={m.landing_stats_label()}>
            {tiles.map((tile) => (
              <div class="flex min-w-0 flex-col gap-1.5 rounded-lg border border-border bg-surface/90 p-4">
                <dt class="readout truncate">{tile.label}</dt>
                <dd class="font-display-caps text-display-xs leading-none tabular-nums text-fg">
                  <span aria-hidden="true" data-count-up={tile.value} title={formatNumber(locale, tile.value)}>
                    {formatCompactNumber(locale, tile.value)}
                  </span>
                  <span class="sr-only">{formatNumber(locale, tile.value)}</span>
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
