---
/**
 * The hub while no jam exists yet: a short statement, what entries are judged on and two ways to
 * hear about the first one (notification settings, Discord).
 */
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { href } from '../../lib/i18n.ts';
import { SOCIAL_LINKS } from '../../lib/site.ts';

const locale = Astro.locals.locale;
const criteria = [m.jams_category_fun(), m.jams_category_polish(), m.jams_category_creativity(), m.jams_category_lore()];
---

<section aria-labelledby="jams-first" class="flex max-w-(--container-prose) flex-col items-start gap-4 border-y border-border py-8">
  <h2 id="jams-first" class="text-2xl font-bold text-fg md:text-3xl">{m.jams_first_title()}</h2>
  <p class="text-base text-fg-muted">{m.jams_first_text()}</p>
  <div class="flex flex-col gap-1.5">
    <p class="text-sm font-semibold text-fg">{m.jams_first_judged()}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-fg-muted">
      {criteria.map((label) => <li>{label}</li>)}
    </ul>
  </div>
  <p class="text-sm text-fg-muted">{m.jams_first_prize()}</p>
  <div class="flex flex-wrap gap-3">
    <a href={href('/settings/notifications', locale)} class={buttonClasses({ variant: 'primary', size: 'md' })}>
      {m.jams_first_notify()}
    </a>
    <a href={SOCIAL_LINKS.discord} class={buttonClasses({ variant: 'secondary', size: 'md' })} rel="noopener" target="_blank">
      {m.jams_first_discord()}
    </a>
  </div>
  <p class="text-sm text-fg-muted">{m.jams_first_hint()}</p>
</section>
