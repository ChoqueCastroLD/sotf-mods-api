---
/**
 * «How a jam works» in four short steps. Static text, shown on the hub.
 */
import { m } from '@sotf/i18n/messages';

interface Props {
  headingLevel?: 2 | 3;
  class?: string;
}

const { headingLevel = 2, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const steps = [
  { title: m.jams_how_1_title(), text: m.jams_how_1_text() },
  { title: m.jams_how_2_title(), text: m.jams_how_2_text() },
  { title: m.jams_how_3_title(), text: m.jams_how_3_text() },
  { title: m.jams_how_4_title(), text: m.jams_how_4_text() },
];
---

<section aria-labelledby="jams-how" class:list={['flex flex-col gap-4', className]}>
  <Heading id="jams-how" class="text-xl font-bold text-fg md:text-2xl">{m.jams_how_title()}</Heading>
  <ol class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step, index) => (
        <li class="flex flex-col gap-1 border-t border-border pt-3">
          <span class="text-sm font-semibold text-fg">
            <span class="text-fg-muted tabular-nums">{index + 1}.</span> {step.title}
          </span>
          <p class="text-sm text-fg-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
