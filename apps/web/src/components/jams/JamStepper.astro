---
/**
 * The four stages of a jam (announce, build, vote, results) as a plain row: done stages are
 * marked with a check, the current one is bold with a red rule, the rest are muted. Horizontal
 * from `md` up, vertical below. The state is also text (`sr-only`), never colour alone.
 */
import type { JamSummaryDTO } from '@sotf/contracts/jams';
import { formatDate, toHreflang } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Check } from 'lucide-react';
import { JAM_STAGES, stageDates, stageLabel, stageStates } from './phase.ts';

interface Props {
  jam: Pick<
    JamSummaryDTO,
    | 'phase'
    | 'announceAt'
    | 'submissionsOpenAt'
    | 'submissionsCloseAt'
    | 'votingOpenAt'
    | 'votingCloseAt'
    | 'resultsPublishedAt'
  >;
  class?: string;
}

const { jam, class: className } = Astro.props;
const locale = Astro.locals.locale;
const states = stageStates(jam.phase);

function when(stage: (typeof JAM_STAGES)[number]): string | null {
  const { from, to } = stageDates(jam, stage);
  if (!from) return null;
  const start = formatDate(locale, from, 'medium');
  if (!to) return start;
  return new Intl.DateTimeFormat(toHreflang(locale), { dateStyle: 'medium', timeZone: 'UTC' }).formatRange(
    new Date(from),
    new Date(to),
  );
}

const stateText = (state: (typeof states)[number]) =>
  state === 'done' ? m.jams_stage_done() : state === 'current' ? m.jams_stage_current() : m.jams_stage_next();
---

<ol class:list={['grid gap-4 md:grid-cols-4 md:gap-6', className]} aria-label={m.jams_schedule_title()}>
  {
    JAM_STAGES.map((stage, index) => {
      const state = states[index] ?? 'upcoming';
      const dates = when(stage);
      return (
        <li
          class:list={['flex flex-col gap-0.5 border-t-2 pt-3', state === 'upcoming' ? 'border-border' : 'border-primary']}
          aria-current={state === 'current' ? 'step' : undefined}
        >
          <span
            class:list={[
              'flex items-center gap-1.5 text-sm',
              state === 'current' ? 'font-bold text-fg' : state === 'done' ? 'font-semibold text-fg' : 'text-fg-muted',
            ]}
          >
            {state === 'done' && <Icon icon={Check} size={14} strokeWidth={2.5} className="text-primary" />}
            {stageLabel(stage)}
          </span>
          {dates && <span class="text-xs text-fg-muted tabular-nums">{dates}</span>}
          <span class="sr-only">{stateText(state)}</span>
        </li>
      );
    })
  }
</ol>
