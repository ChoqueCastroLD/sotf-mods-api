---
/**
 * The line shown while a theme is still secret: when it will be revealed.
 */
import { formatDate } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';

interface Props {
  revealAt?: string | null;
  class?: string;
}

const { revealAt = null, class: className } = Astro.props;
const locale = Astro.locals.locale;
const reveal = revealAt ? m.jams_mystery_reveal({ date: formatDate(locale, revealAt, 'medium') }) : m.jams_theme_hidden();
---

<p class:list={['flex flex-wrap items-baseline gap-x-2 text-sm', className]}>
  <span class="text-fg-muted">{m.jams_theme_heading()}</span>
  <span class="font-semibold text-fg">{m.jams_mystery_title()}</span>
  <span class="text-fg-muted">{reveal}</span>
</p>
