---
/**
 * Header of a jam: phase, entries, title, tagline, theme (or the sealed-theme line) and, beside
 * it, the countdown to the next milestone and the actions.
 *
 * - `mode="detail"`: the `h1` of `/jams/:slug`; the `actions` slot holds the island mount.
 * - `mode="hub"`: the featured jam of `/jams`; `h2`, a call to action link and the stage row.
 */
import type { JamSummaryDTO } from '@sotf/contracts/jams';
import { formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { ArrowRight } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import Countdown from './Countdown.astro';
import { type JamResultsDTO, winnerOf } from './data.ts';
import JamStepper from './JamStepper.astro';
import MysteryTheme from './MysteryTheme.astro';
import PhaseBadge from './PhaseBadge.astro';
import { nextDeadline } from './phase.ts';
import WinnerSpotlight from './WinnerSpotlight.astro';

interface Props {
  jam: JamSummaryDTO;
  mode: 'detail' | 'hub';
  results?: JamResultsDTO | null;
  /** `#anchor` of the results section (detail mode with published results). */
  resultsAnchor?: string | undefined;
}

const { jam, mode, results = null, resultsAnchor } = Astro.props;
const locale = Astro.locals.locale;
const Heading = mode === 'detail' ? 'h1' : 'h2';
const deadline = nextDeadline(jam);
const finished = jam.phase === 'results' || jam.phase === 'archived';
const winner = winnerOf(results);

const CTA: Record<string, () => string> = {
  announced: () => m.jams_cta_view(),
  submissions: () => m.jams_cta_join(),
  submissions_closed: () => m.jams_cta_view(),
  voting: () => m.jams_cta_vote(),
  results: () => m.jams_cta_results(),
  archived: () => m.jams_cta_results(),
};
const ctaLabel = (CTA[jam.phase] ?? CTA.announced)?.() ?? m.jams_cta_view();
const showSide = mode === 'detail' || deadline !== null || finished;
---

<section aria-labelledby={mode === 'detail' ? 'jam-title' : `jam-hero-${jam.slug}`} class="flex flex-col gap-6">
  <div class:list={['grid gap-6', showSide && 'lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-12']}>
    <div class="flex min-w-0 flex-col items-start gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <PhaseBadge phase={jam.phase} />
        <span class="text-sm text-fg-muted">{m.jams_entries_count({ count: jam.entryCount })}</span>
      </div>
      <Heading
        id={mode === 'detail' ? 'jam-title' : `jam-hero-${jam.slug}`}
        class="text-3xl font-bold text-balance text-fg md:text-4xl"
      >
        {jam.title}
      </Heading>
      {jam.tagline && <p class="max-w-(--container-prose) text-base text-fg-muted md:text-lg">{jam.tagline}</p>}
      {
        jam.theme ? (
          <p class="flex flex-wrap items-baseline gap-x-2 text-base">
            <span class="text-fg-muted">{m.jams_theme_heading()}</span>
            <span class="font-bold text-fg">{jam.theme}</span>
          </p>
        ) : jam.themeHidden ? (
          <MysteryTheme revealAt={jam.submissionsOpenAt} />
        ) : null
      }
      {
        mode === 'hub' && (
          <a href={href(`/jams/${jam.slug}`, locale)} class={buttonClasses({ variant: 'primary', size: 'lg', className: 'mt-2' })}>
            {ctaLabel}
            <Icon icon={ArrowRight} size={18} className="rtl:rotate-180" />
          </a>
        )
      }
    </div>

    {
      showSide && (
        <div class="flex min-w-0 flex-col gap-4 lg:border-s lg:border-border lg:ps-10">
          {deadline && <Countdown deadline={deadline} />}
          {!deadline && finished && (
            <div class="flex flex-col gap-3">
              {winner && <WinnerSpotlight placement={winner} link={mode === 'detail'} />}
              {results && (
                <p class="text-sm text-fg-muted tabular-nums">
                  {m.jams_results_summary({ participants: results.participants, voters: results.voters })}
                </p>
              )}
              {!results && jam.resultsPublishedAt && (
                <p class="text-sm text-fg-muted tabular-nums">
                  {formatDate(locale, jam.resultsPublishedAt, 'medium')} · {formatNumber(locale, jam.entryCount)}
                </p>
              )}
              {mode === 'detail' && resultsAnchor && results && results.overall.length > 0 && (
                <a href={resultsAnchor} class={buttonClasses({ variant: 'secondary', size: 'md', className: 'self-start' })}>
                  {m.jams_cta_results()}
                </a>
              )}
            </div>
          )}
          <slot name="actions" />
        </div>
      )
    }
  </div>

  <JamStepper jam={jam} />
</section>
