---
/**
 * Countdown to the next milestone of a jam: days, hours, minutes and seconds in one line. The
 * server renders the time left at render time (the page is edge-cached for a few minutes) so
 * crawlers and visitors without JavaScript see a sensible figure next to the exact date;
 * `islands/jams/countdown.ts` then keeps it ticking. A ticking clock is never announced: the
 * figures are `aria-hidden` and the exact instant is in the visible `<time>` caption.
 *
 * `compact` renders only the text (`2 d 04:12:09`) for lists.
 */
import { formatDateTime } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { deadlineLabel, type JamDeadline } from './phase.ts';

interface Props {
  deadline: JamDeadline;
  compact?: boolean;
  class?: string;
}

const { deadline, compact = false, class: className } = Astro.props;
const locale = Astro.locals.locale;
const left = Math.max(0, Date.parse(deadline.at) - Date.now());
const total = Math.floor(left / 1000);
const parts = {
  d: Math.floor(total / 86_400),
  h: Math.floor((total % 86_400) / 3600),
  m: Math.floor((total % 3600) / 60),
  s: total % 60,
};
const pad = (value: number) => String(value).padStart(2, '0');
const cells = [
  { unit: 'd', value: pad(parts.d), label: m.jams_unit_days() },
  { unit: 'h', value: pad(parts.h), label: m.jams_unit_hours() },
  { unit: 'm', value: pad(parts.m), label: m.jams_unit_minutes() },
  { unit: 's', value: pad(parts.s), label: m.jams_unit_seconds() },
];
const exact = `${formatDateTime(locale, deadline.at, 'medium', 'short')} UTC`;
---

{
  compact ? (
    <p class:list={['flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm', className]}>
      <span class="text-fg-muted">{deadlineLabel(deadline.kind)}</span>
      <time
        datetime={deadline.at}
        data-jam-countdown={deadline.at}
        data-locale={locale}
        class="font-semibold text-fg tabular-nums"
      >
        {exact}
      </time>
    </p>
  ) : (
    <div class:list={['flex flex-col gap-2', className]}>
      <p class="text-sm text-fg-muted">{deadlineLabel(deadline.kind)}</p>
      <div class="flex items-baseline gap-4 sm:gap-5" data-jam-clock={deadline.at} aria-hidden="true">
        {cells.map((cell) => (
          <div class="flex items-baseline gap-1">
            <span data-unit={cell.unit} class="text-3xl font-bold tabular-nums text-fg sm:text-4xl">
              {cell.value}
            </span>
            <span class="text-sm text-fg-muted lowercase">{cell.label}</span>
          </div>
        ))}
      </div>
      <time datetime={deadline.at} class="text-xs text-fg-muted tabular-nums">
        {exact}
      </time>
    </div>
  )
}
