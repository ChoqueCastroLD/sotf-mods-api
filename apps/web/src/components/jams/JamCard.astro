---
/**
 * A jam in the hub (everything except the featured one) as one row: title, phase, theme (or the
 * sealed-theme line), tagline, entries, the next milestone and, for finished jams, the winner.
 * The whole row is one link (the title).
 */
import { formatDate } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { href } from '../../lib/i18n.ts';
import Countdown from './Countdown.astro';
import type { JamResultsDTO, JamSummaryDTO } from './data.ts';
import MysteryTheme from './MysteryTheme.astro';
import PhaseBadge from './PhaseBadge.astro';
import { nextDeadline } from './phase.ts';
import WinnerSpotlight from './WinnerSpotlight.astro';

interface Props {
  jam: JamSummaryDTO;
  winner?: JamResultsDTO['overall'][number] | null;
  headingLevel?: 2 | 3;
}

const { jam, winner = null, headingLevel = 3 } = Astro.props;
const locale = Astro.locals.locale;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const deadline = nextDeadline(jam);
const finished = jam.phase === 'results' || jam.phase === 'archived';
---

<article class="relative grid gap-1.5 border-b border-border py-5 hover:bg-fg/3 md:grid-cols-[minmax(0,1fr)_auto] md:items-start md:gap-x-8">
  <div class="flex min-w-0 flex-col gap-1.5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <Heading class="text-xl font-bold text-fg">
        <a
          href={href(`/jams/${jam.slug}`, locale)}
          class="outline-none after:absolute after:inset-0 after:content-[''] focus-visible:after:ring-2 focus-visible:after:ring-focus"
        >
          {jam.title}
        </a>
      </Heading>
      <PhaseBadge phase={jam.phase} />
    </div>
    {
      jam.theme ? (
        <p class="flex flex-wrap items-baseline gap-x-2 text-sm">
          <span class="text-fg-muted">{m.jams_theme_heading()}</span>
          <span class="font-semibold text-fg">{jam.theme}</span>
        </p>
      ) : jam.themeHidden ? (
        <MysteryTheme revealAt={jam.submissionsOpenAt} />
      ) : null
    }
    {jam.tagline && <p class="line-clamp-2 max-w-(--container-prose) text-sm text-fg-muted">{jam.tagline}</p>}
    {winner && <WinnerSpotlight placement={winner} link={false} />}
  </div>
  <div class="flex flex-col gap-1 text-sm text-fg-muted md:items-end md:text-end">
    <span class="tabular-nums">{m.jams_entries_count({ count: jam.entryCount })}</span>
    {
      deadline ? (
        <Countdown deadline={deadline} compact={true} />
      ) : finished && jam.resultsPublishedAt ? (
        <time datetime={jam.resultsPublishedAt} class="tabular-nums">
          {formatDate(locale, jam.resultsPublishedAt, 'medium')}
        </time>
      ) : null
    }
  </div>
</article>
