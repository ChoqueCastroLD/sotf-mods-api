---
/**
 * Results of one category as a ranked list (top 3, ties included): rank, the mod's thumbnail,
 * name, team, the average stars and the number of votes. Ranks are text, never only colour.
 */
import { profilePath } from '@sotf/contracts/seo';
import { formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Package, Star } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { JamResultsDTO } from './data.ts';

type Placement = JamResultsDTO['overall'][number];

interface Props {
  placements: readonly Placement[];
}

const { placements } = Astro.props;
const locale = Astro.locals.locale;
const ranked = placements.filter((placement) => placement.rank <= 3);
---

<ol class="flex flex-col">
  {
    ranked.map((placement) => {
      const mod = placement.entry.mod;
      const thumb = mod.thumbnail;
      return (
        <li class="flex items-center gap-4 border-b border-border py-4" data-rank={placement.rank}>
          <span class="w-8 shrink-0 text-center text-2xl font-bold tabular-nums text-fg">
            {m.jams_rank({ rank: placement.rank })}
          </span>
          <span class="relative block aspect-[16/10] w-24 shrink-0 overflow-hidden rounded-md bg-sunken sm:w-32">
            {thumb ? (
              <img
                src={thumb.url}
                alt=""
                width={thumb.width ?? 640}
                height={thumb.height ?? 400}
                loading="lazy"
                decoding="async"
                class="size-full object-cover"
              />
            ) : (
              <span class="grid size-full place-items-center text-fg-subtle">
                <Icon icon={Package} size={28} />
              </span>
            )}
          </span>
          <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <h4 class="truncate text-lg font-bold text-fg">
              <a href={href(mod.canonicalPath, locale)} class="hover:underline">
                {mod.name}
              </a>
            </h4>
            <p class="text-sm text-fg-muted">
              {m.jams_by()}{' '}
              {placement.entry.authors.map((author, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={href(profilePath(author.handle), locale)} class="font-semibold text-fg hover:underline">
                    {author.displayName || author.handle}
                  </a>
                </>
              ))}
            </p>
          </div>
          <p class="flex shrink-0 flex-col items-end gap-0.5 text-sm text-fg-muted tabular-nums">
            <span class="inline-flex items-center gap-1 font-semibold text-fg">
              <Icon icon={Star} size={15} className="fill-current" />
              {formatNumber(locale, placement.average, { maximumFractionDigits: 2, minimumFractionDigits: 2 })}
            </span>
            <span>{m.jams_votes_count({ count: placement.votes })}</span>
          </p>
        </li>
      );
    })
  }
</ol>
