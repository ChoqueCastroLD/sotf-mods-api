---
/**
 * Published results: one podium per category behind a row of category tabs (the overall podium
 * first). The tabs are native radio inputs styled as pills: arrow keys, focus and announcements
 * come from the platform, they work without JavaScript, and `:has()` swaps the podium. Without
 * `:has()` support the first panel stays visible.
 */
import { JAM_OVERALL_KEY } from '@sotf/contracts/jams';
import { m } from '@sotf/i18n/messages';
import type { JamResultsDTO } from './data.ts';
import Podium from './Podium.astro';
import { categoryLabel } from './phase.ts';

interface Props {
  results: JamResultsDTO;
  /** Unique per page, names the radio group. */
  id?: string;
}

const { results, id = 'jam-board' } = Astro.props;
const panels = [
  { key: JAM_OVERALL_KEY, label: categoryLabel({ key: JAM_OVERALL_KEY, label: null }), placements: results.overall },
  ...results.categories
    .filter((category) => category.placements.length > 0)
    .map((category) => ({ key: category.key, label: categoryLabel(category), placements: category.placements })),
];
---

<div class="jam-board flex flex-col gap-6" data-jam-board>
  <div role="radiogroup" aria-label={m.jams_results_tabs_label()} class="flex flex-wrap gap-2">
    {
      panels.map((panel, index) => (
        <label class="relative inline-flex min-h-11 cursor-pointer select-none items-center rounded-full border border-border-strong bg-surface px-4 text-sm font-semibold text-fg-muted transition-colors duration-(--dur-fast) hover:text-fg has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-fg has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-focus">
          <input
            type="radio"
            name={`${id}-tab`}
            value={panel.key}
            data-tab={index}
            checked={index === 0}
            class="peer absolute inset-0 size-full cursor-pointer opacity-0"
          />
          {panel.label}
        </label>
      ))
    }
  </div>
  {
    panels.map((panel, index) => (
      <div data-panel={index} data-key={panel.key}>
        <h3 class="sr-only">{panel.label}</h3>
        <Podium placements={panel.placements} trophy={panel.key === JAM_OVERALL_KEY} />
      </div>
    ))
  }
</div>

<style is:global>
  .jam-board [data-panel] {
    display: none;
  }
  .jam-board [data-panel='0'] {
    display: block;
  }
  .jam-board:has([data-tab]:checked) [data-panel] {
    display: none;
  }
  .jam-board:has([data-tab='0']:checked) [data-panel='0'],
  .jam-board:has([data-tab='1']:checked) [data-panel='1'],
  .jam-board:has([data-tab='2']:checked) [data-panel='2'],
  .jam-board:has([data-tab='3']:checked) [data-panel='3'],
  .jam-board:has([data-tab='4']:checked) [data-panel='4'],
  .jam-board:has([data-tab='5']:checked) [data-panel='5'],
  .jam-board:has([data-tab='6']:checked) [data-panel='6'],
  .jam-board:has([data-tab='7']:checked) [data-panel='7'],
  .jam-board:has([data-tab='8']:checked) [data-panel='8'] {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .jam-board [data-panel] {
      animation: rise 320ms var(--ease-out) both;
    }
  }
</style>
