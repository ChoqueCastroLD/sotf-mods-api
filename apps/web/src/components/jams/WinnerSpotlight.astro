---
/**
 * The winner of a jam in one line: label, mod name, team and score. Used on the hub and on past
 * jams. With `link={false}` it holds no anchors (it sits inside a row that is already one link).
 */
import { profilePath } from '@sotf/contracts/seo';
import { formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Star } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { JamResultsDTO } from './data.ts';

type Placement = JamResultsDTO['overall'][number];

interface Props {
  placement: Placement;
  link?: boolean;
  class?: string;
}

const { placement, link = true, class: className } = Astro.props;
const locale = Astro.locals.locale;
const mod = placement.entry.mod;
const authors = placement.entry.authors.map((a) => a.displayName || a.handle);
---

<p class:list={['flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-0.5 text-sm', className]}>
  <span class="text-fg-muted">{m.jams_winner_label()}</span>
  {
    link ? (
      <a href={href(mod.canonicalPath, locale)} class="font-semibold text-fg hover:underline">
        {mod.name}
      </a>
    ) : (
      <span class="font-semibold text-fg">{mod.name}</span>
    )
  }
  <span class="text-fg-muted">
    {m.jams_by()}{' '}
    {
      link
        ? placement.entry.authors.map((author, index) => (
            <>
              {index > 0 && ', '}
              <a href={href(profilePath(author.handle), locale)} class="hover:underline">
                {author.displayName || author.handle}
              </a>
            </>
          ))
        : authors.join(', ')
    }
  </span>
  <span class="inline-flex items-center gap-1 text-fg-muted tabular-nums">
    <Icon icon={Star} size={13} className="fill-current" />
    {formatNumber(locale, placement.average, { maximumFractionDigits: 2, minimumFractionDigits: 2 })}
  </span>
</p>
