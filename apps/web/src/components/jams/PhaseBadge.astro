---
/**
 * Phase of a jam as a small label. The text always names the phase; colour is only a second cue.
 */
import type { JamPhase } from '@sotf/contracts/jams';
import { PHASE_TONE_CLASSES, phaseLabel, phaseTone } from './phase.ts';

interface Props {
  phase: JamPhase;
  class?: string;
}

const { phase, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold',
    PHASE_TONE_CLASSES[phaseTone(phase)],
    className,
  ]}
>
  {phaseLabel(phase)}
</span>
