---
/**
 * Layout of the auth pages (log in, register, password reset, email verification): the site shell
 * around one centred column with the heading, an optional intro and the form. The form itself is a
 * React island passed in the default slot; `<noscript>` explains that the forms need JavaScript (the
 * API only accepts JSON bodies). Every auth page is `noindex` and has no ads.
 */
import { m } from '@sotf/i18n/messages';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  /** Template name for RUM and analytics (`login`, `register`…). */
  template: string;
  title: string;
  description: string;
  heading: string;
  intro?: string | undefined;
}

const { template, title, description, heading, intro } = Astro.props;
---

<BaseLayout template={template} seo={{ title, description, noindex: true }} mainClass="grid">
  <section
    class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-10 md:py-16"
    aria-labelledby="auth-heading"
  >
    <header class="grid gap-2">
      <h1 id="auth-heading" class="text-2xl font-bold text-fg md:text-3xl">{heading}</h1>
      {intro && <p class="text-fg-muted">{intro}</p>}
    </header>
    <noscript>
      <p class="rounded-md border border-warning/50 bg-warning/10 p-3 text-sm text-fg">{m.auth_noscript()}</p>
    </noscript>
    <div>
      <slot />
    </div>
  </section>
</BaseLayout>
