---
/**
 * Account area of the header.
 *
 * Public HTML is identical for everyone, so the server renders the guest state (Log in and
 * Register, the login link remembers the page with `?next=`) plus the hidden signed-in markup:
 * the Upload button, the avatar button and its menu (native `popover`, no framework).
 * `scripts/account-hint.ts` reads the `sotf_li` hint cookie and, only then, calls `/me/summary`,
 * paints the avatar and emits `sotf:account`; `account-menu.ts` fills the menu from that event
 * (profile link, Moderation for moderators and admins, unread notifications, the «verify your
 * email» reminder). `html[data-signed-in]` (set by the same script) reveals `[data-signed-in-only]`.
 *
 * The same menu is the phone's account sheet: the bottom tab bar opens it (`popovertarget`) and
 * below `md` it is drawn as a bottom sheet. The slot itself is hidden on phones.
 *
 * Sign-out is a real form (`POST /logout`), so it works even if the script failed.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import {
  Bell,
  Download,
  Heart,
  LayoutDashboard,
  LogOut,
  MailWarning,
  Settings,
  ShieldCheck,
  Upload,
  UserRound,
} from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import { PATHS } from '../layout/nav-items.ts';

const locale = Astro.locals.locale;
const next = Astro.locals.pagePath;
const loginHref = `${href(PATHS.login, locale)}?next=${encodeURIComponent(next)}`;
const itemClass =
  'flex min-h-11 w-full items-center gap-3 rounded-md px-3 text-sm text-fg hover:bg-fg/8 focus-visible:bg-fg/8 md:min-h-10';
---

<div data-account-slot class="hidden shrink-0 items-center justify-end gap-1 md:flex">
  <div data-account-guest class="flex items-center gap-1">
    <a
      href={loginHref}
      class="inline-flex h-10 items-center rounded-full px-3 text-sm font-medium text-fg hover:bg-fg/8"
    >
      {m.shell_nav_login()}
    </a>
    <a
      href={href(PATHS.register, locale)}
      class="hidden h-10 items-center rounded-full bg-primary px-4 text-sm font-semibold text-primary-fg hover:bg-primary-hover lg:inline-flex"
    >
      {m.shell_nav_register()}
    </a>
  </div>

  <a
    data-signed-in-only
    href={PATHS.uploadMod}
    aria-label={m.shell_nav_upload()}
    class="h-10 items-center gap-2 rounded-full bg-primary px-3 text-sm font-semibold text-primary-fg hover:bg-primary-hover lg:px-4"
  >
    <Icon icon={Upload} size={18} />
    <span class="hidden lg:inline">{m.shell_nav_upload()}</span>
  </a>

  <!-- Room for the notifications bell (mounted here later, `islands/signals/mount.ts`): the header does not shift when it appears. -->
  <span data-signals-bell class="hidden size-10 shrink-0 items-center justify-center [html[data-signed-in]_&]:inline-flex"></span>

  <button
    type="button"
    data-account-user
    hidden
    popovertarget="account-menu"
    class="inline-flex size-10 items-center justify-center overflow-hidden rounded-full border border-border-strong bg-raised text-sm font-semibold text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
  >
    <span data-account-name class="sr-only">{m.common_account_menu()}</span>
    <span data-account-initials aria-hidden="true"></span>
  </button>
</div>

<div
  id="account-menu"
  popover="auto"
  data-account-menu
  data-profile-base={href(PATHS.profile, locale)}
  class="account-menu account-sheet m-0 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-border bg-overlay p-2 text-fg shadow-lg"
>
  <nav aria-label={m.common_account_menu()}>
    <div class="grid gap-0.5 border-b border-border px-3 pt-1 pb-3">
      <span class="text-xs text-fg-muted">{m.auth_menu_signed_in_as()}</span>
      <span data-menu-name class="truncate font-semibold"></span>
      <span data-menu-handle class="truncate text-sm text-fg-muted"></span>
    </div>
    <p data-menu-unverified hidden class="mt-2 grid gap-1 rounded-md bg-warning/10 p-3 text-sm">
      <span class="flex items-start gap-2">
        <Icon icon={MailWarning} size={16} className="mt-0.5 shrink-0 text-warning" />
        {m.auth_menu_unverified()}
      </span>
      <button
        type="button"
        data-menu-resend
        data-label-sent={m.auth_welcome_resent()}
        data-label-failed={m.auth_menu_resend_failed()}
        data-label-verified={m.auth_verify_already()}
        class="justify-self-start text-sm font-semibold text-link underline underline-offset-3 disabled:no-underline disabled:opacity-70"
      >
        {m.auth_welcome_resend()}
      </button>
      <span data-menu-resend-status role="status" class="text-xs text-fg-muted"></span>
    </p>
    <ul class="mt-2 grid gap-0.5">
      <li>
        <a data-menu-profile href={href(PATHS.profile, locale)} class={itemClass}>
          <Icon icon={UserRound} size={18} className="text-fg-muted" />
          {m.shell_nav_profile()}
        </a>
      </li>
      <li>
        <a href={PATHS.dashboard} class={itemClass}>
          <Icon icon={LayoutDashboard} size={18} className="text-fg-muted" />
          {m.shell_nav_dashboard()}
        </a>
      </li>
      <li>
        <a href={PATHS.notifications} class={itemClass}>
          <Icon icon={Bell} size={18} className="text-fg-muted" />
          <span class="flex-1">{m.shell_nav_notifications()}</span>
          <span
            data-menu-unread
            hidden
            class="rounded-full bg-primary px-2 text-2xs font-semibold text-primary-fg tabular-nums"
          >
            <span class="sr-only">{m.auth_menu_unread()}</span>
            <span data-menu-unread-count></span>
          </span>
        </a>
      </li>
      <li>
        <a href={PATHS.following} class={itemClass}>
          <Icon icon={Heart} size={18} className="text-fg-muted" />
          {m.common_action_following()}
        </a>
      </li>
      <li>
        <a href={PATHS.downloads} class={itemClass}>
          <Icon icon={Download} size={18} className="text-fg-muted" />
          {m.me_downloads_title()}
        </a>
      </li>
      <li>
        <a href={PATHS.settings} class={itemClass}>
          <Icon icon={Settings} size={18} className="text-fg-muted" />
          {m.shell_nav_settings()}
        </a>
      </li>
      <li data-menu-moderation hidden>
        <a href={PATHS.moderation} class={itemClass}>
          <Icon icon={ShieldCheck} size={18} className="text-fg-muted" />
          {m.shell_nav_moderation()}
        </a>
      </li>
    </ul>
    <form method="post" action="/logout" class="mt-2 border-t border-border pt-2" data-menu-logout>
      <input type="hidden" name="next" value={next} />
      <input type="hidden" name="locale" value={locale} />
      <button type="submit" class={itemClass}>
        <Icon icon={LogOut} size={18} className="text-fg-muted" />
        {m.shell_nav_logout()}
      </button>
    </form>
  </nav>
</div>

<script>
  import { initAccountMenu } from './account-menu.ts';

  initAccountMenu();
</script>

<style is:global>
  /* Signed-in only controls stay hidden until the account hint says there is a session. */
  [data-signed-in-only] {
    display: none;
  }
  html[data-signed-in] [data-signed-in-only] {
    display: inline-flex;
  }
  html[data-signed-in] [data-account-guest] {
    display: none;
  }

  /* Phones: the menu is a bottom sheet opened by the tab bar. */
  @media (max-width: 47.999rem) {
    html body [data-account-menu].account-menu.account-sheet:popover-open {
      position: fixed;
      inset: auto 0 0 0;
      width: 100%;
      max-width: none;
      border-width: 1px 0 0;
      border-radius: 1rem 1rem 0 0;
      padding: 0.75rem 0.75rem calc(0.75rem + var(--safe-bottom));
    }
    .account-sheet::backdrop {
      background: rgb(0 0 0 / 0.55);
    }
  }
  /* From md it hangs under the bar (offsets in layouts/global.css). */
  @media (min-width: 48rem) {
    html body [data-account-menu].account-menu.account-sheet:popover-open {
      position: fixed;
      inset-block-end: auto;
      inset-inline-start: auto;
    }
  }
</style>
