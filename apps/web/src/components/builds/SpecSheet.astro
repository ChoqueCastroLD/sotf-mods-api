---
/**
 * SPEC SHEET (research/03 §6.6): the technical facts of the blueprint as a monospace `<dl>` on
 * the cyanotype grid — pieces, structures, BuildShare version, GUID (copyable), size class with its
 * scale, uploader, blueprint and original authors, version, file, dates and downloads. It is the
 * citable answer of the page (GEO), so every value is plain text; unknown facts say so.
 */

import { BUILD_SIZE_CLASSES } from '@sotf/contracts/manifest';
import { profilePath } from '@sotf/contracts/seo';
import { formatBytes, formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Copy } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { BuildSpec, ModDetailDTO } from './data.ts';
import { sizeRangeLabel } from './i18n.ts';

interface Props {
  build: ModDetailDTO;
  spec: BuildSpec;
}

const { build, spec } = Astro.props;
const locale = Astro.locals.locale;
const latest = build.latestVersion;
const unknown = m.builds_spec_unknown();
const shortGuid = spec.guid && spec.guid.length > 12 ? `${spec.guid.slice(0, 8)}…${spec.guid.slice(-4)}` : spec.guid;
const dt = 'readout text-blueprint';
const dd = 'min-w-0 font-mono text-sm text-fg tabular-nums break-words';
const unknownClass = 'min-w-0 font-mono text-sm text-fg-subtle';
---

<section
  aria-labelledby="spec-title"
  class="texture-blueprint relative grid gap-4 rounded-lg border border-blueprint/40 p-4 md:p-5"
  data-spec-sheet
>
  <h2 id="spec-title" class="font-display-caps text-display-xs text-blueprint">{m.builds_spec_title()}</h2>
  <dl class="grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-2.5 sm:grid-cols-[minmax(8rem,auto)_1fr] lg:grid-cols-1 lg:gap-y-1 xl:grid-cols-[minmax(8rem,auto)_1fr] xl:gap-y-2.5">
    <dt class={dt}>{m.builds_spec_pieces()}</dt>
    <dd class={spec.elements === null ? unknownClass : dd}>
      {spec.elements === null ? unknown : formatNumber(locale, spec.elements)}
    </dd>

    {
      spec.structures !== null && (
        <>
          <dt class={dt}>{m.builds_spec_structures()}</dt>
          <dd class={dd}>{formatNumber(locale, spec.structures)}</dd>
        </>
      )
    }

    <dt class={dt}>{m.builds_spec_size()}</dt>
    <dd class={spec.sizeClass ? dd : unknownClass}>
      {
        spec.sizeClass ? (
          <span class="grid gap-1.5">
            <span>
              <strong class="font-semibold">{spec.sizeClass}</strong> · {m.builds_size_name({ size: spec.sizeClass })}
            </span>
            <span class="flex gap-1" role="img" aria-label={`${m.builds_size_scale_label()}: ${sizeRangeLabel(spec.sizeClass, locale)}`}>
              {BUILD_SIZE_CLASSES.map((size) => (
                <span
                  class:list={[
                    'inline-flex h-6 min-w-8 items-center justify-center rounded-xs border px-1 text-2xs',
                    size === spec.sizeClass
                      ? 'border-blueprint bg-blueprint font-semibold text-blueprint-surface'
                      : 'border-blueprint/40 text-blueprint',
                  ]}
                  aria-hidden="true"
                >
                  {size}
                </span>
              ))}
            </span>
            <span class="text-xs text-fg-muted">{sizeRangeLabel(spec.sizeClass, locale)}</span>
          </span>
        ) : (
          unknown
        )
      }
    </dd>

    <dt class={dt}>{m.builds_spec_buildshare()}</dt>
    <dd class={spec.buildShareVersion ? dd : unknownClass}>
      {spec.buildShareVersion ? `v${spec.buildShareVersion}` : unknown}
    </dd>

    <dt class={dt}>{m.builds_spec_guid()}</dt>
    <dd class={spec.guid ? dd : unknownClass}>
      {
        spec.guid ? (
          <span class="flex items-center gap-1.5">
            <code title={spec.guid} data-guid={spec.guid}>
              <span aria-hidden="true">{shortGuid}</span>
              <span class="sr-only">{spec.guid}</span>
            </code>
            <button
              type="button"
              data-copy-text={spec.guid}
              data-copied={m.builds_spec_guid_copied()}
              class="inline-flex size-8 items-center justify-center rounded-sm text-blueprint hover:bg-blueprint/10"
              title={m.builds_spec_copy_guid()}
            >
              <Icon icon={Copy} size={16} label={m.builds_spec_copy_guid()} />
            </button>
          </span>
        ) : (
          unknown
        )
      }
    </dd>

    <dt class={dt}>{m.builds_spec_uploader()}</dt>
    <dd class={dd}>
      <a href={href(profilePath(build.userHandle), locale)} class="underline-offset-3 hover:underline">
        @{build.userHandle}
      </a>
    </dd>

    {
      spec.blueprintAuthor && (
        <>
          <dt class={dt}>{m.builds_spec_blueprint_author()}</dt>
          <dd class={dd}>{spec.blueprintAuthor}</dd>
        </>
      )
    }

    {
      build.originalAuthor && (
        <>
          <dt class={dt}>{m.builds_spec_original_author()}</dt>
          <dd class={dd}>
            {build.originalAuthor.url ? (
              <a
                href={build.originalAuthor.url}
                rel="nofollow ugc noopener"
                target="_blank"
                class="underline underline-offset-3"
              >
                {build.originalAuthor.name}
                <span class="sr-only">{m.common_new_tab()}</span>
              </a>
            ) : (
              build.originalAuthor.name
            )}
          </dd>
        </>
      )
    }

    {
      latest && (
        <>
          <dt class={dt}>{m.builds_spec_version()}</dt>
          <dd class={dd}>v{latest.version}</dd>
          <dt class={dt}>{m.builds_spec_file()}</dt>
          <dd class={dd}>
            {latest.fileName ?? '.json'}
            {typeof latest.fileSize === 'number' && ` · ${formatBytes(locale, latest.fileSize)}`}
          </dd>
        </>
      )
    }

    <dt class={dt}>{m.builds_spec_updated()}</dt>
    <dd class={dd}><time datetime={build.lastReleasedAt}>{formatDate(locale, build.lastReleasedAt, 'medium')}</time></dd>

    <dt class={dt}>{m.builds_spec_published()}</dt>
    <dd class={dd}>
      <time datetime={build.publishedAt ?? build.createdAt}>
        {formatDate(locale, build.publishedAt ?? build.createdAt, 'medium')}
      </time>
    </dd>

    <dt class={dt}>{m.builds_spec_downloads()}</dt>
    <dd class={dd} data-live="downloads-full">{formatNumber(locale, build.downloads)}</dd>
  </dl>
</section>
