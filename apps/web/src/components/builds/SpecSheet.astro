---
/**
 * Details of a build: a plain definition list with hairlines (pieces, structures, size, BuildShare
 * version, GUID with copy, authors, version, file, dates, downloads). It stays the citable answer
 * of the page, so every value is plain text; unknown facts are simply left out.
 */

import { profilePath } from '@sotf/contracts/seo';
import { formatBytes, formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Copy } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { BuildSpec, ModDetailDTO } from './data.ts';
import { sizeRangeLabel } from './i18n.ts';
import './blueprint.css';

interface Props {
  build: ModDetailDTO;
  spec: BuildSpec;
}

const { build, spec } = Astro.props;
const locale = Astro.locals.locale;
const latest = build.latestVersion;
const shortGuid = spec.guid && spec.guid.length > 12 ? `${spec.guid.slice(0, 8)}…${spec.guid.slice(-4)}` : spec.guid;
const row = 'flex items-baseline justify-between gap-4 border-b border-(--bp-line-soft) py-2 last:border-b-0';
const dt = 'shrink-0 text-fg-muted';
const dd = 'bp-nums min-w-0 text-end tabular-nums [overflow-wrap:anywhere]';
---

<section id="spec" data-fold="closed" aria-labelledby="spec-title" class="bp-plate grid min-w-0 grid-cols-[minmax(0,1fr)] scroll-mt-32 gap-3 p-4 md:scroll-mt-24" data-spec-sheet>
  <h2 id="spec-title" class="text-sm font-semibold text-fg">{m.mod_details_title()}</h2>
  <dl class="-mt-1 flex flex-col text-sm">
    {
      spec.elements !== null && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_pieces()}</dt>
          <dd class={dd}>{formatNumber(locale, spec.elements)}</dd>
        </div>
      )
    }
    {
      spec.structures !== null && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_structures()}</dt>
          <dd class={dd}>{formatNumber(locale, spec.structures)}</dd>
        </div>
      )
    }
    {
      spec.sizeClass && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_size()}</dt>
          <dd class={dd}>
            {m.builds_size_name({ size: spec.sizeClass })}
            <span class="block text-xs text-fg-muted">{sizeRangeLabel(spec.sizeClass, locale)}</span>
          </dd>
        </div>
      )
    }
    {
      spec.buildShareVersion && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_buildshare()}</dt>
          <dd class={`${dd} font-mono text-xs`}>v{spec.buildShareVersion}</dd>
        </div>
      )
    }
    {
      spec.guid && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_guid()}</dt>
          <dd class={`${dd} flex items-center justify-end gap-1.5 font-mono text-xs`}>
            <code title={spec.guid} data-guid={spec.guid}>
              <span aria-hidden="true">{shortGuid}</span>
              <span class="sr-only">{spec.guid}</span>
            </code>
            <button
              type="button"
              data-copy-text={spec.guid}
              data-copied={m.builds_spec_guid_copied()}
              class="inline-flex size-8 items-center justify-center rounded-sm text-fg-muted hover:bg-fg/8 hover:text-fg"
              title={m.builds_spec_copy_guid()}
            >
              <Icon icon={Copy} size={16} label={m.builds_spec_copy_guid()} />
            </button>
          </dd>
        </div>
      )
    }
    <div class={row}>
      <dt class={dt}>{m.builds_spec_uploader()}</dt>
      <dd class={dd}>
        <a href={href(profilePath(build.userHandle), locale)} class="text-link underline-offset-3 hover:underline">
          @{build.userHandle}
        </a>
      </dd>
    </div>
    {
      spec.blueprintAuthor && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_blueprint_author()}</dt>
          <dd class={dd}>{spec.blueprintAuthor}</dd>
        </div>
      )
    }
    {
      build.originalAuthor && (
        <div class={row}>
          <dt class={dt}>{m.builds_spec_original_author()}</dt>
          <dd class={dd}>
            {build.originalAuthor.url ? (
              <a
                href={build.originalAuthor.url}
                rel="nofollow ugc noopener"
                target="_blank"
                class="text-link underline underline-offset-3"
              >
                {build.originalAuthor.name}
                <span class="sr-only">{m.common_new_tab()}</span>
              </a>
            ) : (
              build.originalAuthor.name
            )}
          </dd>
        </div>
      )
    }
    {
      latest && (
        <>
          <div class={row}>
            <dt class={dt}>{m.builds_spec_version()}</dt>
            <dd class={`${dd} font-mono text-xs`}>v{latest.version}</dd>
          </div>
          <div class={row}>
            <dt class={dt}>{m.builds_spec_file()}</dt>
            <dd class={dd}>
              {latest.fileName ?? '.json'}
              {typeof latest.fileSize === 'number' && ` · ${formatBytes(locale, latest.fileSize)}`}
            </dd>
          </div>
        </>
      )
    }
    <div class={row}>
      <dt class={dt}>{m.builds_spec_updated()}</dt>
      <dd class={dd}><time datetime={build.lastReleasedAt}>{formatDate(locale, build.lastReleasedAt, 'medium')}</time></dd>
    </div>
    <div class={row}>
      <dt class={dt}>{m.builds_spec_published()}</dt>
      <dd class={dd}>
        <time datetime={build.publishedAt ?? build.createdAt}>
          {formatDate(locale, build.publishedAt ?? build.createdAt, 'medium')}
        </time>
      </dd>
    </div>
    <div class={row}>
      <dt class={dt}>{m.builds_spec_downloads()}</dt>
      <dd class={dd} data-live="downloads-full">{formatNumber(locale, build.downloads)}</dd>
    </div>
  </dl>
</section>
