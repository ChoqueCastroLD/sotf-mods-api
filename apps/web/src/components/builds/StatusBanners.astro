---
/**
 * Status banners of a build: pending approval, unlisted, archived (with a link to the successor).
 * Each banner pairs an icon with text (status is never colour alone). Compatibility banners are
 * gone with the compatibility reports.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Archive, EyeOff, Hourglass } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import type { ModDetailDTO } from './data.ts';

interface Props {
  build: ModDetailDTO;
}

const { build } = Astro.props;
const locale = Astro.locals.locale;

type Tone = 'info' | 'warning';
interface Item {
  id: string;
  tone: Tone;
  icon: typeof Archive;
  title: string;
  text: string;
  action?: { label: string; href: string };
}

const items: Item[] = [];
for (const banner of build.banners) {
  switch (banner) {
    case 'pending_review':
      items.push({
        id: banner,
        tone: 'warning',
        icon: Hourglass,
        title: m.builds_banner_pending_title(),
        text: m.builds_banner_pending_text(),
      });
      break;
    case 'unlisted':
      items.push({
        id: banner,
        tone: 'info',
        icon: EyeOff,
        title: m.builds_banner_unlisted_title(),
        text: m.builds_banner_unlisted_text(),
      });
      break;
    case 'archived':
      items.push({
        id: banner,
        tone: 'warning',
        icon: Archive,
        title: m.builds_banner_archived_title(),
        text: m.builds_banner_archived_text(),
        ...(build.successor
          ? {
              action: {
                label: m.builds_banner_archived_successor({ name: build.successor.name }),
                href: href(build.successor.canonicalPath, locale),
              },
            }
          : {}),
      });
      break;
    default:
      break;
  }
}

const toneClasses: Record<Tone, { box: string; icon: string }> = {
  info: { box: 'border-border bg-surface', icon: 'text-fg-muted' },
  warning: { box: 'border-warning/40 bg-warning-soft', icon: 'text-warning' },
};
---

{
  items.length > 0 && (
    <div class="grid gap-2" data-build-banners>
      {items.map((item) => (
        <div
          role="status"
          data-banner={item.id}
          class:list={['flex items-start gap-3 rounded-md border px-3 py-2.5 text-sm text-fg', toneClasses[item.tone].box]}
        >
          <Icon icon={item.icon} size={18} className={`mt-0.5 shrink-0 ${toneClasses[item.tone].icon}`} />
          <p class="min-w-0 flex-1">
            <strong class="me-1.5 font-semibold">{item.title}</strong>
            <span class="text-fg-muted">{item.text}</span>
            {item.action && (
              <a href={item.action.href} class="ms-2 inline-flex font-medium text-link underline underline-offset-3">
                {item.action.label}
              </a>
            )}
          </p>
        </div>
      ))}
    </div>
  )
}
