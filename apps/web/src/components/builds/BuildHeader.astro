---
/**
 * Header of a build, built like the mod header: title, author with the Trusted tag, a plain stats
 * row (downloads, followers, rating, pieces, size) and the actions: Download (latest version, the
 * other versions in its menu), then a small group with Follow, Copy link, How to import and Report.
 *
 * - Download: a real link to the counted download route (302 to R2); `rel="nofollow"`.
 * - Follow: a toggle button enhanced by `build-page.ts` (optimistic with undo); it sits in a GET
 *   form to the sign-in page (`?next=`), so guests and no-JS visitors sign in first.
 */
import { profilePath } from '@sotf/contracts/seo';
import { formatCompactNumber, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Avatar } from '@sotf/ui/avatar';
import { DownloadSplitButton, displayName, downloadOptionOf, StarRating, TrustedMark } from '@sotf/ui/domain';
import { Icon } from '@sotf/ui/icons';
import { Flag, Heart, Link2, ListOrdered } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import { loadModTranslation } from '../../lib/mod-translation.ts';
import { isShortVersion } from '../mod/format.ts';
import TranslatedText from '../mod/TranslatedText.astro';
import type { BuildSpec, ModDetailDTO, VersionDTO } from './data.ts';
import { blueprintAuthorDiffers } from './data.ts';
import { loginHrefFor, sizeRangeLabel } from './i18n.ts';

interface Props {
  build: ModDetailDTO;
  spec: BuildSpec;
  /** Every version (newest first), or null when the list was unavailable. */
  versions: VersionDTO[] | null;
}

const { build, spec, versions } = Astro.props;
const locale = Astro.locals.locale;
const loginHref = loginHrefFor(href('/login', locale), href(Astro.locals.pagePath, locale));
const latest = build.latestVersion;
const others = (versions ?? []).filter((version) => version.id !== latest?.id && version.status === 'active');
const authorName = build.userDisplayName || build.userHandle;
const showBlueprintAuthor = blueprintAuthorDiffers(spec, build);
const summary = build.reviewsSummary;
const rating = summary.showStars && summary.average !== null ? summary.average : null;
const shownName = displayName(build);
const translation = locale !== 'en' && build.shortDescription ? await loadModTranslation(build, locale) : null;
const stat = 'bp-nums inline-flex items-center gap-1.5 tabular-nums';
const LINK =
  'inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-fg-muted hover:bg-fg/6 hover:text-fg aria-pressed:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus';
---

<header class="grid grid-cols-1 content-start gap-4" data-build-header>
  <div class="grid grid-cols-1 gap-2">
    <h1
      id="build-title"
      class="text-balance break-words text-3xl font-bold leading-tight text-fg [hyphens:auto] md:text-4xl"
      lang={shownName !== build.name ? locale : undefined}
    >
      {shownName}
      {latest && isShortVersion(latest.version) && (
        <span class="ms-2 whitespace-nowrap align-baseline font-mono text-base font-normal text-fg-muted">v{latest.version}</span>
      )}
    </h1>
    {
      shownName !== build.name && (
        <p class="flex items-baseline gap-2 text-sm text-fg-subtle" data-original-name>
          <span class="shrink-0">{m.entity_original_label()}</span>
          <span class="min-w-0 break-words text-base text-fg-muted" lang={build.contentLang ?? 'en'} translate="no">{build.name}</span>
        </p>
      )
    }
    {
      build.shortDescription && translation?.shortDescription ? (
        <TranslatedText
          translated={translation.shortDescription}
          original={build.shortDescription}
          locale={locale}
          sourceLang={build.contentLang}
          source={translation.sources?.shortDescription ?? 'machine'}
          class="text-base text-pretty text-fg-muted md:text-lg"
        />
      ) : (
        build.shortDescription && <p class="text-base text-pretty text-fg-muted md:text-lg">{build.shortDescription}</p>
      )
    }
  </div>

  <p class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-border pt-4 text-sm text-fg-muted">
    <a
      href={href(profilePath(build.userHandle), locale)}
      class="inline-flex min-h-6 items-center gap-2 font-semibold text-fg underline-offset-3 hover:underline"
    >
      <Avatar name={authorName} id={build.userId} src={build.userAvatarUrl} size={24} />
      <span>{authorName}</span>
    </a>
    {build.verifiedCreator && <TrustedMark />}
  </p>
  {
    showBlueprintAuthor && spec.blueprintAuthor && (
      <p class="text-sm text-fg-muted" data-blueprint-author>
        {m.builds_blueprint_author({ author: spec.blueprintAuthor })}
      </p>
    )
  }
  {
    build.originalAuthor && (
      <p class="text-sm text-fg-muted" data-original-author>
        {build.originalAuthor.url ? (
          <a
            href={build.originalAuthor.url}
            rel="nofollow ugc noopener"
            target="_blank"
            class="text-link underline underline-offset-3"
          >
            {m.builds_original_author({ author: build.originalAuthor.name })}
            <span class="sr-only">{m.common_new_tab()}</span>
          </a>
        ) : (
          m.builds_original_author({ author: build.originalAuthor.name })
        )}
      </p>
    )
  }

  <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-fg-muted" aria-label={m.builds_stats_label()}>
    <li class={stat} title={formatNumber(locale, build.downloads)} data-live-downloads>
      <span data-live="downloads-stat" class="text-fg">{m.common_downloads_compact({ count: build.downloads, display: formatCompactNumber(locale, build.downloads) })}</span>
    </li>
    <li class={stat}>
      <span data-follow-count data-followers={build.followers} class="text-fg">{m.common_followers_count({ count: build.followers })}</span>
    </li>
    {
      rating !== null && (
        <li class={stat}>
          <a href="#reviews" class="inline-flex items-center gap-1.5 underline-offset-3 hover:text-fg hover:underline">
            <StarRating value={rating} size={14} />
            {m.builds_stat_rating({
              rating: formatNumber(locale, rating, { minimumFractionDigits: 1, maximumFractionDigits: 1 }),
              count: summary.count,
            })}
          </a>
        </li>
      )
    }
    {
      spec.elements !== null && (
        <li class={stat}>
          {m.builds_stat_pieces({ count: spec.elements, display: formatNumber(locale, spec.elements) })}
        </li>
      )
    }
    {
      spec.sizeClass && (
        <li
          class={stat}
          title={`${m.builds_size_name({ size: spec.sizeClass })} · ${sizeRangeLabel(spec.sizeClass, locale)}`}
        >
          {m.builds_size_badge({ size: spec.sizeClass })}
          <span class="sr-only">
            ({m.builds_size_name({ size: spec.sizeClass })}, {sizeRangeLabel(spec.sizeClass, locale)})
          </span>
        </li>
      )
    }
  </ul>

  <div class="grid gap-3" id="download">
    {
      latest && latest.status === 'active' ? (
        <div class="max-md:hidden" data-download-area>
          <DownloadSplitButton
            primary={downloadOptionOf(latest)}
            others={others.map(downloadOptionOf)}
            size="md"
            className="items-start"
          />
        </div>
      ) : (
        <p class="text-sm text-fg-muted max-md:hidden">{m.builds_action_download_unavailable()}</p>
      )
    }

    <div class="-ms-2.5 flex flex-wrap items-center gap-1 max-md:hidden">
      <form method="get" action={href('/login', locale)} class="contents" data-follow-form>
        <input type="hidden" name="next" value={href(Astro.locals.pagePath, locale)} />
        <button
          type="submit"
          aria-pressed="false"
          data-follow
          data-mod-id={build.id}
          data-login={loginHref}
          title={m.builds_follow_hint()}
          class={LINK}
        >
          <Icon icon={Heart} size={16} className="[[aria-pressed=true]_&]:fill-current" />
          <span data-follow-label>{m.common_action_follow()}</span>
        </button>
      </form>
      <button type="button" data-copy-link data-copied={m.builds_link_copied()} class={LINK}>
        <Icon icon={Link2} size={16} />
        {m.common_action_copy_link()}
      </button>
      <a href="#import" class={LINK}>
        <Icon icon={ListOrdered} size={16} />
        {m.builds_action_how_to_import()}
      </a>
      <button type="button" hidden data-js-only data-dialog-open="report-dialog" class={LINK}>
        <Icon icon={Flag} size={16} />
        {m.mod_action_report()}
      </button>
    </div>
  </div>
</header>
