---
/**
 * «More actions» bottom sheet of the build page on phones (opened from the sticky bar): how to
 * import, versions, share, copy link and report, as big tappable rows.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { ChevronRight, Flag, History, Link2, ListOrdered, Share2 } from 'lucide-react';
import ModDialog from '../mod/ModDialog.astro';

const ROW =
  'flex min-h-14 w-full items-center gap-3 rounded-md px-2 py-2 text-start text-base font-medium text-fg active:bg-fg/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus';
const TILE = 'flex size-6 shrink-0 items-center justify-center text-fg-muted';
const chevron = 'text-fg-subtle rtl:rotate-180';
---

<ModDialog id="more-sheet" title={m.mod_action_more()} bodyClass="!gap-0 !px-3 !py-2">
  <ul class="grid">
    <li>
      <a href="#import" data-sheet-close-on-click class={ROW}>
        <span class={TILE}><Icon icon={ListOrdered} size={20} /></span>
        <span class="min-w-0 flex-1">{m.builds_action_how_to_import()}</span>
        <Icon icon={ChevronRight} size={18} className={chevron} />
      </a>
    </li>
    <li>
      <a href="#versions" data-sheet-close-on-click class={ROW}>
        <span class={TILE}><Icon icon={History} size={20} /></span>
        <span class="min-w-0 flex-1">{m.builds_versions_title()}</span>
        <Icon icon={ChevronRight} size={18} className={chevron} />
      </a>
    </li>
    <li>
      <button type="button" hidden data-js-only data-share-action class={ROW}>
        <span class={TILE}><Icon icon={Share2} size={20} /></span>
        <span class="min-w-0 flex-1">{m.common_action_share()}</span>
      </button>
    </li>
    <li>
      <button type="button" data-copy-link data-copied={m.builds_link_copied()} class={ROW}>
        <span class={TILE}><Icon icon={Link2} size={20} /></span>
        <span class="min-w-0 flex-1">{m.common_action_copy_link()}</span>
      </button>
    </li>
    <li class="mt-1 border-t border-border pt-1">
      <button type="button" hidden data-js-only data-dialog-open="report-dialog" class={ROW}>
        <span class={TILE}><Icon icon={Flag} size={20} /></span>
        <span class="min-w-0 flex-1">{m.mod_action_report()}</span>
      </button>
    </li>
  </ul>
</ModDialog>
