---
/**
 * Sticky action bar of the build page on phones: Download (primary, with the version) · Follow ·
 * More. It sits above the site's tab bar and follows it down when the tab bar hides while
 * scrolling. Hidden from `md` up (the header actions are visible there). Follow is a link to the
 * sign-in page for guests; `build-page.ts` turns it into a toggle for signed-in visitors.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Download, Ellipsis, Heart } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import { isShortVersion } from '../mod/format.ts';
import type { ModDetailDTO } from './data.ts';
import { loginHrefFor } from './i18n.ts';

interface Props {
  build: ModDetailDTO;
}

const { build } = Astro.props;
const locale = Astro.locals.locale;
const latest = build.latestVersion;
const downloadable = latest !== null && latest.status === 'active';
const loginHref = loginHrefFor(href('/login', locale), href(Astro.locals.pagePath, locale));
const SIDE =
  'inline-flex size-12 shrink-0 items-center justify-center rounded-md border border-border-strong bg-raised text-fg active:bg-fg/10 aria-pressed:border-primary aria-pressed:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus';
---

<div aria-hidden="true" class="h-20 md:hidden"></div>
<div
  data-mobile-download-bar
  class="fixed inset-x-0 bottom-[calc(4rem+env(safe-area-inset-bottom))] z-(--z-sticky) border-t border-border bg-bg/95 px-3 py-2 transition-[bottom] duration-(--dur-base) supports-[backdrop-filter]:bg-bg/80 supports-[backdrop-filter]:backdrop-blur-md md:hidden [html[data-scroll-dir=down]_&]:bottom-0 [html[data-scroll-dir=down]_&]:pb-[calc(0.5rem+env(safe-area-inset-bottom))] motion-reduce:transition-none"
>
  <div class="mx-auto flex max-w-lg items-center gap-2">
    {
      downloadable && latest ? (
        <a
          href={latest.downloadPath}
          rel="nofollow"
          data-download={latest.version}
          class="inline-flex h-12 min-w-0 flex-1 items-center justify-center gap-2 rounded-md bg-primary px-4 font-medium text-primary-fg hover:bg-primary-hover active:bg-primary-hover"
        >
          <Icon icon={Download} size={18} />
          <span class="truncate">{isShortVersion(latest.version) ? m.common_download_version_short({ version: latest.version }) : m.common_action_download()}</span>
        </a>
      ) : (
        <p class="inline-flex h-12 min-w-0 flex-1 items-center justify-center rounded-md border border-border px-3 text-center text-sm text-fg-muted">
          <span class="truncate">{m.builds_action_download_unavailable()}</span>
        </p>
      )
    }
    <!-- biome-ignore lint/a11y/useAriaPropsSupportedByRole: aria-pressed is the toggle state set by build-page.ts (guests: the link to sign-in) -->
    <a href={loginHref} aria-pressed="false" data-follow data-mod-id={build.id} data-login={loginHref} class={SIDE}>
      <Icon icon={Heart} size={20} className="[[aria-pressed=true]_&]:fill-current" />
      <span class="sr-only" data-follow-label>{m.common_action_follow()}</span>
    </a>
    <button type="button" hidden data-js-only data-dialog-open="more-sheet" class={SIDE} aria-haspopup="dialog">
      <Icon icon={Ellipsis} size={22} />
      <span class="sr-only">{m.mod_action_more()}</span>
    </button>
  </div>
</div>
