---
/**
 * Fixed download bar on phones: «Download v1.2» + «How to import», above the site's tab bar and
 * following it down when the tab bar hides while scrolling (`html[data-scroll-dir=down]`),
 * respecting `safe-area-inset-bottom`. A spacer keeps the footer reachable. Hidden from `md` up
 * (the header button is visible there).
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Download, ListOrdered } from 'lucide-react';
import type { ModDetailDTO } from './data.ts';

interface Props {
  build: ModDetailDTO;
}

const { build } = Astro.props;
const latest = build.latestVersion;
const downloadable = latest !== null && latest.status === 'active';
---

{
  downloadable && latest && (
    <>
      <div aria-hidden="true" class="h-20 md:hidden" />
      <div
        data-mobile-download-bar
        class="fixed inset-x-0 bottom-[calc(4rem+env(safe-area-inset-bottom))] z-(--z-sticky) border-t border-blueprint/40 bg-bg/95 px-3 py-2 transition-[bottom] duration-(--dur-base) supports-[backdrop-filter]:bg-bg/80 supports-[backdrop-filter]:backdrop-blur-md md:hidden [html[data-scroll-dir=down]_&]:bottom-0 [html[data-scroll-dir=down]_&]:pb-[calc(0.5rem+env(safe-area-inset-bottom))] motion-reduce:transition-none"
      >
        <div class="mx-auto flex max-w-lg items-center gap-2">
          <a
            href={latest.downloadPath}
            rel="nofollow"
            data-download={latest.version}
            class="inline-flex h-12 min-w-0 flex-1 items-center justify-center gap-2 rounded-md bg-primary px-4 font-semibold text-primary-fg shadow-glow hover:bg-primary-hover"
          >
            <Icon icon={Download} size={18} />
            <span class="truncate">{m.common_download_version_short({ version: latest.version })}</span>
          </a>
          <a
            href="#import"
            class="inline-flex size-12 shrink-0 items-center justify-center rounded-md border border-blueprint/60 bg-raised text-blueprint"
          >
            <Icon icon={ListOrdered} size={20} />
            <span class="sr-only">{m.builds_action_how_to_import()}</span>
          </a>
        </div>
      </div>
    </>
  )
}
