---
/**
 * Profile header (T0-15), like the old profile: avatar, name with the Trusted mark and the staff
 * role, @handle and member since, bio, links, one row of stats and the actions (follow, share,
 * and «Edit profile» revealed by `profile-page.ts` on your own profile).
 */
import { formatCompactNumber, formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { Avatar } from '@sotf/ui/avatar';
import { buttonClasses } from '@sotf/ui/button';
import { ProseLocator } from '@sotf/ui/domain';
import { Icon, type LucideIcon } from '@sotf/ui/icons';
import {
  CodeXml,
  Coffee,
  Globe,
  HeartHandshake,
  Link as LinkIcon,
  MessageCircle,
  Pencil,
  Share2,
  SquarePlay,
  Tv,
  UserCheck,
  UserPlus,
} from 'lucide-react';
import Picture from '../layout/Picture.astro';
import { markdownLabels } from '../mod/i18n.ts';
import type { UserPublicDTO } from './data.ts';
import { linkLabel } from './i18n.ts';
import ProfileToast from './ProfileToast.astro';

interface Props {
  user: UserPublicDTO;
  /** Localised sign-in page and the `next` it returns to (guest fallback of «Follow»). */
  loginAction: string;
  next: string;
  /** Localised `/settings/profile`. */
  editHref: string;
}

const { user, loginAction, next, editHref } = Astro.props;
const locale = Astro.locals.locale;
const name = user.displayName || user.handle;
const stats = user.stats;
const role = user.role === 'admin' ? m.profile_role_admin() : user.role === 'moderator' ? m.profile_role_moderator() : null;
const trusted = user.verifiedCreator;

const LINK_ICONS: Record<string, LucideIcon> = {
  website: Globe,
  github: CodeXml,
  youtube: SquarePlay,
  twitch: Tv,
  discord: MessageCircle,
  kofi: Coffee,
  patreon: HeartHandshake,
};

const statItems: Array<{ label: string; value: string; title: string; followers?: number }> = [
  {
    label: m.profile_stat_published_label(),
    value: formatNumber(locale, stats.modsCount + stats.buildsCount),
    title: m.profile_stat_mods_title({ mods: stats.modsCount, builds: stats.buildsCount }),
  },
  {
    label: m.profile_stat_downloads_label(),
    value: formatCompactNumber(locale, stats.downloadsTotal),
    title: formatNumber(locale, stats.downloadsTotal),
  },
  {
    label: m.profile_stat_followers_label(),
    value: formatCompactNumber(locale, stats.followersCount),
    title: formatNumber(locale, stats.followersCount),
    followers: stats.followersCount,
  },
  {
    label: m.profile_stat_reviews_label(),
    value: formatCompactNumber(locale, stats.reviewsCount),
    title: formatNumber(locale, stats.reviewsCount),
  },
];
if (stats.ratingAvg !== null) {
  const rating = formatNumber(locale, stats.ratingAvg, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  statItems.push({ label: m.profile_stat_rating_label(), value: rating, title: m.profile_stat_rating_title({ rating }) });
}
---

<header class="grid gap-6">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
    <div class="flex min-w-0 items-center gap-4 md:gap-5">
      {
        user.avatar ? (
          <Picture
            image={user.avatar}
            sizes="(min-width: 48rem) 96px, 72px"
            alt={m.profile_avatar_alt({ name })}
            priority
            fallbackWidth={96}
            fallbackHeight={96}
            class="block size-18 shrink-0 rounded-full bg-raised object-cover md:size-24"
          />
        ) : (
          <Avatar name={name} id={user.id} size={96} className="size-18 shrink-0 md:size-24" />
        )
      }
      <div class="grid min-w-0 gap-1">
        <div class="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-1">
          <h1 id="profile-name" class="text-2xl font-bold break-words text-fg md:text-3xl">{name}</h1>
          {
            trusted && (
              <span class="inline-flex items-center rounded-full bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-fg">
                {m.profile_trusted()}
              </span>
            )
          }
          {
            role && (
              <span class="inline-flex items-center rounded-full border border-border-strong px-2.5 py-0.5 text-xs font-semibold text-fg-muted">
                {role}
              </span>
            )
          }
        </div>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm text-fg-muted">
          <span>@{user.handle}</span>
          <time datetime={user.createdAt}>{m.profile_member_since({ date: formatDate(locale, user.createdAt, 'long') })}</time>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2" data-profile-actions>
      <form method="get" action={loginAction} class="contents" data-profile-follow-form>
        <input type="hidden" name="next" value={next} />
        <button
          type="submit"
          aria-pressed="false"
          data-follow-user={user.handle}
          data-follow-user-id={user.id}
          data-followers={stats.followersCount}
          class={buttonClasses({ variant: 'primary', size: 'md', className: 'group/follow max-md:h-11 max-md:px-5' })}
        >
          <Icon icon={UserPlus} size={18} className="group-aria-pressed/follow:hidden" />
          <Icon icon={UserCheck} size={18} className="hidden group-aria-pressed/follow:inline" />
          <span data-follow-label>{m.common_action_follow()}</span>
          <span class="sr-only">{name}</span>
        </button>
      </form>
      <a
        href={editHref}
        hidden
        data-profile-edit
        class={buttonClasses({ variant: 'secondary', size: 'md', className: 'max-md:h-11' })}
      >
        <Icon icon={Pencil} size={18} />
        {m.profile_action_edit()}
      </a>
      <button
        type="button"
        data-profile-share
        data-share-title={name}
        data-copied={m.profile_link_copied()}
        aria-label={m.common_action_share()}
        class={buttonClasses({ variant: 'secondary', size: 'md', className: 'max-md:size-11 max-md:px-0' })}
      >
        <Icon icon={Share2} size={18} />
        <span class="max-md:sr-only">{m.common_action_share()}</span>
      </button>
    </div>
  </div>

  {
    user.bioHtml && (
      <ProseLocator html={localizeHtml(user.bioHtml, markdownLabels())} className="max-w-(--container-prose) text-pretty" />
    )
  }

  {
    user.links.length > 0 && (
      <ul class="flex flex-wrap gap-2" aria-label={m.profile_links_label()}>
        {user.links.map((link) => (
          <li>
            <a
              href={link.url}
              rel="me ugc nofollow noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border px-3 text-sm text-fg hover:border-border-strong hover:bg-fg/4 md:min-h-9"
            >
              <Icon icon={LINK_ICONS[link.kind] ?? LinkIcon} size={16} className="text-fg-muted" />
              {linkLabel(link)}
              <span class="sr-only">{m.common_new_tab()}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <dl
    class="grid grid-cols-2 gap-x-6 gap-y-5 border-y border-border py-5 sm:grid-cols-3 md:flex md:flex-wrap md:gap-x-12"
    aria-label={m.profile_stats_label()}
  >
    {
      statItems.map((item) => (
        <div class="flex min-w-0 flex-col-reverse gap-0.5" title={item.title}>
          <dt class="text-sm text-fg-muted">{item.label}</dt>
          <dd
            class="text-2xl font-bold tabular-nums text-fg"
            data-follow-count={item.followers === undefined ? undefined : ''}
            data-followers={item.followers}
          >
            {item.value}
          </dd>
        </div>
      ))
    }
  </dl>

  <ProfileToast />
</header>
