---
/**
 * Empty and error states of a profile tab: one title, one line and one link. The error state says
 * what happened and offers «Try again» (the same URL) with the request reference.
 */

import { href } from '../../lib/i18n.ts';
import PageState from '../state/PageState.astro';

interface Props {
  kind: 'empty' | 'error';
  title: string;
  description?: string;
  action?: { href: string; label: string } | null;
  /** Error: URL of the retry link (default: the current page). */
  retryHref?: string;
}

const { kind, title, description, action, retryHref } = Astro.props;
const retry = retryHref ?? href(Astro.locals.pagePath, Astro.locals.locale);
---

<PageState
  kind={kind}
  title={title}
  text={description}
  action={action ?? null}
  retryHref={retry}
  reference={Astro.locals.requestId}
  headingLevel={3}
/>
