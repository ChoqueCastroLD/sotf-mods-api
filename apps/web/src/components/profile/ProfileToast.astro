---
/**
 * Polite status line of the profile and creators pages (`role="status"`): follow/unfollow with
 * «Undo», «Link copied» and errors. Driven by `profile-page.ts`; invisible and inert until open.
 */
import { m } from '@sotf/i18n/messages';
---

<div
  data-profile-toast
  role="status"
  aria-live="polite"
  class="group/toast pointer-events-none fixed inset-x-4 bottom-[calc(5.5rem+env(safe-area-inset-bottom))] z-(--z-overlay) flex justify-center md:bottom-8"
>
  <div
    class="pointer-events-auto invisible flex max-w-md items-center gap-3 rounded-lg border border-border bg-overlay px-4 py-3 text-sm text-fg opacity-0 shadow-lg transition-opacity duration-(--dur-fast) group-data-open/toast:visible group-data-open/toast:opacity-100 motion-reduce:transition-none"
  >
    <span data-profile-toast-text></span>
    <button
      type="button"
      data-profile-undo
      hidden
      class="inline-flex min-h-11 items-center font-semibold text-link underline underline-offset-3 md:min-h-8"
    >
      {m.common_action_undo()}
    </button>
  </div>
</div>
