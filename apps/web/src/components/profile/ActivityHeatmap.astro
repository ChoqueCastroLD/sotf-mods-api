---
/**
 * Activity tab (research/03 §6.4 «contribution contour», T0-15): a 12-month heatmap in the Flare
 * sequential scale (week columns, Monday first), its legend, the totals, a short timeline of the
 * latest active days and the same data as a table (`<details>`, PLAN §1.2 «tabla alternativa»).
 *
 * Server-rendered SVG: no chart library, no JavaScript. On narrow screens the grid scrolls
 * horizontally; `profile-page.ts` starts it at the most recent weeks.
 */
import { formatDate, formatList, formatNumber, type Locale, toIntlLocale } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { type HeatCell, heatmapModel } from './activity.ts';
import type { UserActivity } from './data.ts';

interface Props {
  activity: UserActivity;
  name: string;
}

const { activity, name } = Astro.props;
const locale: Locale = Astro.locals.locale;
const model = heatmapModel(activity.from, activity.to, activity.days);
const intl = toIntlLocale(locale);

const CELL = 12;
const GAP = 3;
const STEP = CELL + GAP;
const LEFT = 30;
const TOP = 18;
const width = LEFT + model.weeks * STEP;
const height = TOP + 7 * STEP;

const LEVEL_CLASS: Record<HeatCell['level'], string> = {
  0: 'fill-fg/8',
  1: 'fill-[light-dark(var(--color-flare-100),var(--color-flare-900))]',
  2: 'fill-[light-dark(var(--color-flare-200),var(--color-flare-700))]',
  3: 'fill-[light-dark(var(--color-flare-400),var(--color-flare-500))]',
  4: 'fill-[light-dark(var(--color-flare-600),var(--color-flare-300))]',
};
const LEVELS = [0, 1, 2, 3, 4] as const;

const monthShort = new Intl.DateTimeFormat(intl, { month: 'short', timeZone: 'UTC' });
const monthLong = new Intl.DateTimeFormat(intl, { month: 'long', year: 'numeric', timeZone: 'UTC' });
const weekdayShort = new Intl.DateTimeFormat(intl, { weekday: 'short', timeZone: 'UTC' });
// 2024-01-01 was a Monday: rows 0, 2 and 4 are Monday, Wednesday and Friday.
const weekdayLabels = [0, 2, 4].map((row) => ({
  row,
  label: weekdayShort.format(new Date(Date.UTC(2024, 0, 1 + row))),
}));

/** «1 release, 3 comments and 2 field reports» (only the kinds of that day). */
function detailText(day: { releases: number; comments: number; reviews: number; reports: number }): string {
  const parts: string[] = [];
  if (day.releases > 0) parts.push(m.profile_activity_count_releases({ count: day.releases }));
  if (day.comments > 0) parts.push(m.profile_activity_count_comments({ count: day.comments }));
  if (day.reviews > 0) parts.push(m.profile_activity_count_reviews({ count: day.reviews }));
  if (day.reports > 0) parts.push(m.profile_activity_count_reports({ count: day.reports }));
  return formatList(locale, parts);
}

function cellTitle(cell: HeatCell): string {
  const date = formatDate(locale, cell.day, 'medium');
  const detail = cell.detail;
  if (!detail) return date;
  return m.profile_activity_cell({ date, detail: detailText(detail) });
}

const summary = m.profile_activity_summary({
  count: model.totals.total,
  days: model.totals.activeDays,
  from: formatDate(locale, activity.from, 'medium'),
  to: formatDate(locale, activity.to, 'medium'),
});
const recent = model.activeDays.slice(0, 8);
const thClass = 'px-3 py-2 text-start font-medium text-fg-muted';
const tdClass = 'px-3 py-2 text-end tabular-nums';
---

<section aria-labelledby="activity-title" class="grid gap-6">
  <div class="grid gap-1">
    <h2 id="activity-title" class="font-display-caps text-display-xs text-fg">{m.profile_activity_title()}</h2>
    <p class="text-sm text-fg-muted">{summary}</p>
  </div>

  <figure class="grid gap-3">
    <!-- biome-ignore lint/a11y/noNoninteractiveTabindex: a horizontally scrollable region must be reachable by keyboard (WCAG 2.1.1) -->
    <section tabindex="0"
      class="overflow-x-auto overscroll-x-contain rounded-lg border border-border bg-surface p-3 focus-visible:outline-2 focus-visible:outline-focus md:p-4"
      aria-label={m.profile_activity_heatmap_label({ name })}
      data-heatmap-scroll
    >
      <svg
        viewBox={`0 0 ${width} ${height}`}
        width={width}
        height={height}
        class="block max-w-none"
        role="img"
        aria-label={summary}
      >
        {
          model.months.map((month) => (
            <text
              x={LEFT + month.week * STEP}
              y={11}
              class="fill-fg-muted font-mono text-[10px]"
            >
              {monthShort.format(new Date(`${month.month}T00:00:00Z`))}
            </text>
          ))
        }
        {
          weekdayLabels.map((weekday) => (
            <text
              x={0}
              y={TOP + weekday.row * STEP + CELL - 2}
              class="fill-fg-subtle font-mono text-[10px]"
            >
              {weekday.label}
            </text>
          ))
        }
        {
          model.cells
            .filter((cell) => !cell.outside)
            .map((cell) => (
              <rect
                x={LEFT + cell.week * STEP}
                y={TOP + cell.weekday * STEP}
                width={CELL}
                height={CELL}
                rx={2.5}
                class={LEVEL_CLASS[cell.level]}
                data-level={cell.level}
              >
                {cell.level > 0 && <title>{cellTitle(cell)}</title>}
              </rect>
            ))
        }
      </svg>
    </section>
    <figcaption class="flex flex-wrap items-center justify-between gap-3 text-xs text-fg-muted">
      <span>{m.profile_activity_caption()}</span>
      <span class="inline-flex items-center gap-1.5" aria-hidden="true">
        {m.profile_activity_legend_less()}
        {
          LEVELS.map((level) => (
            <svg viewBox="0 0 12 12" width="12" height="12" class="block" aria-hidden="true">
              <rect width="12" height="12" rx="2.5" class={LEVEL_CLASS[level]} />
            </svg>
          ))
        }
        {m.profile_activity_legend_more()}
      </span>
    </figcaption>
  </figure>

  <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      [
        { label: m.profile_activity_kind_releases(), value: model.totals.releases },
        { label: m.profile_activity_kind_comments(), value: model.totals.comments },
        { label: m.profile_activity_kind_reviews(), value: model.totals.reviews },
        { label: m.profile_activity_kind_reports(), value: model.totals.reports },
      ].map((item) => (
        <div class="flex flex-col gap-0.5 rounded-md border border-border bg-surface px-3 py-2">
          <dt class="readout text-fg-muted">{item.label}</dt>
          <dd class="font-display-caps text-xl tabular-nums text-fg">{formatNumber(locale, item.value)}</dd>
        </div>
      ))
    }
  </dl>

  {
    recent.length > 0 && (
      <section aria-labelledby="activity-recent-title" class="grid gap-3">
        <h3 id="activity-recent-title" class="readout text-fg-muted">
          {m.profile_activity_recent_title()}
        </h3>
        <ol class="grid gap-2 border-s border-border ps-4">
          {recent.map((day) => (
            <li class="relative grid gap-0.5 before:absolute before:-start-[1.3rem] before:top-1.5 before:size-2 before:rounded-full before:bg-primary">
              <time datetime={day.day} class="text-sm font-medium text-fg">
                {formatDate(locale, day.day, 'long')}
              </time>
              <span class="text-sm text-fg-muted">
                {detailText(day)}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <details class="group rounded-lg border border-border bg-surface">
    <summary
      class="flex min-h-11 cursor-pointer items-center px-4 text-sm font-semibold text-fg marker:content-none focus-visible:outline-2 focus-visible:outline-focus"
    >
      {m.profile_activity_table_toggle()}
    </summary>
    <div class="overflow-x-auto px-1 pb-3">
      <table class="w-full min-w-lg text-sm">
        <caption class="sr-only">{m.profile_activity_table_caption({ name })}</caption>
        <thead>
          <tr class="border-b border-border">
            <th scope="col" class={thClass}>{m.profile_activity_table_month()}</th>
            <th scope="col" class={`${thClass} text-end`}>{m.profile_activity_kind_releases()}</th>
            <th scope="col" class={`${thClass} text-end`}>{m.profile_activity_kind_comments()}</th>
            <th scope="col" class={`${thClass} text-end`}>{m.profile_activity_kind_reviews()}</th>
            <th scope="col" class={`${thClass} text-end`}>{m.profile_activity_kind_reports()}</th>
            <th scope="col" class={`${thClass} text-end`}>{m.profile_activity_table_active_days()}</th>
            <th scope="col" class={`${thClass} text-end`}>{m.profile_activity_table_total()}</th>
          </tr>
        </thead>
        <tbody>
          {
            model.monthTotals.map((month) => (
              <tr class="border-b border-border/60 last:border-0">
                <th scope="row" class="px-3 py-2 text-start font-normal text-fg">
                  {monthLong.format(new Date(`${month.month}T00:00:00Z`))}
                </th>
                <td class={tdClass}>{formatNumber(locale, month.releases)}</td>
                <td class={tdClass}>{formatNumber(locale, month.comments)}</td>
                <td class={tdClass}>{formatNumber(locale, month.reviews)}</td>
                <td class={tdClass}>{formatNumber(locale, month.reports)}</td>
                <td class={tdClass}>{formatNumber(locale, month.activeDays)}</td>
                <td class={`${tdClass} font-semibold`}>{formatNumber(locale, month.total)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</section>
