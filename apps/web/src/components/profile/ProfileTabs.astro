---
/**
 * Tab bar of the profile (T0-15): real links (`?tab=`), so every tab is crawlable, works without
 * JavaScript and keeps its own URL. The active tab has `aria-current="page"`.
 */
import { formatCompactNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { cn } from '@sotf/ui/cn';
import { href } from '../../lib/i18n.ts';
import { type ProfileTab, tabPath, type UserPublicDTO } from './data.ts';

interface Props {
  user: UserPublicDTO;
  tabs: readonly ProfileTab[];
  active: ProfileTab;
  defaultTab: ProfileTab;
}

const { user, tabs, active, defaultTab } = Astro.props;
const locale = Astro.locals.locale;

function label(tab: ProfileTab): string {
  switch (tab) {
    case 'mods':
      return m.profile_tab_mods();
    case 'builds':
      return m.profile_tab_builds();
    case 'reviews':
      return m.profile_tab_reviews();
  }
}

function count(tab: ProfileTab): number {
  switch (tab) {
    case 'mods':
      return user.stats.modsCount;
    case 'builds':
      return user.stats.buildsCount;
    case 'reviews':
      return user.stats.reviewsCount;
  }
}
---

<nav aria-label={m.profile_tabs_label()} class="flex gap-6 overflow-x-auto border-b border-border">
  {
    tabs.map((tab) => (
      <a
        href={href(tabPath(user, tab, { isDefault: tab === defaultTab }), locale)}
        aria-current={tab === active ? 'page' : undefined}
        data-tab={tab}
        class={cn(
          '-mb-px inline-flex min-h-11 items-center gap-1.5 border-b-2 px-0.5 text-sm font-semibold whitespace-nowrap',
          tab === active
            ? 'border-primary text-fg'
            : 'border-transparent text-fg-muted hover:border-border-strong hover:text-fg',
        )}
      >
        {label(tab)}
        <span class="text-xs font-normal tabular-nums text-fg-subtle">{formatCompactNumber(locale, count(tab))}</span>
      </a>
    ))
  }
</nav>
