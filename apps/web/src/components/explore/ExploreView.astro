---
/**
 * The Explore listing UI (research/03 §6.2, PLAN T0-06), shared by `/mods`, `/builds`,
 * `/categories/:slug` and `/tags/:slug`:
 *
 *   header (readout, h1, count, intro) · type tabs · filter rail (GET form; bottom sheet on
 *   mobile) · toolbar (sort, order, view) · active filters · results · «Load more» + pagination.
 *
 * Without JavaScript every control is a link or the GET form. `scripts/explore` enhances it:
 * instant filters, in-place swaps with View Transitions, «Load more», the mobile sheet.
 */
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { Pagination } from '@sotf/ui/pagination';
import { SlidersHorizontal, X } from 'lucide-react';
import { adUnitFor } from '../../lib/ads.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import ExploreFilters from './ExploreFilters.tsx';
import ExploreResults, { ExploreSkeleton } from './ExploreResults.tsx';
import { ListingEmpty, ListingError } from './ExploreStates.tsx';
import ExploreToolbar from './ExploreToolbar.tsx';
import type { ListingData } from './load.ts';
import type { ListType } from './state.ts';

interface Props {
  data: ListingData;
  heading: string;
  readout: string;
  /** Short intro under the heading (plain text). */
  intro?: string;
  /** Tabs to offer (default: all four; hubs of build categories pass none). */
  tabs?: readonly ListType[];
  /** Empty state copy when nothing matches without any filter (e.g. a new category). */
  emptyTitle?: string;
  emptyText?: string;
}

const { data, heading, readout, intro, tabs = ['mod', 'library', 'build', 'all'], emptyTitle, emptyText } = Astro.props;
const { model, list, state, i18n } = data;
const locale = Astro.locals.locale;
const requestId = Astro.locals.requestId;
const items = list?.items ?? [];
const total = list?.total ?? null;
const totalPages = list?.totalPages ?? 0;
const pastEnd = list !== null && list.total > 0 && state.page > list.totalPages;
const nextHref = list !== null && state.page < list.totalPages ? model.pageHref(state.page + 1) : null;
const offset = (state.page - 1) * (list?.pageSize ?? 24);
const shownTabs = model.tabs.filter((tab) => tabs.includes(tab.key));
const countText = total === null ? '' : m.explore_results_count({ count: total });
const hasBuilds = state.type === 'build';
const filtered = model.activeCount > 0;
const feedAd = adUnitFor(loadEnv(), 'feed');
---

<div data-explore-root="" data-explore-page={state.page} class="flex flex-col gap-6">
  <header class="flex flex-col gap-2">
    <p class="readout text-signal">{readout}</p>
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <h1 id="explore-heading" class="font-display-caps text-display-sm text-fg">{heading}</h1>
      <p class="font-mono text-sm text-fg-muted tabular-nums" data-explore-count="">{countText}</p>
    </div>
    {intro && <p class="max-w-(--container-prose) text-base text-fg-muted">{intro}</p>}
    <slot name="intro" />
  </header>

  {
    shownTabs.length > 1 && (
      <nav aria-label={m.explore_tabs_label()} data-explore-intercept="" class="-mx-1 overflow-x-auto">
        <ul class="flex min-w-max gap-1 border-b border-border px-1">
          {shownTabs.map((tab) => (
            <li>
              <a
                href={tab.href}
                aria-current={tab.current ? 'page' : undefined}
                class:list={[
                  'inline-flex h-11 items-center gap-2 border-b-2 px-3 text-sm font-semibold transition-colors',
                  tab.current ? 'border-primary text-fg' : 'border-transparent text-fg-muted hover:text-fg',
                ]}
              >
                {tab.label}
                {tab.count !== null && (
                  <span class="font-mono text-2xs font-normal text-fg-subtle tabular-nums">{tab.count}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)]">
    <aside
      id="explore-filters"
      data-explore-sheet=""
      data-explore-intercept=""
      aria-labelledby="explore-filters-title"
      class="explore-sheet max-lg:hidden max-lg:target:flex"
    >
      <div class="mb-4 flex items-center justify-between gap-2">
        <h2 id="explore-filters-title" class="font-display-caps text-display-xs text-fg">{m.explore_filters_title()}</h2>
        <a
          href="#explore-results"
          data-explore-sheet-close=""
          class="inline-flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-fg/8 hover:text-fg lg:hidden"
        >
          <Icon icon={X} size={20} />
          <span class="sr-only">{m.explore_filters_close()}</span>
        </a>
      </div>
      <ExploreFilters model={model} i18n={i18n} total={total} />
    </aside>

    <section id="explore-results" aria-labelledby="explore-results-title" class="flex min-w-0 flex-col gap-4" tabindex="-1">
      <h2 id="explore-results-title" class="sr-only">{m.explore_results_heading()}</h2>

      <div class="flex flex-wrap items-center gap-2" data-explore-intercept="">
        <a
          href="#explore-filters"
          data-explore-sheet-open=""
          aria-controls="explore-filters"
          class={`${buttonClasses({ variant: 'secondary', size: 'md' })} lg:hidden`}
        >
          <Icon icon={SlidersHorizontal} size={16} />
          {m.explore_filters_open({ count: model.activeCount })}
        </a>
        <ExploreToolbar model={model} i18n={i18n} />
      </div>

      {
        model.active.length > 0 && (
          <div class="flex flex-wrap items-center gap-2" data-explore-intercept="">
            <span class="readout me-1">{m.explore_active_label()}</span>
            <ul class="contents">
              {model.active.map((filter) => (
                <li>
                  <a
                    href={filter.removeHref}
                    rel="nofollow"
                    class:list={[
                      'inline-flex h-8 items-center gap-1.5 rounded-full border px-3 text-sm text-fg hover:bg-fg/6',
                      filter.excluded ? 'border-danger bg-danger-soft' : 'border-primary bg-primary/12',
                    ]}
                  >
                    <span aria-hidden="true">{filter.label}</span>
                    <Icon icon={X} size={14} />
                    <span class="sr-only">{m.explore_active_remove({ label: filter.label })}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={model.clearHref} rel="nofollow" class="ms-1 text-sm text-link underline underline-offset-3">
              {m.explore_clear_all()}
            </a>
          </div>
        )
      }

      <p class="sr-only" aria-live="polite" aria-atomic="true" data-explore-status=""></p>

      <div data-explore-list="">
        {
          list === null ? (
            <ListingError
              title={m.explore_error_title()}
              text={m.explore_error_text()}
              retryHref={href(Astro.url.pathname + Astro.url.search, locale)}
              reference={requestId}
            />
          ) : pastEnd ? (
            <ListingEmpty
              title={m.explore_past_end_title()}
              text={m.explore_past_end_text()}
              action={{ label: m.explore_back_to_first(), href: model.pageHref(1) }}
            />
          ) : items.length === 0 ? (
            <div data-explore-intercept="">
              <ListingEmpty
                title={filtered ? m.explore_empty_title() : (emptyTitle ?? m.explore_empty_title())}
                text={filtered ? m.explore_empty_text() : (emptyText ?? m.explore_empty_unfiltered_text())}
                filters={model.active}
                tryRemovingLabel={m.explore_empty_try_removing()}
                removeLabel={(label: string) => m.explore_active_remove({ label })}
                action={filtered ? { label: m.explore_clear_all(), href: model.clearHref, nofollow: true } : null}
              />
            </div>
          ) : (
            <ExploreResults
              items={items}
              view={state.view}
              locale={locale}
              i18n={i18n}
              priorityFirst={state.page === 1}
              offset={offset}
              ad={feedAd}
            />
          )
        }
      </div>

      {
        list !== null && items.length > 0 && (
          <div class="mt-4 flex flex-col items-center gap-4" data-explore-intercept="" data-explore-pager="">
            {nextHref && (
              <button
                type="button"
                hidden
                data-explore-more=""
                data-next-href={nextHref}
                class={buttonClasses({ variant: 'secondary', size: 'lg' })}
              >
                {m.common_action_load_more()}
              </button>
            )}
            <p class="font-mono text-xs text-fg-subtle tabular-nums" data-explore-page-indicator="">
              {m.common_pagination_page_of({ page: state.page, total: Math.max(1, totalPages) })}
            </p>
            <Pagination page={state.page} totalPages={totalPages} hrefFor={(page: number) => model.pageHref(page)} />
          </div>
        )
      }
    </section>
  </div>

  <template data-explore-skeleton="">
    <ExploreSkeleton view={state.view} builds={hasBuilds} />
  </template>
  <div hidden data-explore-messages={JSON.stringify({ loading: m.explore_loading(), offline: m.explore_offline(), failed: m.explore_failed() })}></div>
</div>

<style>
  @media (width < 64rem) {
    .explore-sheet {
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-modal, 60);
      max-height: 88dvh;
      flex-direction: column;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-top: 1px solid var(--color-border-strong);
      border-radius: var(--radius-xl, 1rem) var(--radius-xl, 1rem) 0 0;
      background: var(--color-surface);
      padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom));
      box-shadow: 0 -12px 40px rgb(0 0 0 / 0.45);
    }
    .explore-sheet[data-open] {
      display: flex;
    }
  }
</style>

<script>
  import { initExplore } from '../../scripts/explore/explore.ts';

  initExplore();
</script>
