---
/**
 * The search and grid listing UI of `/mods` (search page) and `/builds` (and build category hubs):
 *
 *   header · search box · type tabs · filter rail (GET form; bottom sheet below `lg`) · toolbar
 *   (count, sort, order) · active filter chips · responsive grid · numbered pagination with a page
 *   size select.
 *
 * Without JavaScript every control is a link or the GET form (the search box and the page size
 * select belong to the form through the `form` attribute). `scripts/explore` enhances it:
 * instant filters, in-place swaps with View Transitions and the mobile sheets.
 */
import { m } from '@sotf/i18n/messages';
import type { ModCardDTO } from '@sotf/contracts/catalog';
import { Icon } from '@sotf/ui/icons';
import { Pagination } from '@sotf/ui/pagination';
import { ArrowUpDown, ChevronDown, SlidersHorizontal, X } from 'lucide-react';
import { adUnitFor } from '../../lib/ads.ts';
import '../builds/blueprint.css';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import ExploreFilters, { FORM_ID } from './ExploreFilters.tsx';
import ExploreResults, { ExploreSkeleton } from './ExploreResults.tsx';
import ExploreSearchBar from './ExploreSearchBar.astro';
import ExploreSortSheet from './ExploreSortSheet.tsx';
import { ListingEmpty, ListingError } from './ExploreStates.tsx';
import ExploreToolbar from './ExploreToolbar.tsx';
import type { ListingData } from './load.ts';
import NoResults from './NoResults.tsx';
import { EXPLORE_PAGE_SIZE, type ListType } from './state.ts';

interface Props {
  data: ListingData;
  heading: string;
  /** Short intro under the heading (plain text). */
  intro?: string;
  /** Tabs to offer (default: mods, libraries, all; builds pass none). */
  tabs?: readonly ListType[];
  /** Empty state copy when nothing matches without any filter (e.g. a new category). */
  emptyTitle?: string;
  emptyText?: string;
  /** Popular items and category links offered by the «no results» state of the mods search. */
  popular?: readonly ModCardDTO[];
  categoryLinks?: readonly { label: string; href: string }[];
}

const {
  data,
  heading,
  intro,
  tabs = ['mod', 'library', 'all'],
  emptyTitle,
  emptyText,
  popular = [],
  categoryLinks = [],
} = Astro.props;
const { model, list, state, i18n } = data;
const locale = Astro.locals.locale;
const requestId = Astro.locals.requestId;
const items = list?.items ?? [];
const total = list?.total ?? null;
const totalPages = list?.totalPages ?? 0;
const pageSize = list?.pageSize ?? state.pageSize;
const pastEnd = list !== null && list.total > 0 && state.page > list.totalPages;
const offset = (state.page - 1) * pageSize;
const shownTabs = model.tabs.filter((tab) => tabs.includes(tab.key));
const countText = total === null ? '' : m.explore_results_count({ count: total });
const rangeText =
  total === null || items.length === 0
    ? ''
    : m.explore_results_range({ from: offset + 1, to: offset + items.length, total });
const builds = state.type === 'build';
const filtered = model.activeCount > 0;
// AdSense policy: no ads next to adult content, so none while the NSFW toggle is on.
const feedAd = state.nsfw ? null : adUnitFor(loadEnv(), 'feed');
const sortLabel = model.sortOptions.find((option) => option.value === model.sortValue)?.label ?? '';
const searchLabel = builds ? m.explore_search_builds_label() : m.explore_catalog_search_label();
const searchPlaceholder = searchLabel;
---

<div data-explore-root="" data-explore-page={state.page} data-explore-kind={builds ? 'builds' : 'mods'} class="flex flex-col gap-4 lg:gap-6">
  {
    builds ? (
      <header class="bp-hero bp-paper flex flex-col gap-4">
        <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
        <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
        <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
        <span class="bp-tick bp-tick-br" aria-hidden="true"></span>
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
          <h1 id="explore-heading" class="text-3xl font-bold text-fg lg:text-4xl">{heading}</h1>
          <p class="bp-mono text-sm tabular-nums" data-explore-count="">{countText}</p>
        </div>
        {intro && <p class="max-w-(--container-prose) text-sm text-fg-muted lg:text-base">{intro}</p>}
        <div class="[&:empty]:hidden"><slot name="intro" /></div>
        <ExploreSearchBar form={FORM_ID} q={state.q} label={searchLabel} placeholder={searchPlaceholder} clearHref={model.hrefOf({ q: '' })} />
      </header>
    ) : (
      <header class="flex flex-col gap-3 lg:gap-4">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h1 id="explore-heading" class="text-3xl font-bold text-fg lg:text-4xl">{heading}</h1>
          <p class="sr-only" data-explore-count="">{countText}</p>
        </div>
        {intro && <p class="max-w-(--container-prose) text-sm text-fg-muted lg:text-base">{intro}</p>}
        <div class="[&:empty]:hidden"><slot name="intro" /></div>
        <ExploreSearchBar form={FORM_ID} q={state.q} label={searchLabel} placeholder={searchPlaceholder} clearHref={model.hrefOf({ q: '' })} />
      </header>
    )
  }

  {
    shownTabs.length > 1 && (
      <nav aria-label={m.explore_tabs_label()} data-explore-intercept="" class="-mx-4 lg:mx-0">
        <ul class="explore-scroll flex min-w-0 gap-1 overflow-x-auto border-b border-border px-4 lg:px-0">
          {shownTabs.map((tab) => (
            <li class="shrink-0">
              <a
                href={tab.href}
                aria-current={tab.current ? 'page' : undefined}
                class:list={[
                  'inline-flex h-11 items-center gap-2 border-b-2 px-3 text-sm font-semibold whitespace-nowrap transition-colors',
                  tab.current ? 'border-primary text-fg' : 'border-transparent text-fg-muted hover:text-fg',
                ]}
              >
                {tab.label}
                {tab.count !== null && <span class="text-xs font-normal text-fg-subtle tabular-nums">{tab.count}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="grid gap-6 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[17rem_minmax(0,1fr)]">
    <section
      id="explore-filters"
      data-explore-sheet="filters"
      data-explore-intercept=""
      aria-labelledby="explore-filters-title"
      class="explore-sheet explore-rail"
    >
      <div data-sheet-handle="" class="explore-sheet-handle lg:hidden"><span></span></div>
      <div data-sheet-drag="" class="mb-1 flex items-center justify-between gap-2 px-4 lg:mb-4 lg:px-0">
        <h2 id="explore-filters-title" class="text-lg font-bold text-fg">{m.explore_filters_title()}</h2>
        <a
          href="#explore-results"
          data-explore-sheet-close=""
          class="inline-flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-fg/8 hover:text-fg lg:hidden"
        >
          <Icon icon={X} size={20} />
          <span class="sr-only">{m.explore_filters_close()}</span>
        </a>
      </div>
      <ExploreFilters model={model} i18n={i18n} total={total} />
    </section>
    <ExploreSortSheet model={model} />

    <section id="explore-results" aria-labelledby="explore-results-title" class="flex min-w-0 flex-col gap-3 lg:gap-4" tabindex="-1">
      <h2 id="explore-results-title" class="sr-only">{m.explore_results_heading()}</h2>

      <div class="explore-toolbar" data-explore-intercept="" data-explore-toolbar="">
        <a
          href="#explore-filters"
          data-explore-sheet-open="filters"
          aria-controls="explore-filters"
          aria-haspopup="dialog"
          class="explore-pill" data-mobile-only=""
          data-active={model.activeCount > 0 ? '' : undefined}
        >
          <Icon icon={SlidersHorizontal} size={18} />
          <span>{m.explore_filters_title()}</span>
          {model.activeCount > 0 && <span class="explore-pill-count" aria-hidden="true">{model.activeCount}</span>}
          <span class="sr-only">{m.explore_filters_open({ count: model.activeCount })}</span>
        </a>
        <a
          href="#explore-sort"
          data-explore-sheet-open="sort"
          aria-controls="explore-sort"
          aria-haspopup="dialog"
          class="explore-pill min-w-0 flex-1" data-mobile-only=""
        >
          <Icon icon={ArrowUpDown} size={18} />
          <span class="truncate">{sortLabel}</span>
          <span class="sr-only">{m.explore_sort_label()}</span>
        </a>
        <p class="text-sm text-fg-muted tabular-nums max-lg:hidden" aria-hidden="true">{rangeText || countText}</p>
        <ExploreToolbar model={model} i18n={i18n} />
      </div>

      {
        model.active.length > 0 && (
          <div class="explore-chips" data-explore-intercept="">
            <span class="sr-only">{m.explore_active_label()}</span>
            <ul class="contents">
              {model.active.map((filter) => (
                <li class="shrink-0">
                  <a
                    href={filter.removeHref}
                    rel="nofollow"
                    class:list={[
                      'inline-flex h-9 items-center gap-1.5 rounded-full border ps-3.5 pe-2.5 text-sm whitespace-nowrap text-fg transition-colors hover:bg-fg/6 lg:h-8 lg:pe-3',
                      filter.excluded ? 'border-danger bg-danger-soft' : 'border-primary bg-primary/12',
                    ]}
                  >
                    <span aria-hidden="true">{filter.label}</span>
                    <Icon icon={X} size={14} />
                    <span class="sr-only">{m.explore_active_remove({ label: filter.label })}</span>
                  </a>
                </li>
              ))}
              <li class="shrink-0">
                <a href={model.clearHref} rel="nofollow" class="inline-flex h-9 items-center px-2 text-sm font-medium text-link underline underline-offset-3 whitespace-nowrap">
                  {m.explore_clear_all()}
                </a>
              </li>
            </ul>
          </div>
        )
      }

      <p class="sr-only" aria-live="polite" aria-atomic="true" data-explore-status=""></p>

      <div data-explore-list="">
        {
          list === null ? (
            <ListingError
              title={m.explore_error_title()}
              text={m.explore_error_text()}
              retryHref={href(Astro.url.pathname + Astro.url.search, locale)}
              reference={requestId}
            />
          ) : pastEnd ? (
            <ListingEmpty
              title={m.explore_past_end_title()}
              text={m.explore_past_end_text()}
              action={{ label: m.explore_back_to_first(), href: model.pageHref(1) }}
            />
          ) : items.length === 0 ? (
            <div data-explore-intercept="">
              <NoResults
                title={state.q ? m.explore_noresults_query_title({ query: state.q }) : filtered ? m.explore_empty_title() : (emptyTitle ?? m.explore_empty_title())}
                text={filtered ? m.explore_empty_text() : (emptyText ?? m.explore_empty_unfiltered_text())}
                tip={filtered ? m.explore_search_empty_hint() : undefined}
                clear={filtered ? { label: m.explore_clear_all(), href: model.clearHref } : null}
                browse={categoryLinks.length > 0 ? { heading: m.explore_search_browse(), links: categoryLinks } : null}
                popular={popular.length > 0 ? { heading: m.explore_suggest_popular(), items: popular } : null}
                locale={locale}
                i18n={i18n}
              />
            </div>
          ) : (
            <ExploreResults
              items={items}
              view="grid"
              builds={builds}
              locale={locale}
              i18n={i18n}
              priorityFirst={state.page === 1}
              offset={offset}
              ad={feedAd}
            />
          )
        }
      </div>

      {
        list !== null && items.length > 0 && (
          <div
            class="mt-4 grid items-center gap-4 border-t border-border pt-5 lg:grid-cols-[1fr_auto_1fr] lg:gap-6"
            data-explore-intercept=""
            data-explore-pager=""
          >
            <p class="text-sm text-fg-muted tabular-nums max-lg:text-center lg:col-start-1 lg:row-start-1" data-explore-page-indicator="">
              {rangeText}
            </p>
            <div class="explore-pagination lg:col-start-2 lg:row-start-1">
              <Pagination page={state.page} totalPages={totalPages} hrefFor={(page: number) => model.pageHref(page)} />
            </div>
            <label class="flex items-center justify-center gap-2 text-sm text-fg-muted lg:col-start-3 lg:row-start-1 lg:justify-self-end">
              {m.explore_page_size_label()}
              <span class="relative block">
                <select
                  name="pageSize"
                  form={FORM_ID}
                  data-default={String(EXPLORE_PAGE_SIZE)}
                  class="h-10 appearance-none rounded-md border border-border-strong bg-sunken ps-3 pe-9 text-sm text-fg transition-colors hover:border-fg-subtle focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus"
                >
                  {model.pageSizes.map((option) => (
                    <option value={option.value} selected={option.selected}>{option.label}</option>
                  ))}
                </select>
                <span class="pointer-events-none absolute inset-y-0 end-3 flex items-center text-fg-subtle"><Icon icon={ChevronDown} size={16} /></span>
              </span>
            </label>
          </div>
        )
      }
    </section>
  </div>

  <template data-explore-skeleton="">
    <ExploreSkeleton view="grid" builds={builds} />
  </template>
  <div hidden data-explore-messages={JSON.stringify({ loading: m.explore_loading(), offline: m.explore_offline(), failed: m.explore_failed() })}></div>
</div>

<style is:global>
  /* ---- Toolbar: the sticky bar under the header on mobile ------------------------------- */
  .explore-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (width < 64rem) {
    .explore-toolbar {
      position: sticky;
      top: var(--sticky-top, 4rem);
      z-index: var(--z-raised, 10);
      margin-inline: -1rem;
      padding: 0.5rem 1rem;
      background: color-mix(in oklab, var(--color-bg) 92%, transparent);
      border-bottom: 1px solid var(--color-border);
      backdrop-filter: blur(12px);
    }
  }
  .explore-pill {
    display: inline-flex;
    height: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    padding-inline: 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
    transition: background-color var(--dur-fast, 120ms), border-color var(--dur-fast, 120ms), scale var(--dur-fast, 120ms);
  }
  .explore-pill:active {
    scale: 0.97;
    background: var(--color-raised);
  }
  .explore-pill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .explore-pill[data-active] {
    border-color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 12%, var(--color-surface));
  }
  @media (width >= 64rem) {
    .explore-pill[data-mobile-only] {
      display: none;
    }
  }
  .explore-pill-count {
    display: inline-flex;
    min-width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-primary);
    padding-inline: 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-fg);
  }

  /* ---- Active filters: one horizontally scrolling row on mobile ------------------------- */
  .explore-chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  @media (width < 64rem) {
    .explore-chips {
      flex-wrap: nowrap;
      margin-inline: -1rem;
      padding-inline: 1rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 1rem;
      scrollbar-width: none;
    }
    .explore-chips::-webkit-scrollbar,
    .explore-scroll::-webkit-scrollbar {
      display: none;
    }
    .explore-chips li {
      scroll-snap-align: start;
    }
  }
  .explore-scroll {
    scrollbar-width: none;
  }
  #explore-results {
    scroll-margin-top: var(--sticky-top, 4rem);
  }

  /* ---- Filters rail (md+) and the two bottom sheets (below md) -------------------------- */
  @media (width >= 64rem) {
    .explore-rail {
      position: sticky;
      top: calc(var(--sticky-top, 4rem) + 1rem);
      align-self: start;
      max-height: calc(100dvh - var(--sticky-top, 4rem) - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      padding-inline-end: 0.25rem;
    }
    .explore-sheet-actions {
      display: none;
    }
  }
  @media (width < 64rem) {
    .explore-sheet {
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-modal, 60);
      display: none;
      max-height: min(90dvh, 46rem);
      flex-direction: column;
      overscroll-behavior: contain;
      border-top: 1px solid var(--color-border-strong);
      border-radius: 1.25rem 1.25rem 0 0;
      background: var(--color-surface);
      box-shadow: 0 -16px 48px rgb(0 0 0 / 0.5);
      padding-bottom: env(safe-area-inset-bottom);
      will-change: transform;
    }
    .explore-sheet:target,
    .explore-sheet[data-open] {
      display: flex;
    }
    .explore-sheet[data-open] {
      animation: explore-sheet-up var(--dur-slow, 280ms) var(--ease-out, ease-out) both;
    }
    .explore-sheet[data-dragging] {
      animation: none;
      transition: none;
    }
    .explore-sheet[data-closing] {
      transition: transform 200ms ease-in;
      transform: translateY(105%);
    }
    .explore-sheet-handle {
      display: flex;
      flex-shrink: 0;
      justify-content: center;
      padding: 0.625rem 0 0.375rem;
      touch-action: none;
      cursor: grab;
    }
    .explore-sheet-handle span {
      display: block;
      width: 2.5rem;
      height: 0.3125rem;
      border-radius: 9999px;
      background: var(--color-border-strong);
    }
    .explore-sheet-actions > ul {
      padding-bottom: 0.5rem;
    }
  }
  @media (width >= 64rem) {
    .explore-sheet-handle {
      display: none;
    }
  }
  @keyframes explore-sheet-up {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes explore-backdrop-in {
    from {
      opacity: 0;
    }
  }
  [data-explore-backdrop] {
    animation: explore-backdrop-in var(--dur-base, 200ms) ease-out both;
  }
  @media (prefers-reduced-motion: reduce) {
    .explore-sheet[data-open],
    [data-explore-backdrop] {
      animation: none;
    }
    .explore-sheet[data-closing] {
      transition: none;
    }
  }

  /* Switch look of the checkbox toggles inside the mobile sheet. */
  @media (width < 64rem) {
    .explore-toggle {
      appearance: none;
      position: relative;
      width: 2.75rem;
      height: 1.625rem;
      flex-shrink: 0;
      border-radius: 9999px;
      background: var(--color-border-strong);
      transition: background-color var(--dur-fast, 120ms);
    }
    .explore-toggle::after {
      content: '';
      position: absolute;
      inset-block-start: 0.1875rem;
      inset-inline-start: 0.1875rem;
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 9999px;
      background: var(--color-fg);
      transition: translate var(--dur-fast, 120ms) var(--ease-out, ease-out);
    }
    .explore-toggle:checked {
      background: var(--color-primary);
    }
    .explore-toggle:checked::after {
      translate: 1.125rem 0;
      background: var(--color-primary-fg);
    }
    [dir='rtl'] .explore-toggle:checked::after {
      translate: -1.125rem 0;
    }
  }

  /* With JavaScript every filter applies by itself: the rail's apply button is only the no-JS path. */
  @media (width >= 64rem) {
    html[data-explore-js] .explore-rail [data-explore-apply] {
      display: none;
    }
  }
  /* Loading: the results dim a little while the next page is fetched. */
  #explore-results[aria-busy='true'] [data-explore-list] {
    opacity: 0.6;
    transition: opacity var(--dur-base, 200ms);
  }
</style>
<script>
  import { initExplore } from '../../scripts/explore/explore.ts';

  initExplore();
</script>
