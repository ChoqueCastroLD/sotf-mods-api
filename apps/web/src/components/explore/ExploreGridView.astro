---
/**
 * The grid listing UI (research/03 §6.2, PLAN T0-06) that is still used by the builds pages (the
 * mod listings use `CatalogView`; `ExploreView` picks one):
 *
 *   header (readout, h1, count, intro) · type tabs · filter rail (GET form; bottom sheet on
 *   mobile) · toolbar (sort, order, view) · active filters · results · «Load more» + pagination.
 *
 * Without JavaScript every control is a link or the GET form. `scripts/explore` enhances it:
 * instant filters, in-place swaps with View Transitions, «Load more», the mobile sheet.
 */
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { Pagination } from '@sotf/ui/pagination';
import { ArrowUpDown, SlidersHorizontal, X } from 'lucide-react';
import { adUnitFor } from '../../lib/ads.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import ExploreFilters from './ExploreFilters.tsx';
import ExploreResults, { ExploreSkeleton } from './ExploreResults.tsx';
import ExploreSortSheet from './ExploreSortSheet.tsx';
import { ListingEmpty, ListingError } from './ExploreStates.tsx';
import ExploreToolbar from './ExploreToolbar.tsx';
import type { ListingData } from './load.ts';
import type { ListType } from './state.ts';

interface Props {
  data: ListingData;
  heading: string;
  readout: string;
  /** Short intro under the heading (plain text). */
  intro?: string;
  /** Tabs to offer (default: all four; hubs of build categories pass none). */
  tabs?: readonly ListType[];
  /** Empty state copy when nothing matches without any filter (e.g. a new category). */
  emptyTitle?: string;
  emptyText?: string;
}

const { data, heading, readout, intro, tabs = ['mod', 'library', 'build', 'all'], emptyTitle, emptyText } = Astro.props;
const { model, list, state, i18n } = data;
const locale = Astro.locals.locale;
const requestId = Astro.locals.requestId;
const items = list?.items ?? [];
const total = list?.total ?? null;
const totalPages = list?.totalPages ?? 0;
const pastEnd = list !== null && list.total > 0 && state.page > list.totalPages;
const nextHref = list !== null && state.page < list.totalPages ? model.pageHref(state.page + 1) : null;
const offset = (state.page - 1) * (list?.pageSize ?? 24);
const shownTabs = model.tabs.filter((tab) => tabs.includes(tab.key));
const countText = total === null ? '' : m.explore_results_count({ count: total });
const hasBuilds = state.type === 'build';
const filtered = model.activeCount > 0;
const feedAd = adUnitFor(loadEnv(), 'feed');
const sortLabel = model.sortOptions.find((option) => option.value === model.sortValue)?.label ?? '';

---

<div data-explore-root="" data-explore-page={state.page} class="flex flex-col gap-4 md:gap-6">
  <header class="grid gap-x-6 gap-y-1.5 [grid-template-areas:'readout_count'_'title_title'_'intro_intro'] md:[grid-template-areas:'readout_readout'_'title_count'_'intro_intro']">
    <p class="readout self-center text-signal [grid-area:readout]">{readout}</p>
    <h1 id="explore-heading" class="font-display-caps text-display-sm text-fg [grid-area:title]">{heading}</h1>
    <p class="justify-self-end font-mono text-sm text-fg-muted tabular-nums [grid-area:count] md:self-end" data-explore-count="">{countText}</p>
    {intro && <p class="line-clamp-2 max-w-(--container-prose) text-sm text-fg-muted [grid-area:intro] md:line-clamp-none md:text-base">{intro}</p>}
    <div class="[grid-area:intro] empty:hidden"><slot name="intro" /></div>
  </header>

  {
    shownTabs.length > 1 && (
      <nav aria-label={m.explore_tabs_label()} data-explore-intercept="" class="-mx-4 md:mx-0">
        <ul class="explore-scroll flex min-w-0 gap-1 overflow-x-auto border-b border-border px-4 md:px-0">
          {shownTabs.map((tab) => (
            <li class="shrink-0">
              <a
                href={tab.href}
                aria-current={tab.current ? 'page' : undefined}
                class:list={[
                  'inline-flex h-11 items-center gap-2 border-b-2 px-3 text-sm font-semibold whitespace-nowrap transition-colors',
                  tab.current ? 'border-primary text-fg' : 'border-transparent text-fg-muted hover:text-fg',
                ]}
              >
                {tab.label}
                {tab.count !== null && (
                  <span class="font-mono text-2xs font-normal text-fg-subtle tabular-nums">{tab.count}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="grid gap-6 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-6 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-8">
    <section
      id="explore-filters"
      data-explore-sheet="filters"
      data-explore-intercept=""
      aria-labelledby="explore-filters-title"
      class="explore-sheet explore-rail"
    >
      <div data-sheet-handle="" class="explore-sheet-handle md:hidden"><span></span></div>
      <div data-sheet-drag="" class="mb-1 flex items-center justify-between gap-2 px-4 md:mb-4 md:px-0">
        <h2 id="explore-filters-title" class="font-display-caps text-display-xs text-fg">{m.explore_filters_title()}</h2>
        <a
          href="#explore-results"
          data-explore-sheet-close=""
          class="inline-flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-fg/8 hover:text-fg md:hidden"
        >
          <Icon icon={X} size={20} />
          <span class="sr-only">{m.explore_filters_close()}</span>
        </a>
      </div>
      <ExploreFilters model={model} i18n={i18n} total={total} />
    </section>
    <ExploreSortSheet model={model} />

    <section id="explore-results" aria-labelledby="explore-results-title" class="flex min-w-0 flex-col gap-3 md:gap-4" tabindex="-1">
      <h2 id="explore-results-title" class="sr-only">{m.explore_results_heading()}</h2>

      <div class="explore-toolbar" data-explore-intercept="" data-explore-toolbar="">
        <a
          href="#explore-filters"
          data-explore-sheet-open="filters"
          aria-controls="explore-filters"
          aria-haspopup="dialog"
          class="explore-pill" data-mobile-only=""
          data-active={model.activeCount > 0 ? '' : undefined}
        >
          <Icon icon={SlidersHorizontal} size={18} />
          <span>{m.explore_filters_title()}</span>
          {model.activeCount > 0 && <span class="explore-pill-count" aria-hidden="true">{model.activeCount}</span>}
          <span class="sr-only">{m.explore_filters_open({ count: model.activeCount })}</span>
        </a>
        <a
          href="#explore-sort"
          data-explore-sheet-open="sort"
          aria-controls="explore-sort"
          aria-haspopup="dialog"
          class="explore-pill min-w-0 flex-1" data-mobile-only=""
        >
          <Icon icon={ArrowUpDown} size={18} />
          <span class="truncate">{sortLabel}</span>
          <span class="sr-only">{m.explore_sort_label()}</span>
        </a>
        <ExploreToolbar model={model} i18n={i18n} />
      </div>

      {
        model.active.length > 0 && (
          <div class="explore-chips" data-explore-intercept="">
            <span class="readout sr-only md:not-sr-only md:me-1">{m.explore_active_label()}</span>
            <ul class="contents">
              {model.active.map((filter) => (
                <li class="shrink-0">
                  <a
                    href={filter.removeHref}
                    rel="nofollow"
                    class:list={[
                      'inline-flex h-9 items-center gap-1.5 rounded-full border ps-3.5 pe-2.5 text-sm whitespace-nowrap text-fg hover:bg-fg/6 md:h-8 md:pe-3',
                      filter.excluded ? 'border-danger bg-danger-soft' : 'border-primary bg-primary/12',
                    ]}
                  >
                    <span aria-hidden="true">{filter.label}</span>
                    <Icon icon={X} size={14} />
                    <span class="sr-only">{m.explore_active_remove({ label: filter.label })}</span>
                  </a>
                </li>
              ))}
              <li class="shrink-0">
                <a href={model.clearHref} rel="nofollow" class="inline-flex h-9 items-center px-2 text-sm font-medium text-link underline underline-offset-3 whitespace-nowrap">
                  {m.explore_clear_all()}
                </a>
              </li>
            </ul>
          </div>
        )
      }

      <p class="sr-only" aria-live="polite" aria-atomic="true" data-explore-status=""></p>

      <div data-explore-list="">
        {
          list === null ? (
            <ListingError
              title={m.explore_error_title()}
              text={m.explore_error_text()}
              retryHref={href(Astro.url.pathname + Astro.url.search, locale)}
              reference={requestId}
            />
          ) : pastEnd ? (
            <ListingEmpty
              title={m.explore_past_end_title()}
              text={m.explore_past_end_text()}
              action={{ label: m.explore_back_to_first(), href: model.pageHref(1) }}
            />
          ) : items.length === 0 ? (
            <div data-explore-intercept="">
              <ListingEmpty
                title={filtered ? m.explore_empty_title() : (emptyTitle ?? m.explore_empty_title())}
                text={filtered ? m.explore_empty_text() : (emptyText ?? m.explore_empty_unfiltered_text())}
                filters={model.active}
                tryRemovingLabel={m.explore_empty_try_removing()}
                removeLabel={(label: string) => m.explore_active_remove({ label })}
                action={filtered ? { label: m.explore_clear_all(), href: model.clearHref, nofollow: true } : null}
              />
            </div>
          ) : (
            <ExploreResults
              items={items}
              view={state.view}
              locale={locale}
              i18n={i18n}
              priorityFirst={state.page === 1}
              offset={offset}
              ad={feedAd}
            />
          )
        }
      </div>

      {
        list !== null && items.length > 0 && (
          <div class="mt-2 flex flex-col items-center gap-4 md:mt-4" data-explore-intercept="" data-explore-pager="">
            {nextHref && (
              <>
                <span data-explore-sentinel="" aria-hidden="true" class="block h-px w-full"></span>
                <button
                  type="button"
                  hidden
                  data-explore-more=""
                  data-next-href={nextHref}
                  class={`${buttonClasses({ variant: 'secondary', size: 'lg' })} max-md:h-12 max-md:w-full`}
                >
                  {m.common_action_load_more()}
                </button>
              </>
            )}
            <p class="font-mono text-xs text-fg-subtle tabular-nums" data-explore-page-indicator="">
              {m.common_pagination_page_of({ page: state.page, total: Math.max(1, totalPages) })}
            </p>
            <div class="explore-pagination w-full">
              <Pagination page={state.page} totalPages={totalPages} hrefFor={(page: number) => model.pageHref(page)} />
            </div>
          </div>
        )
      }
    </section>
  </div>

  <template data-explore-skeleton="">
    <ExploreSkeleton view={state.view} builds={hasBuilds} />
  </template>
  <div hidden data-explore-messages={JSON.stringify({ loading: m.explore_loading(), offline: m.explore_offline(), failed: m.explore_failed() })}></div>
</div>

<style is:global>
  /* ---- Toolbar: the sticky bar under the header on mobile ------------------------------- */
  .explore-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  @media (width < 48rem) {
    .explore-toolbar {
      position: sticky;
      top: var(--sticky-top, 4rem);
      z-index: var(--z-raised, 10);
      margin-inline: -1rem;
      padding: 0.5rem 1rem;
      background: color-mix(in oklab, var(--color-bg) 92%, transparent);
      border-bottom: 1px solid var(--color-border);
      backdrop-filter: blur(12px);
    }
  }
  .explore-pill {
    display: inline-flex;
    height: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    padding-inline: 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
    transition: background-color var(--dur-fast, 120ms), border-color var(--dur-fast, 120ms), scale var(--dur-fast, 120ms);
  }
  .explore-pill:active {
    scale: 0.97;
    background: var(--color-raised);
  }
  .explore-pill:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .explore-pill[data-active] {
    border-color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 12%, var(--color-surface));
  }
  @media (width >= 48rem) {
    .explore-pill[data-mobile-only] {
      display: none;
    }
  }
  .explore-pill-count {
    display: inline-flex;
    min-width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-primary);
    padding-inline: 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-fg);
  }

  /* ---- Active filters: one horizontally scrolling row on mobile ------------------------- */
  .explore-chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  @media (width < 48rem) {
    .explore-chips {
      flex-wrap: nowrap;
      margin-inline: -1rem;
      padding-inline: 1rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 1rem;
      scrollbar-width: none;
    }
    .explore-chips::-webkit-scrollbar,
    .explore-scroll::-webkit-scrollbar {
      display: none;
    }
    .explore-chips li {
      scroll-snap-align: start;
    }
  }
  .explore-scroll {
    scrollbar-width: none;
  }
  #explore-results {
    scroll-margin-top: var(--sticky-top, 4rem);
  }

  /* ---- Filters rail (md+) and the two bottom sheets (below md) -------------------------- */
  @media (width >= 48rem) {
    .explore-rail {
      position: sticky;
      top: calc(var(--sticky-top, 4rem) + 1rem);
      align-self: start;
      max-height: calc(100dvh - var(--sticky-top, 4rem) - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      padding-inline-end: 0.25rem;
    }
    .explore-sheet-actions {
      display: none;
    }
  }
  @media (width < 48rem) {
    .explore-sheet {
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-modal, 60);
      display: none;
      max-height: min(90dvh, 46rem);
      flex-direction: column;
      overscroll-behavior: contain;
      border-top: 1px solid var(--color-border-strong);
      border-radius: 1.25rem 1.25rem 0 0;
      background: var(--color-surface);
      box-shadow: 0 -16px 48px rgb(0 0 0 / 0.5);
      padding-bottom: env(safe-area-inset-bottom);
      will-change: transform;
    }
    .explore-sheet:target,
    .explore-sheet[data-open] {
      display: flex;
    }
    .explore-sheet[data-open] {
      animation: explore-sheet-up var(--dur-slow, 280ms) var(--ease-out, ease-out) both;
    }
    .explore-sheet[data-dragging] {
      animation: none;
      transition: none;
    }
    .explore-sheet[data-closing] {
      transition: transform 200ms ease-in;
      transform: translateY(105%);
    }
    .explore-sheet-handle {
      display: flex;
      flex-shrink: 0;
      justify-content: center;
      padding: 0.625rem 0 0.375rem;
      touch-action: none;
      cursor: grab;
    }
    .explore-sheet-handle span {
      display: block;
      width: 2.5rem;
      height: 0.3125rem;
      border-radius: 9999px;
      background: var(--color-border-strong);
    }
    .explore-sheet-actions > ul {
      padding-bottom: 0.5rem;
    }
  }
  @media (width >= 48rem) {
    .explore-sheet-handle {
      display: none;
    }
  }
  @keyframes explore-sheet-up {
    from {
      transform: translateY(100%);
    }
  }
  @keyframes explore-backdrop-in {
    from {
      opacity: 0;
    }
  }
  [data-explore-backdrop] {
    animation: explore-backdrop-in var(--dur-base, 200ms) ease-out both;
  }
  @media (prefers-reduced-motion: reduce) {
    .explore-sheet[data-open],
    [data-explore-backdrop] {
      animation: none;
    }
    .explore-sheet[data-closing] {
      transition: none;
    }
  }

  /* Switch look of the checkbox toggles inside the mobile sheet. */
  @media (width < 48rem) {
    .explore-toggle {
      appearance: none;
      position: relative;
      width: 2.75rem;
      height: 1.625rem;
      flex-shrink: 0;
      border-radius: 9999px;
      background: var(--color-border-strong);
      transition: background-color var(--dur-fast, 120ms);
    }
    .explore-toggle::after {
      content: '';
      position: absolute;
      inset-block-start: 0.1875rem;
      inset-inline-start: 0.1875rem;
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 9999px;
      background: var(--color-fg);
      transition: translate var(--dur-fast, 120ms) var(--ease-out, ease-out);
    }
    .explore-toggle:checked {
      background: var(--color-primary);
    }
    .explore-toggle:checked::after {
      translate: 1.125rem 0;
      background: var(--color-primary-fg);
    }
    [dir='rtl'] .explore-toggle:checked::after {
      translate: -1.125rem 0;
    }
    /* Numbered pagination is the no-JS fallback; with JS the list loads as you scroll. */
    html[data-explore-js] .explore-pagination {
      display: none;
    }
  }

  /* Load more: the skeleton that follows the last card while the next page loads. */
  [data-explore-items] > [data-explore-pending] {
    pointer-events: none;
  }
</style>

<script>
  import { initExplore } from '../../scripts/explore/explore.ts';

  initExplore();
</script>
