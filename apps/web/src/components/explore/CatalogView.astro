---
/**
 * The catalogue (`/`, `/mods`, category and tag pages), an evolution of the old `/mods` page:
 *
 *   featured carousel (top mods of the week, home only) · two columns on desktop: left 2/3 the
 *   title, the sticky toolbar and the mod list with its pager; right 1/3 the site figures and
 *   «Mods of the week». On phones the columns stack: carousel, toolbar, list, then the ranking.
 *
 * The toolbar is a plain GET form (search, category, type, sort, NSFW, Unapproved): every view is a
 * real URL and works without JavaScript; `scripts/explore/catalog.ts` submits on change.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Pagination } from '@sotf/ui/pagination';
import { ChevronDown, Search, SlidersHorizontal, X } from 'lucide-react';
import { adUnitFor } from '../../lib/ads.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import { type CatalogAside, FEATURED_SIZE, WEEKLY_VISIBLE } from './aside.ts';
import { FeaturedStrip, SiteFigures, WeeklyList } from './CatalogAside.tsx';
import CatalogList from './CatalogList.tsx';
import { buildToolbarModel, modCardLabels } from './catalog.ts';
import type { ListingData } from './load.ts';

interface Props {
  data: ListingData;
  heading: string;
  /** Short intro under the heading (category and tag pages). */
  intro?: string | undefined;
  /** Side blocks (`/`, `/mods`); category and tag pages are a single wide column. */
  aside?: CatalogAside | null;
  /** The carousel (default listing, first page). */
  showFeatured?: boolean;
  emptyTitle?: string | undefined;
  emptyText?: string | undefined;
}

const { data, heading, intro, aside = null, showFeatured = false, emptyTitle, emptyText } = Astro.props;
const { model, list, state, i18n, taxonomy } = data;
const locale = Astro.locals.locale;
const requestId = Astro.locals.requestId;
const items = list?.items ?? [];
const total = list?.total ?? null;
const totalPages = list?.totalPages ?? 0;
const pastEnd = list !== null && list.total > 0 && state.page > list.totalPages;
const offset = (state.page - 1) * (list?.pageSize ?? 24);
const toolbar = buildToolbarModel({ locale, state, taxonomy, model });
const labels = modCardLabels();
// AdSense policy: no ads next to adult content, so none while the NSFW toggle is on.
const feedAd = state.nsfw ? null : adUnitFor(loadEnv(), 'feed');
const now = Date.now();
const featured = showFeatured && aside?.weekly ? aside.weekly.filter((mod) => mod.downloads7d > 0).slice(0, FEATURED_SIZE) : [];
// Chips only for what the toolbar has no control for (tags, exclusions, legacy filters, author).
const chips = model.active.filter(
  (filter) =>
    filter.key !== 'q' &&
    filter.key !== 'nsfw' &&
    filter.key !== 'unapproved' &&
    !(filter.key.startsWith('category:') && state.category.length === 1),
);
const filtered = toolbar.changed > 0 || chips.length > 0 || state.q !== '';
const selectClass =
  'h-10 w-full appearance-none rounded-md border border-border-strong bg-sunken ps-3 pe-9 text-sm text-fg transition-colors hover:border-fg-subtle focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus';
const checkboxClass = 'size-4 shrink-0 rounded-xs accent-primary';
---

<div data-catalog-root="" class="flex flex-col gap-6 md:gap-8">
  {featured.length > 0 && <FeaturedStrip mods={featured} locale={locale} />}

  <div class:list={['grid items-start gap-8 lg:gap-10', aside && 'lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]']}>
    <div class="flex min-w-0 flex-col gap-4">
      <header class="flex flex-col gap-1.5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h1 class="text-2xl font-bold text-fg md:text-3xl">{heading}</h1>
          {total !== null && (
            <p class="text-sm text-fg-muted tabular-nums" data-catalog-count="">
              {m.explore_catalog_count({ count: total })}
            </p>
          )}
        </div>
        {intro && <p class="max-w-(--container-prose) text-sm text-fg-muted md:text-base">{intro}</p>}
      </header>

      <form
        method="get"
        action={toolbar.action}
        aria-label={m.explore_catalog_search_label()}
        data-catalog-form=""
        class="sticky top-(--sticky-top) z-(--z-raised,10) -mx-4 grid grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-2 border-b border-border bg-bg/92 px-4 py-2 backdrop-blur-md md:mx-0 md:grid-cols-[minmax(0,1fr)_11rem_11rem_auto] md:rounded-lg md:border md:bg-surface/92 md:px-3 lg:grid-cols-[minmax(0,1fr)_12rem_12rem_auto]"
      >
        <input type="checkbox" id="catalog-filters-toggle" aria-label={m.explore_catalog_filters()} class="peer sr-only md:hidden" />
        <div class="relative min-w-0">
          <span class="pointer-events-none absolute inset-y-0 start-3 flex items-center text-fg-subtle">
            <Icon icon={Search} size={16} />
          </span>
          <input
            type="search"
            name="q"
            value={toolbar.q}
            maxlength={100}
            autocomplete="off"
            enterkeyhint="search"
            aria-label={m.explore_catalog_search_label()}
            placeholder={m.explore_catalog_search_placeholder()}
            class="h-10 w-full rounded-md border border-border-strong bg-sunken ps-9 pe-3 text-sm text-fg placeholder:text-fg-subtle hover:border-fg-subtle focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-focus"
          />
        </div>
        <button
          type="submit"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-primary px-3 text-sm font-semibold text-primary-fg transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus md:col-start-4 md:row-start-1 md:px-4"
        >
          <span class="md:hidden"><Icon icon={Search} size={18} /></span>
          <span class="max-md:sr-only">{m.explore_catalog_search_button()}</span>
        </button>
        <label
          for="catalog-filters-toggle"
          class="relative inline-flex size-10 cursor-pointer items-center justify-center rounded-md border border-border-strong text-fg transition-colors hover:bg-fg/6 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus md:hidden"
        >
          <Icon icon={SlidersHorizontal} size={18} />
          <span class="sr-only">{m.explore_catalog_filters()}</span>
          {toolbar.changed > 0 && (
            <span aria-hidden="true" class="absolute -end-1 -top-1 inline-flex size-4 items-center justify-center rounded-full bg-primary text-[0.625rem] font-bold text-primary-fg">{toolbar.changed}</span>
          )}
        </label>

        <div class="col-span-full hidden grid-cols-2 gap-2 pt-1 peer-checked:grid md:contents md:peer-checked:contents">
          <label class="flex min-w-0 flex-col gap-1 text-xs text-fg-muted md:col-start-2 md:row-start-1">
            <span class="md:sr-only">{m.explore_catalog_category_label()}</span>
            <span class="relative block">
              <select name="category" class={selectClass}>
                {toolbar.categories.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
              </select>
              <span class="pointer-events-none absolute inset-y-0 end-3 flex items-center text-fg-subtle"><Icon icon={ChevronDown} size={16} /></span>
            </span>
          </label>
          <label class="flex min-w-0 flex-col gap-1 text-xs text-fg-muted md:col-start-3 md:row-start-1">
            <span class="md:sr-only">{m.explore_catalog_sort_label()}</span>
            <span class="relative block">
              <select name="sort" class={selectClass}>
                {toolbar.sorts.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
              </select>
              <span class="pointer-events-none absolute inset-y-0 end-3 flex items-center text-fg-subtle"><Icon icon={ChevronDown} size={16} /></span>
            </span>
          </label>
          <label class="flex min-w-0 flex-col gap-1 text-xs text-fg-muted md:col-start-1 md:row-start-2 md:flex-row md:items-center md:gap-2">
            {m.explore_catalog_type_label()}
            <span class="relative block md:w-36">
              <select name="type" class={`${selectClass} md:h-8`}>
                {toolbar.types.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
              </select>
              <span class="pointer-events-none absolute inset-y-0 end-3 flex items-center text-fg-subtle"><Icon icon={ChevronDown} size={16} /></span>
            </span>
          </label>
          <div class="flex items-center gap-5 max-md:col-span-2 md:col-span-3 md:col-start-2 md:row-start-2 md:justify-end">
            {toolbar.toggles.map((toggle) => (
              <label class="inline-flex min-h-8 cursor-pointer items-center gap-2 text-sm text-fg">
                <input type="checkbox" name={toggle.name} value="1" checked={toggle.checked} class={checkboxClass} />
                {toggle.label}
              </label>
            ))}
          </div>
        </div>
        {toolbar.hidden.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
      </form>

      {
        chips.length > 0 && (
          <ul class="flex flex-wrap items-center gap-2" aria-label={m.explore_active_label()}>
            {chips.map((filter) => (
              <li>
                <a
                  href={filter.removeHref}
                  rel="nofollow"
                  class:list={[
                    'inline-flex h-8 items-center gap-1.5 rounded-full border ps-3 pe-2.5 text-sm text-fg hover:bg-fg/6',
                    filter.excluded ? 'border-danger bg-danger-soft' : 'border-border-strong',
                  ]}
                >
                  <span aria-hidden="true">{filter.label}</span>
                  <Icon icon={X} size={14} />
                  <span class="sr-only">{m.explore_active_remove({ label: filter.label })}</span>
                </a>
              </li>
            ))}
            <li>
              <a href={model.clearHref} rel="nofollow" class="inline-flex h-8 items-center px-2 text-sm text-fg-muted underline underline-offset-3 hover:text-fg">
                {m.explore_clear_all()}
              </a>
            </li>
          </ul>
        )
      }

      {
        state.unapproved && (
          <p class="rounded-lg border border-border bg-surface px-4 py-3 text-sm text-fg-muted" role="note">
            {m.explore_catalog_unapproved_notice()}{' '}
            <a href={href('/mods', locale)} class="whitespace-nowrap text-fg underline underline-offset-3 hover:text-primary">{m.explore_catalog_unapproved_back()}</a>
          </p>
        )
      }

      <div id="catalog-results" class="scroll-mt-(--sticky-top)">
        {
          list === null ? (
            <div class="flex flex-col items-start gap-2 py-8" role="alert">
              <h2 class="text-lg font-bold text-fg">{m.explore_catalog_error_title()}</h2>
              <p class="text-sm text-fg-muted">{m.explore_catalog_error_text()}</p>
              <a href={href(Astro.url.pathname + Astro.url.search, locale)} class="mt-1 inline-flex h-9 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-fg hover:bg-fg/6">{m.explore_catalog_retry()}</a>
              {requestId && <p class="font-mono text-2xs text-fg-subtle">{requestId}</p>}
            </div>
          ) : pastEnd ? (
            <div class="flex flex-col items-start gap-2 py-8">
              <h2 class="text-lg font-bold text-fg">{m.explore_past_end_title()}</h2>
              <p class="text-sm text-fg-muted">{m.explore_past_end_text()}</p>
              <a href={model.pageHref(1)} class="mt-1 inline-flex h-9 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-fg hover:bg-fg/6">{m.explore_back_to_first()}</a>
            </div>
          ) : items.length === 0 ? (
            <div class="flex flex-col items-start gap-2 py-8">
              <h2 class="text-lg font-bold text-fg">{filtered || state.unapproved ? m.explore_catalog_empty_title() : (emptyTitle ?? m.explore_catalog_empty_title())}</h2>
              <p class="text-sm text-fg-muted">
                {state.unapproved
                  ? m.explore_catalog_empty_unapproved()
                  : filtered
                    ? m.explore_catalog_empty_text()
                    : (emptyText ?? m.explore_catalog_empty_text())}
              </p>
              {filtered && (
                <a href={model.clearHref} rel="nofollow" class="mt-1 inline-flex h-9 items-center rounded-md border border-border-strong px-4 text-sm font-medium text-fg hover:bg-fg/6">{m.explore_catalog_empty_clear()}</a>
              )}
            </div>
          ) : (
            <CatalogList
              items={items}
              locale={locale}
              i18n={i18n}
              labels={labels}
              now={now}
              priorityFirst={state.page === 1}
              offset={offset}
              ad={feedAd}
            />
          )
        }
      </div>

      {
        list !== null && items.length > 0 && totalPages > 1 && (
          <div class="mt-2 flex justify-center">
            <Pagination page={state.page} totalPages={totalPages} hrefFor={(page: number) => model.pageHref(page)} />
          </div>
        )
      }
    </div>

    {
      aside && (
        <aside
          aria-label={m.landing_weekly_title()}
          class="flex min-w-0 flex-col gap-8 lg:sticky lg:top-[calc(var(--sticky-top)+1rem)] lg:max-h-[calc(100dvh-var(--sticky-top)-2rem)] lg:gap-6 lg:overflow-y-auto lg:overscroll-contain lg:[scrollbar-width:thin]"
        >
          {aside.stats && (
            <div class="order-2 lg:order-1 lg:pt-1">
              <SiteFigures stats={aside.stats} locale={locale} />
            </div>
          )}
          {aside.weekly && (
            <div class="order-1 lg:order-2">
              <WeeklyList mods={aside.weekly} locale={locale} visible={WEEKLY_VISIBLE} />
            </div>
          )}
        </aside>
      )
    }
  </div>
</div>

<script>
  import { initCatalog } from '../../scripts/explore/catalog.ts';

  initCatalog();
</script>
