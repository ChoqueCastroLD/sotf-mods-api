---
/**
 * One list of Patch Radar (broken · waiting for reports · working): mod, latest version, 30-day
 * downloads, status with its report counts (icon + text, never colour alone) and the way to
 * report (`#field-report` on the mod page).
 */
import type { CompatStatus } from '@sotf/contracts/common';
import { formatCompactNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { href } from '../../lib/i18n.ts';
import type { PatchRadarRow } from './radar.ts';

interface Props {
  id: string;
  title: string;
  hint?: string;
  empty: string;
  rows: readonly PatchRadarRow[];
  tone: 'danger' | 'warning' | 'success';
}

const { id, title, hint, empty, rows, tone } = Astro.props;
const locale = Astro.locals.locale;

const STATUS: Readonly<Record<CompatStatus, { glyph: string; className: string }>> = {
  works: { glyph: '✔', className: 'border-success/50 bg-success-soft text-success' },
  mixed: { glyph: '⚠', className: 'border-warning/50 bg-warning-soft text-warning' },
  broken: { glyph: '✖', className: 'border-danger/50 bg-danger-soft text-danger' },
  untested: { glyph: '?', className: 'border-border-strong bg-fg/6 text-fg-muted' },
};
const toneClass = { danger: 'text-danger', warning: 'text-warning', success: 'text-success' }[tone];
---

<section id={id} aria-labelledby={`${id}-title`} class="flex scroll-mt-20 flex-col gap-3">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id={`${id}-title`} class:list={['font-display-caps text-display-xs', toneClass]}>
      {title} <span class="font-mono text-base text-fg-muted">({rows.length})</span>
    </h2>
    {hint && <p class="text-sm text-fg-muted">{hint}</p>}
  </div>
  {
    rows.length === 0 ? (
      <p class="rounded-lg border border-dashed border-border-strong bg-surface p-4 text-sm text-fg-muted">{empty}</p>
    ) : (
      <ol class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface">
        {rows.map((row) => {
          const status = STATUS[row.compat.status];
          const reports = row.compat.works + row.compat.partial + row.compat.broken;
          return (
            <li class="grid grid-cols-[3rem_minmax(0,1fr)] items-center gap-x-3 gap-y-2 p-3 sm:grid-cols-[3rem_minmax(0,1fr)_auto] md:px-4">
              {row.mod.thumbnailUrl ? (
                <img
                  src={row.mod.thumbnailUrl}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="size-12 rounded-md border border-border object-cover"
                />
              ) : (
                <span aria-hidden="true" class="flex size-12 items-center justify-center rounded-md border border-border bg-fg/6 font-display-caps text-lg text-fg-subtle">
                  {row.mod.name.slice(0, 1)}
                </span>
              )}
              <div class="grid min-w-0 gap-0.5">
                <a
                  href={href(row.mod.canonicalPath, locale)}
                  class="truncate font-semibold text-fg hover:text-link hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                >
                  {row.mod.name}
                </a>
                <p class="flex flex-wrap items-center gap-x-3 gap-y-0.5 font-mono text-xs text-fg-muted">
                  {row.latestVersion && <span>v{row.latestVersion}</span>}
                  <span>
                    {m.content_radar_downloads_30d({
                      count: row.downloads30d,
                      display: formatCompactNumber(locale, row.downloads30d),
                    })}
                  </span>
                  {row.possiblyOutdated && <span class="font-sans font-semibold text-warning">{m.content_radar_outdated()}</span>}
                </p>
              </div>
              <div class="col-span-2 flex flex-wrap items-center gap-2 sm:col-span-1 sm:justify-end">
                <span
                  class:list={['inline-flex items-center gap-1.5 rounded-sm border px-2 py-0.5 text-xs font-semibold', status.className]}
                >
                  <span aria-hidden="true">{status.glyph}</span>
                  {m.content_radar_status({ status: row.compat.status })}
                </span>
                {reports > 0 && (
                  <span class="font-mono text-xs text-fg-muted">
                    {m.content_radar_counts({
                      works: row.compat.works,
                      partial: row.compat.partial,
                      broken: row.compat.broken,
                    })}
                  </span>
                )}
                <a
                  href={href(`${row.mod.canonicalPath}#field-report`, locale)}
                  class="inline-flex min-h-9 items-center rounded-md border border-border-strong px-2.5 text-xs font-semibold text-fg hover:bg-fg/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                >
                  {m.content_radar_report()}
                  <span class="sr-only">: {row.mod.name}</span>
                </a>
              </div>
            </li>
          );
        })}
      </ol>
    )
  }
</section>
