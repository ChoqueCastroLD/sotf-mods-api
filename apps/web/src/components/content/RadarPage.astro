---
/**
 * Page shell of Patch Radar (`/patch-radar`, `/patch-radar/:build`): SEO («Do SOTF mods work on
 * patch X? — Patch Radar», summary with figures), JSON-LD `Article` + `ItemList` of the top mods,
 * and the empty (no build registered yet) and error states. The page sets its own cache policy.
 */
import { formatPercent } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { Radar, RotateCw, SignalZero } from 'lucide-react';
import PageLayout from '../../layouts/PageLayout.astro';
import { loadEnv } from '../../lib/env.ts';
import { href, localizePath } from '../../lib/i18n.ts';
import type { JsonLd } from '../../lib/seo/jsonld.ts';
import { articleJsonLd, itemListJsonLd } from './jsonld.ts';
import RadarUptime from './RadarUptime.astro';
import RadarView from './RadarView.astro';
import { type PatchRadar, radarModified } from './radar.ts';

interface Props {
  /** Locale-less path of the page. */
  path: string;
  state: { kind: 'ok'; radar: PatchRadar } | { kind: 'empty' } | { kind: 'error' };
}

const { path, state } = Astro.props;
const locale = Astro.locals.locale;
const siteUrl = loadEnv().siteUrl.replace(/\/+$/, '');
const url = `${siteUrl}${localizePath(path, locale)}`;

let title = m.content_radar_seo_title_generic();
let description = m.content_radar_description_generic();
const jsonLd: JsonLd[] = [];
if (state.kind === 'ok') {
  const { radar } = state;
  title = m.content_radar_seo_title({ build: radar.build.label });
  description = m.content_radar_description({
    build: radar.build.label,
    share: formatPercent(locale, radar.confirmedShare),
    works: radar.works.length,
    broken: radar.broken.length,
    pending: radar.pending.length,
  });
  const top = [...radar.works, ...radar.broken, ...radar.pending].sort((a, b) => b.downloads30d - a.downloads30d);
  jsonLd.push(
    articleJsonLd({
      siteUrl,
      url,
      locale,
      headline: m.content_radar_title({ build: radar.build.label }),
      description,
      datePublished: radar.build.releasedAt,
      dateModified: radarModified(radar),
    }),
    itemListJsonLd(
      `${url}#top`,
      m.content_radar_list_name({ build: radar.build.label }),
      top.map((row) => ({ name: row.mod.name, url: `${siteUrl}${localizePath(row.mod.canonicalPath, locale)}` })),
    ),
  );
}
const crumbs =
  path === '/patch-radar'
    ? [{ label: m.common_nav_home(), path: '/' }, { label: m.common_term_patch_radar() }]
    : [
        { label: m.common_nav_home(), path: '/' },
        { label: m.common_term_patch_radar(), path: '/patch-radar' },
        { label: state.kind === 'ok' ? state.radar.build.label : m.common_term_patch_radar() },
      ];
---

<PageLayout
  template="patch-radar"
  width="wide"
  seo={{
    title,
    rawTitle: true,
    description,
    path,
    noindex: state.kind !== 'ok',
    og: { imageAlt: m.meta_og_default_alt(), type: 'article' },
  }}
  jsonLd={jsonLd}
  breadcrumbs={crumbs}
>
  {state.kind === 'ok' && <RadarView radar={state.radar} />}
  {state.kind === 'ok' && <RadarUptime />}
  {
    state.kind === 'empty' && (
      <section aria-labelledby="radar-title" class="mx-auto flex max-w-(--container-prose) flex-col items-center gap-4 py-10 text-center">
        <Icon icon={Radar} size={40} className="text-signal" />
        <p class="readout text-signal">{m.common_term_patch_radar()}</p>
        <h1 id="radar-title" class="font-display-caps text-display-sm text-balance text-fg">
          {m.content_radar_empty_title()}
        </h1>
        <p class="text-pretty text-fg-muted">{m.content_radar_empty_text()}</p>
        <a href={href('/install', locale)} class={buttonClasses({ variant: 'secondary', size: 'md' })}>
          {m.content_radar_install_link()}
        </a>
      </section>
    )
  }
  {
    state.kind === 'error' && (
      <section
        aria-labelledby="radar-title"
        class="mx-auto flex max-w-(--container-prose) flex-col items-center gap-4 py-10 text-center"
        role="alert"
      >
        <Icon icon={SignalZero} size={40} className="text-warning" />
        <h1 id="radar-title" class="font-display-caps text-display-sm text-balance text-fg">
          {m.content_radar_error_title()}
        </h1>
        <p class="text-pretty text-fg-muted">{m.content_radar_error_text()}</p>
        <a href={href(path, locale)} class={buttonClasses({ variant: 'primary', size: 'md' })}>
          <Icon icon={RotateCw} size={16} />
          {m.common_action_retry()}
        </a>
        <p class="font-mono text-xs text-fg-subtle">{m.content_error_ref({ ref: Astro.locals.requestId })}</p>
      </section>
    )
  }
</PageLayout>
