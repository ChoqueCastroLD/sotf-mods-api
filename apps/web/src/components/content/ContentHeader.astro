---
/**
 * Header of a content page: a small label, the page's single `<h1>`, an optional lead and a
 * metadata line (dates, «verified with…») passed in the default slot.
 */
interface Props {
  eyebrow: string;
  title: string;
  /** Id of the `<h1>` (the article is labelled by it). */
  id: string;
  lead?: string | undefined;
  /** `lang` of the title and lead when they are not in the page language (untranslated text). */
  textLang?: string | undefined;
}

const { eyebrow, title, id, lead, textLang } = Astro.props;
---

<header class="flex flex-col gap-3">
  <p class="text-sm font-semibold text-fg-muted">{eyebrow}</p>
  <h1 id={id} lang={textLang} class="text-3xl font-bold text-balance text-fg md:text-4xl">{title}</h1>
  {lead && <p lang={textLang} class="max-w-(--container-prose) text-lg text-pretty text-fg-muted">{lead}</p>}
  {
    Astro.slots.has('default') && (
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-fg-muted">
        <slot />
      </div>
    )
  }
</header>
