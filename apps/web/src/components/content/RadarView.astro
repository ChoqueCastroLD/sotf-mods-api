---
/**
 * Patch Radar of one game build (PLAN §7.10 `/patch-radar`, research/03 §6.15): the build and its
 * notes, RedLoader / RedManager status on it, «N % of the top 50 confirmed», the top 50 (by
 * 30-day downloads) split into broken · waiting for reports · working, the call to report (+XP),
 * how the status is computed and the build history.
 */
import { COMPAT_RULES } from '@sotf/contracts/compat';
import { formatDate, formatNumber, formatPercent } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { History, Info, Radar, Sparkles, TriangleAlert } from 'lucide-react';
import { href } from '../../lib/i18n.ts';
import ContentHeader from './ContentHeader.astro';
import RadarList from './RadarList.astro';
import { buildPath, type PatchRadar } from './radar.ts';

interface Props {
  radar: PatchRadar;
}

const { radar } = Astro.props;
const locale = Astro.locals.locale;
const build = radar.build;
const total = radar.works.length + radar.broken.length + radar.pending.length;
const ecoGlyph = { works: '●', partial: '◐', broken: '✕', unknown: '○' } as const;
const ecoClass = {
  works: 'text-success',
  partial: 'text-warning',
  broken: 'text-danger',
  unknown: 'text-fg-muted',
} as const;
const DATE_SLOT = '';
const [releasedBefore = '', releasedAfter = ''] = m.content_radar_released({ date: DATE_SLOT }).split(DATE_SLOT);
const history = radar.history.filter((entry) => entry.id !== build.id || radar.history.length > 1);
const current = radar.history.find((entry) => entry.isCurrent) ?? null;
const pct = (share: number) => formatPercent(locale, share);
---

<article class="flex flex-col gap-10" aria-labelledby="radar-title">
  <div class="flex flex-col gap-4">
    <ContentHeader eyebrow={m.common_term_patch_radar()} title={m.content_radar_title({ build: build.label })} id="radar-title">
      <span>
        {releasedBefore}<time datetime={build.releasedAt}>{formatDate(locale, build.releasedAt, 'long')}</time>{releasedAfter}
      </span>
      {
        build.isCurrent && (
          <span class="inline-flex items-center gap-1 rounded-sm bg-signal-soft px-2 py-0.5 font-sans text-xs font-semibold text-signal">
            <Icon icon={Radar} size={14} />
            {m.content_radar_current()}
          </span>
        )
      }
      {
        build.isBreaking && (
          <span class="inline-flex items-center gap-1 rounded-sm bg-warning-soft px-2 py-0.5 font-sans text-xs font-semibold text-warning">
            <Icon icon={TriangleAlert} size={14} />
            {m.content_radar_breaking()}
          </span>
        )
      }
    </ContentHeader>

    {
      !build.isCurrent && current && (
        <p class="flex flex-wrap items-center gap-2 rounded-lg border border-signal/40 bg-signal-soft p-3 text-sm text-fg">
          <Icon icon={Info} size={16} className="shrink-0 text-signal" />
          {m.content_radar_past_notice({ build: current.label })}
          <a href={href('/patch-radar', locale)} class="font-semibold text-link underline underline-offset-3">
            {m.content_radar_past_link()}
          </a>
        </p>
      )
    }
  </div>

  <section aria-labelledby="radar-summary-title" class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div class="flex flex-col justify-between gap-4 rounded-lg border border-border-strong bg-surface p-5">
      <h2 id="radar-summary-title" class="sr-only">{m.content_radar_summary_title()}</h2>
      <p class="text-lg font-semibold text-balance text-fg">
        {m.content_radar_confirmed({ share: pct(radar.confirmedShare), build: build.label, count: total })}
      </p>
      <div
        class="flex h-2 overflow-hidden rounded-full bg-fg/10"
        role="img"
        aria-label={m.content_radar_bar_label({
          works: radar.works.length,
          broken: radar.broken.length,
          pending: radar.pending.length,
        })}
      >
        {total > 0 && <span class="bg-success" style={`width:${(radar.works.length / total) * 100}%`} />}
        {total > 0 && <span class="bg-danger" style={`width:${(radar.broken.length / total) * 100}%`} />}
        {total > 0 && <span class="bg-warning" style={`width:${(radar.pending.length / total) * 100}%`} />}
      </div>
      <dl class="grid grid-cols-3 gap-2 text-center">
        <div class="rounded-md bg-success-soft p-2">
          <dt class="text-xs text-fg-muted">{m.content_radar_stat_works()}</dt>
          <dd class="font-display-caps text-2xl text-success">{formatNumber(locale, radar.works.length)}</dd>
        </div>
        <div class="rounded-md bg-danger-soft p-2">
          <dt class="text-xs text-fg-muted">{m.content_radar_stat_broken()}</dt>
          <dd class="font-display-caps text-2xl text-danger">{formatNumber(locale, radar.broken.length)}</dd>
        </div>
        <div class="rounded-md bg-warning-soft p-2">
          <dt class="text-xs text-fg-muted">{m.content_radar_stat_pending()}</dt>
          <dd class="font-display-caps text-2xl text-warning">{formatNumber(locale, radar.pending.length)}</dd>
        </div>
      </dl>
    </div>

    <div class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-5">
      <h2 class="readout">{m.content_radar_ecosystem_title({ build: build.label })}</h2>
      {
        radar.ecosystem.length === 0 ? (
          <p class="text-sm text-fg-muted">{m.content_radar_ecosystem_empty()}</p>
        ) : (
          <ul class="grid gap-3">
            {radar.ecosystem.map((entry) => (
              <li class="grid gap-1">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="font-semibold text-fg">
                    {entry.loader.url ? (
                      <a href={entry.loader.url} rel="noopener" class="hover:text-link hover:underline">
                        {entry.loader.name} {entry.loader.version}
                      </a>
                    ) : (
                      `${entry.loader.name} ${entry.loader.version}`
                    )}
                  </span>
                  <span class:list={['inline-flex items-center gap-1 text-sm font-semibold', ecoClass[entry.status]]}>
                    <span aria-hidden="true">{ecoGlyph[entry.status]}</span>
                    {m.content_radar_eco_status({ status: entry.status })}
                  </span>
                </p>
                {entry.noteHtml && (
                  <div class="text-sm text-fg-muted [&_a]:text-link [&_a]:underline [&_p]:my-1" set:html={entry.noteHtml} />
                )}
              </li>
            ))}
          </ul>
        )
      }
      <a href={href('/install', locale)} class="mt-auto inline-flex min-h-9 items-center self-start text-sm font-semibold text-link hover:underline">
        {m.content_radar_install_link()}
      </a>
    </div>
  </section>

  {
    build.notesHtml && (
      <section aria-labelledby="radar-notes-title" class="flex flex-col gap-2">
        <h2 id="radar-notes-title" class="readout">
          {m.content_radar_notes()}
        </h2>
        <div
          class="max-w-(--container-prose) text-fg-muted [&_a]:text-link [&_a]:underline [&_li]:ms-5 [&_li]:list-disc [&_p]:my-2"
          set:html={build.notesHtml}
        />
      </section>
    )
  }

  <RadarList
    id="broken"
    tone="danger"
    title={m.content_radar_broken_title()}
    empty={m.content_radar_broken_empty({ build: build.label })}
    rows={radar.broken}
  />

  <RadarList
    id="pending"
    tone="warning"
    title={m.content_radar_pending_title()}
    hint={m.content_radar_pending_hint()}
    empty={m.content_radar_pending_empty()}
    rows={radar.pending}
  />

  <section
    aria-labelledby="radar-cta-title"
    class="grid gap-4 rounded-lg border border-primary/50 bg-primary-soft p-5 md:grid-cols-[1fr_auto] md:items-center md:p-6"
  >
    <div class="grid gap-1">
      <h2 id="radar-cta-title" class="flex items-center gap-2 text-lg font-semibold text-fg">
        <Icon icon={Sparkles} size={20} className="text-primary" />
        {m.content_radar_cta_title({ build: build.label })}
      </h2>
      <p class="text-fg-muted">{m.content_radar_cta_text()}</p>
    </div>
    <a href="#pending" class={buttonClasses({ variant: 'primary', size: 'md' })}>{m.content_radar_cta_button()}</a>
  </section>

  <RadarList
    id="works"
    tone="success"
    title={m.content_radar_works_title()}
    empty={m.content_radar_works_empty({ build: build.label })}
    rows={radar.works}
  />

  <div class="grid gap-6 lg:grid-cols-2">
    <section aria-labelledby="radar-legend-title" class="flex flex-col gap-2 rounded-lg border border-border bg-surface p-5">
      <h2 id="radar-legend-title" class="flex items-center gap-2 font-semibold text-fg">
        <Icon icon={Info} size={18} className="text-signal" />
        {m.content_radar_legend_title()}
      </h2>
      <p class="text-sm text-pretty text-fg-muted">
        {m.content_radar_legend_text({
          min: COMPAT_RULES.minWeightedReports,
          works: pct(COMPAT_RULES.worksShare),
          broken: pct(COMPAT_RULES.brokenShare),
        })}
      </p>
      <p class="text-sm text-pretty text-fg-muted">{m.content_radar_legend_outdated()}</p>
    </section>

    <section aria-labelledby="radar-history-title" class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-5">
      <h2 id="radar-history-title" class="flex items-center gap-2 font-semibold text-fg">
        <Icon icon={History} size={18} className="text-fg-muted" />
        {m.content_radar_history_title()}
      </h2>
      {
        history.length === 0 ? (
          <p class="text-sm text-fg-muted">{m.content_radar_history_empty()}</p>
        ) : (
          <ol class="grid gap-1">
            {history.map((entry) => (
              <li>
                <a
                  href={href(buildPath(entry), locale)}
                  aria-current={entry.id === build.id ? 'page' : undefined}
                  class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-0.5 rounded-md px-2 text-sm hover:bg-fg/6 aria-[current]:bg-primary/10 aria-[current]:font-semibold"
                >
                  <span class="font-mono font-semibold text-fg">{entry.label}</span>
                  <time datetime={entry.releasedAt} class="text-fg-muted">
                    {formatDate(locale, entry.releasedAt)}
                  </time>
                  {entry.isCurrent && <span class="text-xs font-semibold text-signal">{m.content_radar_current()}</span>}
                  {entry.isBreaking && <span class="text-xs font-semibold text-warning">{m.content_radar_breaking()}</span>}
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </div>
</article>
