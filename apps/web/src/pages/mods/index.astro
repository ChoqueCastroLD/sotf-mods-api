---
/**
 * `/mods`: the same catalogue view as `/` (see `components/explore/catalog-page.ts`): search,
 * category, type, sort, NSFW and Unapproved in the sticky toolbar, numbered pagination.
 *
 * - Legacy query parameters (`category`, `search`, `orderby`, `type=Mod|Build|Both|Library`,
 *   `nsfw`, `showunapproved`, `page=1`) → 301 (PLAN §4.6), resolved in the loader because
 *   categories need the catalogue.
 * - Canonical `/` for the default listing; `/mods?page=N` is indexable; any filter, sort or the
 *   Unapproved view → `noindex, follow`.
 * - Cache: E(300) `list:mods`; the API failing → 503, not cached.
 */
import CatalogPage from '../../components/explore/CatalogPage.astro';
import { loadCatalogPage } from '../../components/explore/catalog-page.ts';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';
import { localizeCards } from '../../lib/localize.ts';

const locale = Astro.locals.locale;
setPageCache(Astro, pageCache.listMods());

const page = await loadCatalogPage({ url: Astro.url, locale, mode: 'mods' });
if (page.kind === 'redirect') return Astro.redirect(page.location, 301);
await localizeCards({ listing: page.listing.list, aside: page.aside }, locale);

if (page.listing.list === null) {
  setPageCache(Astro, false);
  Astro.response.status = 503;
}
---

<CatalogPage page={page} />
