---
/**
 * `/mods/:user/:slug/versions` (PLAN §4.2): every version in semver order: the version table
 * (size, game/loader, downloads, direct download) and the full changelog with an anchor per
 * version. SSR, edge-cached with `mod:{id}`.
 */
import { m } from '@sotf/i18n/messages';
import { VersionTable } from '@sotf/ui/domain';
import { loadVersions, resolveModPage } from '../../../../../components/mod/data.ts';
import { versionsPagePath } from '../../../../../components/mod/format.ts';
import ModLayout from '../../../../../components/mod/ModLayout.astro';
import { respondUnresolved } from '../../../../../components/mod/responses.ts';
import { subpageTitle, truncate } from '../../../../../components/mod/seo.ts';
import { SECTION_TITLE_CLASSES } from '../../../../../components/mod/styles.ts';
import VersionRows from '../../../../../components/mod/VersionRows.astro';
import VersionTimeline from '../../../../../components/mod/VersionTimeline.astro';
import { setPageCache } from '../../../../../lib/cache/page.ts';
import { pageCache } from '../../../../../lib/cache/policy.ts';
import { href } from '../../../../../lib/i18n.ts';
import { ensureLocals } from '../../../../../lib/request-context.ts';

export const prerender = false;

ensureLocals(Astro);
const resolved = await resolveModPage(Astro);
if (resolved.kind !== 'ok') return respondUnresolved(Astro, resolved);
if (resolved.rest.length !== 1 || resolved.rest[0] !== 'versions') return respondUnresolved(Astro, { kind: 'not-found' });

const { mod } = resolved;
setPageCache(Astro, pageCache.mod(mod.id, mod.userId));
const versions = await loadVersions(mod.id);
const label = m.mod_tab_versions();
const latest = versions.find((version) => version.isLatest) ?? versions[0] ?? null;
---

<ModLayout
  mod={mod}
  tab="versions"
  versions={versions}
  crumbs={[{ label }]}
  seo={{
    title: subpageTitle(label, mod),
    description: truncate(
      m.mod_versions_meta_description({ name: mod.name, count: versions.length, version: latest?.version ?? '-' }),
      160,
    ),
    path: versionsPagePath(mod),
    noindex: mod.noindex,
    og: { imageAlt: m.mod_og_alt({ name: mod.name }), ...(mod.nsfw || !mod.thumbnail ? {} : { image: mod.thumbnail.url }) },
  }}
>
  <section aria-labelledby="versions-title" class="grid gap-4">
    <h2 id="versions-title" class={SECTION_TITLE_CLASSES}>{m.mod_versions_title({ count: versions.length })}</h2>
    <div class="max-md:hidden">
      <VersionTable versions={versions} caption={m.mod_versions_caption({ name: mod.name })} />
    </div>
    <VersionRows mod={mod} versions={versions} />
    {
      versions.length > 1 && (
        <p>
          <a
            href={href(`${versionsPagePath(mod)}/compare`, Astro.locals.locale)}
            class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-link"
          >
            {m.mod_knowledge_compare_link()}
          </a>
        </p>
      )
    }
  </section>

  <section id="changelog" aria-labelledby="changelog-title" class="grid gap-4 max-md:hidden">
    <h2 id="changelog-title" class={SECTION_TITLE_CLASSES}>{m.mod_changelog_title()}</h2>
    {
      versions.length > 0 ? (
        <VersionTimeline mod={mod} versions={versions} />
      ) : (
        <p class="text-fg-muted">{m.mod_versions_empty()}</p>
      )
    }
  </section>
</ModLayout>
