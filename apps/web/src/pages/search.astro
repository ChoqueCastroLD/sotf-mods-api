---
/**
 * `/search?q=` (PLAN §4.2, §7.9; T0-07 «Ver todos»): full-text + fuzzy results across mods,
 * builds, kits, creators and pages, grouped by type, with a type filter (`type=`), highlighted
 * matches and a link to Explore with the same text filter. The legacy `/mods?search=` lands here.
 *
 * `noindex` (and out of the hreflang cluster), E(60) with no entity tags; the API failing →
 * error state, 503, not cached.
 */
import type { SearchHitDTO } from '@sotf/contracts/search';
import { m } from '@sotf/i18n/messages';
import { exploreDomainI18n } from '../components/explore/domain-i18n.ts';
import { ListingEmpty, ListingError } from '../components/explore/ExploreStates.tsx';
import SearchResults, { type SearchGroup } from '../components/explore/SearchResults.tsx';
import PageLayout from '../layouts/PageLayout.astro';
import { serverApi } from '../lib/api.ts';
import { setPageCache } from '../lib/cache/page.ts';
import { pageCache } from '../lib/cache/policy.ts';
import { href } from '../lib/i18n.ts';
import { loadTaxonomy } from '../components/explore/taxonomy.ts';
import { Icon } from '@sotf/ui/icons';
import { Clock, Search as SearchIcon, X } from 'lucide-react';

const SEARCH_LIMIT = 50;
const TYPES = ['mod', 'build', 'kit', 'user', 'page'] as const;
type SearchType = (typeof TYPES)[number];

const locale = Astro.locals.locale;
setPageCache(Astro, pageCache.search());

const q = (Astro.url.searchParams.get('q') ?? '').replace(/\s+/g, ' ').trim().slice(0, 100);
const rawType = Astro.url.searchParams.get('type');
const type: SearchType | null = (TYPES as readonly string[]).includes(rawType ?? '') ? (rawType as SearchType) : null;

let hits: SearchHitDTO[] = [];
let total = 0;
let failed = false;
if (q) {
  try {
    const result = await serverApi().search.search(
      { query: { q, limit: SEARCH_LIMIT, locale, ...(type ? { types: [type] } : {}) } },
      { signal: AbortSignal.timeout(5000) },
    );
    hits = result.hits;
    total = result.total;
  } catch {
    failed = true;
    setPageCache(Astro, false);
    Astro.response.status = 503;
  }
}

const typeLabels: Record<SearchType, string> = {
  mod: m.common_term_mods(),
  build: m.common_term_builds(),
  kit: m.common_term_kits(),
  user: m.common_nav_creators(),
  page: m.explore_search_type_pages(),
};
const groups: SearchGroup[] = TYPES.map((key) => ({
  key,
  title: typeLabels[key],
  hits: hits.filter((hit) => hit.type === key),
})).filter((group) => group.hits.length > 0);

const searchHref = (next: SearchType | null) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (next) params.set('type', next);
  const query = params.toString();
  return href(`/search${query ? `?${query}` : ''}`, locale);
};
const filters = [{ key: null, label: m.explore_search_type_all() }, ...TYPES.map((key) => ({ key, label: typeLabels[key] }))];
const exploreHref = href(`/mods?${new URLSearchParams({ type: 'all', q }).toString()}`, locale);
const browseCategories = q ? [] : (await loadTaxonomy(locale)).categories.filter((category) => category.kind === 'mod');
const title = q ? m.meta_search_title({ query: q }) : m.meta_search_title_empty();
---

<PageLayout
  template="search"
  seo={{
    title,
    description: m.explore_search_description(),
    path: '/search',
    noindex: true,
    alternates: false,
  }}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: m.common_search_label() }]}
>
  <div
    class="flex min-w-0 flex-col gap-4 md:gap-6"
    data-search-page=""
    data-search-query={q}
    data-search-total={total}
    data-search-base={href('/search', locale)}
  >
    <header class="flex flex-col gap-2">
      <p class="readout text-signal">{m.common_search_label()}</p>
      <h1 class="font-display-caps text-display-sm text-fg">
        {q ? m.explore_search_heading_query({ query: q }) : m.explore_search_heading()}
      </h1>
    </header>

    <div class="search-bar" data-search-bar="">
      <search class="max-w-2xl">
        <form method="get" action={href('/search', locale)} class="flex gap-2" data-search-form="">
          {type && <input type="hidden" name="type" value={type} />}
          <label for="search-q" class="sr-only">{m.common_search_label()}</label>
          <div class="relative min-w-0 flex-1">
            <span class="pointer-events-none absolute inset-y-0 start-3.5 flex items-center text-fg-subtle">
              <Icon icon={SearchIcon} size={20} />
            </span>
            <input
              id="search-q"
              name="q"
              type="search"
              value={q}
              maxlength="100"
              enterkeyhint="search"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder={m.common_search_placeholder()}
              class="h-12 w-full rounded-full border border-border-strong bg-sunken ps-11 pe-11 text-base text-fg placeholder:text-fg-subtle focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-focus md:rounded-md"
            />
            <button
              type="button"
              hidden
              data-search-clear=""
              class="absolute inset-y-1 end-1 inline-flex size-10 items-center justify-center rounded-full text-fg-muted hover:bg-fg/8 hover:text-fg"
            >
              <Icon icon={X} size={18} />
              <span class="sr-only">{m.explore_search_clear_input()}</span>
            </button>
          </div>
          <button
            type="submit"
            class="inline-flex h-12 items-center rounded-full bg-primary px-5 font-semibold text-primary-fg shadow-glow max-md:hidden md:rounded-md"
          >
            {m.common_search_label()}
          </button>
        </form>
      </search>

      {
        q && (
          <nav aria-label={m.explore_search_types_label()} class="-mx-4 mt-1 md:mx-0">
            <ul class="search-tabs flex min-w-0 gap-1 overflow-x-auto border-b border-border px-4 md:px-0">
              {filters.map((filter) => (
                <li class="shrink-0">
                  <a
                    href={searchHref(filter.key)}
                    rel="nofollow"
                    aria-current={filter.key === type ? 'page' : undefined}
                    class:list={[
                      'inline-flex h-11 items-center border-b-2 px-3 text-sm font-semibold whitespace-nowrap',
                      filter.key === type ? 'border-primary text-fg' : 'border-transparent text-fg-muted hover:text-fg',
                    ]}
                  >
                    {filter.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    {
      q && !failed && (
        <p class="font-mono text-sm text-fg-muted tabular-nums" aria-live="polite">
          {m.explore_search_count({ count: total, query: q })}
        </p>
      )
    }

    {
      !q && (
        <section hidden data-search-recents="" aria-labelledby="search-recent-title" class="flex flex-col gap-1">
          <div class="flex items-center justify-between gap-3">
            <h2 id="search-recent-title" class="readout">{m.explore_search_recent_title()}</h2>
            <button
              type="button"
              data-search-recents-clear=""
              class="inline-flex min-h-11 items-center px-2 text-sm font-medium text-link underline underline-offset-3"
            >
              {m.explore_search_recent_clear()}
            </button>
          </div>
          <ul data-search-recents-list="" data-remove-label={m.explore_search_recent_remove({ query: '{query}' })} class="divide-y divide-border rounded-xl border border-border bg-surface" />
        </section>
      )
    }

    {
      !q && browseCategories.length > 0 && (
        <section aria-labelledby="search-browse-title" class="flex flex-col gap-3">
          <h2 id="search-browse-title" class="readout">{m.explore_search_browse()}</h2>
          <ul class="flex flex-wrap gap-2">
            {browseCategories.map((category) => (
              <li>
                <a
                  href={href(`/categories/${category.slug}`, locale)}
                  class="inline-flex h-11 items-center gap-2 rounded-full border border-border-strong bg-surface px-4 text-sm font-medium text-fg active:bg-raised"
                >
                  {category.names[locale] ?? category.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      !q ? (
        <ListingEmpty
          title={m.explore_search_prompt_title()}
          text={m.explore_search_prompt_text()}
          action={{ label: m.explore_search_browse(), href: href('/categories', locale) }}
          headingLevel={2}
        />
      ) : failed ? (
        <ListingError
          title={m.explore_error_title()}
          text={m.explore_search_error_text()}
          retryHref={href(Astro.url.pathname + Astro.url.search, locale)}
          reference={Astro.locals.requestId}
          headingLevel={2}
        />
      ) : groups.length === 0 ? (
        <ListingEmpty
          title={m.common_search_no_results({ query: q })}
          text={m.explore_search_empty_hint()}
          action={{ label: m.explore_search_browse(), href: href('/categories', locale) }}
          headingLevel={2}
        />
      ) : (
        <SearchResults groups={groups} locale={locale} i18n={exploreDomainI18n(locale, (_key: string, fallback: string) => fallback)} exploreHref={exploreHref} exploreLabel={m.explore_search_in_explore()} />
      )
    }
  </div>

  <style is:global>
    .search-tabs {
      scrollbar-width: none;
    }
    .search-tabs::-webkit-scrollbar {
      display: none;
    }
    @media (width < 48rem) {
      .search-bar {
        position: sticky;
        top: var(--sticky-top, 4rem);
        z-index: var(--z-raised, 10);
        margin-inline: -1rem;
        padding: 0.5rem 1rem 0;
        background: color-mix(in oklab, var(--color-bg) 94%, transparent);
        backdrop-filter: blur(12px);
      }
    }
  </style>

  <script>
    import { initSearchPage } from '../scripts/explore/search.ts';

    initSearchPage();
  </script>
</PageLayout>
