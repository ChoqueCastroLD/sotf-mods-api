---
/**
 * `/manager`: SotF Mods Manager, the site's own mod manager for Windows (2026-11), inside the site
 * shell. One concrete pitch: what installing a mod by hand takes, next to what the Install button
 * does, then the rest of the app, the honest answers people need before running an unsigned exe,
 * and the download.
 *
 * - Facts come from the source of truth: the version and the exe size from the latest GitHub
 *   release, the number of mods from the catalogue (each hidden if its call fails).
 * - Real screenshots of the app only. No cards around images, no decorative icons.
 * - Download links point to the exe of the latest release and carry `data-manager-cta` (the
 *   beacon records `manager_download_click` for the owner dashboard).
 * - Edge-cached a day like the other static pages.
 */
import { formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { CodeXml, Download } from 'lucide-react';
import PageLayout from '../layouts/PageLayout.astro';
import { serverApi } from '../lib/api.ts';
import { setPageCache } from '../lib/cache/page.ts';
import { pageCache } from '../lib/cache/policy.ts';
import { MANAGER } from '../lib/site.ts';

const locale = Astro.locals.locale;
setPageCache(Astro, pageCache.static());

interface Release {
  version: string;
  sizeKb: number | null;
}

async function latestRelease(): Promise<Release | null> {
  try {
    const res = await fetch('https://api.github.com/repos/ChoqueCastroLD/sotf-mods-manager/releases/latest', {
      headers: { accept: 'application/vnd.github+json', 'user-agent': 'sotf-mods.com' },
      signal: AbortSignal.timeout(2500),
    });
    if (!res.ok) return null;
    const body = (await res.json()) as { tag_name?: string; assets?: Array<{ name: string; size: number }> };
    const version = (body.tag_name ?? '').replace(/^v/i, '');
    if (!/^[\w.+-]{1,32}$/.test(version)) return null;
    const exe = body.assets?.find((asset) => asset.name.toLowerCase().endsWith('.exe'));
    return { version, sizeKb: exe ? Math.round(exe.size / 1024) : null };
  } catch {
    return null;
  }
}

async function modsCount(): Promise<number | null> {
  try {
    const list = await serverApi().catalog.listMods(
      { query: { type: 'mod', pageSize: 1, compat: 'any' } },
      { signal: AbortSignal.timeout(2500) },
    );
    return list.total;
  } catch {
    return null;
  }
}

const [release, mods] = await Promise.all([latestRelease(), modsCount()]);
const facts = [
  release ? m.manager_fact_version({ version: release.version }) : null,
  release?.sizeKb ? m.manager_fact_size({ size: formatNumber(locale, release.sizeKb) }) : null,
  m.manager_fact_windows(),
  mods !== null ? m.manager_fact_mods({ count: formatNumber(locale, mods) }) : null,
].filter((fact) => fact !== null);

const byHand = [m.manager_hand_1(), m.manager_hand_2(), m.manager_hand_3(), m.manager_hand_4(), m.manager_hand_5()];
const more = [
  { title: m.manager_updates_title(), text: m.manager_updates_text(), src: '/manager/installed.webp', alt: m.manager_shot_installed(), width: 1264, height: 781 },
  { title: m.manager_profiles_title(), text: m.manager_profiles_text(), src: '/manager/import.webp', alt: m.manager_shot_import(), width: 524, height: 208 },
  { title: m.manager_redloader_title(), text: m.manager_redloader_text(), src: '/manager/settings.webp', alt: m.manager_shot_settings(), width: 1264, height: 781 },
  { title: m.manager_crash_title(), text: m.manager_crash_text(), src: '/manager/crash.webp', alt: m.manager_shot_crash(), width: 524, height: 189 },
];
const faq = [
  { q: m.manager_faq_safe_q(), a: m.manager_faq_safe_a() },
  { q: m.manager_faq_manual_q(), a: m.manager_faq_manual_a() },
  { q: m.manager_faq_slow_q(), a: m.manager_faq_slow_a() },
  { q: m.manager_faq_cost_q(), a: m.manager_faq_cost_a() },
];
// One button group, used twice: the download and the source next to it, joined.
const GROUP = 'grid w-full grid-cols-1 overflow-hidden rounded-lg border border-border-strong sm:inline-grid sm:w-auto sm:grid-cols-[auto_auto]';
const PRIMARY =
  'flex h-13 items-center justify-center gap-2.5 bg-primary px-6 text-base font-bold text-primary-fg transition-colors hover:bg-primary-hover focus-visible:relative focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus';
const SECONDARY =
  'flex h-13 items-center justify-center gap-2.5 border-border-strong bg-surface px-6 text-base font-semibold text-fg transition-colors hover:bg-raised max-sm:border-t sm:border-s focus-visible:relative focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus';
---

<PageLayout
  template="manager"
  width="wide"
  seo={{
    title: m.manager_meta_title(),
    description: m.manager_meta_description(),
    path: '/manager',
    og: { image: '/manager/main.webp', imageAlt: m.manager_shot_main(), imageWidth: 1264, imageHeight: 781 },
  }}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: MANAGER.name }]}
>
  <article class="manager flex flex-col">
    <header class="grid gap-8 pt-2 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="flex flex-col gap-5 lg:col-span-7">
        <h1 class="manager-display text-balance text-fg">{m.manager_title()}</h1>
        <p class="manager-lead max-w-[38rem] text-pretty text-fg-muted">{m.manager_lead()}</p>
      </div>
      <div class="flex flex-col gap-5 lg:col-span-5 lg:items-end">
        <div class={GROUP}>
          <a href={MANAGER.downloadUrl} data-manager-cta="manager-hero" rel="nofollow" class={PRIMARY}>
            <Icon icon={Download} size={20} />
            {m.manager_download()}
          </a>
          <a href={MANAGER.repoUrl} rel="noopener" class={SECONDARY}>
            <Icon icon={CodeXml} size={18} />
            {m.manager_github()}
          </a>
        </div>
        <!-- Phones: two aligned columns. From sm: one row with real dividers. -->
        <ul class="grid grid-cols-2 gap-x-6 gap-y-1.5 text-sm text-fg-muted sm:flex sm:flex-wrap sm:gap-0 lg:justify-end">
          {
            facts.map((fact) => (
              <li class="sm:border-border sm:px-3 sm:first:ps-0 sm:not-first:border-s lg:last:pe-0">{fact}</li>
            ))
          }
        </ul>
      </div>
    </header>

    <img
      src="/manager/main.webp"
      alt={m.manager_shot_main()}
      width="1264"
      height="781"
      fetchpriority="high"
      class="manager-shot mt-10 w-full rounded-lg md:mt-14"
    />

    <section aria-labelledby="manager-compare" class="mt-24 md:mt-32">
      <h2 id="manager-compare" class="manager-h2 max-w-[32rem] text-balance text-fg">{m.manager_compare_title()}</h2>
      <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <h3 class="text-base font-semibold text-fg-muted">{m.manager_hand_title()}</h3>
          <ol class="mt-5 border-t border-border">
            {
              byHand.map((step, index) => (
                <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-2 border-b border-border py-4">
                  <span class="text-lg font-bold text-fg-subtle tabular-nums">{index + 1}</span>
                  <span class="text-base text-fg-muted">{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <h3 class="text-base font-semibold text-fg">{m.manager_app_title()}</h3>
          <div class="mt-5 grid grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-2 border-y border-primary/60 py-4">
            <span class="text-lg font-bold text-primary tabular-nums">1</span>
            <span class="text-lg font-semibold text-fg">{m.manager_app_step()}</span>
          </div>
          <p class="mt-5 max-w-[34rem] text-base text-pretty text-fg-muted">{m.manager_app_text()}</p>
          <img
            src="/manager/install-dialog.webp"
            alt={m.manager_shot_install()}
            width="524"
            height="246"
            loading="lazy"
            decoding="async"
            class="manager-shot mt-6 w-full max-w-[524px] rounded-md"
          />
          <p class="mt-5 max-w-[34rem] text-sm text-pretty text-fg-muted">
            {m.manager_app_links()}
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="manager-more" class="mt-24 md:mt-32">
      <h2 id="manager-more" class="manager-h2 text-fg">{m.manager_more_title()}</h2>
      <div class="mt-10 border-t border-border">
        {
          more.map((item) => (
            <div class="grid gap-6 border-b border-border py-10 lg:grid-cols-12 lg:items-center lg:gap-10">
              <div class="lg:col-span-5">
                <h3 class="text-xl font-bold text-fg">{item.title}</h3>
                <p class="mt-2 max-w-[30rem] text-base text-pretty text-fg-muted">{item.text}</p>
              </div>
              <div class="lg:col-span-7">
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  class:list={['manager-shot rounded-md', item.width > 600 ? 'w-full' : 'w-full max-w-[524px]']}
                />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="manager-faq" class="mt-24 grid gap-10 md:mt-32 lg:grid-cols-12">
      <h2 id="manager-faq" class="manager-h2 text-fg lg:col-span-4">{m.manager_faq_title()}</h2>
      <dl class="border-t border-border lg:col-span-8">
        {
          faq.map((item) => (
            <div class="grid gap-2 border-b border-border py-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-8">
              <dt class="text-base font-semibold text-fg">{item.q}</dt>
              <dd class="text-base text-pretty text-fg-muted">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="manager-get" class="mt-24 mb-8 flex flex-col items-start gap-6 border-t border-border pt-12 md:mt-32 md:flex-row md:items-center md:justify-between">
      <h2 id="manager-get" class="manager-h2 text-fg">{m.manager_final_title()}</h2>
      <div class={GROUP}>
        <a href={MANAGER.downloadUrl} data-manager-cta="manager-bottom" rel="nofollow" class={PRIMARY}>
          <Icon icon={Download} size={20} />
          {m.manager_download()}
        </a>
        <a href={MANAGER.releaseUrl} data-manager-cta="manager-notes" rel="noopener" class={SECONDARY}>
          {m.manager_release_notes()}
        </a>
      </div>
    </section>
  </article>
</PageLayout>

<style>
  /* Type scale of this page (Onest, the site's typeface): display 2.5/3.5/4.25rem, h2
     1.75/2.25rem, lead 1.125/1.25rem. Tight leading on the big sizes, normal on text. */
  .manager-display {
    font-size: 2.5rem;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .manager-h2 {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .manager-lead {
    font-size: 1.125rem;
    line-height: 1.6;
  }
  @media (min-width: 48rem) {
    .manager-display {
      font-size: 3.5rem;
    }
    .manager-h2 {
      font-size: 2.25rem;
    }
    .manager-lead {
      font-size: 1.25rem;
    }
  }
  @media (min-width: 80rem) {
    .manager-display {
      font-size: 4.25rem;
    }
  }
  /* Screenshots sit on the page: a hairline to separate the app's dark UI from the page, no frame. */
  .manager-shot {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--color-fg) 10%, transparent),
      0 24px 60px -32px rgb(0 0 0 / 0.55);
  }
</style>
