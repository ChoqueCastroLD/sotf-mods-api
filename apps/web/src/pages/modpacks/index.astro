---
/**
 * `/modpacks`: the approved public modpacks as a grid with a search box, the sorts (most
 * downloaded, newest, recently updated) and numbered pagination, in the style of `/mods`.
 * A modpack installs in one go with SotF Mods Manager (`.sotfprofile`).
 *
 * - Canonical `/modpacks`; `?page=N` is indexable; a search or a sort → `noindex, follow`.
 * - Cache: E(300) `list:kits`; the API failing → 503 with an error state, never cached.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Pagination } from '@sotf/ui/pagination';
import { Layers, Plus, Search, X } from 'lucide-react';
import {
  listQueryOf,
  listViewOf,
  loadModpacks,
  MODPACK_SORTS,
  MODPACKS_PAGE_SIZE,
  type ModpackListView,
  type ModpackSort,
} from '../../components/modpacks/data.ts';
import ModpackCard from '../../components/modpacks/ModpackCard.astro';
import PageState from '../../components/state/PageState.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import { itemListJsonLd } from '../../lib/seo/jsonld.ts';

export const prerender = false;

const locale = Astro.locals.locale;
setPageCache(Astro, pageCache.listModpacks());

const view = listViewOf(Astro.url.searchParams);
const list = await loadModpacks(view);
if (list === null) {
  setPageCache(Astro, false);
  Astro.response.status = 503;
}
const items = list?.items ?? [];
const total = list?.total ?? 0;
const totalPages = Math.max(1, Math.ceil(total / MODPACKS_PAGE_SIZE));
const base = href('/modpacks', locale);
const urlOf = (next: Partial<ModpackListView>) => `${base}${listQueryOf({ ...view, page: 1, ...next })}`;
const sortLabel: Record<ModpackSort, string> = {
  downloads: m.modpacks_sort_downloads(),
  new: m.modpacks_sort_new(),
  updated: m.modpacks_sort_updated(),
};
const filtered = view.q !== '' || view.sort !== 'downloads';
const first = (view.page - 1) * MODPACKS_PAGE_SIZE + 1;
const rangeText = total > 0 ? m.modpacks_range({ from: first, to: first + items.length - 1, total }) : '';
const siteUrl = loadEnv().siteUrl;
const jsonLd =
  items.length > 0
    ? [
        itemListJsonLd({
          url: `${siteUrl}${base}`,
          name: m.modpacks_title(),
          items: items.map((pack) => ({ name: pack.name, url: `${siteUrl}${href(pack.canonicalPath, locale)}` })),
        }),
      ]
    : [];
---

<PageLayout
  template="modpacks"
  width="wide"
  seo={{
    title: view.page > 1 ? m.requests_list_title_page({ title: m.modpacks_title(), page: view.page }) : m.modpacks_title(),
    description: m.modpacks_description(),
    path: view.page > 1 && !filtered ? `/modpacks?page=${view.page}` : '/modpacks',
    noindex: filtered,
  }}
  jsonLd={jsonLd}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: m.modpacks_nav() }]}
>
  <div class="flex flex-col gap-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-bold text-fg md:text-4xl">{m.modpacks_title()}</h1>
        <p class="max-w-(--container-prose) text-base text-fg-muted">{m.modpacks_intro()}</p>
      </div>
      <a
        href="/dashboard/modpacks/new"
        rel="nofollow"
        class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-fg transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >
        <Icon icon={Plus} size={18} />
        {m.modpacks_create()}
      </a>
    </header>

    <search><form method="get" action={base} class="flex items-stretch gap-2">
      {view.sort !== 'downloads' && <input type="hidden" name="sort" value={view.sort} />}
      <div class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute inset-y-0 start-4 flex items-center text-fg-subtle">
          <Icon icon={Search} size={20} />
        </span>
        <input
          type="search"
          name="q"
          value={view.q}
          maxlength={100}
          autocomplete="off"
          enterkeyhint="search"
          aria-label={m.modpacks_search_label()}
          placeholder={m.modpacks_search_placeholder()}
          class="modpacks-q h-12 w-full rounded-lg border border-border-strong bg-sunken ps-12 pe-12 text-base text-fg shadow-sm transition-colors placeholder:text-fg-subtle hover:border-fg-subtle focus-visible:border-primary focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-primary/60 lg:h-14 lg:text-lg"
        />
        {
          view.q !== '' && (
            <a
              href={urlOf({ q: '' })}
              rel="nofollow"
              title={m.explore_search_clear_input()}
              class="absolute inset-y-1 end-1 inline-flex w-10 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-fg/8 hover:text-fg focus-visible:outline-2 focus-visible:outline-focus lg:inset-y-1.5"
            >
              <Icon icon={X} size={18} />
              <span class="sr-only">{m.explore_search_clear_input()}</span>
            </a>
          )
        }
      </div>
      <button
        type="submit"
        class="inline-flex h-12 shrink-0 items-center justify-center rounded-lg bg-primary text-base font-semibold text-primary-fg transition-colors hover:bg-primary-hover active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus max-sm:w-12 sm:px-6 lg:h-14 lg:px-8"
      >
        <span class="sm:hidden"><Icon icon={Search} size={20} /></span>
        <span class="max-sm:sr-only">{m.explore_catalog_search_button()}</span>
      </button>
    </form></search>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-border pb-2">
      <nav aria-label={m.requests_sort_label()} class="flex items-center gap-x-5 overflow-x-auto text-sm">
        <span class="text-fg-muted max-md:sr-only">{m.requests_sort_label()}</span>
        {
          MODPACK_SORTS.map((sort) => (
            <a
              href={urlOf({ sort })}
              rel="nofollow"
              aria-current={view.sort === sort ? 'true' : undefined}
              class:list={[
                'inline-flex min-h-10 items-center whitespace-nowrap',
                view.sort === sort
                  ? 'font-semibold text-fg underline decoration-primary decoration-2 underline-offset-8'
                  : 'text-fg-muted hover:text-fg',
              ]}
            >
              {sortLabel[sort]}
            </a>
          ))
        }
      </nav>
      {rangeText && <p class="text-sm text-fg-muted tabular-nums">{rangeText}</p>}
    </div>

    {
      list === null ? (
        <PageState
          kind="error"
          title={m.modpacks_error_title()}
          text={m.modpacks_error_text()}
          retryHref={href(Astro.url.pathname, locale)}
          reference={Astro.locals.requestId}
        />
      ) : items.length === 0 ? (
        <div class="flex flex-col items-center gap-3 rounded-lg border border-dashed border-border px-6 py-14 text-center">
          <Icon icon={Layers} size={32} className="text-fg-subtle" />
          <p class="text-lg font-semibold text-fg">
            {view.q ? m.modpacks_empty_query_title({ query: view.q }) : m.modpacks_empty_title()}
          </p>
          <p class="max-w-(--container-prose) text-sm text-fg-muted">{m.modpacks_empty_text()}</p>
          {view.q && (
            <a href={urlOf({ q: '' })} rel="nofollow" class="text-sm font-medium text-link underline underline-offset-3">
              {m.explore_clear_all()}
            </a>
          )}
        </div>
      ) : (
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {items.map((pack, index) => (
            <li class="min-w-0">
              <ModpackCard pack={pack} priority={view.page === 1 && index < 4} />
            </li>
          ))}
        </ul>
      )
    }

    {
      totalPages > 1 && (
        <div class="flex justify-center border-t border-border pt-5">
          <Pagination page={view.page} totalPages={totalPages} hrefFor={(page: number) => `${base}${listQueryOf({ ...view, page })}`} />
        </div>
      )
    }
  </div>
</PageLayout>

<style is:global>
  .modpacks-q::-webkit-search-cancel-button,
  .modpacks-q::-webkit-search-decoration {
    appearance: none;
    display: none;
  }
</style>
