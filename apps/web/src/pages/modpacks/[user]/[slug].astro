---
/**
 * `/modpacks/:user/:slug`: one approved modpack, with the same structure as a mod page.
 *
 * - Header: the cover (only when it is at least 640 px wide; otherwise a collage of its mods'
 *   pictures), name, author with avatar, counts (mods, downloads, followers, updated), the button
 *   group (Open in SotF Mods Manager, Download .sotfprofile) and Follow, Copy link, Report.
 * - Body: the ordered mods (picture, author, version, dependency and unavailable marks), the
 *   description and the comments; the side column lists the details (mods, total size,
 *   multiplayer support, downloads, dates). Incompatible pairs and unavailable mods are noted.
 * - Social layer (`components/modpacks/social.ts`): follow with undo, live counters, comments.
 * - Pending, hidden or missing modpacks are 404. Cache: E(detail) tagged with the kit and owner;
 *   the API failing gives 503, never cached.
 */
import { KIT_COMMENT_RULES } from '@sotf/contracts/kit-social';
import { profilePath } from '@sotf/contracts/seo';
import { formatBytes, formatCompactNumber, formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { Avatar } from '@sotf/ui/avatar';
import { PROSE_LOCATOR_CLASSES } from '@sotf/ui/domain';
import { Icon } from '@sotf/ui/icons';
import { AlertTriangle, Ban, Download, Flag, Heart, Info, Layers, Link as LinkIcon, MonitorDown, Package } from 'lucide-react';
import { loginHrefFor } from '../../../components/mod/format.ts';
import { configureModDomainI18n, markdownLabels } from '../../../components/mod/i18n.ts';
import ReportDialog from '../../../components/mod/ReportDialog.astro';
import { respondNotFound } from '../../../components/mod/responses.ts';
import { loadModpack } from '../../../components/modpacks/data.ts';
import type { ModpackSocialData } from '../../../components/modpacks/social.ts';
import PageState from '../../../components/state/PageState.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { setPageCache } from '../../../lib/cache/page.ts';
import { pageCache } from '../../../lib/cache/policy.ts';
import { loadEnv } from '../../../lib/env.ts';
import { href } from '../../../lib/i18n.ts';
import { itemListJsonLd } from '../../../lib/seo/jsonld.ts';
import { managerModpackLink } from '../../../lib/site.ts';

export const prerender = false;

configureModDomainI18n();
const locale = Astro.locals.locale;
const user = Astro.params.user ?? '';
const slug = Astro.params.slug ?? '';
const SEGMENT = /^[\w.-]{1,64}$/;
if (!SEGMENT.test(user) || !SEGMENT.test(slug)) return respondNotFound(Astro);

const data = await loadModpack(user, slug);
if (data === 'missing') return respondNotFound(Astro);
if (data === null) {
  setPageCache(Astro, false);
  Astro.response.status = 503;
} else {
  setPageCache(Astro, pageCache.modpack(data.id, data.owner.id));
}
const pack = data;

type Row =
  | { kind: 'mod'; position: number; item: NonNullable<typeof pack>['items'][number] }
  | { kind: 'gone'; position: number; name: string; manifestId: string };
const rows: Row[] = pack
  ? [
      ...pack.items.map((item) => ({ kind: 'mod' as const, position: item.position, item })),
      ...pack.unavailable.map((gone) => ({ kind: 'gone' as const, position: gone.position, name: gone.name, manifestId: gone.manifestId })),
    ].sort((a, b) => a.position - b.position)
  : [];
const unavailableCount = rows.filter((row) => row.kind === 'gone' || !row.item.available).length;
const author = pack ? pack.owner.displayName || pack.owner.handle : '';
const path = pack ? pack.canonicalPath : `/modpacks/${user}/${slug}`;
const loginHref = loginHrefFor(href('/login', locale), href(path, locale));
const downloadHref = pack
  ? `/api/modpacks/slug/${encodeURIComponent(pack.owner.handle)}/${encodeURIComponent(pack.slug)}/download`
  : '#';
// A cover narrower than this looks blurry at the size of the media column: use the collage then.
const COVER_MIN_WIDTH = 640;
const cover = pack?.cover && (pack.cover.width ?? 0) >= COVER_MIN_WIDTH ? pack.cover : null;
const collage = pack
  ? pack.items
      .filter((item) => item.available && item.mod.thumbnail)
      .slice(0, 4)
      .map((item) => item.mod.thumbnail as NonNullable<typeof item.mod.thumbnail>)
  : [];
const multiplayer = pack
  ? [
      { label: m.common_multiplayer_everyone(), count: pack.multiplayer.allPlayers },
      { label: m.common_multiplayer_host_only(), count: pack.multiplayer.hostOnly },
      { label: m.mod_multiplayer_client_side(), count: pack.multiplayer.clientSide },
      { label: m.common_multiplayer_solo_only(), count: pack.multiplayer.singleplayerOnly },
    ].filter((row) => row.count > 0)
  : [];
const labels = markdownLabels();
const siteUrl = loadEnv().siteUrl;
const description = pack ? m.modpacks_detail_description({ name: pack.name, author, count: pack.itemsCount }) : m.modpacks_error_text();
const jsonLd = pack
  ? [
      itemListJsonLd({
        url: `${siteUrl}${href(path, locale)}`,
        name: pack.name,
        items: pack.items.map((item) => ({ name: item.mod.name, url: `${siteUrl}${href(item.mod.canonicalPath, locale)}` })),
      }),
    ]
  : [];

/** `{n}` templates per plural category, read from an ICU message by rendering sample counts. */
function pluralTemplates(render: (count: number) => string): Record<string, string> {
  const rules = new Intl.PluralRules(locale);
  const out: Record<string, string> = {};
  for (const n of [0, 1, 2, 3, 5, 11, 21, 22, 101, 1.5]) {
    const category = rules.select(n);
    if (out[category]) continue;
    const formatted = new Intl.NumberFormat(locale).format(n);
    out[category] = render(n).replace(formatted, '{n}');
  }
  return out;
}

const social: ModpackSocialData | null = pack
  ? {
      kitId: pack.id,
      ownerId: pack.owner.id,
      locale,
      loginHref,
      profileHref: href(profilePath('{handle}'), locale).replace('%7Bhandle%7D', '{handle}'),
      commentMax: KIT_COMMENT_RULES.bodyMax,
      messages: {
        follow: m.common_action_follow(),
        following: m.common_action_following(),
        followed: m.mod_toast_followed({ name: pack.name }),
        unfollowed: m.mod_toast_unfollowed({ name: pack.name }),
        undo: m.social_action_undo(),
        signInRequired: m.mod_toast_sign_in(),
        verifyEmail: m.mod_toast_verify_email(),
        rateLimited: m.mod_toast_rate_limited(),
        error: m.mod_toast_error(),
        followers: pluralTemplates((count) => m.common_followers_count({ count })),
        comments: pluralTemplates((count) => m.common_comments_count({ count })),
        commentsEmpty: m.modpacks_comments_empty(),
        commentsLoading: m.social_loading(),
        commentsLoadFailed: m.modpacks_comments_load_failed(),
        retry: m.social_action_retry(),
        loadMore: m.social_action_load_more(),
        formLabel: m.social_comment_label(),
        formPlaceholder: m.modpacks_comment_placeholder(),
        formSubmit: m.social_comment_submit(),
        formEmpty: m.social_comment_empty(),
        formTooLong: m.social_comment_too_long({ max: KIT_COMMENT_RULES.bodyMax }),
        reply: m.social_reply(),
        replyLabel: m.social_reply_to_label({ name: '{name}' }),
        replySubmit: m.social_comment_reply_submit(),
        cancel: m.social_action_cancel(),
        edit: m.social_action_edit(),
        save: m.social_action_save(),
        delete: m.social_action_delete(),
        deletedNote: m.modpacks_comment_removed_note(),
        owner: m.modpacks_comment_owner(),
        edited: m.modpacks_comment_edited(),
        signInToComment: m.social_comment_sign_in(),
        verifyToComment: m.social_verify_to_comment(),
        posted: m.social_comment_posted(),
        saved: m.social_comment_edited(),
        removed: m.social_comment_deleted(),
        deletedAuthor: m.social_deleted_user(),
      },
    }
  : null;
const ACTION =
  'inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-fg-muted hover:bg-fg/6 hover:text-fg aria-pressed:text-primary aria-busy:cursor-progress focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus';
---

<PageLayout
  template="modpack"
  width="wide"
  seo={{
    title: pack ? m.modpacks_detail_title({ name: pack.name }) : m.modpacks_error_title(),
    description,
    path,
    noindex: pack ? pack.noindex : true,
    ...(pack?.ogImage
      ? { og: { image: pack.ogImage.url, imageAlt: pack.name, imageWidth: pack.ogImage.width, imageHeight: pack.ogImage.height } }
      : cover
        ? { og: { image: cover.url, imageAlt: pack?.name ?? '', ...(cover.width && cover.height ? { imageWidth: cover.width, imageHeight: cover.height } : {}) } }
        : {}),
  }}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: m.common_nav_home(), path: '/' },
    { label: m.modpacks_nav(), path: '/modpacks' },
    { label: pack?.name ?? m.modpacks_error_title() },
  ]}
>
  {
    pack === null || social === null ? (
      <PageState
        kind="error"
        title={m.modpacks_error_title()}
        text={m.modpacks_error_text()}
        retryHref={href(Astro.url.pathname, locale)}
        reference={Astro.locals.requestId}
      />
    ) : (
      <div class="flex flex-col gap-10" data-modpack-root>
        <section class="grid items-start gap-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-10">
          <div class="aspect-video overflow-hidden rounded-lg bg-sunken">
            {cover ? (
              <img
                src={cover.url}
                srcset={cover.srcset ?? undefined}
                sizes="(min-width: 1024px) 58vw, 100vw"
                alt=""
                fetchpriority="high"
                class="size-full object-cover"
              />
            ) : collage.length > 0 ? (
              <div class:list={['grid size-full gap-0.5', collage.length > 1 && 'grid-cols-2', collage.length > 2 && 'grid-rows-2']}>
                {collage.map((image, index) => (
                  <img
                    src={image.url}
                    srcset={image.srcset ?? undefined}
                    sizes="(min-width: 1024px) 29vw, 50vw"
                    alt=""
                    class:list={['size-full object-cover', collage.length === 3 && index === 0 && 'row-span-2']}
                  />
                ))}
              </div>
            ) : (
              <div class="flex size-full items-center justify-center text-fg-subtle">
                <Icon icon={Layers} size={56} />
              </div>
            )}
          </div>

          <div class="flex min-w-0 flex-col gap-5">
            <div class="flex flex-col gap-3">
              <h1 class="text-3xl font-extrabold tracking-tight text-balance break-words text-fg md:text-4xl">{pack.name}</h1>
              <a href={href(profilePath(pack.owner.handle), locale)} class="inline-flex w-fit items-center gap-2 text-base font-semibold text-fg hover:text-link">
                <Avatar name={author} id={pack.owner.id} src={pack.owner.avatarUrl} size={24} />
                {author}
              </a>
            </div>
            <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-fg-muted tabular-nums">
              <li>{m.modpacks_mods_count({ count: pack.itemsCount })}</li>
              <li>{m.modpacks_downloads_count({ count: pack.downloads })}</li>
              <li data-kit-followers={pack.followersCount}>{m.common_followers_count({ count: pack.followersCount })}</li>
              <li>{m.modpacks_updated({ date: formatDate(locale, pack.updatedAt, 'medium') })}</li>
            </ul>
            <div class="grid grid-cols-1 overflow-hidden rounded-lg border border-border-strong sm:grid-cols-[minmax(0,1fr)_auto]">
              <a
                href={managerModpackLink(pack.owner.handle, pack.slug)}
                data-manager-placement="modpack"
                class="flex h-12 items-center justify-center gap-2 bg-primary px-5 text-base font-bold text-primary-fg transition-colors hover:bg-primary-hover focus-visible:relative focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus"
              >
                <Icon icon={MonitorDown} size={18} />
                {m.modpacks_open_in_manager()}
              </a>
              <a
                href={downloadHref}
                download={`${pack.slug}.sotfprofile`}
                rel="nofollow"
                class="flex h-12 items-center justify-center gap-2 border-border-strong bg-surface px-5 text-sm font-semibold text-fg transition-colors hover:bg-raised max-sm:border-t sm:border-s focus-visible:relative focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus"
              >
                <Icon icon={Download} size={16} />
                {m.modpacks_download()}
              </a>
            </div>
            <p class="flex items-start gap-2 text-sm text-pretty text-fg-muted">
              <Icon icon={Info} size={16} className="mt-0.5 shrink-0" />
              <span>
                {m.modpacks_howto()}{' '}
                <a href={href('/manager', locale)} class="font-medium text-link underline underline-offset-3">{m.modpacks_get_manager()}</a>
              </span>
            </p>
            <div class="-ms-2.5 flex flex-wrap items-center gap-1">
              <a href={loginHref} data-kit-follow class={ACTION}>
                <Icon icon={Heart} size={16} className="[[aria-pressed=true]_&]:fill-current" />
                <span data-follow-label>{m.common_action_follow()}</span>
              </a>
              <button
                type="button"
                data-modpack-copy={href(pack.canonicalPath, locale)}
                data-copied={m.modpacks_link_copied()}
                data-copy-failed={m.modpacks_link_copy_failed()}
                class={ACTION}
              >
                <Icon icon={LinkIcon} size={16} />
                {m.modpacks_copy_link()}
              </button>
              <button type="button" hidden data-dialog-open="report-dialog" data-js-only class={ACTION}>
                <Icon icon={Flag} size={16} />
                {m.mod_action_report()}
              </button>
            </div>
          </div>
        </section>

        {(pack.conflictPairs.length > 0 || unavailableCount > 0) && (
          <div class="grid gap-3">
            {pack.conflictPairs.length > 0 && (
              <div role="note" class="flex items-start gap-3 rounded-lg border border-danger/50 bg-danger-soft p-4 text-sm text-fg">
                <Icon icon={AlertTriangle} size={18} className="mt-0.5 shrink-0 text-danger" />
                <div class="grid gap-1">
                  <p class="font-semibold">{m.modpacks_conflicts_title()}</p>
                  <ul class="grid gap-0.5">
                    {pack.conflictPairs.map(([a, b]) => <li>{m.modpacks_conflict_pair({ a, b })}</li>)}
                  </ul>
                </div>
              </div>
            )}
            {unavailableCount > 0 && (
              <div role="note" class="flex items-start gap-3 rounded-lg border border-warning/50 bg-warning-soft p-4 text-sm text-fg">
                <Icon icon={Ban} size={18} className="mt-0.5 shrink-0 text-warning" />
                <p>{m.modpacks_unavailable_count({ count: unavailableCount })}</p>
              </div>
            )}
          </div>
        )}

        <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] xl:grid-cols-[minmax(0,1fr)_20rem]">
          <div class="flex min-w-0 flex-col gap-12">
            <section aria-labelledby="modpack-mods">
              <h2 id="modpack-mods" class="text-xl font-bold text-fg md:text-2xl">{m.modpacks_mods_title()}</h2>
              <ol class="mt-4 border-t border-border">
                {rows.map((row, index) =>
                  row.kind === 'mod' ? (
                    <li class:list={['grid grid-cols-[1.75rem_6rem_minmax(0,1fr)] items-center gap-3 border-b border-border py-3 sm:grid-cols-[2rem_7rem_minmax(0,1fr)_auto]', !row.item.available && 'opacity-60']}>
                      <span class="text-end text-sm text-fg-subtle tabular-nums">{index + 1}</span>
                      <span class="block aspect-video overflow-hidden rounded-md bg-sunken">
                        {row.item.mod.thumbnail ? (
                          <img
                            src={row.item.mod.thumbnail.url}
                            srcset={row.item.mod.thumbnail.srcset ?? undefined}
                            sizes="112px"
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="size-full object-cover"
                          />
                        ) : (
                          <span class="flex size-full items-center justify-center text-fg-subtle">
                            <Icon icon={Package} size={20} />
                          </span>
                        )}
                      </span>
                      <span class="grid min-w-0 gap-0.5">
                        <a href={href(row.item.mod.canonicalPath, locale)} class="truncate font-semibold text-fg hover:text-link">
                          {row.item.mod.name}
                        </a>
                        <span class="flex min-w-0 flex-wrap gap-x-3 text-sm text-fg-muted">
                          <span class="truncate">{m.modpacks_by({ author: row.item.mod.userDisplayName || row.item.mod.userHandle })}</span>
                          {row.item.mod.latestVersion && <span class="font-mono text-xs leading-5 text-fg-subtle">v{row.item.mod.latestVersion}</span>}
                        </span>
                      </span>
                      {(row.item.isAutoDependency || !row.item.available) && (
                        <span class="col-start-3 text-xs font-semibold text-fg-muted sm:col-start-auto sm:text-end">
                          {!row.item.available ? m.modpacks_unavailable() : m.modpacks_dependency()}
                        </span>
                      )}
                    </li>
                  ) : (
                    <li class="grid grid-cols-[1.75rem_6rem_minmax(0,1fr)] items-center gap-3 border-b border-border py-3 opacity-60 sm:grid-cols-[2rem_7rem_minmax(0,1fr)_auto]">
                      <span class="text-end text-sm text-fg-subtle tabular-nums">{index + 1}</span>
                      <span class="flex aspect-video items-center justify-center rounded-md bg-sunken text-fg-subtle">
                        <Icon icon={Ban} size={20} />
                      </span>
                      <span class="grid min-w-0 gap-0.5">
                        <span class="truncate font-semibold text-fg">{row.name}</span>
                        <span class="truncate font-mono text-xs text-fg-subtle">{row.manifestId}</span>
                      </span>
                      <span class="col-start-3 text-xs font-semibold text-fg-muted sm:col-start-auto sm:text-end">{m.modpacks_unavailable()}</span>
                    </li>
                  ),
                )}
              </ol>
            </section>

            {pack.descriptionHtml && (
              <section aria-labelledby="modpack-about">
                <h2 id="modpack-about" class="text-xl font-bold text-fg md:text-2xl">{m.modpacks_about_title()}</h2>
                <div class:list={[PROSE_LOCATOR_CLASSES, 'prose-base mt-4']} set:html={localizeHtml(pack.descriptionHtml, labels)} />
              </section>
            )}

            <section aria-labelledby="modpack-comments" id="comments" class="scroll-mt-(--sticky-top)" data-kit-comments>
              <h2 id="modpack-comments" class="text-xl font-bold text-fg md:text-2xl" data-kit-comments-count>{m.mod_tab_comments()}</h2>
              <div class="mt-4" data-kit-comments-form>
                <a href={loginHref} rel="nofollow" class="inline-flex h-10 items-center rounded-md border border-border-strong px-4 text-sm font-semibold text-fg hover:bg-fg/6">
                  {m.social_comment_sign_in()}
                </a>
              </div>
              <p class="mt-6 text-sm text-fg-muted" data-kit-comments-status>{m.social_loading()}</p>
              <div class="mt-2 divide-y divide-border" data-kit-comments-list></div>
              <button
                type="button"
                hidden
                data-kit-comments-more
                class="mt-4 inline-flex h-10 items-center rounded-md border border-border-strong px-4 text-sm font-semibold text-fg hover:bg-fg/6 aria-busy:cursor-progress"
              >
                {m.social_action_load_more()}
              </button>
            </section>
          </div>

          <aside aria-labelledby="modpack-details" class="lg:sticky lg:top-[calc(var(--sticky-top)+1rem)]">
            <h2 id="modpack-details" class="text-base font-semibold text-fg">{m.mod_details_title()}</h2>
            <dl class="mt-3 border-t border-border text-sm">
              <div class="flex justify-between gap-4 border-b border-border py-3">
                <dt class="text-fg-muted">{m.modpacks_detail_mods()}</dt>
                <dd class="font-medium text-fg tabular-nums">{formatNumber(locale, pack.itemsCount)}</dd>
              </div>
              {pack.totalBytes !== null && (
                <div class="flex justify-between gap-4 border-b border-border py-3">
                  <dt class="text-fg-muted">{m.modpacks_detail_size()}</dt>
                  <dd class="font-medium text-fg tabular-nums">{formatBytes(locale, pack.totalBytes)}</dd>
                </div>
              )}
              {multiplayer.length > 0 && (
                <div class="grid gap-2 border-b border-border py-3">
                  <dt class="text-fg-muted">{m.modpacks_detail_multiplayer()}</dt>
                  <dd>
                    <ul class="grid gap-1">
                      {multiplayer.map((row) => (
                        <li class="flex justify-between gap-4">
                          <span class="text-fg">{row.label}</span>
                          <span class="font-medium text-fg tabular-nums">{formatNumber(locale, row.count)}</span>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
              <div class="flex justify-between gap-4 border-b border-border py-3">
                <dt class="text-fg-muted">{m.modpacks_stat_downloads()}</dt>
                <dd class="font-medium text-fg tabular-nums">{formatCompactNumber(locale, pack.downloads)}</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-border py-3">
                <dt class="text-fg-muted">{m.modpacks_detail_created()}</dt>
                <dd class="font-medium text-fg"><time datetime={pack.createdAt}>{formatDate(locale, pack.createdAt, 'medium')}</time></dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-border py-3">
                <dt class="text-fg-muted">{m.modpacks_stat_updated()}</dt>
                <dd class="font-medium text-fg"><time datetime={pack.updatedAt}>{formatDate(locale, pack.updatedAt, 'medium')}</time></dd>
              </div>
            </dl>
          </aside>
        </div>

        <ReportDialog mod={{ id: pack.id, name: pack.name }} loginHref={loginHref} targetType="kit" />
        <script type="application/json" id="modpack-social" set:html={JSON.stringify(social).replace(/</g, '\\u003c')} />
      </div>
    )
  }
</PageLayout>

<script>
  import { initModpackSocial, type ModpackSocialData } from '../../../components/modpacks/social.ts';
  import { toast } from '../../../lib/client/toast.ts';
  import { DIALOG_OPEN_EVENT, type DialogOpenDetail, initDialogs } from '../../../scripts/mod/dialogs.ts';
  import { whenSession } from '../../../scripts/mod/session.ts';

  const root = document.querySelector<HTMLElement>('[data-modpack-root]');
  const raw = document.getElementById('modpack-social')?.textContent;
  if (root && raw) {
    initDialogs(root);
    initModpackSocial(root, JSON.parse(raw) as ModpackSocialData);
    document.addEventListener(DIALOG_OPEN_EVENT, (event) => {
      const { id, dialog } = (event as CustomEvent<DialogOpenDetail>).detail;
      if (id === 'report-dialog') {
        void whenSession().then((summary) => import('../../../scripts/mod/report.ts').then(({ bindReport }) => bindReport(dialog, summary)));
      }
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-modpack-copy]')) {
    button.addEventListener('click', async () => {
      const url = new URL(button.dataset.modpackCopy ?? '/', window.location.origin).href;
      try {
        await navigator.clipboard.writeText(url);
        toast.success(button.dataset.copied ?? '');
      } catch {
        toast.error(button.dataset.copyFailed ?? '');
      }
    });
  }
</script>
