---
/**
 * `/reset-password?token=` (PLAN §4.2, §4.6: v2 tokens and, for 24 h after the cut-over, legacy
 * reset tokens). The URL carries a secret, so the response is never cached (no edge entry, no
 * origin LRU entry keyed by the token); the island removes the token from the address bar.
 */
import { toHtmlLang } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import AuthShell from '../components/account/AuthShell.astro';
import { islandMessages } from '../islands/auth/messages.server.ts';
import ResetPasswordForm from '../islands/auth/ResetPasswordForm.tsx';
import { setPageCache } from '../lib/cache/page.ts';

setPageCache(Astro, false);
Astro.response.headers.set('referrer-policy', 'no-referrer');
const locale = Astro.locals.locale;
---

<AuthShell
  template="reset-password"
  title={m.auth_meta_reset_title()}
  description={m.auth_meta_reset_description()}
  heading={m.auth_reset_heading()}
  intro={m.auth_reset_intro()}
>
  <ResetPasswordForm
    client:load
    locale={locale}
    lang={toHtmlLang(locale)}
    messages={islandMessages('ResetPasswordForm', locale)} />
</AuthShell>
