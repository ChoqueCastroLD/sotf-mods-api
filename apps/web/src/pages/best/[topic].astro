---
/**
 * `/best/:topic` — GEO hubs (PLAN §4.2, §8): `mods`, `quality-of-life-mods`, `multiplayer-mods`,
 * `dedicated-server-mods`, `building-mods`, `libraries`. Fixed catalogue queries
 * (`content/best/hubs.ts`), an editorial intro per locale (`content/best/<topic>/<locale>.md`)
 * and «updated on {date}» (the most recent release among the listed items).
 *
 * Indexable from 5 items (the same threshold as the best sitemap); E(3600) `list:mods`. Unknown topic → 404; other letter cases → 301.
 */
import type { ModCardDTO } from '@sotf/contracts/catalog';
import { formatDate, toHtmlLang } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { buttonClasses } from '@sotf/ui/button';
import { Icon } from '@sotf/ui/icons';
import { ArrowRight } from 'lucide-react';
import { exploreDomainI18n } from '../../components/explore/domain-i18n.ts';
import ExploreResults from '../../components/explore/ExploreResults.tsx';
import { ListingEmpty, ListingError } from '../../components/explore/ExploreStates.tsx';
import { collectionJsonLd, latestRelease } from '../../components/explore/seo.ts';
import { EXPLORE_PAGE_SIZE } from '../../components/explore/state.ts';
import { loadTaxonomy } from '../../components/explore/taxonomy.ts';
import { BEST_TOPICS, type BestTopic, HUBS, hubIntro, isBestTopic } from '../../content/best/hubs.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import { serverApi } from '../../lib/api.ts';
import { setPageCache } from '../../lib/cache/page.ts';
import { EDGE_TTL, pageCache } from '../../lib/cache/policy.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import { BEST_INDEX_MIN_ITEMS } from '../../lib/seo/sitemaps.ts';

const locale = Astro.locals.locale;
const raw = Astro.params.topic ?? '';
const requested = raw.toLowerCase();
if (!isBestTopic(requested)) {
  setPageCache(Astro, pageCache.notFound());
  return new Response(null, { status: 404 });
}
if (requested !== raw) {
  setPageCache(Astro, pageCache.custom(EDGE_TTL.hour, ['list:mods']));
  return Astro.redirect(href(`/best/${requested}`, locale), 301);
}
const topic: BestTopic = requested;
setPageCache(Astro, pageCache.custom(EDGE_TTL.hour, ['list:mods']));

const hub = HUBS[topic];
const [taxonomy, results] = await Promise.all([
  loadTaxonomy(locale),
  Promise.allSettled(
    hub.queries.map((query) =>
      serverApi().catalog.listMods(
        { query: { ...query, sort: 'downloads', order: 'desc', page: 1, pageSize: Math.min(hub.limit, EXPLORE_PAGE_SIZE) } },
        { signal: AbortSignal.timeout(5000) },
      ),
    ),
  ),
]);
const failed = results.every((result) => result.status === 'rejected');
const merged = new Map<number, ModCardDTO>();
for (const result of results) {
  if (result.status !== 'fulfilled') continue;
  for (const item of result.value.items) if (!merged.has(item.id)) merged.set(item.id, item);
}
const items = [...merged.values()].sort((a, b) => b.downloads - a.downloads).slice(0, hub.limit);
if (failed) {
  setPageCache(Astro, false);
  Astro.response.status = 503;
}

type MessageFn = (inputs?: Record<string, unknown>) => string;
const messages = m as unknown as Record<string, MessageFn>;
const key = topic.replace(/-/g, '_');
const copy = (suffix: string, inputs: Record<string, unknown> = {}) => messages[`explore_best_${key}_${suffix}`]?.(inputs) ?? '';
const heading = copy('heading');
const title = copy('title', { count: items.length });
const description = copy('description');
const intro = hubIntro(topic, locale);
const updated = latestRelease(items);
// «Updated {date}» with the date inside a <time> element, in each language's word order.
const DATE_SLOT = '\uE000';
const [updatedBefore = '', updatedAfter = ''] = m.explore_hub_updated({ date: DATE_SLOT }).split(DATE_SLOT);
const updatedParts = [updatedBefore, updatedAfter] as const;
const i18n = exploreDomainI18n(locale, (nameKey, fallback) => taxonomy.byNameKey(nameKey, fallback));
const siteUrl = loadEnv().siteUrl;
const path = `/best/${topic}`;
const jsonLd = items.length
  ? [collectionJsonLd({ siteUrl, locale, path, name: heading, description, items, dateModified: updated })]
  : [];
const others = BEST_TOPICS.filter((other) => other !== topic).map((other) => ({
  href: href(`/best/${other}`, locale),
  label: messages[`explore_best_${other.replace(/-/g, '_')}_heading`]?.({}) ?? other,
}));
---

<PageLayout
  template="best"
  width="wide"
  seo={{ title, description, path, noindex: failed || items.length < BEST_INDEX_MIN_ITEMS }}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: m.common_nav_home(), path: '/' },
    { label: m.common_term_mods(), path: '/mods' },
    { label: heading },
  ]}
>
  <article class="flex flex-col gap-8" aria-labelledby="best-heading">
    <header class="flex flex-col gap-3">
      <p class="readout text-signal">{m.explore_readout_hub()}</p>
      <h1 id="best-heading" class="font-display-caps text-display-sm text-fg">{heading}</h1>
      {
        updated && (
          <p class="font-mono text-sm text-fg-muted">
            {updatedParts[0]}
            <time datetime={updated}>{formatDate(locale, updated, 'long')}</time>
            {updatedParts[1]}
          </p>
        )
      }
      {
        intro && (
          <div
            lang={intro.locale === locale ? undefined : toHtmlLang(intro.locale)}
            class="prose-locator max-w-(--container-prose) text-base text-fg-muted [&_a]:text-link [&_a]:underline [&_p]:mb-3 [&_strong]:text-fg"
          >
            <intro.Content />
          </div>
        )
      }
    </header>

    <section aria-labelledby="best-list-title" class="flex flex-col gap-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 id="best-list-title" class="font-display-caps text-display-xs text-fg">
          {m.explore_hub_top({ count: items.length })}
        </h2>
        <a href={href(hub.explore, locale)} class="inline-flex items-center gap-1 text-sm font-medium text-link hover:underline">
          {m.explore_hub_see_all()}
          <Icon icon={ArrowRight} size={14} className="rtl:rotate-180" />
        </a>
      </div>
      {
        failed ? (
          <ListingError
            title={m.explore_error_title()}
            text={m.explore_error_text()}
            retryHref={href(Astro.url.pathname, locale)}
            reference={Astro.locals.requestId}
          />
        ) : items.length === 0 ? (
          <ListingEmpty
            title={m.explore_empty_category_title()}
            text={m.explore_empty_category_text()}
            action={{ label: m.explore_hub_see_all(), href: href('/mods', locale) }}
          />
        ) : (
          <ExploreResults items={items} view="grid" locale={locale} i18n={i18n} priorityFirst />
        )
      }
      <div class="flex justify-center">
        <a href={href(hub.explore, locale)} class={buttonClasses({ variant: 'secondary', size: 'md' })}>
          {m.explore_hub_see_all()}
        </a>
      </div>
    </section>

    <nav aria-labelledby="best-others-title" class="border-t border-border pt-6">
      <h2 id="best-others-title" class="readout mb-3">{m.explore_hub_others()}</h2>
      <ul class="flex flex-wrap gap-2">
        {
          others.map((other) => (
            <li>
              <a
                href={other.href}
                class="inline-flex h-9 items-center rounded-full border border-border-strong px-3 text-sm text-fg hover:border-primary hover:bg-fg/6"
              >
                {other.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</PageLayout>
