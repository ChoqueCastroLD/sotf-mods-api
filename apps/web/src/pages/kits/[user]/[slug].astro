---
/**
 * Kit page `/kits/:user/:slug` (WP-71, PLAN §7.8, research/03 §6.5 «DETALLE»). SSR, edge-cached
 * 900 s with `kit:{id}` (purged by every kit write); the resolver answers 301/404/410 for renamed,
 * mistyped or deleted kits, private kits are 404.
 *
 * Knolling header, curator and revision, «Download all» (sequential checklist sheet), share code
 * + short URL + QR, fork, the multiplayer and compatibility summaries and the total size, the
 * ordered items (notes, pins, auto-added dependencies) and the sidebar (description, revisions,
 * more kits of the curator). Everything user-specific (the owner's «Edit», fork) is resolved by
 * the page script after load; the HTML is the same for every visitor.
 */
import { kitShortPath } from '@sotf/contracts/kits';
import { profilePath } from '@sotf/contracts/seo';
import { formatCompactNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { Breadcrumbs } from '@sotf/ui/breadcrumbs';
import { KitCard, ProseLocator } from '@sotf/ui/domain';
import { Icon } from '@sotf/ui/icons';
import {
  CircleAlert,
  CircleCheck,
  CircleHelp,
  Copy,
  Download,
  GitFork,
  HardDrive,
  Heart,
  Layers,
  Pencil,
  Share2,
  Star,
  Users,
} from 'lucide-react';
import DownloadAllDialog from '../../../components/kits/DownloadAllDialog.astro';
import { loadCurrentBuild, loadMoreFromCurator, resolveKitPage } from '../../../components/kits/data.ts';
import {
  type CompatLine,
  compatLines,
  dateLabel,
  downloadableItems,
  kitUrl,
  loginHref,
  multiplayerParts,
  SLOT,
  splitSlot,
  totalSizeLabel,
} from '../../../components/kits/format.ts';
import KitItems from '../../../components/kits/KitItems.astro';
import KitPageData from '../../../components/kits/KitPageData.astro';
import KitScripts from '../../../components/kits/KitScripts.astro';
import { KitsEmpty } from '../../../components/kits/KitStates.tsx';
import KnollingMat from '../../../components/kits/KnollingMat.astro';
import ShareKitDialog from '../../../components/kits/ShareKitDialog.astro';
import { kitDescription, kitJsonLd, kitTitle } from '../../../components/kits/seo.ts';
import { configureModDomainI18n, markdownLabels } from '../../../components/mod/i18n.ts';
import { respondUnresolved } from '../../../components/mod/responses.ts';
import { ACTION_CLASSES, PANEL_CLASSES, SECTION_TITLE_CLASSES } from '../../../components/mod/styles.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { setPageCache } from '../../../lib/cache/page.ts';
import { pageCache } from '../../../lib/cache/policy.ts';
import { loadEnv } from '../../../lib/env.ts';
import { href } from '../../../lib/i18n.ts';
import { ensureLocals } from '../../../lib/request-context.ts';
import { breadcrumbJsonLd } from '../../../lib/seo/jsonld.ts';

export const prerender = false;

configureModDomainI18n();
const locale = ensureLocals(Astro).locale;
const resolved = await resolveKitPage(Astro);
if (resolved.kind !== 'ok') return respondUnresolved(Astro, resolved);

const { kit } = resolved;
setPageCache(Astro, pageCache.kit(kit.id));
const [currentBuild, moreKits] = await Promise.all([loadCurrentBuild(), loadMoreFromCurator(kit)]);

const env = loadEnv();
const url = kitUrl(kit, locale, env.siteUrl);
const login = loginHref(locale, kit.canonicalPath);
const curator = kit.owner.displayName || kit.owner.handle;
const description = kitDescription(kit);
const descriptionHtml = kit.descriptionHtml?.trim() ? localizeHtml(kit.descriptionHtml, markdownLabels()) : '';
const downloadable = downloadableItems(kit);
const size = totalSizeLabel(kit, locale);
const mpParts = multiplayerParts(kit);
const compat = compatLines(kit, currentBuild);
const explicitCount = kit.items.filter((item) => !item.isAutoDependency).length;
const autoCount = kit.items.length - explicitCount;
const [curatedBefore, curatedAfter] = splitSlot(m.kits_curated_by({ curator: SLOT }));
const [forkBefore, forkAfter] = kit.forkedFrom
  ? splitSlot(m.kits_forked_from({ kit: SLOT, handle: kit.forkedFrom.ownerHandle }))
  : ['', ''];
const ogImage = kit.ogImage?.url ?? kit.cover?.url ?? kit.previewThumbnails[0];
const ogSized = kit.ogImage !== null && ogImage === kit.ogImage?.url;
const trail = [
  { label: m.common_nav_home(), path: '/' },
  { label: m.common_term_kits(), path: '/kits' },
  { label: kit.name },
];
const graph = [
  kitJsonLd({ kit, locale, siteUrl: env.siteUrl, description }),
  breadcrumbJsonLd(
    trail.map((crumb) => ({
      name: crumb.label,
      url: crumb.path === undefined ? undefined : `${env.siteUrl}${href(crumb.path, locale)}`,
    })),
  ),
];
const compatIcon: Record<CompatLine['tone'], typeof CircleCheck> = {
  works: CircleCheck,
  untested: CircleHelp,
  broken: CircleAlert,
  conflicts: CircleAlert,
};
const compatTone: Record<CompatLine['tone'], string> = {
  works: 'text-success',
  untested: 'text-warning',
  broken: 'text-danger',
  conflicts: kit.compat.conflicts > 0 ? 'text-danger' : 'text-fg-muted',
};
---

<BaseLayout
  template="kit"
  seo={{
    title: kitTitle(kit),
    description,
    path: kit.canonicalPath,
    noindex: kit.noindex,
    og: {
      imageAlt: m.kits_og_alt({ name: kit.name }),
      type: 'website',
      ...(ogImage ? { image: ogImage } : {}),
      ...(ogSized ? { imageWidth: 1200, imageHeight: 630 } : {}),
    },
  }}
  jsonLd={graph}
  entity={{ type: 'kit', id: kit.id }}
>
  <div data-kit-page data-kit-id={kit.id}>
    <div class="mx-auto grid w-full max-w-(--container-content) gap-6 px-4 py-6 md:px-6 md:py-8">
      <Breadcrumbs
        items={trail.map((crumb) => ({
          label: crumb.label,
          href: crumb.path === undefined ? undefined : href(crumb.path, locale),
        }))}
      />

      {
        kit.visibility === 'unlisted' && (
          <p class="rounded-lg border border-border bg-surface px-4 py-3 text-sm text-fg-muted" role="note">
            <strong class="font-semibold text-fg">{m.kits_unlisted_title()}</strong> {m.kits_unlisted_text()}
          </p>
        )
      }

      <KnollingMat kit={kit} />

      <header class="grid gap-4">
        <div class="grid gap-2">
          <p class="readout text-signal">
            {m.kits_detail_readout()} · <span class="font-mono">{kit.code}</span>
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="font-display-caps text-display-sm break-words text-fg">{kit.name}</h1>
            {
              kit.isStaffPick && (
                <span class="inline-flex items-center gap-1 rounded-full border border-primary/50 bg-primary/10 px-2.5 py-1 text-xs font-semibold text-fg">
                  <Icon icon={Star} size={12} />
                  {m.kits_staff_pick()}
                </span>
              )
            }
          </div>
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-fg-muted">
            <span>
              {curatedBefore}<a
                href={href(profilePath(kit.owner.handle), locale)}
                class="font-semibold text-fg hover:text-link hover:underline">{curator}</a
              >{curatedAfter}
            </span>
            <span aria-hidden="true">·</span>
            <span>
              {m.kits_revision({ revision: kit.revision })}
              (<time datetime={kit.updatedAt}>{dateLabel(kit.updatedAt, locale)}</time>)
            </span>
            <span aria-hidden="true">·</span>
            <span data-kit-followers={kit.followersCount} data-kit-followers-text>
              {m.kits_followers({ count: kit.followersCount, display: formatCompactNumber(locale, kit.followersCount) })}
            </span>
          </p>
          {
            kit.forkedFrom && (
              <p class="flex items-center gap-1.5 text-sm text-fg-muted">
                <Icon icon={GitFork} size={14} />
                <span>
                  {forkBefore}<a
                    href={href(kit.forkedFrom.canonicalPath, locale)}
                    class="font-semibold text-link hover:underline">{kit.forkedFrom.name}</a
                  >{forkAfter}
                </span>
              </p>
            )
          }
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {
            downloadable.length > 0 && (
              <a
                href="#kit-items"
                data-dialog-open="kit-download-dialog"
                class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-4 font-semibold text-primary-fg shadow-glow hover:bg-primary-hover"
              >
                <Icon icon={Download} size={18} />
                {m.kits_download_all({ count: downloadable.length })}
              </a>
            )
          }
          <button type="button" hidden data-js-only data-copy-text={kit.code} class={ACTION_CLASSES}>
            <Icon icon={Copy} size={16} />
            <span>{m.kits_copy_code()}</span>
          </button>
          <a href={kitShortPath(kit.code)} data-dialog-open="kit-share-dialog" class={ACTION_CLASSES}>
            <Icon icon={Share2} size={16} />
            <span>{m.common_action_share()}</span>
          </a>
          <!-- biome-ignore lint/a11y/useAriaPropsSupportedByRole: aria-pressed is the toggle state read by the follow script (data-kit-follow) -->
          <a href={login} data-kit-follow rel="nofollow" aria-pressed="false" class={`${ACTION_CLASSES} aria-pressed:border-primary aria-pressed:text-fg`}>
            <Icon icon={Heart} size={16} />
            <span data-follow-label>{m.kitsocial_follow()}</span>
          </a>
          <a href={login} data-kit-fork rel="nofollow" class={ACTION_CLASSES}>
            <Icon icon={GitFork} size={16} />
            <span>{m.kits_fork()}</span>
          </a>
          <a href={`/me/kits/${kit.id}`} hidden data-kit-owner-only rel="nofollow" class={ACTION_CLASSES}>
            <Icon icon={Pencil} size={16} />
            <span>{m.kits_edit()}</span>
          </a>
        </div>
      </header>

      <section aria-labelledby="kit-summary-title" class="grid gap-3 sm:grid-cols-3">
        <h2 id="kit-summary-title" class="sr-only">{m.kits_summary_title()}</h2>
        <div class={PANEL_CLASSES}>
          <h3 class="readout mb-2 text-fg-muted">{m.kits_summary_compat()}</h3>
          <ul class="grid gap-1.5 text-sm">
            {
              compat.map((line) => (
                <li class="flex items-start gap-2">
                  <Icon icon={compatIcon[line.tone]} size={16} className={`mt-0.5 shrink-0 ${compatTone[line.tone]}`} />
                  <span>{line.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class={PANEL_CLASSES}>
          <h3 class="readout mb-2 text-fg-muted">{m.kits_summary_multiplayer()}</h3>
          {
            mpParts.length > 0 ? (
              <ul class="grid gap-1.5 text-sm">
                {mpParts.map((part) => (
                  <li class="flex items-start gap-2">
                    <Icon icon={Users} size={16} className="mt-0.5 shrink-0 text-fg-subtle" />
                    <span>{part}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-fg-muted">{m.kits_mp_none()}</p>
            )
          }
        </div>
        <div class={PANEL_CLASSES}>
          <h3 class="readout mb-2 text-fg-muted">{m.kits_summary_size()}</h3>
          <ul class="grid gap-1.5 text-sm">
            <li class="flex items-start gap-2">
              <Icon icon={Layers} size={16} className="mt-0.5 shrink-0 text-fg-subtle" />
              <span>
                {
                  autoCount > 0
                    ? m.kits_items_with_auto({ count: explicitCount, auto: autoCount })
                    : m.kits_items_count({ count: kit.items.length })
                }
              </span>
            </li>
            <li class="flex items-start gap-2">
              <Icon icon={HardDrive} size={16} className="mt-0.5 shrink-0 text-fg-subtle" />
              <span>{size ? m.kits_total_size({ size }) : m.kits_total_size_unknown()}</span>
            </li>
          </ul>
        </div>
      </section>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <section id="kit-items" aria-labelledby="kit-items-title" class="grid min-w-0 content-start gap-4">
          <h2 id="kit-items-title" class={SECTION_TITLE_CLASSES}>{m.kits_items_title()}</h2>
          {
            kit.items.length > 0 ? (
              <KitItems kit={kit} currentBuild={currentBuild} />
            ) : (
              <KitsEmpty title={m.kits_detail_empty_title()} text={m.kits_detail_empty_text()} headingLevel={3} />
            )
          }
          <section id="kit-comments" data-kit-comments aria-labelledby="kit-comments-title" class="mt-6 grid gap-4">
            <h2 id="kit-comments-title" class={SECTION_TITLE_CLASSES}>
              {m.kitsocial_comments_title()}
              <span class="ms-2 text-sm font-normal text-fg-muted" data-kit-comments-count></span>
            </h2>
            <div data-kit-comments-form></div>
            <p class="text-sm text-fg-muted" data-kit-comments-status aria-live="polite" hidden></p>
            <div class="grid gap-3" data-kit-comments-list aria-live="polite"></div>
            <button
              type="button"
              hidden
              data-kit-comments-more
              class="justify-self-start rounded-md border border-border-strong bg-raised px-4 py-2 text-sm font-semibold text-fg hover:bg-surface"
            >
              {m.kitsocial_load_more()}
            </button>
          </section>
        </section>

        <aside aria-label={m.kits_sidebar_label()} class="grid min-w-0 content-start gap-4">
          <section aria-labelledby="kit-about-title" class={PANEL_CLASSES}>
            <h2 id="kit-about-title" class="mb-3 font-semibold text-fg">{m.kits_about_title()}</h2>
            {
              descriptionHtml ? (
                <ProseLocator html={descriptionHtml} className="text-sm" />
              ) : (
                <p class="text-sm text-fg-muted">{m.kits_about_empty()}</p>
              )
            }
          </section>

          {
            kit.recentRevisions.length > 0 && (
              <section aria-labelledby="kit-revisions-title" class={PANEL_CLASSES}>
                <h2 id="kit-revisions-title" class="mb-3 font-semibold text-fg">{m.kits_revisions_title()}</h2>
                <ol class="grid gap-2 text-sm">
                  {kit.recentRevisions.map((revision) => (
                    <li class="grid gap-0.5">
                      <span class="font-mono text-xs text-fg-subtle">
                        {m.kits_revision({ revision: revision.revision })} ·{' '}
                        <time datetime={revision.createdAt}>{dateLabel(revision.createdAt, locale)}</time>
                      </span>
                      <span class="break-words text-fg">{revision.summary}</span>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            moreKits.length > 0 && (
              <section aria-labelledby="kit-more-title" class="grid gap-3">
                <h2 id="kit-more-title" class="font-semibold text-fg">{m.kits_more_from({ curator })}</h2>
                <ul class="grid gap-3">
                  {moreKits.map((card) => (
                    <li>
                      <KitCard kit={card} headingLevel={3} currentBuild={currentBuild} />
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </aside>
      </div>
    </div>

    {
      downloadable.length > 0 && (
        <>
          <div aria-hidden="true" class="h-20 md:hidden"></div>
          <div class="fixed inset-x-0 bottom-[calc(4rem+env(safe-area-inset-bottom))] z-(--z-sticky) border-t border-border bg-bg/95 px-3 py-2 transition-[bottom] duration-(--dur-base) supports-[backdrop-filter]:bg-bg/80 supports-[backdrop-filter]:backdrop-blur-md md:hidden [html[data-scroll-dir=down]_&]:bottom-0 [html[data-scroll-dir=down]_&]:pb-[calc(0.5rem+env(safe-area-inset-bottom))] motion-reduce:transition-none">
            <div class="mx-auto flex max-w-lg items-center gap-2">
              <a
                href="#kit-items"
                data-dialog-open="kit-download-dialog"
                class="inline-flex h-12 min-w-0 flex-1 items-center justify-center gap-2 rounded-md bg-primary px-4 font-semibold text-primary-fg shadow-glow hover:bg-primary-hover"
              >
                <Icon icon={Download} size={18} />
                <span class="truncate">{m.kits_download_all({ count: downloadable.length })}</span>
              </a>
              <a
                href={kitShortPath(kit.code)}
                data-dialog-open="kit-share-dialog"
                class="inline-flex size-12 shrink-0 items-center justify-center rounded-md border border-border-strong bg-raised text-fg"
              >
                <Icon icon={Share2} size={20} />
                <span class="sr-only">{m.common_action_share()}</span>
              </a>
            </div>
          </div>
          <DownloadAllDialog kit={kit} />
        </>
      )
    }
    <ShareKitDialog kit={kit} url={url} siteUrl={env.siteUrl} />
    <div
      data-mod-toast
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed inset-x-0 bottom-[calc(5rem+env(safe-area-inset-bottom))] z-(--z-toast) flex justify-center px-4 md:bottom-6"
    >
    </div>
    <KitPageData kit={kit} url={url} siteUrl={env.siteUrl} loginHref={login} />
    <KitScripts />
  </div>
</BaseLayout>
