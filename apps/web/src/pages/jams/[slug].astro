---
/**
 * `/jams/:slug` — one Mod Jam: what it is, the schedule with a countdown, the rules and prizes,
 * the entries (gallery, with the rating controls during voting) and, once published, the results
 * podium per category.
 *
 * - Cache: E(300) `list:jams`; drafts are 404. The HTML is shared: nothing user specific is
 *   rendered here. Members get the island (follow, submit an entry, withdraw, vote); guests and
 *   crawlers keep the server-rendered page.
 * - A hidden theme stays hidden in the HTML until submissions open (the API withholds it).
 * - SEO: `Event` JSON-LD, the generated OG image when present.
 */
import { JAM_OVERALL_KEY } from '@sotf/contracts/jams';
import { profilePath } from '@sotf/contracts/seo';
import { formatDateTime } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { PROSE_LOCATOR_CLASSES } from '@sotf/ui/domain';
import { ModCard } from '@sotf/ui/domain';
import { KitsError } from '../../components/kits/KitStates.tsx';
import { jamPath, loadJamPage } from '../../components/jams/data.ts';
import Countdown from '../../components/jams/Countdown.astro';
import Podium from '../../components/jams/Podium.astro';
import {
  accentHex,
  categoryLabel,
  nextDeadline,
  PHASE_TONE_CLASSES,
  phaseLabel,
  phaseTone,
} from '../../components/jams/phase.ts';
import { loginHrefFor } from '../../components/mod/format.ts';
import { configureModDomainI18n, markdownLabels } from '../../components/mod/i18n.ts';
import { respondNotFound } from '../../components/mod/responses.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import { jamEventJsonLd } from '../../lib/seo/jsonld.ts';

export const prerender = false;

configureModDomainI18n();
const locale = Astro.locals.locale;
const slug = /^[a-z0-9](?:[a-z0-9-]{0,58}[a-z0-9])?$/.test(Astro.params.slug ?? '') ? (Astro.params.slug as string) : null;
if (slug === null) return respondNotFound(Astro);

const data = await loadJamPage(slug);
if (data.kind === 'not-found') return respondNotFound(Astro);
if (data.kind === 'error') {
  setPageCache(Astro, false);
  Astro.response.status = 503;
} else {
  setPageCache(Astro, pageCache.listJams());
}

const labels = markdownLabels();
const jam = data.kind === 'ok' ? data.jam : null;
const entries = data.kind === 'ok' ? data.entries : [];
const results = data.kind === 'ok' ? data.results : null;
const path = jamPath(slug);
const loginHref = loginHrefFor(href('/login', locale), href(path, locale));
const siteUrl = loadEnv().siteUrl;

const accent = jam ? accentHex(jam.accent) : '#F2A93B';
const deadline = jam ? nextDeadline(jam) : null;
const voting = jam?.phase === 'voting';
const showEntries = jam !== null && ['submissions', 'submissions_closed', 'voting', 'results', 'archived'].includes(jam.phase);
const timeline = jam
  ? [
      { key: 'announce', label: m.jams_timeline_announce(), at: jam.announceAt },
      { key: 'open', label: m.jams_timeline_submissions_open(), at: jam.submissionsOpenAt },
      { key: 'close', label: m.jams_timeline_submissions_close(), at: jam.submissionsCloseAt },
      { key: 'vote-open', label: m.jams_timeline_voting_open(), at: jam.votingOpenAt },
      { key: 'vote-close', label: m.jams_timeline_voting_close(), at: jam.votingCloseAt },
    ].flatMap((step) => (step.at === null ? [] : [{ key: step.key, label: step.label, at: step.at }]))
  : [];

const description = jam ? jam.tagline || m.jams_detail_description_fallback({ title: jam.title }) : m.jams_hub_description();
const jsonLd = jam
  ? [
      jamEventJsonLd({
        name: jam.title,
        description,
        url: `${siteUrl}${href(path, locale)}`,
        startDate: jam.submissionsOpenAt ?? jam.announceAt,
        endDate: jam.votingCloseAt ?? jam.submissionsCloseAt,
        image: jam.ogImageUrl ?? jam.bannerUrl,
        organizerName: 'SOTF Mods',
        organizerUrl: siteUrl,
      }),
    ]
  : [];
const title = jam?.title ?? m.jams_hub_title();
---

<PageLayout
  template="jam"
  width="wide"
  seo={{
    title,
    description,
    path,
    ...(jam && (jam.ogImageUrl ?? jam.bannerUrl) ? { og: { image: (jam.ogImageUrl ?? jam.bannerUrl) as string, imageAlt: jam.title, imageWidth: 1200, imageHeight: 630 } } : {}),
  }}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: m.common_nav_home(), path: '/' },
    { label: m.jams_nav(), path: '/jams' },
    { label: title },
  ]}
>
  {
    jam === null ? (
      <KitsError
        title={m.jams_error_title()}
        text={m.jams_error_text()}
        retryHref={href(Astro.url.pathname, locale)}
        reference={Astro.locals.requestId}
      />
    ) : (
      <article class="flex flex-col gap-8">
        <header
          class="relative overflow-hidden rounded-xl border border-border"
          style={`background: linear-gradient(135deg, ${accent}40, ${accent}0d 65%);`}
        >
          {jam.bannerUrl && (
            <img
              src={jam.bannerUrl}
              alt=""
              decoding="async"
              fetchpriority="high"
              class="absolute inset-0 size-full object-cover opacity-40"
            />
          )}
          <div class="relative flex flex-col gap-4 p-5 md:p-8">
            <div class="flex flex-wrap items-center gap-2">
              <span class:list={['rounded-sm px-2 py-1 text-xs font-semibold', PHASE_TONE_CLASSES[phaseTone(jam.phase)]]}>
                {phaseLabel(jam.phase)}
              </span>
              <span class="readout text-fg-muted">{m.jams_entries_count({ count: jam.entryCount })}</span>
            </div>
            <h1 class="font-display-caps text-display-sm text-fg">{jam.title}</h1>
            {jam.tagline && <p class="max-w-(--container-prose) text-base text-fg">{jam.tagline}</p>}
            {jam.theme ? (
              <p class="text-lg font-semibold text-fg">
                <span class="readout me-2 text-fg-muted">{m.jams_theme_heading()}</span>{jam.theme}
              </p>
            ) : jam.themeHidden ? (
              <p class="text-base font-semibold text-fg-muted">{m.jams_theme_hidden()}</p>
            ) : null}
            {deadline && <Countdown deadline={deadline} />}
            <div
              data-island="jam"
              data-jam-slug={jam.slug}
              data-phase={jam.phase}
              data-max-entries={jam.maxEntriesPerUser}
              data-max-coauthors={jam.maxCoAuthors}
              data-categories={JSON.stringify(jam.categories.map((category) => ({ id: category.id, label: categoryLabel(category) })))}
              class="min-h-11"
            >
              <p class="text-sm text-fg-muted" data-jam-guest-hint>
                {jam.phase === 'announced' || jam.phase === 'submissions' || voting ? (
                  <>
                    {m.jams_guest_hint()}{' '}
                    <a href={loginHref} class="font-semibold text-link underline underline-offset-3" rel="nofollow">
                      {m.jams_sign_in()}
                    </a>
                  </>
                ) : null}
              </p>
            </div>
          </div>
        </header>

        {results && results.overall.length > 0 && (
          <section aria-labelledby="jam-results" class="flex flex-col gap-5">
            <div class="flex flex-wrap items-end justify-between gap-2">
              <h2 id="jam-results" class="text-xl font-semibold text-fg">{m.jams_results_title()}</h2>
              <p class="font-mono text-xs text-fg-muted tabular-nums">
                {m.jams_results_summary({ participants: results.participants, voters: results.voters })}
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="readout text-featured">{categoryLabel({ key: JAM_OVERALL_KEY, label: null })}</h3>
              <Podium placements={results.overall} />
            </div>
            {results.categories.map((category) => (
              <div class="flex flex-col gap-2">
                <h3 class="readout text-fg-muted">{categoryLabel(category)}</h3>
                <Podium placements={category.placements} />
              </div>
            ))}
            <p class="text-xs text-fg-muted">{m.jams_results_method({ min: results.minVotes })}</p>
          </section>
        )}

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
          <div class="flex min-w-0 flex-col gap-8">
            {jam.descriptionHtml && (
              <section aria-labelledby="jam-about" class="flex flex-col gap-2">
                <h2 id="jam-about" class="text-lg font-semibold text-fg">{m.jams_about_title()}</h2>
                <div class:list={[PROSE_LOCATOR_CLASSES]} set:html={localizeHtml(jam.descriptionHtml, labels)} />
              </section>
            )}
            {jam.rulesHtml && (
              <section aria-labelledby="jam-rules" class="flex flex-col gap-2">
                <h2 id="jam-rules" class="text-lg font-semibold text-fg">{m.jams_rules_title()}</h2>
                <div class:list={[PROSE_LOCATOR_CLASSES]} set:html={localizeHtml(jam.rulesHtml, labels)} />
              </section>
            )}
            {jam.prizesHtml && (
              <section aria-labelledby="jam-prizes" class="flex flex-col gap-2">
                <h2 id="jam-prizes" class="text-lg font-semibold text-fg">{m.jams_prizes_title()}</h2>
                <div class:list={[PROSE_LOCATOR_CLASSES]} set:html={localizeHtml(jam.prizesHtml, labels)} />
              </section>
            )}
          </div>
          <aside class="flex flex-col gap-6" aria-label={m.jams_schedule_title()}>
            <section aria-labelledby="jam-schedule" class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4">
              <h2 id="jam-schedule" class="readout text-fg-muted">{m.jams_schedule_title()}</h2>
              {timeline.length === 0 ? (
                <p class="text-sm text-fg-muted">{m.jams_schedule_tba()}</p>
              ) : (
                <ol class="flex flex-col gap-2">
                  {timeline.map((step) => (
                    <li class="flex flex-col">
                      <span class="text-sm font-semibold text-fg">{step.label}</span>
                      <time datetime={step.at} class="font-mono text-xs text-fg-muted tabular-nums">
                        {formatDateTime(locale, step.at, 'medium', 'short')} UTC
                      </time>
                    </li>
                  ))}
                </ol>
              )}
            </section>
            <section aria-labelledby="jam-categories" class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4">
              <h2 id="jam-categories" class="readout text-fg-muted">{m.jams_categories_title()}</h2>
              <ul class="flex flex-col gap-1 text-sm text-fg">
                {jam.categories.map((category) => (
                  <li>{categoryLabel(category)}</li>
                ))}
              </ul>
              <p class="text-xs text-fg-muted">{m.jams_voting_rules({ minDays: jam.minVoterAgeDays })}</p>
            </section>
          </aside>
        </div>

        {showEntries && (
          <section aria-labelledby="jam-entries" class="flex flex-col gap-4">
            <div class="flex flex-wrap items-end justify-between gap-2">
              <h2 id="jam-entries" class="text-xl font-semibold text-fg">
                {m.jams_entries_title()}
                <span class="ms-1 font-mono text-sm font-normal text-fg-muted">{entries.length}</span>
              </h2>
              {voting && <p class="text-sm text-fg-muted">{m.jams_voting_hint()}</p>}
            </div>
            {entries.length === 0 ? (
              <p class="rounded-lg border border-dashed border-border p-6 text-center text-sm text-fg-muted">
                {m.jams_entries_empty()}
              </p>
            ) : (
              <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                {entries.map((entry) => (
                  <li class="flex min-w-0 flex-col gap-2" data-jam-entry={entry.id}>
                    <ModCard
                      mod={{ ...entry.mod, canonicalPath: href(entry.mod.canonicalPath, locale) }}
                      variant="compact"
                      headingLevel={3}
                      viewTransition={false}
                    />
                    <p class="text-xs text-fg-muted">
                      {m.jams_by()}{' '}
                      {entry.authors.map((author, index) => (
                        <>
                          {index > 0 && ', '}
                          <a href={href(profilePath(author.handle), locale)} class="font-semibold text-fg hover:underline">
                            {author.displayName || author.handle}
                          </a>
                        </>
                      ))}
                    </p>
                    {entry.notesHtml && (
                      <details class="rounded-md border border-border bg-surface px-3 py-2 text-sm">
                        <summary class="min-h-11 cursor-pointer py-2 font-semibold text-fg md:min-h-0 md:py-0">{m.jams_entry_notes()}</summary>
                        <div class:list={[PROSE_LOCATOR_CLASSES, 'prose-sm mt-2']} set:html={localizeHtml(entry.notesHtml, labels)} />
                      </details>
                    )}
                    {voting && <div data-jam-vote-slot data-entry-id={entry.id} />}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}
      </article>
    )
  }
  <div
    data-mod-toast
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed inset-x-0 bottom-[calc(9rem+env(safe-area-inset-bottom))] z-(--z-toast) flex justify-center px-4 md:bottom-6"
  >
  </div>
</PageLayout>

<script>
  import { bootJamPage } from '../../islands/jams/boot.ts';
  import { startCountdowns } from '../../islands/jams/countdown.ts';
  import { whenSession } from '../../scripts/mod/session.ts';

  startCountdowns(document);
  void bootJamPage(document, whenSession()).catch(() => {});
</script>
