---
/**
 * `/jams/:slug` — one Mod Jam: what it is, the schedule with a countdown, the rules and prizes,
 * the entries (gallery, with the rating controls during voting) and, once published, the results
 * podium per category.
 *
 * - Cache: E(300) `list:jams`; drafts are 404. The HTML is shared: nothing user specific is
 *   rendered here. Members get the island (follow, submit an entry, withdraw, vote); guests and
 *   crawlers keep the server-rendered page.
 * - A hidden theme stays hidden in the HTML until submissions open (the API withholds it).
 * - SEO: `Event` JSON-LD, the generated OG image when present.
 */

import { formatDateTime } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { PROSE_LOCATOR_CLASSES } from '@sotf/ui/domain';
import { Icon } from '@sotf/ui/icons';
import { BookOpen, CalendarDays, Gamepad2, Gem, Lightbulb, ShieldCheck, Tag, Trophy } from 'lucide-react';
import { jamPath, loadJamPage } from '../../components/jams/data.ts';
import EntryCard from '../../components/jams/EntryCard.astro';
import JamHero from '../../components/jams/JamHero.astro';
import JamStepper from '../../components/jams/JamStepper.astro';
import { categoryLabel } from '../../components/jams/phase.ts';
import ResultsBoard from '../../components/jams/ResultsBoard.astro';
import { KitsError } from '../../components/kits/KitStates.tsx';
import { loginHrefFor } from '../../components/mod/format.ts';
import { configureModDomainI18n, markdownLabels } from '../../components/mod/i18n.ts';
import { respondNotFound } from '../../components/mod/responses.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';
import { loadEnv } from '../../lib/env.ts';
import { href } from '../../lib/i18n.ts';
import { jamEventJsonLd } from '../../lib/seo/jsonld.ts';

export const prerender = false;

configureModDomainI18n();
const locale = Astro.locals.locale;
const slug = /^[a-z0-9](?:[a-z0-9-]{0,58}[a-z0-9])?$/.test(Astro.params.slug ?? '') ? (Astro.params.slug as string) : null;
if (slug === null) return respondNotFound(Astro);

const data = await loadJamPage(slug);
if (data.kind === 'not-found') return respondNotFound(Astro);
if (data.kind === 'error') {
  setPageCache(Astro, false);
  Astro.response.status = 503;
} else {
  setPageCache(Astro, pageCache.listJams());
}

const labels = markdownLabels();
const jam = data.kind === 'ok' ? data.jam : null;
const entries = data.kind === 'ok' ? data.entries : [];
const results = data.kind === 'ok' ? data.results : null;
const path = jamPath(slug);
const loginHref = loginHrefFor(href('/login', locale), href(path, locale));
const siteUrl = loadEnv().siteUrl;

const voting = jam?.phase === 'voting';
const showEntries = jam !== null && ['submissions', 'submissions_closed', 'voting', 'results', 'archived'].includes(jam.phase);
const hasPodium = results !== null && results.overall.length > 0;
const CATEGORY_ICON = { fun: Gamepad2, polish: Gem, creativity: Lightbulb, lore: BookOpen } as const;
/** What the voting booth needs of an entry (the island has no other source for names and images). */
const boothEntries = entries.map((entry) => ({
  id: entry.id,
  name: entry.mod.name,
  path: href(entry.mod.canonicalPath, locale),
  thumb: entry.mod.thumbnail?.url ?? null,
  blurb: entry.mod.shortDescription.slice(0, 220),
  authors: entry.authors.map((author) => author.displayName || author.handle),
}));
const timeline = jam
  ? [
      { key: 'announce', label: m.jams_timeline_announce(), at: jam.announceAt },
      { key: 'open', label: m.jams_timeline_submissions_open(), at: jam.submissionsOpenAt },
      { key: 'close', label: m.jams_timeline_submissions_close(), at: jam.submissionsCloseAt },
      { key: 'vote-open', label: m.jams_timeline_voting_open(), at: jam.votingOpenAt },
      { key: 'vote-close', label: m.jams_timeline_voting_close(), at: jam.votingCloseAt },
    ].flatMap((step) => (step.at === null ? [] : [{ key: step.key, label: step.label, at: step.at }]))
  : [];

const description = jam ? jam.tagline || m.jams_detail_description_fallback({ title: jam.title }) : m.jams_hub_description();
const jsonLd = jam
  ? [
      jamEventJsonLd({
        name: jam.title,
        description,
        url: `${siteUrl}${href(path, locale)}`,
        startDate: jam.submissionsOpenAt ?? jam.announceAt,
        endDate: jam.votingCloseAt ?? jam.submissionsCloseAt,
        image: jam.ogImageUrl ?? jam.bannerUrl,
        organizerName: 'SOTF Mods',
        organizerUrl: siteUrl,
      }),
    ]
  : [];
const title = jam?.title ?? m.jams_hub_title();
---

<PageLayout
  template="jam"
  width="wide"
  seo={{
    title,
    description,
    path,
    ...(jam && (jam.ogImageUrl ?? jam.bannerUrl) ? { og: { image: (jam.ogImageUrl ?? jam.bannerUrl) as string, imageAlt: jam.title, imageWidth: 1200, imageHeight: 630 } } : {}),
  }}
  jsonLd={jsonLd}
  breadcrumbs={[
    { label: m.common_nav_home(), path: '/' },
    { label: m.jams_nav(), path: '/jams' },
    { label: title },
  ]}
>
  {
    jam === null ? (
      <KitsError
        title={m.jams_error_title()}
        text={m.jams_error_text()}
        retryHref={href(Astro.url.pathname, locale)}
        reference={Astro.locals.requestId}
      />
    ) : (
      <article class="flex flex-col gap-8 md:gap-12">
        <JamHero jam={jam} mode="detail" results={results} resultsAnchor={hasPodium ? '#jam-results' : undefined}>
          <div
            slot="actions"
            data-island="jam"
            data-jam-slug={jam.slug}
            data-phase={jam.phase}
            data-max-entries={jam.maxEntriesPerUser}
            data-max-coauthors={jam.maxCoAuthors}
            data-categories={JSON.stringify(jam.categories.map((category) => ({ id: category.id, label: categoryLabel(category) })))}
            class:list={[jam.phase === 'results' || jam.phase === 'archived' ? '' : 'min-h-11']}
          >
            <p class="text-sm text-night-200" data-jam-guest-hint>
              {jam.phase === 'announced' || jam.phase === 'submissions' || voting ? (
                <>
                  {m.jams_guest_hint()}{' '}
                  <a href={loginHref} class="font-semibold text-primary underline underline-offset-3" rel="nofollow">
                    {m.jams_sign_in()}
                  </a>
                </>
              ) : null}
            </p>
          </div>
        </JamHero>

        <JamStepper jam={jam} class="rounded-xl border border-border bg-surface p-5 md:px-8" />

        <div class="flex flex-col gap-8 md:gap-12">
          {hasPodium && results && (
            <section aria-labelledby="jam-results" id="jam-results" class="flex scroll-mt-24 flex-col gap-6">
              <div class="flex flex-wrap items-end justify-between gap-2">
                <h2 id="jam-results" class="font-display-caps text-4xl leading-none text-fg">{m.jams_results_title()}</h2>
                <p class="font-mono text-xs text-fg-muted tabular-nums">
                  {m.jams_results_summary({ participants: results.participants, voters: results.voters })}
                </p>
              </div>
              <ResultsBoard results={results} id={`jam-${jam.slug}`} />
              <p class="text-xs text-fg-muted">{m.jams_results_method({ min: results.minVotes })}</p>
            </section>
          )}

          {showEntries && (
            <section
              aria-labelledby="jam-entries"
              id="jam-entries"
              class:list={['flex scroll-mt-24 flex-col gap-5', voting ? 'order-first' : '']}
            >
              <div class="flex flex-wrap items-end justify-between gap-2">
                <h2 id="jam-entries" class="font-display-caps text-4xl leading-none text-fg">
                  {m.jams_entries_title()}
                  <span class="ms-2 font-mono text-sm font-normal text-fg-muted">{entries.length}</span>
                </h2>
              </div>
              {voting && entries.length > 0 && (
                <div data-jam-vote-dock data-entries={JSON.stringify(boothEntries)}>
                  <div class="texture-topo flex min-h-24 flex-col gap-3 rounded-xl border border-border bg-surface p-4 md:flex-row md:items-center md:justify-between md:gap-8 md:p-5">
                    <div class="flex flex-col gap-2">
                      <p class="font-display-caps text-2xl leading-none text-fg">{m.jams_vote_dock_title()}</p>
                      <p class="max-w-(--container-prose) text-sm text-fg-muted">{m.jams_voting_hint()}</p>
                    </div>
                    <a
                      href={loginHref}
                      rel="nofollow"
                      class="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-md bg-primary px-6 font-semibold text-primary-fg hover:bg-primary-hover"
                    >
                      {m.jams_vote_signin()}
                    </a>
                  </div>
                </div>
              )}
              {entries.length === 0 ? (
                <div class="flex flex-col items-center gap-6 overflow-hidden rounded-xl border border-dashed border-border-strong/60 bg-surface p-6 sm:flex-row sm:p-8">
                  <picture class="shrink-0">
                    <source type="image/avif" srcset="/art/jams/empty-480.avif" />
                    <img
                      src="/art/jams/empty-480.webp"
                      alt=""
                      width="480"
                      height="480"
                      loading="lazy"
                      decoding="async"
                      class="size-40 rounded-xl object-cover sm:size-48"
                    />
                  </picture>
                  <div class="flex max-w-prose flex-col gap-2 text-center sm:text-start">
                    <p class="font-display-caps text-3xl leading-none text-fg">
                      {jam.phase === 'submissions' ? m.jams_entries_empty_open_title() : m.jams_entries_empty()}
                    </p>
                    {jam.phase === 'submissions' && <p class="text-sm text-fg-muted">{m.jams_entries_empty_open_text()}</p>}
                  </div>
                </div>
              ) : (
                <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {entries.map((entry, index) => (
                    <EntryCard entry={entry} accent={jam.accent} voting={voting} labels={labels} eager={index < 3} />
                  ))}
                </ul>
              )}
            </section>
          )}

          <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-10">
            <div class="flex min-w-0 flex-col gap-8">
              {jam.descriptionHtml && (
                <section aria-labelledby="jam-about" class="flex flex-col gap-3">
                  <h2 id="jam-about" class="font-display-caps text-3xl leading-none text-fg">{m.jams_about_title()}</h2>
                  <div class:list={[PROSE_LOCATOR_CLASSES]} set:html={localizeHtml(jam.descriptionHtml, labels)} />
                </section>
              )}
              {jam.rulesHtml && (
                <section aria-labelledby="jam-rules" class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-5 md:p-6">
                  <h2 id="jam-rules" class="font-display-caps text-3xl leading-none text-fg">{m.jams_rules_title()}</h2>
                  <div class:list={[PROSE_LOCATOR_CLASSES]} set:html={localizeHtml(jam.rulesHtml, labels)} />
                </section>
              )}
              <section aria-labelledby="jam-schedule" class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-5">
  <h2 id="jam-schedule" class="readout flex items-center gap-2 text-fg-muted">
    <Icon icon={CalendarDays} size={14} />
    {m.jams_schedule_title()}
  </h2>
  {timeline.length === 0 ? (
    <p class="text-sm text-fg-muted">{m.jams_schedule_tba()}</p>
  ) : (
    <ol class="grid gap-x-6 gap-y-3 sm:grid-cols-2 xl:grid-cols-3">
      {timeline.map((step) => (
        <li class="flex flex-col gap-0.5">
          <span class="text-sm font-semibold text-fg">{step.label}</span>
          <time datetime={step.at} class="font-mono text-xs text-fg-muted tabular-nums">
            {formatDateTime(locale, step.at, 'medium', 'short')} UTC
          </time>
        </li>
      ))}
    </ol>
  )}
</section>
            </div>
            <aside class="flex flex-col gap-5" aria-label={m.jams_details_aside()}>
              {jam.prizesHtml && (
                <section
                  aria-labelledby="jam-prizes"
                  class="relative isolate overflow-hidden rounded-xl border border-featured/40 bg-night-975 p-5 text-night-50"
                >
                  <picture class="absolute inset-0 -z-20">
                    <source type="image/avif" srcset="/art/jams/trophy-400.avif 400w, /art/jams/trophy-800.avif 800w" sizes="22rem" />
                    <img
                      src="/art/jams/trophy-800.webp"
                      alt=""
                      width="800"
                      height="800"
                      loading="lazy"
                      decoding="async"
                      class="size-full object-cover"
                      style="object-position: 50% 30%;"
                    />
                  </picture>
                  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night-975 via-night-975/80 to-night-975/20" aria-hidden="true"></div>
                  <div class="flex min-h-56 flex-col justify-end gap-2">
                    <h2 id="jam-prizes" class="font-display-caps flex items-center gap-2 text-3xl leading-none text-featured">
                      <Icon icon={Trophy} size={24} />
                      {m.jams_prizes_title()}
                    </h2>
                    <div class:list={[PROSE_LOCATOR_CLASSES, 'text-night-100 [&_*]:text-night-100 [&_strong]:text-night-50']} set:html={localizeHtml(jam.prizesHtml, labels)} />
                  </div>
                </section>
              )}
              <section aria-labelledby="jam-categories" class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-5">
                <h2 id="jam-categories" class="readout flex items-center gap-2 text-fg-muted">
                  <Icon icon={Tag} size={14} />
                  {m.jams_categories_title()}
                </h2>
                <ul class="grid grid-cols-2 gap-2">
                  {jam.categories.map((category) => (
                    <li class="flex items-center gap-2 rounded-md border border-border bg-sunken/50 px-3 py-2 text-sm font-semibold text-fg">
                      <Icon icon={CATEGORY_ICON[category.key as keyof typeof CATEGORY_ICON] ?? Tag} size={16} className="text-primary" />
                      {categoryLabel(category)}
                    </li>
                  ))}
                </ul>
                <p class="flex gap-2 text-xs text-fg-muted">
                  <Icon icon={ShieldCheck} size={16} className="mt-0.5 text-signal" />
                  <span>{m.jams_voting_rules({ minDays: jam.minVoterAgeDays })}</span>
                </p>
              </section>
            </aside>
          </div>
        </div>
      </article>
    )
  }
  <div
    data-mod-toast
    role="status"
    aria-live="polite"
    class="pointer-events-none fixed inset-x-0 bottom-[calc(9rem+env(safe-area-inset-bottom))] z-(--z-toast) flex justify-center px-4 md:bottom-6"
  >
  </div>
</PageLayout>

<script>
  import { bootJamPage } from '../../islands/jams/boot.ts';
  import { startCountdowns } from '../../islands/jams/countdown.ts';
  import { whenSession } from '../../scripts/mod/session.ts';

  startCountdowns(document);
  void bootJamPage(document, whenSession()).catch(() => {});
</script>
