---
/**
 * `/jams` — the Mod Jams hub: the jam that is happening (or the next one) featured as a cinematic
 * hero with its countdown and stage trail, the jams coming up (a sealed theme gets a teaser), the
 * jams with results and their winners, the archive, and how a jam works. With no jam at all it is
 * the page of the first one («on its way»). All plain links, no JavaScript needed except the
 * ticking countdown.
 *
 * - Cache: E(300) `list:jams` (purged by every phase change); the API failing gives 503 with an
 *   error state, never cached.
 */
import { m } from '@sotf/i18n/messages';
import { groupJams, loadFinishedResults, loadJamList, winnerOf } from '../../components/jams/data.ts';
import FirstJam from '../../components/jams/FirstJam.astro';
import HowItWorks from '../../components/jams/HowItWorks.astro';
import JamCard from '../../components/jams/JamCard.astro';
import JamHero from '../../components/jams/JamHero.astro';
import { pickFeatured } from '../../components/jams/phase.ts';
import { KitsError } from '../../components/kits/KitStates.tsx';
import { configureModDomainI18n } from '../../components/mod/i18n.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';
import { href } from '../../lib/i18n.ts';

export const prerender = false;

configureModDomainI18n();
const locale = Astro.locals.locale;
setPageCache(Astro, pageCache.listJams());

const items = await loadJamList();
if (items === null) {
  setPageCache(Astro, false);
  Astro.response.status = 503;
}
const all = items ?? [];
const featured = pickFeatured(all);
const rest = all.filter((jam) => jam.id !== featured?.id);
const groups = groupJams(rest);
const upcoming = groups.running.filter((jam) => jam.phase === 'announced');
const running = groups.running.filter((jam) => jam.phase !== 'announced');
const results = await loadFinishedResults(all);
const ahead = [...running, ...upcoming];
const past = [...groups.results, ...groups.archive];
const sections = [
  { id: 'ahead', title: running.length > 0 ? m.jams_hub_running() : m.jams_hub_upcoming(), jams: ahead, finished: false },
  { id: 'past', title: m.jams_hub_results(), jams: past, finished: true },
].filter((section) => section.jams.length > 0);
---

<PageLayout
  template="jams"
  width="wide"
  seo={{ title: m.jams_hub_title(), description: m.jams_hub_description(), path: '/jams' }}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: m.jams_nav() }]}
>
  <div class="flex flex-col gap-10 md:gap-14">
    <header class="flex flex-col gap-2">
      <p class="readout text-signal">{m.jams_hub_readout()}</p>
      <h1 class="font-display-caps text-display-sm text-fg">{m.jams_hub_title()}</h1>
      <p class="max-w-(--container-prose) text-base text-fg-muted">{m.jams_hub_intro()}</p>
    </header>

    {
      items === null ? (
        <KitsError
          title={m.jams_error_title()}
          text={m.jams_error_text()}
          retryHref={href(Astro.url.pathname, locale)}
          reference={Astro.locals.requestId}
        />
      ) : featured === null ? (
        <>
          <FirstJam />
          <HowItWorks />
        </>
      ) : (
        <>
          <JamHero jam={featured} mode="hub" results={results.get(featured.slug) ?? null} />
          {sections.map((section) => (
            <section aria-labelledby={`jams-${section.id}`} class="flex flex-col gap-4">
              <h2 id={`jams-${section.id}`} class="font-display-caps text-3xl text-fg">
                {section.title}
                <span class="ms-2 font-mono text-sm font-normal text-fg-muted">{section.jams.length}</span>
              </h2>
              <ul
                class:list={[
                  'grid grid-cols-1 gap-5',
                  section.jams.length === 2 && 'md:grid-cols-2',
                  section.jams.length >= 3 && 'md:grid-cols-2 xl:grid-cols-3',
                ]}
              >
                {section.jams.map((jam) => (
                  <li class="min-w-0">
                    <JamCard jam={jam} wide={section.jams.length === 1} winner={section.finished ? winnerOf(results.get(jam.slug)) : null} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <HowItWorks />
        </>
      )
    }
  </div>
</PageLayout>

<script>
  import { startCountdowns } from '../../islands/jams/countdown.ts';

  startCountdowns(document);
</script>
