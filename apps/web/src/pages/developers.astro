---
/**
 * `/developers` (T0-32, PLAN §4.2, §5.1, §5.5): the public API guide — hosts, format, errors,
 * pagination, caching, limits, the «Integrate a mod manager» walkthrough, and the legacy `/api/*`
 * surface with its deprecation schedule (the `Link: rel="deprecation"` header of the frozen routes
 * points here). Prose is Markdown per locale (`content/developers`); every table is generated from
 * `@sotf/contracts`. Links to the Scalar reference (`/api/docs`) and `/api/v2/openapi.json`.
 */
import { formatDate, formatNumber } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { BookOpen, Braces, History } from 'lucide-react';
import { errorCodes, legacyTiers, publicRateLimits, publicReadEndpoints } from '../components/content/api-reference.ts';
import DocLayout from '../components/content/DocLayout.astro';
import EndpointTable from '../components/content/EndpointTable.astro';
import { techArticleJsonLd } from '../components/content/jsonld.ts';
import { DEVELOPERS_UPDATED, developersDoc, LEGACY_SUNSET_DATE } from '../content/developers/index.ts';
import { setPageCache } from '../lib/cache/page.ts';
import { pageCache } from '../lib/cache/policy.ts';
import { loadEnv } from '../lib/env.ts';
import { localizePath } from '../lib/i18n.ts';

setPageCache(Astro, pageCache.static());
const locale = Astro.locals.locale;
const doc = developersDoc.get(locale);
if (!doc) throw new Error('developers: the English text is missing');
const siteUrl = loadEnv().siteUrl.replace(/\/+$/, '');
const path = '/developers';
const url = `${siteUrl}${localizePath(path, doc.locale)}`;
const englishLang = locale === 'en' ? undefined : 'en';

const groups = publicReadEndpoints();
const limits = publicRateLimits();
const legacy = legacyTiers();
const errors = errorCodes();
const sunset = formatDate(locale, LEGACY_SUNSET_DATE, 'long');

const quickLinks = [
  { href: '/api/docs', icon: BookOpen, title: m.content_dev_link_docs_title(), text: m.content_dev_link_docs_text() },
  { href: '/api/v2/openapi.json', icon: Braces, title: m.content_dev_link_openapi_title(), text: m.content_dev_link_openapi_text() },
  { href: '#legacy', icon: History, title: m.content_dev_link_legacy_title(), text: m.content_dev_link_legacy_text({ date: sunset }) },
];
const bucketLabel = (bucket: string) => m.content_dev_bucket({ bucket });
const keyLabel = (key: string) => m.content_dev_limit_key({ key });
---

<DocLayout
  template="developers"
  path={path}
  eyebrow={m.content_dev_eyebrow()}
  doc={doc}
  translatedLocales={developersDoc.locales()}
  updated={DEVELOPERS_UPDATED}
  extraSections={[
    { id: 'endpoints', text: m.content_dev_endpoints_title() },
    { id: 'error-codes', text: m.content_dev_errors_title() },
    { id: 'limits', text: m.content_dev_limits_title() },
    { id: 'legacy', text: m.content_dev_legacy_title() },
  ]}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: m.common_footer_developers() }]}
  jsonLd={[
    techArticleJsonLd({
      siteUrl,
      url,
      locale: doc.locale,
      headline: doc.frontmatter.title,
      description: doc.frontmatter.description,
      datePublished: DEVELOPERS_UPDATED,
      dateModified: DEVELOPERS_UPDATED,
      proficiency: 'Expert',
      sections: doc.headings.filter((heading) => heading.level === 2).map((heading) => heading.text),
    }),
  ]}
>
  <ul slot="before" class="grid gap-3 md:grid-cols-3">
    {
      quickLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="flex h-full flex-col gap-1 rounded-lg border border-border-strong bg-surface p-4 hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
          >
            <span class="flex items-center gap-2 font-semibold text-fg">
              <Icon icon={link.icon} size={18} className="text-primary" />
              {link.title}
            </span>
            <span class="text-sm text-fg-muted">{link.text}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section id="endpoints" aria-labelledby="endpoints-title" class="flex scroll-mt-20 flex-col gap-4">
    <h2 id="endpoints-title" class="font-display-caps text-display-xs text-fg">{m.content_dev_endpoints_title()}</h2>
    <p class="text-fg-muted">{m.content_dev_endpoints_text()}</p>
    {
      groups.map((group) => (
        <div class="flex flex-col gap-2">
          <h3 class="font-mono text-sm font-semibold text-fg">{group.domain}</h3>
          <EndpointTable caption={m.content_dev_endpoints_caption({ domain: group.domain })} rows={group.rows} summaryLang={englishLang} />
        </div>
      ))
    }
  </section>

  <section id="error-codes" aria-labelledby="error-codes-title" class="flex scroll-mt-20 flex-col gap-4">
    <h2 id="error-codes-title" class="font-display-caps text-display-xs text-fg">{m.content_dev_errors_title()}</h2>
    <p class="text-fg-muted">{m.content_dev_errors_text()}</p>
    <div class="overflow-x-auto rounded-lg border border-border">
      <table class="w-full min-w-[32rem] border-collapse text-sm">
        <caption class="sr-only">{m.content_dev_errors_title()}</caption>
        <thead class="bg-sunken">
          <tr>
            <th scope="col" class="px-3 py-2 text-start font-semibold text-fg">{m.content_dev_col_code()}</th>
            <th scope="col" class="px-3 py-2 text-start font-semibold text-fg">{m.content_dev_col_status()}</th>
            <th scope="col" class="px-3 py-2 text-start font-semibold text-fg">{m.content_dev_col_meaning()}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            errors.map((error) => (
              <tr id={error.anchor} class="scroll-mt-20 target:bg-primary/10">
                <th scope="row" class="px-3 py-2 text-start align-top font-mono text-xs font-semibold text-fg">{error.code}</th>
                <td class="px-3 py-2 align-top font-mono text-xs text-fg-muted">{error.status}</td>
                <td class="px-3 py-2 align-top text-fg-muted" lang={englishLang}>
                  {error.title}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="limits" aria-labelledby="limits-title" class="flex scroll-mt-20 flex-col gap-4">
    <h2 id="limits-title" class="font-display-caps text-display-xs text-fg">{m.content_dev_limits_title()}</h2>
    <p class="text-fg-muted">{m.content_dev_limits_text()}</p>
    <div class="overflow-x-auto rounded-lg border border-border">
      <table class="w-full min-w-[32rem] border-collapse text-sm">
        <caption class="sr-only">{m.content_dev_limits_title()}</caption>
        <thead class="bg-sunken">
          <tr>
            <th scope="col" class="px-3 py-2 text-start font-semibold text-fg">{m.content_dev_col_scope()}</th>
            <th scope="col" class="px-3 py-2 text-start font-semibold text-fg">{m.content_dev_col_limit()}</th>
            <th scope="col" class="px-3 py-2 text-start font-semibold text-fg">{m.content_dev_col_notes()}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {
            limits.map((limit) => (
              <tr>
                <th scope="row" class="px-3 py-2 text-start align-top font-normal text-fg">{bucketLabel(limit.bucket)}</th>
                <td class="px-3 py-2 align-top font-mono text-xs whitespace-nowrap text-fg">
                  {formatNumber(locale, limit.max)} / {limit.window} · {keyLabel(limit.key)}
                </td>
                <td class="px-3 py-2 align-top text-fg-muted" lang={englishLang}>
                  {limit.extra ?? '—'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="legacy" aria-labelledby="legacy-title" class="flex scroll-mt-20 flex-col gap-4">
    <h2 id="legacy-title" class="font-display-caps text-display-xs text-fg">{m.content_dev_legacy_title()}</h2>
    <p class="text-fg-muted">{m.content_dev_legacy_text()}</p>

    <h3 class="font-semibold text-fg">{m.content_dev_legacy_stable()}</h3>
    <EndpointTable caption={m.content_dev_legacy_stable()} rows={legacy.stable} summaryLang={englishLang} />

    <h3 class="font-semibold text-fg">{m.content_dev_legacy_deprecated()}</h3>
    <p class="text-sm text-fg-muted">
      {m.content_dev_legacy_deprecated_text({ date: sunset })}
    </p>
    <pre
      class="overflow-x-auto rounded-md border border-border bg-sunken p-3 font-mono text-xs text-fg"><code>Deprecation: true
Sunset: {new Date(`${LEGACY_SUNSET_DATE}T00:00:00Z`).toUTCString()}
Link: &lt;https://sotf-mods.com/developers&gt;; rel="deprecation"</code></pre>
    <EndpointTable caption={m.content_dev_legacy_deprecated()} rows={legacy.deprecated} summaryLang={englishLang} />

    <h3 class="font-semibold text-fg">{m.content_dev_legacy_retired()}</h3>
    <p class="text-sm text-fg-muted">{m.content_dev_legacy_retired_text()}</p>
    <p class="text-sm text-fg-muted">{m.content_dev_legacy_retired_write()}</p>
    <pre
      class="overflow-x-auto rounded-md border border-border bg-sunken p-3 font-mono text-xs text-fg"><code>{'{"status":false,"error":"GONE","message":"This endpoint was retired in sotf-mods v2. See https://sotf-mods.com/developers"}'}</code></pre>
    <ul class="grid gap-1 font-mono text-xs text-fg sm:grid-cols-2">
      {
        legacy.retired.map((route) => (
          <li class="rounded-sm bg-fg/6 px-2 py-1">
            <span class="text-danger">{route.method}</span> {route.path}
          </li>
        ))
      }
    </ul>

    <h3 class="font-semibold text-fg">{m.content_dev_legacy_deviations()}</h3>
    <ol class="grid list-decimal gap-1 ps-6 text-sm text-fg-muted" lang={englishLang}>
      {
        legacy.deviations.map((deviation) => (
          <li id={`deviation-${deviation.id}`}>
            {deviation.description
              .split('`')
              .map((part, index) => (index % 2 === 1 ? <code class="font-mono text-xs text-fg">{part}</code> : part))}
          </li>
        ))
      }
    </ol>

    <h3 class="font-semibold text-fg">{m.content_dev_legacy_kelvin_title()}</h3>
    <p class="text-sm text-fg-muted">{m.content_dev_legacy_kelvin_text()}</p>
  </section>
</DocLayout>
