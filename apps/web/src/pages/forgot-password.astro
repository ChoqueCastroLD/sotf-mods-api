---
/**
 * `/forgot-password` (PLAN §4.2 «P + isla», T0-13). Static HTML (edge-cached, purged on deploy).
 */
import { toHtmlLang } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import AuthShell from '../components/account/AuthShell.astro';
import ForgotPasswordForm from '../islands/auth/ForgotPasswordForm.tsx';
import { islandMessages } from '../islands/auth/messages.server.ts';
import { setPageCache } from '../lib/cache/page.ts';
import { pageCache } from '../lib/cache/policy.ts';
import { loadEnv } from '../lib/env.ts';

setPageCache(Astro, pageCache.static());
const locale = Astro.locals.locale;
---

<AuthShell
  template="forgot-password"
  title={m.auth_meta_forgot_title()}
  description={m.auth_meta_forgot_description()}
  heading={m.auth_forgot_heading()}
  intro={m.auth_forgot_intro()}
>
  <ForgotPasswordForm
    client:load
    locale={locale}
    lang={toHtmlLang(locale)}
    messages={islandMessages('ForgotPasswordForm', locale)} turnstileSiteKey={loadEnv().turnstileSiteKey} />
</AuthShell>
