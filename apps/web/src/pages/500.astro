---
/**
 * 500 «Something broke at base camp» (research/03 §5.10, §6.14): cold campfire, what happened,
 * «Try again», Discord for status and the reference id (`cf-ray` or a UUID) the user can quote.
 * No API calls, no JavaScript needed; `no-store` (the middleware never caches ≥ 500). Transient API
 * failures (429, 502+) answer 503 with `Retry-After` instead.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { MessagesSquare, RotateCcw } from 'lucide-react';
import ArtPicture from '../components/layout/ArtPicture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/i18n.ts';
import { ensureLocals } from '../lib/request-context.ts';
import { SOCIAL_LINKS } from '../lib/site.ts';

interface Props {
  error?: unknown;
}

const locals = ensureLocals(Astro);
// Transient API failures are answered 503 + Retry-After by the middleware (it rewrites here).
Astro.response.status = locals.upstreamError ? 503 : 500;
const retryHref = href(locals.pagePath.split('#', 1)[0] ?? '/', locals.locale);
---

<BaseLayout
  template="server-error"
  seo={{ title: m.meta_server_error_title(), description: m.errors_server_text(), noindex: true, canonical: false, alternates: false }}
>
  <section class="mx-auto grid w-full max-w-(--container-prose) justify-items-center gap-5 pb-16 text-center md:px-4 md:py-16">
    <figure class="relative m-0 w-full overflow-hidden md:rounded-2xl md:border md:border-border md:shadow-lg" aria-hidden="true">
      <ArtPicture
        name="cabin-waypoint"
        widths={[480, 800, 1200]}
        width={1584}
        height={672}
        sizes="(min-width: 44rem) 42rem, 100vw"
        priority
        class="block aspect-[16/9] w-full bg-raised object-cover md:aspect-[1584/672]"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-bg/80 to-transparent md:hidden"></div>
    </figure>
    <div class="grid justify-items-center gap-5 px-4 md:px-0">
    <p class="readout text-danger">{m.errors_server_readout()}</p>
    <h1 class="font-display-caps text-display-sm text-fg">{m.errors_server_title()}</h1>
    <p class="text-lg text-fg-muted">{m.errors_server_text()}</p>
    <div class="grid w-full gap-3 sm:flex sm:w-auto sm:flex-wrap sm:justify-center">
      <a
        href={retryHref}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-primary px-4 sm:min-h-11 font-semibold text-primary-fg"
      >
        <Icon icon={RotateCcw} size={18} />
        {m.errors_server_retry()}
      </a>
      <a
        href={SOCIAL_LINKS.discord}
        rel="noopener"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-border-strong px-4 py-2 text-center leading-tight sm:min-h-11 font-semibold text-fg hover:bg-fg/8"
      >
        <Icon icon={MessagesSquare} size={18} />
        {m.errors_server_status()}
      </a>
    </div>
    <p class="readout text-fg-subtle">{m.errors_reference({ id: locals.requestId })}</p>
    </div>
  </section>
</BaseLayout>
