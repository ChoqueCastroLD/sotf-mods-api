---
/**
 * 500 page: what happened, «Try again», Discord for status and the reference id (`cf-ray` or a
 * UUID) the user can quote.
 * No API calls, no JavaScript needed; `no-store` (the middleware never caches ≥ 500). Transient API
 * failures (429, 502+) answer 503 with `Retry-After` instead.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { MessagesSquare, RotateCcw } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/i18n.ts';
import { ensureLocals } from '../lib/request-context.ts';
import { SOCIAL_LINKS } from '../lib/site.ts';

interface Props {
  error?: unknown;
}

const locals = ensureLocals(Astro);
// Transient API failures are answered 503 + Retry-After by the middleware (it rewrites here).
Astro.response.status = locals.upstreamError ? 503 : 500;
const retryHref = href(locals.pagePath.split('#', 1)[0] ?? '/', locals.locale);
---

<BaseLayout
  template="server-error"
  seo={{ title: m.meta_server_error_title(), description: m.shell_500_text(), noindex: true, canonical: false, alternates: false }}
>
  <section class="mx-auto grid w-full max-w-(--container-prose) gap-5 px-4 py-14 md:px-6 md:py-20">
    <p class="text-sm font-semibold text-danger tabular-nums">{Astro.response.status}</p>
    <h1 class="text-3xl font-bold text-fg md:text-4xl">{m.shell_500_title()}</h1>
    <p class="text-lg text-fg-muted">{m.shell_500_text()}</p>
    <div class="flex flex-wrap gap-3">
      <a
        href={retryHref}
        class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-4 font-semibold text-primary-fg hover:bg-primary-hover"
      >
        <Icon icon={RotateCcw} size={18} />
        {m.errors_server_retry()}
      </a>
      <a
        href={SOCIAL_LINKS.discord}
        rel="noopener"
        class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-4 font-semibold text-fg hover:bg-fg/8"
      >
        <Icon icon={MessagesSquare} size={18} />
        {m.errors_server_status()}
      </a>
    </div>
    <p class="text-sm text-fg-subtle">{m.errors_reference({ id: locals.requestId })}</p>
  </section>
</BaseLayout>
