---
/**
 * `/achievements` (WP-64, PLAN §7.2, §4.2): the public rules of the gamification — Survivor ranks
 * and the XP rules, Creator tiers, every badge with how it is earned and the share of survivors
 * who have it, per-mod milestones, Mod of the Week and the anti-abuse principles.
 *
 * - SSR, edge-cached 3600 s with `stats` (the badge catalog and its unlock shares, `GET /badges`).
 *   Without the API the page still renders every rule from the contract, without the shares.
 * - Secret badges keep their secret: listed as «Secret badge» until someone earns them.
 * - JSON-LD `CollectionPage` → `DefinedTermSet` of the badges (+ `BreadcrumbList`).
 */
import type { CreatorTierKey, SurvivorRankKey } from '@sotf/contracts/common';
import { MOD_MILESTONES } from '@sotf/contracts/common';
import {
  BADGE_GROUPS,
  BADGES,
  CREATOR_TIERS,
  SURVIVOR_RANKS,
  XP_RULES,
  type XpEventKind,
} from '@sotf/contracts/gamification';
import { formatCompactNumber, formatNumber, formatPercent } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { CatalogStamp, RankStampBlock, TierStampBlock } from '../components/profile/Domain.tsx';
import { loadBadgeCatalog } from '../components/profile/data.ts';
import { badgeGroupName, badgeHint, badgeName, profileDomainI18n } from '../components/profile/i18n.ts';
import { achievementsJsonLd } from '../components/profile/seo.ts';
import PageLayout from '../layouts/PageLayout.astro';
import { setPageCache } from '../lib/cache/page.ts';
import { EDGE_TTL, pageCache } from '../lib/cache/policy.ts';
import { loadEnv } from '../lib/env.ts';
import { href } from '../lib/i18n.ts';
import { ensureLocals } from '../lib/request-context.ts';

export const prerender = false;

const locale = ensureLocals(Astro).locale;
const catalog = await loadBadgeCatalog(1500);
setPageCache(Astro, catalog ? pageCache.custom(EDGE_TTL.hour, ['stats']) : pageCache.custom(EDGE_TTL.notFound));

const env = loadEnv();
const i18n = profileDomainI18n(locale);
const pageUrl = `${env.siteUrl}${href('/achievements', locale)}`;

interface Row {
  key: string;
  group: string;
  icon: string;
  secret: boolean;
  repeatable: boolean;
  share: number | null;
  count: number | null;
}

const rows: Row[] = catalog?.badges.length
  ? catalog.badges.map((badge) => ({
      key: badge.key,
      group: badge.group,
      icon: badge.icon,
      secret: badge.isSecret,
      repeatable: badge.isRepeatable,
      share: badge.earnedShare,
      count: badge.earnedCount,
    }))
  : BADGES.map((badge) => ({
      key: badge.key,
      group: badge.group,
      icon: badge.icon,
      secret: badge.secret,
      repeatable: badge.repeatable,
      share: null,
      count: null,
    }));
const groupOrder: readonly string[] = BADGE_GROUPS;
const groups = [...new Set(rows.map((row) => row.group))]
  .sort((a, b) => {
    const ia = groupOrder.indexOf(a);
    const ib = groupOrder.indexOf(b);
    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
  })
  .map((group) => ({ group, badges: rows.filter((row) => row.group === group) }));

const ranks: ReadonlyArray<{ key: SurvivorRankKey; minXp: number }> = catalog?.survivorRanks.length
  ? catalog.survivorRanks
  : SURVIVOR_RANKS;
const tiers: ReadonlyArray<{ key: CreatorTierKey; minDownloads: number }> = catalog?.creatorTiers.length
  ? catalog.creatorTiers
  : CREATOR_TIERS;
const spotlightTiers = new Set(CREATOR_TIERS.filter((tier) => tier.spotlight).map((tier) => tier.key));

const XP_LABEL: Record<XpEventKind, () => string> = {
  review_with_text: () => m.profile_xp_review_with_text(),
  review_helpful_vote: () => m.profile_xp_review_helpful_vote(),
  compat_report: () => m.profile_xp_compat_report(),
  compat_report_consensus: () => m.profile_xp_compat_report_consensus(),
  comment_solution_or_pinned: () => m.profile_xp_comment_solution_or_pinned(),
  bug_report_resolved: () => m.profile_xp_bug_report_resolved(),
  kit_followers_10: () => m.profile_xp_kit_followers_10(),
  profile_completed: () => m.profile_xp_profile_completed(),
  onboarding_completed: () => m.profile_xp_onboarding_completed(),
  first_follow: () => m.profile_xp_first_follow(),
  patch_day_release: () => m.profile_xp_patch_day_release(),
};
const xpRules = (Object.keys(XP_RULES) as XpEventKind[]).map((kind) => ({ kind, ...XP_RULES[kind] }));

function limitText(rule: { dailyCap: number | null; once: boolean; kind: XpEventKind }): string {
  if (rule.kind === 'patch_day_release') return m.profile_xp_limit_per_build();
  if (rule.once) return m.profile_xp_limit_once();
  if (rule.dailyCap !== null) return m.profile_xp_limit_daily({ count: rule.dailyCap });
  return m.profile_xp_limit_none();
}

const jsonLd = [
  achievementsJsonLd({
    locale,
    siteUrl: env.siteUrl,
    pageUrl,
    badges: rows
      .filter((row) => !row.secret)
      .map((row) => ({ name: badgeName(row.key), description: badgeHint(row.key) })),
  }),
];
const sectionTitle = 'font-display-caps text-display-xs text-fg';
const panel = 'rounded-lg border border-border bg-surface';
const th = 'px-4 py-2.5 text-start font-medium text-fg-muted';
const td = 'px-4 py-3';
---

<PageLayout
  template="achievements"
  seo={{ title: m.profile_achievements_meta_title(), description: m.profile_achievements_meta_description() }}
  jsonLd={jsonLd}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: m.common_nav_achievements() }]}
>
  <article class="grid gap-12" aria-labelledby="achievements-title">
    <header class="grid gap-4">
      <h1 id="achievements-title" class="font-display-caps text-display-md text-fg">{m.profile_achievements_title()}</h1>
      <p class="max-w-(--container-prose) text-lg text-pretty text-fg-muted">{m.profile_achievements_intro()}</p>
      <ul class="grid max-w-(--container-prose) list-disc gap-2 ps-5 text-sm text-fg-muted marker:text-primary">
        <li>{m.profile_achievements_principle_quality()}</li>
        <li>{m.profile_achievements_principle_no_streaks()}</li>
        <li>{m.profile_achievements_principle_retroactive()}</li>
        <li>
          <a href={href('/settings/privacy', locale)} class="text-link underline underline-offset-3">
            {m.profile_achievements_principle_privacy()}
          </a>
        </li>
      </ul>
      <nav aria-label={m.profile_achievements_toc()} class="flex flex-wrap gap-2 text-sm">
        {
          [
            ['#ranks', m.profile_achievements_ranks_title()],
            ['#tiers', m.profile_achievements_tiers_title()],
            ['#badges', m.profile_achievements_badges_title()],
            ['#milestones', m.profile_achievements_milestones_title()],
            ['#fair-play', m.profile_achievements_fair_play_title()],
          ].map(([anchor, label]) => (
            <a
              href={anchor}
              class="inline-flex min-h-11 items-center rounded-md border border-border px-3 hover:border-border-strong hover:bg-fg/4 md:min-h-9"
            >
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <section id="ranks" aria-labelledby="ranks-title" class="grid gap-4">
      <h2 id="ranks-title" class={sectionTitle}>{m.profile_achievements_ranks_title()}</h2>
      <p class="max-w-(--container-prose) text-fg-muted">{m.profile_achievements_ranks_intro()}</p>
      <div class="grid gap-6 lg:grid-cols-2">
        <div class:list={[panel, 'overflow-x-auto']}>
          <table class="w-full text-sm">
            <caption class="sr-only">{m.profile_achievements_ranks_title()}</caption>
            <thead>
              <tr class="border-b border-border">
                <th scope="col" class={th}>{m.profile_rank_label()}</th>
                <th scope="col" class={`${th} text-end`}>{m.profile_achievements_xp_needed()}</th>
              </tr>
            </thead>
            <tbody>
              {
                ranks.map((rank) => (
                  <tr class="border-b border-border/60 last:border-0">
                    <th scope="row" class={`${td} text-start font-normal`}>
                      <RankStampBlock i18n={i18n} rank={rank.key} />
                    </th>
                    <td class={`${td} text-end font-mono tabular-nums`}>{formatNumber(locale, rank.minXp)} XP</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class:list={[panel, 'overflow-x-auto']}>
          <table class="w-full text-sm">
            <caption class="px-4 pt-3 text-start font-semibold text-fg">{m.profile_achievements_xp_title()}</caption>
            <thead>
              <tr class="border-b border-border">
                <th scope="col" class={th}>{m.profile_achievements_xp_action()}</th>
                <th scope="col" class={`${th} text-end`}>XP</th>
                <th scope="col" class={`${th} text-end`}>{m.profile_achievements_xp_limit()}</th>
              </tr>
            </thead>
            <tbody>
              {
                xpRules.map((rule) => (
                  <tr class="border-b border-border/60 last:border-0">
                    <th scope="row" class={`${td} text-start font-normal text-fg`}>{XP_LABEL[rule.kind]()}</th>
                    <td class={`${td} text-end font-mono tabular-nums text-primary`}>+{formatNumber(locale, rule.points)}</td>
                    <td class={`${td} text-end text-fg-muted`}>{limitText(rule)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="px-4 pb-4 text-xs text-fg-muted">{m.profile_achievements_xp_note()}</p>
        </div>
      </div>
    </section>

    <section id="tiers" aria-labelledby="tiers-title" class="grid gap-4">
      <h2 id="tiers-title" class={sectionTitle}>{m.profile_achievements_tiers_title()}</h2>
      <p class="max-w-(--container-prose) text-fg-muted">{m.profile_achievements_tiers_intro()}</p>
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          tiers.map((tier) => (
            <li class:list={[panel, 'grid gap-2 p-4']}>
              <TierStampBlock i18n={i18n} tier={tier.key} />
              <p class="font-mono text-sm tabular-nums text-fg">
                {m.profile_achievements_tier_threshold({
                  count: tier.minDownloads,
                  downloads: formatCompactNumber(locale, tier.minDownloads),
                })}
              </p>
              <p class="text-sm text-fg-muted">
                {spotlightTiers.has(tier.key)
                  ? m.profile_achievements_tier_perks_spotlight()
                  : m.profile_achievements_tier_perks()}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="badges" aria-labelledby="badges-title" class="grid gap-6">
      <div class="grid gap-2">
        <h2 id="badges-title" class={sectionTitle}>{m.profile_achievements_badges_title()}</h2>
        <p class="max-w-(--container-prose) text-fg-muted">{m.profile_achievements_badges_intro()}</p>
      </div>
      {
        groups.map((group) => (
          <section aria-labelledby={`group-${group.group}`} class:list={[panel, 'grid gap-4 p-4 md:p-6']}>
            <h3 id={`group-${group.group}`} class="readout text-fg-muted">
              {badgeGroupName(group.group)}
            </h3>
            <ul class="grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
              {group.badges.map((badge) => (
                <li class="grid content-start gap-1.5" data-badge={badge.key}>
                  {badge.secret ? (
                    <>
                      <CatalogStamp i18n={i18n} name={m.profile_badge_secret_name()} icon={badge.icon} locked />
                      <p class="text-sm text-fg-muted">{m.profile_badge_secret_hint()}</p>
                    </>
                  ) : (
                    <>
                      <CatalogStamp i18n={i18n} name={badgeName(badge.key)} icon={badge.icon} />
                      <p class="text-sm text-fg-muted">{badgeHint(badge.key)}</p>
                    </>
                  )}
                  <p class="readout text-fg-subtle">
                    {badge.share !== null && badge.count !== null
                      ? m.profile_achievements_badge_share({
                          share: formatPercent(locale, badge.share, badge.share > 0 && badge.share < 0.01 ? 1 : 0),
                          count: badge.count,
                        })
                      : null}
                    {badge.repeatable && <span class="ms-1">· {m.profile_achievements_badge_repeatable()}</span>}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>

    <section id="milestones" aria-labelledby="milestones-title" class="grid gap-4">
      <h2 id="milestones-title" class={sectionTitle}>{m.profile_achievements_milestones_title()}</h2>
      <p class="max-w-(--container-prose) text-fg-muted">{m.profile_achievements_milestones_intro()}</p>
      <ol class="flex flex-wrap gap-2">
        {
          MOD_MILESTONES.map((milestone) => (
            <li class="rounded-sm border-2 border-fg/60 px-2 py-0.5 font-display-caps text-sm tabular-nums text-fg -rotate-2">
              {formatCompactNumber(locale, milestone)}
            </li>
          ))
        }
      </ol>
      <div class="grid gap-3 md:grid-cols-2">
        <div class:list={[panel, 'grid gap-2 p-4']}>
          <h3 class="font-semibold text-fg">{m.profile_achievements_motw_title()}</h3>
          <p class="text-sm text-fg-muted">{m.profile_achievements_motw_body()}</p>
        </div>
        <div class:list={[panel, 'grid gap-2 p-4']}>
          <h3 class="font-semibold text-fg">{m.profile_achievements_day_title()}</h3>
          <p class="text-sm text-fg-muted">{m.profile_achievements_day_body()}</p>
        </div>
      </div>
    </section>

    <section id="fair-play" aria-labelledby="fair-play-title" class="grid gap-4">
      <h2 id="fair-play-title" class={sectionTitle}>{m.profile_achievements_fair_play_title()}</h2>
      <ul class="grid max-w-(--container-prose) list-disc gap-2 ps-5 text-fg-muted marker:text-primary">
        <li>{m.profile_achievements_fair_play_downloads()}</li>
        <li>{m.profile_achievements_fair_play_same_network()}</li>
        <li>{m.profile_achievements_fair_play_new_accounts()}</li>
        <li>{m.profile_achievements_fair_play_spikes()}</li>
        <li>{m.profile_achievements_fair_play_reversible()}</li>
      </ul>
    </section>
  </article>
</PageLayout>
