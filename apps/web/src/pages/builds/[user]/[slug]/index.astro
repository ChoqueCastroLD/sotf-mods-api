---
/**
 * Build page `/builds/:user/:slug`, laid out like the mod page: gallery and header with the
 * download, then About, Preview, How to import, Required mods, Versions, Reviews and Comments in
 * one column and a plain details list in the sidebar.
 *
 * - SSR, edge-cached 900 s with `mod:{id}` + `user:{id}` (PLAN §4.2); the resolver answers
 *   301/404/410 for old, mistyped or removed URLs and sends mods reached through `/builds` to
 *   `/mods/…`. Unknown sub-paths are 404.
 * - Gallery · header (uploader, authors, stats, size S/M/L/XL, download, follow, copy link) ·
 *   description · «How to import (3 steps)» · required mods · versions · reviews and comments
 *   (first page in the HTML + island mount points) · details · more builds.
 * - Discovery links (WP-61): Markdown alternate, builds RSS feed and oEmbed.
 * - JSON-LD `CreativeWork` (+ `BreadcrumbList` of the visible trail); `aggregateRating` only with ≥ 3
 *   visible reviews. Everything user-specific is filled in by `build-page.ts` after load.
 */

import { toHtmlLang } from '@sotf/i18n';
import { m } from '@sotf/i18n/messages';
import { localizeHtml } from '@sotf/markdown/labels';
import { Breadcrumbs } from '@sotf/ui/breadcrumbs';
import { ProseLocator } from '@sotf/ui/domain';
import BuildGallery from '../../../../components/builds/BuildGallery.astro';
import BuildHeader from '../../../../components/builds/BuildHeader.astro';
import BuildMoreSheet from '../../../../components/builds/BuildMoreSheet.astro';
import BuildSocial from '../../../../components/builds/BuildSocial.astro';
import BuildViewer from '../../../../components/builds/BuildViewer.astro';
import '../../../../components/builds/blueprint.css';
import { BuildDependencies, RelatedBuildGrid } from '../../../../components/builds/Domain.tsx';
import {
  BUILDSHARE_MANIFEST_ID,
  loadBuildExtras,
  resolveBuildPage,
} from '../../../../components/builds/data.ts';
import ImportSteps from '../../../../components/builds/ImportSteps.astro';
import { loginHrefFor, markdownLabels } from '../../../../components/builds/i18n.ts';
import MobileDownloadBar from '../../../../components/builds/MobileDownloadBar.astro';
import { respondUnresolved } from '../../../../components/builds/responses.ts';
import SpecSheet from '../../../../components/builds/SpecSheet.astro';
import StatusBanners from '../../../../components/builds/StatusBanners.astro';
import { buildDescription, buildJsonLd, buildTitle } from '../../../../components/builds/seo.ts';
import VersionsList from '../../../../components/builds/VersionsList.astro';
import Clamp from '../../../../components/mod/Clamp.astro';
import Lightbox from '../../../../components/mod/Lightbox.astro';
import ReportDialog from '../../../../components/mod/ReportDialog.astro';
import SectionNav from '../../../../components/mod/SectionNav.astro';
import SocialSheets from '../../../../components/mod/SocialSheets.astro';
import TranslatedText from '../../../../components/mod/TranslatedText.astro';
import VersionSheet from '../../../../components/mod/VersionSheet.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { setPageCache } from '../../../../lib/cache/page.ts';
import { pageCache } from '../../../../lib/cache/policy.ts';
import { loadEnv } from '../../../../lib/env.ts';
import { href } from '../../../../lib/i18n.ts';
import { pictureSources } from '../../../../lib/images.ts';
import { localizeCards } from '../../../../lib/localize.ts';
import { loadModTranslation } from '../../../../lib/mod-translation.ts';
import { ensureLocals } from '../../../../lib/request-context.ts';
import { breadcrumbJsonLd } from '../../../../lib/seo/jsonld.ts';
import { entityOg } from '../../../../lib/seo/og.ts';

export const prerender = false;

const locale = ensureLocals(Astro).locale;
const resolved = await resolveBuildPage(Astro);
if (resolved.kind !== 'ok') return respondUnresolved(Astro, resolved);
if (resolved.rest.length > 0) return respondUnresolved(Astro, { kind: 'not-found' });

const { build } = resolved;
setPageCache(Astro, pageCache.mod(build.id, build.userId));
const [extras, translation] = await Promise.all([
  loadBuildExtras(build).then((value) => localizeCards(value, locale)),
  loadModTranslation(build, locale),
]);
const { spec } = extras;
const env = loadEnv();
const lang = toHtmlLang(locale);
const pageUrl = `${env.siteUrl}${href(build.canonicalPath, locale)}`;
const labels = markdownLabels();
const descriptionHtml = build.descriptionHtml.trim() ? localizeHtml(build.descriptionHtml, labels) : '';
// T1-25: the description in the visitor's language (the original one click away).
const translatedHtml = translation?.descriptionHtml?.trim() && descriptionHtml ? localizeHtml(translation.descriptionHtml, labels) : '';
const otherDependencies = build.dependencies.filter((dependency) => dependency.manifestId !== BUILDSHARE_MANIFEST_ID);

const hero = build.nsfw ? null : (build.thumbnail ?? build.gallery[0] ?? null);
const heroSources = hero ? pictureSources(hero.srcset) : null;
const preloadImage = hero
  ? heroSources?.avif
    ? {
        href: hero.url,
        srcset: heroSources.avif,
        sizes: '(min-width: 80rem) 760px, (min-width: 64rem) 58vw, 100vw',
        type: 'image/avif',
      }
    : { href: hero.url }
  : undefined;
const sectionTitle = 'text-xl font-bold text-fg';
const trail: { label: string; path?: string }[] = [
  { label: m.common_nav_home(), path: '/' },
  { label: m.common_term_builds(), path: '/builds' },
  { label: build.name },
];
const jsonLd = [
  ...buildJsonLd({ build, spec, locale, siteUrl: env.siteUrl, pageUrl }),
  breadcrumbJsonLd(
    trail.map((crumb) => ({
      name: crumb.label,
      url: crumb.path === undefined ? undefined : `${env.siteUrl}${href(crumb.path, locale)}`,
    })),
  ),
];
const oembedHref = `/oembed?url=${encodeURIComponent(pageUrl)}&format=json`;
const visibleCrumbs = trail.map((crumb) => ({
  label: crumb.label,
  href: crumb.path === undefined ? undefined : href(crumb.path, locale),
}));
---

<BaseLayout
  template="build"
  seo={{
    title: buildTitle(build),
    description: buildDescription(build, spec, locale),
    path: build.canonicalPath,
    noindex: build.noindex,
    adult: build.nsfw,
    og: {
      imageAlt: m.builds_og_alt({ name: build.name }),
      type: 'article',
      ...entityOg(build),
    },
  }}
  jsonLd={jsonLd}
  preloadImage={preloadImage}
  entity={{ type: 'build', id: build.id }}
>
  <Fragment slot="head">
    <meta name="sotf:content-lang" content={build.contentLang ?? 'en'} />
    <link rel="alternate" type="text/markdown" href={`${build.canonicalPath}.md`} title={build.name} />
    <link rel="alternate" type="application/rss+xml" href="/builds/feed.xml" title={m.builds_feed_title()} />
    <link rel="alternate" type="application/json+oembed" href={oembedHref} title={build.name} />
  </Fragment>

  <div class="mx-auto grid w-full max-w-(--container-content) grid-cols-1 gap-4 px-4 py-4 md:gap-5 md:px-6 md:py-8">
    <Breadcrumbs items={visibleCrumbs} />
    <article data-build-page data-mod-id={build.id} class="grid grid-cols-1 gap-6" aria-labelledby="build-title">
      <StatusBanners build={build} />

      <div class="bp-hero bp-paper grid grid-cols-1 gap-6 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:items-start md:gap-8">
        <span class="bp-tick bp-tick-tl" aria-hidden="true"></span>
        <span class="bp-tick bp-tick-tr" aria-hidden="true"></span>
        <span class="bp-tick bp-tick-bl" aria-hidden="true"></span>
        <span class="bp-tick bp-tick-br" aria-hidden="true"></span>
        <BuildGallery build={build} />
        <BuildHeader build={build} spec={spec} versions={extras.versions} />
      </div>

      <SectionNav
        label={m.mod_tabs_label()}
        items={[
          { id: 'about', label: m.mod_tab_description() },
          { id: 'versions', label: m.mod_tab_versions(), count: extras.versions ? String(extras.versions.length) : null },
          { id: 'comments', label: m.mod_tab_comments(), count: build.commentsCount > 0 ? String(build.commentsCount) : null },
          { id: 'reviews', label: m.mod_tab_reviews(), count: build.reviewsSummary.count > 0 ? String(build.reviewsSummary.count) : null },
          { id: 'spec', label: m.mod_details_title() },
        ]}
      />

      <div class="mt-2 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-12">
        <div class="grid min-w-0 gap-12">
          <section id="about" aria-labelledby="about-title" class="grid scroll-mt-32 gap-4 md:scroll-mt-24">
            <h2 id="about-title" class={sectionTitle}>{m.builds_description_title()}</h2>
            <Clamp>
              {
                translatedHtml && translation ? (
                  <TranslatedText
                    html
                    translated={translatedHtml}
                    original={descriptionHtml}
                    locale={locale}
                    sourceLang={build.contentLang}
                    source={translation.sources?.description ?? 'machine'}
                    class="max-w-(--container-prose)"
                  />
                ) : descriptionHtml ? (
                  <ProseLocator
                    html={descriptionHtml}
                    lang={build.contentLang ?? undefined}
                    className="max-w-(--container-prose)"
                  />
                ) : (
                  <p class="text-fg-muted">{m.builds_description_empty()}</p>
                )
              }
            </Clamp>
          </section>

          <BuildViewer build={build} preview={extras.preview} />

          <ImportSteps build={build} />

          {
            otherDependencies.length > 0 && (
              <section id="dependencies" aria-labelledby="dependencies-title" class="grid gap-3">
                <h2 id="dependencies-title" class={sectionTitle}>
                  {m.builds_requires_title()}
                </h2>
                <BuildDependencies lang={lang} dependencies={otherDependencies} />
              </section>
            )
          }

          <VersionsList build={build} versions={extras.versions} />

          <BuildSocial build={build} reviews={extras.reviews} comments={extras.comments} />
        </div>

        <aside class="grid min-w-0 content-start gap-6 max-lg:border-t max-lg:border-border max-lg:pt-8">
          <SpecSheet build={build} spec={spec} />
        </aside>
      </div>

      {
        extras.related.length > 0 && (
          <section aria-labelledby="related-title" class="mt-4 grid gap-4 border-t border-border pt-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 id="related-title" class={sectionTitle}>
                {m.builds_related_title()}
              </h2>
              <a href={href('/builds', locale)} class="inline-flex min-h-9 items-center font-medium text-link hover:underline">
                {m.builds_related_all()}
              </a>
            </div>
            <RelatedBuildGrid lang={lang} builds={extras.related} label={m.builds_related_title()} />
          </section>
        )
      }
    </article>
  </div>

  <MobileDownloadBar build={build} />
  <BuildMoreSheet build={build} />
  <Lightbox mod={build} />
  <VersionSheet />
  <SocialSheets mod={build} loginHref={loginHrefFor(href('/login', locale), href(Astro.locals.pagePath, locale))} reviewsPage={false} />
  <ReportDialog mod={build} loginHref={loginHrefFor(href('/login', locale), href(Astro.locals.pagePath, locale))} />
</BaseLayout>

<script>
  import { initBuildPage } from '../../../../components/builds/build-page.ts';
  import { initBuildViewer } from '../../../../components/builds/build-viewer.ts';

  initBuildPage();
  initBuildViewer();
</script>
