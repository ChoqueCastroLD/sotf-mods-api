---
/**
 * `/`: the catalogue, like the original site's mods page. The default listing (newest mods) under a
 * slim carousel of the week's top mods, with the site figures and «Mods of the week» beside it.
 * Same view as `/mods` (see `components/explore/catalog-page.ts`): `/` is the canonical of the
 * default listing and redirects any filtered or paged variant to `/mods…`.
 *
 * - SSR, edge-cached (`home`, `list:mods`); 503 and not cached while the listing read fails.
 * - One `h1` («Sons of the Forest Mods»), `WebSite` + `SearchAction`, `Organization` and the
 *   `CollectionPage` + `ItemList` of the first page as JSON-LD.
 */
import CatalogPage from '../components/explore/CatalogPage.astro';
import { loadCatalogPage } from '../components/explore/catalog-page.ts';
import { setPageCache } from '../lib/cache/page.ts';
import { EDGE_TTL, pageCache } from '../lib/cache/policy.ts';
import { localizeCards } from '../lib/localize.ts';
import { ensureLocals } from '../lib/request-context.ts';

const locale = ensureLocals(Astro).locale;
setPageCache(Astro, pageCache.custom(EDGE_TTL.list, ['home', 'list:mods']));

const page = await loadCatalogPage({ url: Astro.url, locale, mode: 'home' });
if (page.kind === 'redirect') return Astro.redirect(page.location, 301);
await localizeCards({ listing: page.listing.list, aside: page.aside }, locale);

if (page.listing.list === null) {
  setPageCache(Astro, false);
  Astro.response.status = 503;
}
---

<CatalogPage page={page} />
