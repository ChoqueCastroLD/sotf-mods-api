---
/**
 * `/patch-radar/:build` (PLAN §4.2, §7.10): Patch Radar of a past game build, addressed by the
 * slug of its label (`/patch-radar/1.0.3`). The current build → 301 `/patch-radar`; another
 * spelling or the numeric id → 301 to the canonical slug; unknown → 404. E(300) `compat`.
 */
import RadarPage from '../../components/content/RadarPage.astro';
import { loadBuildRadar } from '../../components/content/radar.ts';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';
import { href } from '../../lib/i18n.ts';

const locale = Astro.locals.locale;
const segment = Astro.params.build ?? '';
const path = `/patch-radar/${segment}`;
const result = await loadBuildRadar(segment);

if (result.kind === 'not-found') {
  setPageCache(Astro, pageCache.notFound());
  return new Response(null, { status: 404 });
}
if (result.kind === 'redirect') {
  setPageCache(Astro, pageCache.compat());
  return Astro.redirect(href(result.path, locale), 301);
}
if (result.kind === 'error') {
  setPageCache(Astro, false);
  Astro.response.status = 503;
  Astro.response.headers.set('retry-after', '60');
} else {
  setPageCache(Astro, pageCache.compat());
}
const state = result.kind === 'ok' ? result : ({ kind: 'error' } as const);
---

<RadarPage path={path} state={state} />
