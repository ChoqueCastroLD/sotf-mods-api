---
/**
 * `/patch-radar` (T0-10, PLAN §4.2, §7.10): ecosystem state on the current game build. SSR, edge
 * E(300) tag `compat` (purged when builds, reports or the ecosystem change); indexable. No build
 * registered yet → friendly empty state (`noindex`); API down → 503, not cached.
 */
import RadarPage from '../../components/content/RadarPage.astro';
import { loadCurrentRadar } from '../../components/content/radar.ts';
import { setPageCache } from '../../lib/cache/page.ts';
import { pageCache } from '../../lib/cache/policy.ts';

const result = await loadCurrentRadar();
if (result.kind === 'error') {
  setPageCache(Astro, false);
  Astro.response.status = 503;
  Astro.response.headers.set('retry-after', '60');
} else {
  setPageCache(Astro, pageCache.compat());
}
const state =
  result.kind === 'ok' ? result : result.kind === 'error' ? ({ kind: 'error' } as const) : ({ kind: 'empty' } as const);
---

<RadarPage path="/patch-radar" state={state} />
