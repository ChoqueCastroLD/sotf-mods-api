---
/**
 * `/brand` — brand kit (research/03 §6.15, PLAN §3.1–3.4): logo lockups, isotype, wordmark, app
 * icon and OG image with SVG/PNG downloads for each surface, the core palette, typefaces, usage
 * rules, a «link to SOTF Mods» snippet and the fan/trademark notice. Everything is static (the
 * files come from `@sotf/brand`); edge-cached a day and purged on deploy.
 */
import { m } from '@sotf/i18n/messages';
import { Icon } from '@sotf/ui/icons';
import { Check, Download, X } from 'lucide-react';
import { BRAND_ASSETS, BRAND_FONTS, BRAND_SWATCHES } from '../components/content/brand-assets.ts';
import ContentHeader from '../components/content/ContentHeader.astro';
import { webPageJsonLd } from '../components/content/jsonld.ts';
import PageLayout from '../layouts/PageLayout.astro';
import { setPageCache } from '../lib/cache/page.ts';
import { pageCache } from '../lib/cache/policy.ts';
import { loadEnv } from '../lib/env.ts';
import { localizePath } from '../lib/i18n.ts';

setPageCache(Astro, pageCache.static());
const locale = Astro.locals.locale;
const siteUrl = loadEnv().siteUrl.replace(/\/+$/, '');
const path = '/brand';
const title = m.content_brand_title();
const description = m.content_brand_description();

type MessageFn = (inputs?: Record<string, unknown>) => string;
const messages = m as unknown as Readonly<Record<string, MessageFn>>;
const text = (key: string) => messages[key]?.({}) ?? key;

const snippet = `<a href="${siteUrl}/"><img src="${siteUrl}/brand/logo-horizontal-night.svg" alt="SOTF Mods" width="157" height="29"></a>`;
const dos = [m.content_brand_do_space(), m.content_brand_do_size(), m.content_brand_do_contrast(), m.content_brand_do_link()];
const donts = [
  m.content_brand_dont_recolor(),
  m.content_brand_dont_distort(),
  m.content_brand_dont_game(),
  m.content_brand_dont_endorse(),
];
---

<PageLayout
  template="brand"
  width="wide"
  seo={{ title, description, path }}
  jsonLd={[
    webPageJsonLd({ siteUrl, url: `${siteUrl}${localizePath(path, locale)}`, locale, name: title, description }),
  ]}
  breadcrumbs={[{ label: m.common_nav_home(), path: '/' }, { label: m.common_footer_brand() }]}
>
  <article class="flex flex-col gap-12" aria-labelledby="brand-title">
    <ContentHeader eyebrow={m.content_brand_eyebrow()} title={title} id="brand-title" lead={m.content_brand_lead()} />

    <section aria-labelledby="brand-logos-title" class="flex flex-col gap-4">
      <h2 id="brand-logos-title" class="font-display-caps text-display-xs text-fg">{m.content_brand_logos_title()}</h2>
      <p class="max-w-(--container-prose) text-fg-muted">{m.content_brand_logos_text()}</p>
      <ul class="grid gap-4 md:grid-cols-2">
        {
          BRAND_ASSETS.map((asset) => (
            <li class="flex flex-col overflow-hidden rounded-lg border border-border bg-surface">
              <div class="grid grid-cols-2">
                {(['night', 'day'] as const).map((surface) => (
                  <div
                    class:list={[
                      'flex h-40 items-center justify-center p-6',
                      surface === 'night' ? 'bg-night-975' : 'bg-night-50',
                    ]}
                  >
                    <img
                      src={asset.previews[surface].src}
                      alt=""
                      width={asset.previews[surface].width}
                      height={asset.previews[surface].height}
                      loading="lazy"
                      decoding="async"
                      class="max-h-full w-auto max-w-full object-contain"
                    />
                  </div>
                ))}
              </div>
              <div class="flex flex-1 flex-col gap-3 p-4">
                <div class="grid gap-0.5">
                  <h3 class="font-semibold text-fg">{text(`content_brand_asset_${asset.id.replace('-', '_')}`)}</h3>
                  <p class="text-sm text-fg-muted">{text(`content_brand_asset_${asset.id.replace('-', '_')}_hint`)}</p>
                </div>
                <div class="grid gap-2 sm:grid-cols-2">
                  {(['night', 'day'] as const).map((surface) => (
                    <div class="grid gap-1">
                      <p class="readout">{surface === 'night' ? m.content_brand_on_night() : m.content_brand_on_day()}</p>
                      <ul class="flex flex-wrap gap-1.5">
                        {asset.files[surface].map((file) => (
                          <li>
                            <a
                              href={file.href}
                              download
                              class="inline-flex min-h-9 items-center gap-1.5 rounded-md border border-border-strong px-2.5 text-xs font-semibold text-fg hover:border-primary hover:bg-fg/6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
                            >
                              <Icon icon={Download} size={14} />
                              {file.format}
                              {file.size && <span class="font-mono font-normal text-fg-muted">{file.size}</span>}
                              <span class="sr-only">
                                {' '}
                                {text(`content_brand_asset_${asset.id.replace('-', '_')}`)}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="brand-colors-title" class="flex flex-col gap-4">
      <h2 id="brand-colors-title" class="font-display-caps text-display-xs text-fg">{m.content_brand_colors_title()}</h2>
      <p class="max-w-(--container-prose) text-fg-muted">{m.content_brand_colors_text()}</p>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          BRAND_SWATCHES.map((swatch) => (
            <li class="overflow-hidden rounded-lg border border-border">
              <div class="flex h-24 items-end p-3" style={`background:${swatch.hex};color:${swatch.on}`}>
                <span class="font-mono text-sm font-semibold">{swatch.hex}</span>
              </div>
              <p class="bg-surface px-3 py-2 text-sm text-fg">{text(`content_brand_color_${swatch.id.replace('-', '_')}`)}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="brand-type-title" class="flex flex-col gap-4">
      <h2 id="brand-type-title" class="font-display-caps text-display-xs text-fg">{m.content_brand_type_title()}</h2>
      <ul class="grid gap-3 md:grid-cols-3">
        {
          BRAND_FONTS.map((font) => (
            <li class="flex flex-col gap-2 rounded-lg border border-border bg-surface p-4">
              <p class:list={['text-3xl text-fg', font.className]}>{font.name}</p>
              <p class="text-sm text-fg-muted">{text(`content_brand_font_${font.id}`)}</p>
              <a href={font.url} rel="noopener" class="mt-auto text-sm font-semibold text-link underline underline-offset-3">
                {m.content_brand_font_link({ name: font.name })}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="brand-rules-title" class="flex flex-col gap-4">
      <h2 id="brand-rules-title" class="font-display-caps text-display-xs text-fg">{m.content_brand_rules_title()}</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="rounded-lg border border-success/40 bg-success-soft p-5">
          <h3 class="mb-3 flex items-center gap-2 font-semibold text-success">
            <Icon icon={Check} size={18} />
            {m.content_brand_do_title()}
          </h3>
          <ul class="grid gap-2 text-sm text-fg">
            {dos.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="text-success">✔</span>{item}</li>)}
          </ul>
        </div>
        <div class="rounded-lg border border-danger/40 bg-danger-soft p-5">
          <h3 class="mb-3 flex items-center gap-2 font-semibold text-danger">
            <Icon icon={X} size={18} />
            {m.content_brand_dont_title()}
          </h3>
          <ul class="grid gap-2 text-sm text-fg">
            {donts.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="text-danger">✖</span>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="brand-link-title" class="flex flex-col gap-3">
      <h2 id="brand-link-title" class="font-display-caps text-display-xs text-fg">{m.content_brand_link_title()}</h2>
      <p class="max-w-(--container-prose) text-fg-muted">{m.content_brand_link_text()}</p>
      <label for="brand-snippet" class="readout">{m.content_brand_snippet_label()}</label>
      <textarea
        id="brand-snippet"
        readonly
        rows="3"
        class="w-full resize-none rounded-md border border-border-strong bg-sunken p-3 font-mono text-xs text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      >{snippet}</textarea>
    </section>

    <aside aria-labelledby="brand-legal-title" class="rounded-lg border border-border-strong bg-surface p-5">
      <h2 id="brand-legal-title" class="mb-1 font-semibold text-fg">{m.content_brand_legal_title()}</h2>
      <p class="text-sm text-pretty text-fg-muted">{m.content_brand_legal_text()}</p>
      <p class="mt-2 text-sm text-pretty text-fg-muted">{m.common_disclaimer()}</p>
    </aside>
  </article>
</PageLayout>
