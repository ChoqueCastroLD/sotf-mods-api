{
  "name": "@sotf/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify 5 API: /api/v2, the legacy /api/* compatibility layer, SSE, downloads and KelvinSeek.",
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-47301} HOST=${HOST:-127.0.0.1} node --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsdown",
    "migrate": "node src/migrate.ts",
    "backfill": "node src/backfill.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../packages/config/vitest/unit.ts",
    "test:int": "vitest run --config ../../packages/config/vitest/int.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/etag": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/sse": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/under-pressure": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@node-rs/bcrypt": "catalog:",
    "@scalar/fastify-api-reference": "catalog:",
    "@sentry/core": "catalog:",
    "@sotf/contracts": "workspace:*",
    "@sotf/core": "workspace:*",
    "@sotf/db": "workspace:*",
    "close-with-grace": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "fflate": "catalog:",
    "isbot": "catalog:",
    "lru-cache": "catalog:",
    "markdown-it": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "rehype-raw": "catalog:",
    "rehype-sanitize": "catalog:",
    "unified": "catalog:",
    "uuidv7": "catalog:",
    "yauzl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sotf/config": "workspace:*",
    "@sotf/emails": "workspace:*",
    "@sotf/migration-tools": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fflate": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  }
}
